(set:$EnemyMaxHP to 20)
(set:$EnemyHP to $EnemyMaxHP)

(set:$EnemyBaseDEF to 8)
(set:$EnemyDEF to $EnemyBaseDEF)
(set:$EnemySTR to 0)
(set:$EnemyDEX to 0)

(set:$EnemyAction1 to "Fist of Productivity")
(set:$EnemyAction2 to "Productive!")
(set:$EnemyAction3 to "Production Reduction")

(set:$EnemyActionCount to 0)
(set:$EnemyUseFistNext to false)

(set:$EnemyBattleSTRBonus to 0)
(set:$EnemyBattleDEXBonus to 0)

(set:$PlayerBattleSTRPenalty to 0)
(set:$PlayerBattleDEXPenalty to 0)

(set:$PlayerHasActed to false)
(set:$EnemyHasActed to false)


(set:$BattleMessage to $EnemyName + " cracks his productive knuckles.")
(set:$BattlePopup to "")
(set:$BattlePopupType to "")


(set:$EnemySkipNextTurn to false)
(set:$EnemyPaperCut to false)

(go-to:"Battle")


:: Captain Productivity Defeated {"position":"7500,4650","size":"100,100"}
(set:_AlreadyProductive to false)(for:each _activeStatus,...$ActiveStatuses)[(if:_activeStatus's "id" is "Productive")[(set:_AlreadyProductive to true)]](if:not _AlreadyProductive)[(set:$ActiveStatuses to $ActiveStatuses + (a:(dm:"id","Productive","duration",-1)))(set:$EnergyMaxBonus to $EnergyMaxBonus + 2)(set:$EnergyMax to $EnergyMax + 2)(set:$Energy to (min:$EnergyMax,$Energy + 2))](set:$CaptainProductivityDefeated to true)(set:$ShowCaptainProductivityDefeatedPopup to true)(set:$CaptainPostBattleVisits to 0)(go-to:"Your Office")


:: CaptainProductivity {"position":"8025,4700","size":"100,100"}
(set:$CaptainDialogueIndex to 1)(set:$CaptainDialogueLines to (a:"Welcome to Chapter 2!","You can access your inventory and map from icons that will appear at the bottom right.","You can only save the game while in your office, by accessing your nifty work computer!","I recommend you do that right after we're done talking.","You also have a storage box in your office, for keeping all those pesky items from crowding up your inventory.","I think that's all.","Best of luck, and remember.","Stay productive!"))(set:$CaptainDialogueAudio to (a:"audio/voices/Captain-1.m4a","audio/voices/Captain-2.m4a","audio/voices/Captain-3.m4a","audio/voices/Captain-4.m4a","audio/voices/Captain-5.m4a","audio/voices/Captain-6.m4a","audio/voices/Captain-7.m4a","audio/voices/Captain-8.m4a"))<div class="room-screen captain-bg"><div class="captain-speech-bubble"><div class="captain-speech-text">|captainSpeech>[(print:$CaptainDialogueLines's ($CaptainDialogueIndex))]</div>|captainPrompt>[(if:$CaptainDialogueIndex is 1)[<div class="captain-speech-prompt"></div>]]</div><div class="captain-advance-area">|captainAdvance>[Continue]</div>|captainVoice>[(print:'<audio autoplay preload="auto" style="display:none;" src="' + $CaptainDialogueAudio's ($CaptainDialogueIndex) + '"></audio>')]</div>(click-rerun:?captainAdvance)[(if:$CaptainDialogueIndex < $CaptainDialogueLines's length)[(set:$CaptainDialogueIndex to $CaptainDialogueIndex + 1)(rerun:?captainSpeech)(rerun:?captainPrompt)(rerun:?captainVoice)](else:)[(go-to:"Office Tutorial")]]


