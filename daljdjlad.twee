:: Maze 2 Hunter 1 Turn {"position":"10200,3850","size":"100,100"}
(set:_hasLOS to false)
(set:_blocked to false)

<!-- HORIZONTAL LOS -->

(if:$Maze2Hunter1Y is $Maze2PlayerY)[
	(set:_hasLOS to true)

	(for:each _scan,...(range:1,18))[
		(set:_between to false)

		(if:$Maze2Hunter1X < $Maze2PlayerX and _scan > $Maze2Hunter1X and _scan < $Maze2PlayerX)[
			(set:_between to true)
		]
		(else-if:$Maze2Hunter1X > $Maze2PlayerX and _scan < $Maze2Hunter1X and _scan > $Maze2PlayerX)[
			(set:_between to true)
		]

		(if:_between)[
			(set:_scanRow to $Maze2Rows's ($Maze2Hunter1Y))
			(if:_scanRow's (_scan) is "#")[
				(set:_blocked to true)
			]
		]
	]

	(if:_blocked)[
		(set:_hasLOS to false)
	]
]

<!-- VERTICAL LOS -->

(else-if:$Maze2Hunter1X is $Maze2PlayerX)[
	(set:_hasLOS to true)
	(set:_blocked to false)

	(for:each _scan,...(range:1,18))[
		(set:_between to false)

		(if:$Maze2Hunter1Y < $Maze2PlayerY and _scan > $Maze2Hunter1Y and _scan < $Maze2PlayerY)[
			(set:_between to true)
		]
		(else-if:$Maze2Hunter1Y > $Maze2PlayerY and _scan < $Maze2Hunter1Y and _scan > $Maze2PlayerY)[
			(set:_between to true)
		]

		(if:_between)[
			(set:_scanRow to $Maze2Rows's (_scan))
			(if:_scanRow's ($Maze2Hunter1X) is "#")[
				(set:_blocked to true)
			]
		]
	]

	(if:_blocked)[
		(set:_hasLOS to false)
	]
]

(set:$Maze2Hunter1SeesPlayer to _hasLOS)

<!-- ALERT / MEMORY -->

(if:_hasLOS)[
	(set:$Maze2Hunter1Alert to true)
	(set:$Maze2Hunter1LostSight to 0)
	(set:$Maze2Hunter1LastSeenX to $Maze2PlayerX)
	(set:$Maze2Hunter1LastSeenY to $Maze2PlayerY)
]

(else-if:$Maze2Hunter1Alert)[
	(set:$Maze2Hunter1LostSight to $Maze2Hunter1LostSight + 1)

	(if:$Maze2Hunter1LostSight >= 9)[
		(set:$Maze2Hunter1Alert to false)
		(set:$Maze2Hunter1LostSight to 0)
		(set:$Maze2Hunter1LastSeenX to 0)
		(set:$Maze2Hunter1LastSeenY to 0)
		(set:$Maze2Hunter1LastMove to "")
	]
]

<!-- AVAILABLE MOVES -->

(set:_enemyMoves to (a:))

(set:_targetX to $Maze2Hunter1X + 1)
(set:_targetY to $Maze2Hunter1Y)
(set:_enemyRow to $Maze2Rows's (_targetY))
(if:_enemyRow's (_targetX) is ".")[
	(if:not (_targetX is $Maze2Hunter2X and _targetY is $Maze2Hunter2Y))[
		(set:_enemyMoves to _enemyMoves + (a:"RIGHT"))
	]
]

(set:_targetX to $Maze2Hunter1X - 1)
(set:_targetY to $Maze2Hunter1Y)
(set:_enemyRow to $Maze2Rows's (_targetY))
(if:_enemyRow's (_targetX) is ".")[
	(if:not (_targetX is $Maze2Hunter2X and _targetY is $Maze2Hunter2Y))[
		(set:_enemyMoves to _enemyMoves + (a:"LEFT"))
	]
]

(set:_targetX to $Maze2Hunter1X)
(set:_targetY to $Maze2Hunter1Y + 1)
(set:_enemyRow to $Maze2Rows's (_targetY))
(if:_enemyRow's (_targetX) is ".")[
	(if:not (_targetX is $Maze2Hunter2X and _targetY is $Maze2Hunter2Y))[
		(set:_enemyMoves to _enemyMoves + (a:"DOWN"))
	]
]

(set:_targetX to $Maze2Hunter1X)
(set:_targetY to $Maze2Hunter1Y - 1)
(set:_enemyRow to $Maze2Rows's (_targetY))
(if:_enemyRow's (_targetX) is ".")[
	(if:not (_targetX is $Maze2Hunter2X and _targetY is $Maze2Hunter2Y))[
		(set:_enemyMoves to _enemyMoves + (a:"UP"))
	]
]

<!-- DEFAULT RANDOM PATROL -->

(set:_enemyMove to "")

(if:_enemyMoves's length > 0)[
	(set:_enemyMove to _enemyMoves's (random:1,_enemyMoves's length))
]

<!-- CHASE -->

(if:$Maze2Hunter1Alert)[
	(set:_chaseMoveFound to false)

	(if:$Maze2Hunter1LastSeenX > $Maze2Hunter1X and _chaseMoveFound is false)[
		(if:_enemyMoves contains "RIGHT")[
			(set:_enemyMove to "RIGHT")
			(set:_chaseMoveFound to true)
		]
	]

	(if:$Maze2Hunter1LastSeenX < $Maze2Hunter1X and _chaseMoveFound is false)[
		(if:_enemyMoves contains "LEFT")[
			(set:_enemyMove to "LEFT")
			(set:_chaseMoveFound to true)
		]
	]

	(if:$Maze2Hunter1LastSeenY > $Maze2Hunter1Y and _chaseMoveFound is false)[
		(if:_enemyMoves contains "DOWN")[
			(set:_enemyMove to "DOWN")
			(set:_chaseMoveFound to true)
		]
	]

	(if:$Maze2Hunter1LastSeenY < $Maze2Hunter1Y and _chaseMoveFound is false)[
		(if:_enemyMoves contains "UP")[
			(set:_enemyMove to "UP")
			(set:_chaseMoveFound to true)
		]
	]

	<!-- REACHED LAST-SEEN TILE -->

	(if:$Maze2Hunter1X is $Maze2Hunter1LastSeenX and $Maze2Hunter1Y is $Maze2Hunter1LastSeenY)[

		(if:$Maze2Hunter1LastMove is "RIGHT" and _enemyMoves contains "RIGHT")[
			(set:_enemyMove to "RIGHT")
		]
		(else-if:$Maze2Hunter1LastMove is "LEFT" and _enemyMoves contains "LEFT")[
			(set:_enemyMove to "LEFT")
		]
		(else-if:$Maze2Hunter1LastMove is "DOWN" and _enemyMoves contains "DOWN")[
			(set:_enemyMove to "DOWN")
		]
		(else-if:$Maze2Hunter1LastMove is "UP" and _enemyMoves contains "UP")[
			(set:_enemyMove to "UP")
		]
		(else-if:_enemyMoves's length > 0)[
			(set:_enemyMove to _enemyMoves's (random:1,_enemyMoves's length))
		]
	]
]

<!-- MOVE -->

(if:_enemyMove is "RIGHT")[
	(set:$Maze2Hunter1X to $Maze2Hunter1X + 1)
	(set:$Maze2Hunter1LastMove to "RIGHT")
]
(else-if:_enemyMove is "LEFT")[
	(set:$Maze2Hunter1X to $Maze2Hunter1X - 1)
	(set:$Maze2Hunter1LastMove to "LEFT")
]
(else-if:_enemyMove is "DOWN")[
	(set:$Maze2Hunter1Y to $Maze2Hunter1Y + 1)
	(set:$Maze2Hunter1LastMove to "DOWN")
]
(else-if:_enemyMove is "UP")[
	(set:$Maze2Hunter1Y to $Maze2Hunter1Y - 1)
	(set:$Maze2Hunter1LastMove to "UP")
]

<!-- PLAYER CAUGHT -->

(if:$Maze2Hunter1X is $Maze2PlayerX and $Maze2Hunter1Y is $Maze2PlayerY)[
	(set:$Maze2GameOver to true)
]


