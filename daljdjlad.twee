/* =========================================================
   FRIDGE HOTSPOTS
   ========================================================= */

.fridge-click-area {
	position: absolute !important;
	box-sizing: border-box !important;
	overflow: visible !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.fridge-lunch {
	left: 17%;
	top: 24%;
	width: 24.5%;
	height: 22%;
	z-index: 20;
}

.fridge-cheese {
	left: 30.4%;
	top: 50%;
	width: 16%;
	height: 17.8%;
	z-index: 21;
}

.fridge-close {
	left: 85.5%;
	top: 8%;
	width: 8.5%;
	height: 84%;
	z-index: 40;
}


/* =========================================================
   INVISIBLE HARLOWE FRIDGE HOTSPOT CONTENT
   ========================================================= */

.fridge-click-area > tw-hook,
.fridge-click-area > tw-expression,
.fridge-click-area > tw-link {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.fridge-click-area tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 10 !important;
}

.fridge-click-area tw-enchantment:hover,
.fridge-click-area tw-enchantment:focus,
.fridge-click-area tw-hook:hover,
.fridge-click-area tw-hook:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	text-decoration: none !important;
}


/* =========================================================
   FRIDGE HOVER LABELS
   ========================================================= */

.fridge-click-area::after {
	content: attr(data-label);
	position: absolute !important;
	left: 50% !important;
	top: 50% !important;
	display: block !important;
	transform: translate(-50%, -50%) !important;
	padding: 7px 12px !important;
	border: 1px solid rgba(255, 255, 255, 0.75) !important;
	border-radius: 4px !important;
	background: rgba(0, 0, 0, 0.88) !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	white-space: nowrap !important;
	opacity: 0 !important;
	visibility: hidden !important;
	pointer-events: none !important;
	z-index: 1000 !important;
}

.fridge-click-area:hover::after,
.fridge-click-area:focus-within::after {
	opacity: 1 !important;
	visibility: visible !important;
}

/* =========================================================
   SECRET HOTSPOT
   ========================================================= */

.room-screen tw-hook[name="ceilingtile"]:hover {
	background: transparent !important;
	outline: none !important;
}

.room-screen tw-hook[name="ceilingtile"]::after {
	display: none !important;
}


/* =========================================================
   SHARED DEBUG MODE

   Example:
   <div class="room-screen breakroom-bg debug-hotspots">

   or:
   <div class="room-screen freezer-bg debug-hotspots">
   ========================================================= */

.room-screen.debug-hotspots tw-hook {
	background: rgba(255, 0, 0, 0.2) !important;
	outline: 2px solid red !important;
	outline-offset: -2px !important;
}

.room-screen.debug-hotspots tw-hook::before {
	content: attr(name);

	position: absolute;
	left: 3px;
	top: 3px;

	display: block;

	padding: 3px 5px;

	color: white;
	background: rgba(0, 0, 0, 0.9);

	font-family: Arial, sans-serif;
	font-size: 11px;
	line-height: 1;

	pointer-events: none;
	z-index: 40;
}


/* =========================================================
   YOUR OFFICE — FULLSCREEN POINT-AND-CLICK ROOM
   ========================================================= */

.your-office-room {
	position: fixed;
	inset: 0;

	width: 100vw;
	height: 100vh;

	margin: 0;
	padding: 0;

	overflow: hidden;
	background: #000;

	z-index: 100;
}


/* The actual fullscreen office image */

.your-office-background {
	position: absolute;
	inset: 0;

	display: block;

	width: 100%;
	height: 100%;

	max-width: none;
	max-height: none;

	margin: 0;
	padding: 0;
	border: 0;

	object-fit: contain;
	object-position: center center;

	z-index: 101;
	pointer-events: none;
}


/* Layer containing all office hotspots */

.your-office-hotspots {
	position: absolute;
	inset: 0;

	width: 100%;
	height: 100%;

	z-index: 102;
	pointer-events: none;
}


/* Individual clickable office objects */

.your-office-hotspot {
	position: absolute;
	box-sizing: border-box;

	cursor: pointer;
	pointer-events: auto;
}


/* Make the Harlowe expression fill the office hotspot */

.your-office-hotspot tw-expression {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

	z-index: 5 !important;
}


/* Make the link fill the office hotspot */

.your-office-hotspot tw-link {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

	box-sizing: border-box !important;

	border: 0 !important;
	background: transparent !important;
	color: transparent !important;

	font-size: 0 !important;
	line-height: 0 !important;

	text-decoration: none !important;
	cursor: pointer !important;

	opacity: 1 !important;

	z-index: 6 !important;
}


/* Object name shown on hover */

.your-office-hotspot::after {
	content: attr(data-label);

	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);

	padding: 7px 12px;

	border: 1px solid rgba(255, 255, 255, 0.75);
	border-radius: 4px;

	background: rgba(0, 0, 0, 0.88);
	color: #ffffff;

	font-family: Arial, sans-serif;
	font-size: 16px;
	font-weight: bold;
	line-height: 1.2;

	white-space: nowrap;

	opacity: 0;
	pointer-events: none;

	transition: opacity 0.12s ease;

	z-index: 200;
}

.your-office-hotspot:hover::after {
	opacity: 1;
}


/* Very slight object highlight */

.your-office-hotspot:hover {
	background: rgba(255, 255, 255, 0.04);
}


/* =========================================================
   YOUR OFFICE HOTSPOT POSITIONS
   ========================================================= */

/* Door */

.office-door {
	left: 53.4%;
	top: 10.5%;

	width: 16.5%;
	height: 57%;
}


/* Computer */

.office-computer {
	left: 43.5%;
	top: 32.5%;

	width: 16%;
	height: 22%;
}


/* Main desk area, excluding drawers */

.office-desk {
	left: 19.5%;
	top: 48%;

	width: 45%;
	height: 16%;
}


/* Painting */

.office-painting {
	left: 35.8%;
	top: 16.5%;

	width: 9%;
	height: 15%;
}


/* Window */

.office-window {
	left: 4%;
	top: 3%;

	width: 22.5%;
	height: 50%;
}


/* Captain Productivity cutout */

.office-cutout {
	left: 71%;
	top: 14%;

	width: 19%;
	height: 59%;
}


/* Cardboard box */

.office-box {
	left: 79.5%;
	top: 68%;

