:: Maze Cleaner Turn {"position":"10100,3600","size":"100,100"}
<!-- =====================================================
     CALCULATE NEXT ROUTE INDEX
     ===================================================== -->

(set: _nextCleanerIndex to $MazeCleanerRouteIndex + (2 * $MazeCleanerDirection))

(if: _nextCleanerIndex > $MazeCleanerRoute's length)[
	(set: _nextCleanerIndex to 1)
]

(else-if: _nextCleanerIndex < 1)[
	(set: _nextCleanerIndex to $MazeCleanerRoute's length - 1)
]

(set: _nextCleanerX to $MazeCleanerRoute's (_nextCleanerIndex))
(set: _nextCleanerY to $MazeCleanerRoute's (_nextCleanerIndex + 1))


<!-- =====================================================
     CHECK NEXT TILE
     ===================================================== -->

(set: _cleanerRow to $MazeRows's (_nextCleanerY))
(set: _cleanerTile to _cleanerRow's (_nextCleanerX))
(set: _cleanerWalkable to false)
(set: _cleanerHitClosedDoor to false)

(if: _cleanerTile is ".")[
	(set: _cleanerWalkable to true)
]

(else-if: _cleanerTile is "D")[

	(set: _cleanerDoorID to (str:_nextCleanerX) + "," + (str:_nextCleanerY))

	(if: $MazeOpenDoors contains _cleanerDoorID)[
		(set: _cleanerWalkable to true)
	]

	(else:)[
		(set: _cleanerHitClosedDoor to true)
	]

]


<!-- =====================================================
     CLOSED DOOR:
     TAKE THE ROUTE THE OTHER WAY
     ===================================================== -->

(if: _cleanerHitClosedDoor)[

	(set: $MazeCleanerDirection to 0 - $MazeCleanerDirection)

	(set: _nextCleanerIndex to $MazeCleanerRouteIndex + (2 * $MazeCleanerDirection))

	(if: _nextCleanerIndex > $MazeCleanerRoute's length)[
		(set: _nextCleanerIndex to 1)
	]

	(else-if: _nextCleanerIndex < 1)[
		(set: _nextCleanerIndex to $MazeCleanerRoute's length - 1)
	]

	(set: _nextCleanerX to $MazeCleanerRoute's (_nextCleanerIndex))
	(set: _nextCleanerY to $MazeCleanerRoute's (_nextCleanerIndex + 1))


	<!-- CHECK ALTERNATIVE DIRECTION -->

	(set: _cleanerRow to $MazeRows's (_nextCleanerY))
	(set: _cleanerTile to _cleanerRow's (_nextCleanerX))
	(set: _cleanerWalkable to false)

	(if: _cleanerTile is ".")[
		(set: _cleanerWalkable to true)
	]

	(else-if: _cleanerTile is "D")[

		(set: _cleanerDoorID to (str:_nextCleanerX) + "," + (str:_nextCleanerY))

		(if: $MazeOpenDoors contains _cleanerDoorID)[
			(set: _cleanerWalkable to true)
		]

	]

]


<!-- =====================================================
     OTHER ENEMIES BLOCK CLEANER
     ===================================================== -->

(set: _cleanerBlocked to false)

(if:
	(_nextCleanerX is $MazeEnemyX and _nextCleanerY is $MazeEnemyY)
	or
	(_nextCleanerX is $MazeEnemy3X and _nextCleanerY is $MazeEnemy3Y)
	or
	(_nextCleanerX is $MazeEnemy2X and _nextCleanerY is $MazeEnemy2Y)
)[
	(set: _cleanerBlocked to true)
]


<!-- =====================================================
     MOVE
     ===================================================== -->

(if:
	_cleanerWalkable
	and
	_cleanerBlocked is false
)[

	(set: $MazeCleanerX to _nextCleanerX)
	(set: $MazeCleanerY to _nextCleanerY)

	(set: $MazeCleanerRouteIndex to _nextCleanerIndex)

]


<!-- PLAYER CAUGHT -->

(if:
	$MazeCleanerX is $MazePlayerX
	and
	$MazeCleanerY is $MazePlayerY
)[
	(set: $MazeGameOver to true)
]


:: Maze Edge Enemy Turn {"position":"10000,3600","size":"100,100"}
(set: _edgeNextX to $MazeEnemy2X)
(set: _edgeNextY to $MazeEnemy2Y)


<!-- =====================================================
     CALCULATE NEXT TILE IN CURRENT DIRECTION
     ===================================================== -->

(if: $MazeEnemy2Clockwise)[

	(if: $MazeEnemy2Y is 2 and $MazeEnemy2X < 17)[
		(set: _edgeNextX to $MazeEnemy2X + 1)
	]

	(else-if: $MazeEnemy2X is 17 and $MazeEnemy2Y < 17)[
		(set: _edgeNextY to $MazeEnemy2Y + 1)
	]

	(else-if: $MazeEnemy2Y is 17 and $MazeEnemy2X > 2)[
		(set: _edgeNextX to $MazeEnemy2X - 1)
	]

	(else-if: $MazeEnemy2X is 2 and $MazeEnemy2Y > 2)[
		(set: _edgeNextY to $MazeEnemy2Y - 1)
	]

]

(else:)[

	(if: $MazeEnemy2Y is 2 and $MazeEnemy2X > 2)[
		(set: _edgeNextX to $MazeEnemy2X - 1)
	]

	(else-if: $MazeEnemy2X is 2 and $MazeEnemy2Y < 17)[
		(set: _edgeNextY to $MazeEnemy2Y + 1)
	]

	(else-if: $MazeEnemy2Y is 17 and $MazeEnemy2X < 17)[
		(set: _edgeNextX to $MazeEnemy2X + 1)
	]

	(else-if: $MazeEnemy2X is 17 and $MazeEnemy2Y > 2)[
		(set: _edgeNextY to $MazeEnemy2Y - 1)
	]

]


<!-- =====================================================
     CHECK NEXT TILE
     ===================================================== -->

(set: _edgeRow to $MazeRows's (_edgeNextY))
(set: _edgeTile to _edgeRow's (_edgeNextX))

(set: _edgeWalkable to false)
(set: _edgeReverse to false)


<!-- NORMAL FLOOR -->

(if: _edgeTile is ".")[
	(set: _edgeWalkable to true)
]


<!-- DOOR -->

(else-if: _edgeTile is "D")[

	(set: _edgeDoorID to (str:_edgeNextX) + "," + (str:_edgeNextY))

	(if: $MazeOpenDoors contains _edgeDoorID)[
		(set: _edgeWalkable to true)
	]

	(else:)[
		(set: _edgeReverse to true)
	]

]


<!-- WALL -->

(else-if: _edgeTile is "#")[
	(set: _edgeReverse to true)
]


<!-- ANY OTHER NON-WALKABLE MAP TILE -->

(else:)[
	(set: _edgeReverse to true)
]


<!-- =====================================================
     BLOCKED BY MAP:
     REVERSE DIRECTION
     ===================================================== -->

(if: _edgeReverse)[

	(if: $MazeEnemy2Clockwise)[
		(set: $MazeEnemy2Clockwise to false)
	]

	(else:)[
		(set: $MazeEnemy2Clockwise to true)
	]


	<!-- RECALCULATE TILE IN NEW DIRECTION -->

	(set: _edgeNextX to $MazeEnemy2X)
	(set: _edgeNextY to $MazeEnemy2Y)

	(if: $MazeEnemy2Clockwise)[

		(if: $MazeEnemy2Y is 2 and $MazeEnemy2X < 17)[
			(set: _edgeNextX to $MazeEnemy2X + 1)
		]

		(else-if: $MazeEnemy2X is 17 and $MazeEnemy2Y < 17)[
			(set: _edgeNextY to $MazeEnemy2Y + 1)
		]

		(else-if: $MazeEnemy2Y is 17 and $MazeEnemy2X > 2)[
			(set: _edgeNextX to $MazeEnemy2X - 1)
		]

		(else-if: $MazeEnemy2X is 2 and $MazeEnemy2Y > 2)[
			(set: _edgeNextY to $MazeEnemy2Y - 1)
		]

	]

	(else:)[

		(if: $MazeEnemy2Y is 2 and $MazeEnemy2X > 2)[
			(set: _edgeNextX to $MazeEnemy2X - 1)
		]

		(else-if: $MazeEnemy2X is 2 and $MazeEnemy2Y < 17)[
			(set: _edgeNextY to $MazeEnemy2Y + 1)
		]

		(else-if: $MazeEnemy2Y is 17 and $MazeEnemy2X < 17)[
			(set: _edgeNextX to $MazeEnemy2X + 1)
		]

		(else-if: $MazeEnemy2X is 17 and $MazeEnemy2Y > 2)[
			(set: _edgeNextY to $MazeEnemy2Y - 1)
		]

	]


	<!-- CHECK NEW TILE -->

	(set: _edgeRow to $MazeRows's (_edgeNextY))
	(set: _edgeTile to _edgeRow's (_edgeNextX))

	(set: _edgeWalkable to false)

	(if: _edgeTile is ".")[
		(set: _edgeWalkable to true)
	]

	(else-if: _edgeTile is "D")[

		(set: _edgeDoorID to (str:_edgeNextX) + "," + (str:_edgeNextY))

		(if: $MazeOpenDoors contains _edgeDoorID)[
			(set: _edgeWalkable to true)
		]

	]

]


<!-- =====================================================
     CHECK OTHER ENEMIES
     They make ◆ wait, NOT reverse.
     ===================================================== -->

(set: _edgeEnemyBlocked to false)

(if:
	(_edgeNextX is $MazeEnemyX and _edgeNextY is $MazeEnemyY)
	or
	(_edgeNextX is $MazeEnemy3X and _edgeNextY is $MazeEnemy3Y)
	or
	(_edgeNextX is $MazeCleanerX and _edgeNextY is $MazeCleanerY)
)[
	(set: _edgeEnemyBlocked to true)
]


<!-- =====================================================
     MOVE
     ===================================================== -->

(if:
	_edgeWalkable
	and
	_edgeEnemyBlocked is false
)[
	(set: $MazeEnemy2X to _edgeNextX)
	(set: $MazeEnemy2Y to _edgeNextY)
]


<!-- =====================================================
     PLAYER CAUGHT
     ===================================================== -->

(if:
	$MazeEnemy2X is $MazePlayerX
	and
	$MazeEnemy2Y is $MazePlayerY
)[
	(set: $MazeGameOver to true)
]


:: Maze Main Enemy 2 Turn {"position":"9900,3600","size":"100,100"}
(set: _hasLOS to false)
(set: _blocked to false)

(if: $MazeEnemy3Y is $MazePlayerY)[

	(set: _hasLOS to true)

	(for: each _scan, ...(range:1,18))[

		(set: _between to false)

		(if:
			$MazeEnemy3X < $MazePlayerX
			and _scan > $MazeEnemy3X
			and _scan < $MazePlayerX
		)[
			(set: _between to true)
		]

		(else-if:
			$MazeEnemy3X > $MazePlayerX
			and _scan < $MazeEnemy3X
			and _scan > $MazePlayerX
		)[
			(set: _between to true)
		]

		(if: _between)[

			(set: _scanRow to $MazeRows's ($MazeEnemy3Y))
			(set: _scanTile to _scanRow's (_scan))

			(if: _scanTile is "#")[
				(set: _blocked to true)
			]

			(else-if: _scanTile is "D")[

				(set: _scanDoorID to (str:_scan) + "," + (str:$MazeEnemy3Y))

				(if: not ($MazeOpenDoors contains _scanDoorID))[
					(set: _blocked to true)
				]

			]

		]

	]

	(if: _blocked)[
		(set: _hasLOS to false)
	]

]

(else-if: $MazeEnemy3X is $MazePlayerX)[

	(set: _hasLOS to true)
	(set: _blocked to false)

	(for: each _scan, ...(range:1,18))[

		(set: _between to false)

		(if:
			$MazeEnemy3Y < $MazePlayerY
			and _scan > $MazeEnemy3Y
			and _scan < $MazePlayerY
		)[
			(set: _between to true)
		]

		(else-if:
			$MazeEnemy3Y > $MazePlayerY
			and _scan < $MazeEnemy3Y
			and _scan > $MazePlayerY
		)[
			(set: _between to true)
		]

		(if: _between)[

			(set: _scanRow to $MazeRows's (_scan))
			(set: _scanTile to _scanRow's ($MazeEnemy3X))

			(if: _scanTile is "#")[
				(set: _blocked to true)
			]

			(else-if: _scanTile is "D")[

				(set: _scanDoorID to (str:$MazeEnemy3X) + "," + (str:_scan))

				(if: not ($MazeOpenDoors contains _scanDoorID))[
					(set: _blocked to true)
				]

			]

		]

	]

	(if: _blocked)[
		(set: _hasLOS to false)
	]

]

(set: $MazeEnemy3SeesPlayer to _hasLOS)

(if: _hasLOS)[

	(set: $MazeEnemy3Alert to true)
	(set: $MazeEnemy3LostSight to 0)

	(set: $MazeEnemy3LastSeenX to $MazePlayerX)
	(set: $MazeEnemy3LastSeenY to $MazePlayerY)

]

