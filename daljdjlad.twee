:: InvUseConsumable {"position":"500,3350","size":"100,100"}
(link-repeat:"Use")[
	(set:_usedItem to $InspectItem)
	(set:_usedSource to $InspectSource)
	(set:_consumeItem to true)

	(if:_usedItem is "Nutrition Bar")[
		(if:$HP >= $MaxHP)[
			(set:$InvMessage to "You are already at full HP.")
			(set:_consumeItem to false)
		]
		(else:)[
			(set:_healing to (random:1,4) + 2)
			(set:_oldHP to $HP)
			(set:$HP to (min:$MaxHP,$HP + _healing))
			(set:_actualHealing to $HP - _oldHP)
			(set:$InvMessage to "You eat the Nutrition Bar and recover " + (str:_actualHealing) + " HP.")
		]
	]

	(else-if:_usedItem is "Cookie")[
		(if:$HP >= $MaxHP)[
			(set:$InvMessage to "You are already at full HP.")
			(set:_consumeItem to false)
		]
		(else:)[
			(set:_healing to (random:1,4))
			(set:_oldHP to $HP)
			(set:$HP to (min:$MaxHP,$HP + _healing))
			(set:_actualHealing to $HP - _oldHP)
			(set:$InvMessage to "You eat Jennifer's homemade Cookie and recover " + (str:_actualHealing) + " HP.")
		]
	]

	(else-if:_usedItem is "Cheese")[
		(if:$HP >= $MaxHP)[
			(set:$InvMessage to "You are already at full HP.")
			(set:_consumeItem to false)
		]
		(else:)[
			(set:_oldHP to $HP)
			(set:$HP to (min:$MaxHP,$HP + 2))
			(set:_actualHealing to $HP - _oldHP)
			(set:$InvMessage to "You eat the grimy cheese and recover " + (str:_actualHealing) + " HP.")
		]
	]

	(else-if:_usedItem is "Ice Cream")[
		(if:$HP >= $MaxHP)[
			(set:$InvMessage to "You are already at full HP.")
			(set:_consumeItem to false)
		]
		(else:)[
			(set:_healing to (random:1,6) + 4)
			(set:_oldHP to $HP)
			(set:$HP to (min:$MaxHP,$HP + _healing))
			(set:_actualHealing to $HP - _oldHP)
			(set:$InvMessage to "You eat the Ice Cream and recover " + (str:_actualHealing) + " HP.")
		]
	]

	(else-if:_usedItem is "Cigarette")[
		(if:$Energy >= $EnergyMax)[
			(set:$InvMessage to "You are already at full Energy.")
			(set:_consumeItem to false)
		]
		(else:)[
			(set:_oldEnergy to $Energy)
			(set:$Energy to (min:$EnergyMax,$Energy + 2))
			(set:_actualEnergy to $Energy - _oldEnergy)
			(set:$InvMessage to "You smoke the Cigarette and recover " + (str:_actualEnergy) + " Energy.")
		]
	]

	(else-if:_usedItem is "LifeLong Caffeine Booster Can")[
		(set:$DEX to $DEX + 1)
		(set:$InvMessage to "You drink the entire can. Your hands begin vibrating at professional speed. DEX permanently increased by 1.")
	]

	(else-if:_usedItem is "ScaldShield Stomach-Lining Shot")[
		(set:$Officeness to $Officeness + 1)
		(set:$InvMessage to "You swallow the chemical lining agent. You now fear neither boiling coffee nor workplace regulations. Officeness permanently increased by 1.")
	]

	(else-if:_usedItem is "Chonko Chocobar")[
		(set:$HP to (max:0,$HP - 2))
		(set:$CON to $CON + 1)
		(set:$InvMessage to "The Chonko Chocobar damages several internal organs, but makes the survivors stronger. You take 2 damage and permanently gain 1 CON.")
	]

	(else-if:_usedItem is "Disinfectant")[
		(set:$HP to (max:0,$HP - 4))
		(set:$CON to $CON + 1)
		(set:$InvMessage to "The Disinfectant damages several internal organs, but makes the survivors stronger. You take 4 damage and permanently gain 1 CON.")
	]

	(else-if:_usedItem is "Can of Whoop Ass")[
		(set:$STR to $STR + 1)
		(set:$InvMessage to "You crack open the Can of Whoop Ass and drink concentrated hostility. STR permanently increased by 1. Constipation may follow.")
	]

	(else:)[
		(set:$InvMessage to "You cannot use that item.")
		(set:_consumeItem to false)
	]

	(if:_consumeItem)[
		(if:_usedSource is "InvSlot1")[
			(set:$InvSlot1 to "Empty")
		]
		(else-if:_usedSource is "InvSlot2")[
			(set:$InvSlot2 to "Empty")
		]
		(else-if:_usedSource is "InvSlot3")[
			(set:$InvSlot3 to "Empty")
		]
		(else-if:_usedSource is "InvSlot4")[
			(set:$InvSlot4 to "Empty")
		]
		(else-if:_usedSource is "InvSlot5")[
			(set:$InvSlot5 to "Empty")
		]
		(else-if:_usedSource is "InvSlot6")[
			(set:$InvSlot6 to "Empty")
		]

		(set:$InspectItem to "")
		(set:$InspectSource to "")
	]

	(display:"InvStatBonuses")
	(display:"UpdateStats")
	(rerun:?HPDATA)
	(rerun:?invBagHook)
	(rerun:?invCharacterHook)
	(rerun:?invInspectHook)
]


:: Is Hugh Jass there? {"position":"8550,2300","size":"100,100"}



:: Is everything ok? [PanelLeft Rey] {"position":"100,8400","size":"100,100"}
The man catches the word.

“Ok,” he repeats, smiling.

He seals it with a small, deliberate nod.

(text-colour:lime)[Rey: Ok. Friend. Ok.]

Koemi gives a short nod in return.

He taps his chest.

(text-colour:lime)[Rey… Rey.]

Then he turns to Guyh.

(text-colour:lime)[Guyh.]

He lifts his chin slightly, angling himself toward him- not confrontational, just closer.

The smile shifts. Not wider. Warmer.

(text-colour:lime)[My friend. Let me taste that gift of the gab.]

His finger rises and rests lightly against his tongue.

[[...|NEXT0]]


