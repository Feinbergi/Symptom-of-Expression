}



/* =========================================================
   YOUR OFFICE DEBUG MODE

   Add "debug-hotspots" to your-office-room.
   ========================================================= */

.your-office-room.debug-hotspots .your-office-hotspot {
	border: 3px solid rgba(255, 0, 0, 0.95);
	background: rgba(255, 0, 0, 0.18);
}

.your-office-room.debug-hotspots .your-office-hotspot::after {
	opacity: 1;
}


/* =========================================================
   SMALL SCREEN LABELS
   ========================================================= */

@media screen and (max-width: 700px) {
	.room-screen tw-hook:not([name="ceilingtile"])::after {
		max-width: 170px;
		padding: 6px 10px;

		font-size: 13px;
		white-space: normal;
	}

	.your-office-hotspot::after {
		max-width: 170px;
		padding: 6px 10px;

		font-size: 13px;
		white-space: normal;
		text-align: center;
	}

	#mapUI {
		right: 12px !important;
		bottom: 12px !important;
	}
}

