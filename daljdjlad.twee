(set:$AlienTranslatedDialogue to (dm:
"npcName","Pierre",
"playerName","You",
"playerPortrait","https://i.ibb.co/zH6zBCBq/Screenshot-2026-07-21-at-01-03-39.png",
"npcPortrait","https://i.ibb.co/cSwqGjCF/Chat-GPT-Image-Jul-26-2026-at-06-55-36-PM.png","background","https://i.ibb.co/x8cXrBYW/Chat-GPT-Image-Jul-23-2026-at-12-06-54-AM.png",
"exitPassage","Break Room - Freezer",

"openingEvents",(a:
	(dm:
		"speaker","action",
		"text","The Translator Torc hums softly around your neck."
	),
	(dm:
		"speaker","action",
		"text","The alien's incomprehensible babbling abruptly resolves into perfectly understandable speech."
	),
	(dm:
		"speaker","npc",
		"text","Hello! Can you understand me?"
	)
),

"stages",(a:

	(dm:
		"id","start",
		"choices",(a:

			(dm:
				"label","Yes. Finally.",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Yes. Finally."
					),
					(dm:
						"speaker","npc",
						"text","Thank God. I've been freezing in here."
					),
					(dm:
						"speaker","npc",
						"text","I come from the planet Bungus Prime."
					),
					(dm:
						"speaker","npc",
						"text","My ship crash-landed while I was making a brief stop on Earth during my journey to an intergalactic court hearing... and to pick up an Earthish delicacy."
					)
				),
				"next","introQuestions"
			)

		)
	),

	(dm:
		"id","introQuestions",
		"choices",(a:

			(dm:
				"label","Court hearing?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Court hearing?"
					),
					(dm:
						"speaker","npc",
						"text","Yes. I must appeal against a DUI conviction."
