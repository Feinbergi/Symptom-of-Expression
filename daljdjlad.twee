			(dm:
				"label","Wait a second. Why is your head in the office freezer?!",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Wait a second. Why is your head in the office freezer?!"
					),
					(dm:
						"speaker","npc",
						"text","Ah..."
					),
					(dm:
						"speaker","npc",
						"text","Shortly after crashing, I wandered into this office in search of assistance."
					),
					(dm:
						"speaker","npc",
						"text","Unfortunately, I encountered the building's janitor."
					),
					(dm:
						"speaker","npc",
						"text","He kept muttering something about purging the unclean..."
					),
					(dm:
						"speaker","npc",
						"text","Then he decapitated me, put my head in this freezer, and goodness knows what became of the rest of my belongings."
					)
				),
				"next","helpDecision"
			)

		)
	),

	(dm:
