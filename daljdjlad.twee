					(dm:
						"speaker","player",
						"text","Makes sense. Okay, I'll help you. What do I need to do?"
					),
					(dm:
						"speaker","npc",
						"text","Thank you, Earthling!"
					),
					(dm:
						"speaker","npc",
						"text","My ship's battery requires..."
					),
					(dm:
						"speaker","action",
						"text","Pierre pauses dramatically."
					),
					(dm:
						"speaker","npc",
						"text","...a new battery."
					),
					(dm:
						"speaker","npc",
						"text","A very specific one."
					),
					(dm:
						"speaker","npc",
						"text","I require a Triple A battery."
					)
				),
				"next","batteryReaction"
			),

			(dm:
				"label","Makes sense. Sorry, but I don't want to interfere with the janitor's business.",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Makes sense. Sorry, but I don't want to interfere with the janitor's business."
					),
					(dm:
						"speaker","player",
						"text","I'm sure he put your head in here for a reason. I'll find out why."
					),
					(dm:
						"speaker","npc",
						"text","Oh, please reconsider!"
					),
					(dm:
						"speaker","npc",
						"text","I am not unclean. I believe the janitor is a raving madman who has made a simple janitorial error!"
					),
					(dm:
						"speaker","player",
						"text","We'll see..."
					)
				),
				"setAlienState","refused",
				"next","end"
			)

		)
	),

	(dm:
		"id","batteryReaction",
		"choices",(a:

			(dm:
				"label","Are you serious?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Are you serious?"
					),
