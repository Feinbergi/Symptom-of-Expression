<script>
(function () {
	if (!window.twineMenu) return;

	window.twineMenu.play().catch(function () {});

	if (window.bullpenMusicObserver) {
		window.bullpenMusicObserver.disconnect();
	}

	window.bullpenMusicObserver = new MutationObserver(function () {
		setTimeout(function () {
			if (!document.querySelector(".bullpen-bg")) {
				window.twineMenu.pause();
				window.twineMenu.currentTime = 0;
				window.bullpenMusicObserver.disconnect();
				window.bullpenMusicObserver = null;
			}
		}, 0);
	});

	window.bullpenMusicObserver.observe(document.querySelector("tw-story"), {
		childList: true,
		subtree: true
	});
})();
</script>


