	),

	(dm:
		"id","workBorrowDeck",
		"choices",(a:

			(dm:
				"label","Could I borrow one of yours?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Could I borrow one of yours?"
					),
					(dm:
						"speaker","action",
						"text","The moss growing along Jerry's shoulders stiffens defensively."
					),
					(dm:
						"speaker","npc",
						"text","No."
					),
					(dm:
						"speaker","npc",
						"text","My decks are precious."
