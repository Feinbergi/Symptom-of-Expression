	),

	(dm:
		"id","identitySimple",
		"choices",(a:

			(dm:
				"label","So you're basically a facilities employee?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","So you're basically a facilities employee?"
					),
					(dm:
						"speaker","npc",
						"text","Yes."
					)
				),
				"setJerryIdentitySeen",true,
				"next","mainMenu"
			)

		)
	),

	(dm:
		"id","flugiyoRulesOne",
		"choices",(a:

			(dm:
				"label","How does the game work?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","How does the game work?"
					),
					(dm:
