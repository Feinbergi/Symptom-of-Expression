</div>

</div>


]


</div>


]


</div>

</div>


<div class="battle-divider"><span>⚔</span></div>


<div class="board-half player-board-half">

<div class="board-label player-board-label">YOU</div>


<div class="lane-row player-lanes">


(for:each _lane,...(range:1,3))[


<div class="lane-column">

<div class="lane-number">LANE (print:_lane)</div>


(if:(datanames:$PlayerBoard's (_lane))'s length is 0)[


(if:
	_hasSelectedCard and
	_selectedCardType is "creature" and
	$CurrentCardTurn is "player" and
	not $GameOver
)[

	<div class="empty-creature-slot playable-empty-slot">

	(link:"EMPTY")[

		(set:$TargetLane to
			_lane
		)

		(display:"Play Creature Logic")

		(rerun:?GameUI)

	]

	</div>

]


(else:)[

	<div class="empty-creature-slot">EMPTY</div>

]


]


(else:)[


(set:_creature to
	$PlayerBoard's (_lane)
)

(set:_displayDamage to
	_creature's "damage"
)

<!-- =========================================================
     CHECK WHETHER THE SELECTED CREATURE MAY BE PLAYED ONTO
     THIS OCCUPIED FRIENDLY LANE

     GENERIC RULES

     - Identical Food may stack.
     - Food may be played onto any non-Food, non-Object creature.
     - Food may also be played onto Cooking Pot.
     - A non-Food, non-Object creature may replace friendly Food.
     - Cooking Pot may also be played onto friendly Food.
     ========================================================= -->

(set:_selectedCreatureCanPlayHere to false)

(if:
	_hasSelectedCard and
	_selectedCardType is "creature" and
	$CurrentCardTurn is "player" and
	not $GameOver
)[

	<!-- IDENTICAL FOOD ONTO IDENTICAL FOOD -->

	(if:
		_selectedCardTribe is "Food" and
		_creature's "tribe" is "Food" and
		_selectedCardDefinitionID is
		_creature's "definitionID"
	)[
		(set:_selectedCreatureCanPlayHere to true)
	]


	<!-- FOOD ONTO A CREATURE THAT CAN CONSUME IT -->

	(else-if:
		_selectedCardTribe is "Food" and
		(
			(
				_creature's "tribe" is not "Food" and
				_creature's "tribe" is not "Object"
			) or
			_creature's "definitionID" is "cooking-pot"
		)
	)[
		(set:_selectedCreatureCanPlayHere to true)
	]


	<!-- CREATURE OR COOKING POT ONTO FRIENDLY FOOD -->

	(else-if:
		(_selectedCardTribe is not "Food") and
		(
			(_selectedCardTribe is not "Object") or
			(_selectedCardDefinitionID is "cooking-pot")
		) and
		(_creature's "tribe" is "Food")
	)[
		(set:_selectedCreatureCanPlayHere to true)
	]

]


(if:_creature's "effect" is "gnome-warrior")[

	(set:_friendlyGnomes to 0)


	(for:each _countLane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_countLane))'s length > 0)[

			(set:_countCreature to
				$PlayerBoard's (_countLane)
			)


			(if:_countCreature's "tribe" is "Gnome")[

				(set:_friendlyGnomes to
					_friendlyGnomes + 1
				)

			]

		]

	]


	(set:_displayDamage to
		_friendlyGnomes
	)

]


(else-if:_creature's "effect" is "hedgehog-knight")[

	(set:_displayDamage to
		$PlayerGnomesDied
	)

]


(set:_abilityText to "")


(if:_creature's "effect" is not "")[

	(set:_abilityText to
		_creature's "description"
	)

]


<div class="creature-card player-creature-card">


(if:_abilityText is not "")[

	<div class="card-ability-tooltip">

	<div class="ability-tooltip-title">(print:_creature's "name")</div>

	<div class="ability-tooltip-text">(print:_abilityText)</div>

	</div>

]


<div class="creature-cost">(print:_creature's "cost")</div>


<div class="creature-name">


<!-- JUDAS BATTLECRY TARGET OR SPELL TARGET -->

(if:
	$JudasTargeting and
	$CurrentCardTurn is "player" and
	not $GameOver and
	_lane is not $JudasLane
)[
	(link:_creature's "name")[
		(set:$SelectedTargetSide to "player")
		(set:$SelectedTargetType to "creature")
		(set:$SelectedTargetLane to _lane)
		(display:"Resolve Judas Battlecry Target")
		(set:$CardGameMessage to $JudasMessage)
		(rerun:?GameUI)
	]
]

(else-if:
	_hasSelectedCard and
	_selectedCardType is "spell" and
	(
		_selectedCardEffect is "shovel" or
		_selectedCardEffect is "gnome-sweet-gnome" or
		_selectedCardEffect is "sacrifice-friendly-creature-for-health-damage" or
		_selectedCardEffect is "sacrifice-friendly-creature-draw-one" or
		_selectedCardEffect is "sacrifice-friendly-creature-heal-current-health" or
		_selectedCardEffect is "destroy-any-creature" or
		_selectedCardEffect is "eat-creature-health-greater-than-player"
	) and
	$CurrentCardTurn is "player" and
	not $GameOver
)[

	(link:_creature's "name")[

		(set:$SelectedTargetSide to
			"player"
		)

		(set:$SelectedTargetType to
			"creature"
		)

		(set:$SelectedTargetLane to
			_lane
		)

		(display:"Cast Selected Spell Logic")

		(rerun:?GameUI)

	]

]


<!-- SPECIAL CREATURE PLACEMENT TARGET -->

(else-if:_selectedCreatureCanPlayHere)[

	(link:_creature's "name")[

		(set:$TargetLane to
			_lane
		)

		(display:"Play Creature Logic")

		(rerun:?GameUI)

	]

]


(else:)[

	(print:_creature's "name")

]


</div>


<div class="creature-status">

(if:_creature's "ready")[READY]

(else:)[RESTING]

</div>


<div class="creature-stats">

<span class="damage-stat">⚔ (print:_displayDamage)</span>

<span class="health-stat">♥ (print:_creature's "hp")/(print:_creature's "maxHP") (if:_creature's "poison" > 0)[☠ (print:_creature's "poison")]</span>

</div>

</div>


]


</div>


]


</div>

</div>


</div>


<div class="hand-area">

<div class="hand-title">YOUR HAND</div>


<div class="player-hand">


(if:$PlayerHand's length is 0)[


<div class="empty-hand-message">Your hand is empty.</div>


]


(else:)[


(for:each _card,...$PlayerHand)[


(set:_canPlayCard to true)

(if:$JudasTargeting or $ClownTargeting or $RingmasterTargeting or $NextUpTargeting)[
	(set:_canPlayCard to false)
]

(set:_isSelected to false)


(if:$CurrentCardTurn is not "player")[

	(set:_canPlayCard to false)

]


(if:$GameOver)[

	(set:_canPlayCard to false)

]


(if:_card's "cost" > $PlayerMana)[

	(set:_canPlayCard to false)

]


<!-- =========================================================
     DETERMINE WHETHER THIS CREATURE HAS AT LEAST ONE LEGAL
     PLACEMENT LANE

     Legal placements include:

     - any empty lane;
     - identical Food onto identical Food;
     - Food onto any non-Food, non-Object creature;
     - Food onto Cooking Pot;
     - a non-Food, non-Object creature onto friendly Food;
     - Cooking Pot onto friendly Food.
     ========================================================= -->

(if:_card's "type" is "creature")[

	(set:_hasLegalCreatureLane to false)

	(for:each _placementLane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_placementLane))'s length is 0)[
			(set:_hasLegalCreatureLane to true)
		]

		(else:)[

			(set:_placementTarget to
				$PlayerBoard's (_placementLane)
			)

			<!-- IDENTICAL FOOD STACK -->

			(if:
				_card's "tribe" is "Food" and
				_placementTarget's "tribe" is "Food" and
				_card's "definitionID" is
				_placementTarget's "definitionID"
			)[
				(set:_hasLegalCreatureLane to true)
			]


			<!-- FOOD ONTO A CREATURE THAT CAN CONSUME IT -->

			(else-if:
				_card's "tribe" is "Food" and
				(
					(
						_placementTarget's "tribe" is not "Food" and
						_placementTarget's "tribe" is not "Object"
					) or
					_placementTarget's "definitionID" is "cooking-pot"
				)
			)[
				(set:_hasLegalCreatureLane to true)
			]


			<!-- CREATURE OR COOKING POT ONTO FRIENDLY FOOD -->

			(else-if:
				(_card's "tribe" is not "Food") and
				(
					(_card's "tribe" is not "Object") or
					(_card's "definitionID" is "cooking-pot")
				) and
				(_placementTarget's "tribe" is "Food")
			)[
				(set:_hasLegalCreatureLane to true)
			]

		]

	]

	(if:not _hasLegalCreatureLane)[

		(set:_canPlayCard to
			false
		)

	]

]


(else-if:
	_card's "effect" is "shovel" or
	_card's "effect" is "pie-toss" or
	_card's "effect" is "destroy-any-creature" or
	_card's "effect" is "eat-creature-health-greater-than-player"
)[

	(if:not _hasAnyCreatureTarget)[

		(set:_canPlayCard to false)

	]

]


(else-if:
	_card's "effect" is
	"sacrifice-friendly-creature-for-health-damage" or
	_card's "effect" is
	"sacrifice-friendly-creature-draw-one" or
	_card's "effect" is
	"sacrifice-friendly-creature-heal-current-health"
)[

	(if:not _hasAnyFriendlyCreatureTarget)[

		(set:_canPlayCard to false)

	]

]


(if:_hasSelectedCard)[

	(if:_card's "id" is $SelectedCard's "id")[

		(set:_isSelected to true)

	]

]


(set:_handDisplayDamage to
	_card's "damage"
)


(if:_card's "effect" is "gnome-warrior")[

	(set:_handFriendlyGnomes to 1)


	(for:each _countLane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_countLane))'s length > 0)[

			(set:_countCreature to
				$PlayerBoard's (_countLane)
			)


			(if:_countCreature's "tribe" is "Gnome")[

				(set:_handFriendlyGnomes to
					_handFriendlyGnomes + 1
				)

			]

		]

	]


	(set:_handDisplayDamage to
		_handFriendlyGnomes
	)

]


(else-if:_card's "effect" is "hedgehog-knight")[

	(set:_handDisplayDamage to
		$PlayerGnomesDied
	)

]


(set:_abilityText to "")


(if:_card's "effect" is not "")[

	(set:_abilityText to
		_card's "description"
	)


	(if:_card's "effect" is "gnome-sweet-gnome")[

		(set:_abilityText to
			_abilityText +
			" Current damage: " +
			(str:$PlayerGnomesDied) +
			"."
		)

	]

]


(if:_canPlayCard)[


(if:_isSelected)[


<div class="hand-creature-card selected-hand-card">


(if:_abilityText is not "")[

	<div class="card-ability-tooltip">

	<div class="ability-tooltip-title">(print:_card's "name")</div>

	<div class="ability-tooltip-text">(print:_abilityText)</div>

	</div>

]


(link:_card's "name")[

	<!-- =================================================
	     TARGETLESS SPELL CLICKED A SECOND TIME

	     Targetless spells are selected on the first click
	     and cast when the selected card is clicked again.
	     ================================================= -->

	(if:
		_card's "type" is "spell" and
		(
			_card's "effect" is "draw-by-food-consumed" or
			_card's "effect" is "search-deck-for-creature"
		)
	)[

		(display:"Cast Selected Spell Logic")

		(rerun:?GameUI)

	]


	<!-- =================================================
	     OTHER SELECTED CARDS ARE CANCELLED
	     ================================================= -->

	(else:)[

		(set:$SelectedCard to
			(dm:)
		)

		(set:$TargetLane to
			0
		)

		(set:$SelectedTargetSide to
			""
		)

		(set:$SelectedTargetType to
			""
		)

		(set:$SelectedTargetLane to
			0
		)

		(set:$CardGameMessage to
			"Card selection cancelled."
		)

		(rerun:?GameUI)

	]

]


<div class="hand-cost">(print:_card's "cost")</div>


(if:_card's "type" is "spell")[

	<div class="hand-stats">SPELL</div>

]


(else:)[

	<div class="hand-stats">

	⚔ (print:_handDisplayDamage)&nbsp;&nbsp;

	♥ (print:_card's "maxHP")

	</div>

]


</div>


]


(else:)[


<div class="hand-creature-card">


(if:_abilityText is not "")[

	<div class="card-ability-tooltip">

	<div class="ability-tooltip-title">(print:_card's "name")</div>

	<div class="ability-tooltip-text">(print:_abilityText)</div>

	</div>

]


(link:_card's "name")[

	(set:$SelectedCard to
		_card
	)

	(set:$TargetLane to
		0
	)

	(set:$SelectedTargetSide to
		""
	)

	(set:$SelectedTargetType to
		""
	)

	(set:$SelectedTargetLane to
		0
	)


	(if:_card's "type" is "creature")[

		(set:$CardGameMessage to
			"Selected " +
			_card's "name" +
			". Choose a valid lane."
		)

	]


	(else-if:_card's "effect" is "shovel")[

		(set:$CardGameMessage to
			"Selected Shovel. Choose any creature."
		)

	]


	(else-if:_card's "effect" is "gnome-sweet-gnome")[

		(set:$CardGameMessage to
			"Selected Gnome Sweet Gnome. Choose any creature or player."
		)

	]


	(else-if:
		_card's "effect" is
		"sacrifice-friendly-creature-for-health-damage"
	)[

		(set:$CardGameMessage to
			"Selected Betrayal! Choose a friendly creature."
		)

	]


	(else-if:_card's "effect" is "sacrifice-friendly-creature-draw-one")[
		(set:$CardGameMessage to
			"Selected Sacrifice. Choose a friendly creature."
		)
	]

	(else-if:_card's "effect" is "sacrifice-friendly-creature-heal-current-health")[
		(set:$CardGameMessage to
			"Selected Toll. Choose a friendly creature."
		)
	]

	(else-if:_card's "effect" is "eat-creature-health-greater-than-player")[
		(set:$CardGameMessage to
			"Selected Starving! Choose any creature with more current Health than your hero."
		)
	]

	(else-if:_card's "effect" is "pie-toss")[
		(set:$CardGameMessage to
			"Selected Pie Toss. Choose an enemy creature."
		)
	]

	(else-if:_card's "effect" is "destroy-any-creature")[
		(set:$CardGameMessage to
			"Selected Smite. Choose any creature."
		)
	]

	(else-if:_card's "effect" is "draw-by-food-consumed")[

		(set:$CardGameMessage to
			"Selected All You Can Eat! Click it again to cast it."
		)

	]

	(else-if:_card's "effect" is "search-deck-for-creature")[

		(set:$CardGameMessage to
			"Selected Next Up! Click it again to search your deck."
		)

	]


	(rerun:?GameUI)

]


<div class="hand-cost">(print:_card's "cost")</div>


(if:_card's "type" is "spell")[

	<div class="hand-stats">SPELL</div>

]


(else:)[

	<div class="hand-stats">

	⚔ (print:_handDisplayDamage)&nbsp;&nbsp;

	♥ (print:_card's "maxHP")

	</div>

]


</div>


]


]


(else:)[


<div class="hand-creature-card disabled-hand-card">


(if:_abilityText is not "")[

	<div class="card-ability-tooltip">

	<div class="ability-tooltip-title">(print:_card's "name")</div>

	<div class="ability-tooltip-text">(print:_abilityText)</div>

	</div>

]


<div class="hand-card-name">(print:_card's "name")</div>

<div class="hand-cost">(print:_card's "cost")</div>


(if:_card's "type" is "spell")[

	<div class="hand-stats">SPELL</div>

]


(else:)[

	<div class="hand-stats">

	⚔ (print:_handDisplayDamage)&nbsp;&nbsp;

	♥ (print:_card's "maxHP")

	</div>

]


</div>


]


]


]


</div>


<div class="game-controls">


(if:not $GameOver)[

	(if:$CurrentCardTurn is "player")[

		(if:
			_hasSelectedCard or
			$JudasTargeting or
			$ClownTargeting or
			$RingmasterTargeting or
			$NextUpTargeting
		)[

			<span class="game-control-button disabled-control">

			End Turn

			</span>

		]


		(else:)[

			<span class="game-control-button end-turn-control">

			(link:"End Turn")[

				(display:"Player End Turn Logic")

				(rerun:?GameUI)

			]

			</span>

		]

	]

]


(if:_hasSelectedCard)[

	(if:not $GameOver)[

		<span class="game-control-button cancel-control">

		(link:"Cancel")[

			(set:$SelectedCard to
				(dm:)
			)

			(set:$TargetLane to
				0
			)

			(set:$SelectedTargetSide to
				""
			)

			(set:$SelectedTargetType to
				""
			)

			(set:$SelectedTargetLane to
				0
			)

			(set:$CardGameMessage to
				"Card selection cancelled."
			)

			(rerun:?GameUI)

		]

		</span>

	]

]


(if:$GameOver)[

	<span class="game-control-button reset-control">

	(if:$CardGameReturnPassage is not "")[
		(link:$CardGameReturnLabel)[
			(set:$LastCardGameOpponent to $CardGameOpponent)

			(if:$Winner is "player")[
				(set:$LastCardGameResult to "win")
			]
			(else:)[
				(set:$LastCardGameResult to "loss")
			]

			(go-to:$CardGameReturnPassage)
		]
	]
	(else:)[
		(link-goto:"Play Again","Card Game Setup")
	]

	</span>

]


</div>

</div>

</div>





:: Cast Selected Spell Logic {"position":"13000,0","size":"100,100"}
(set:_hasSelectedCard to false)

(if:(datanames:$SelectedCard)'s length > 0)[
	(set:_hasSelectedCard to true)
]


(if:$JudasTargeting)[

	(set:$CardGameMessage to "Resolve Judas's Battlecry before casting another card.")

]

(else-if:$ClownTargeting)[
	(set:$CardGameMessage to "Resolve Clown's Battlecry before casting another card.")
]

(else-if:$RingmasterTargeting)[
	(set:$CardGameMessage to "Resolve Ringmaster's Battlecry before casting another card.")
]

(else-if:$NextUpTargeting)[
	(set:$CardGameMessage to "Choose a creature for Next Up! before casting another card.")
]

(else-if:$CurrentCardTurn is not "player")[

	(set:$CardGameMessage to
		"You cannot cast a spell during the enemy turn."
	)

]


(else-if:$GameOver)[

	(set:$CardGameMessage to
		"The match has already ended."
	)

]


(else-if:not _hasSelectedCard)[

	(set:$CardGameMessage to
		"No spell has been selected."
	)

]


(else-if:$SelectedCard's "type" is not "spell")[

	(set:$CardGameMessage to
		$SelectedCard's "name" +
		" is not a spell."
	)

]


(else-if:$SelectedCard's "cost" > $PlayerMana)[

	(set:$CardGameMessage to
		"You do not have enough Mana to cast " +
		$SelectedCard's "name" +
		"."
	)

]


(else:)[

	(set:_spellCanResolve to true)
	(set:_spellCard to $SelectedCard)
	(set:_spellMessage to "")


	<!-- =====================================================
	     VALIDATE SHOVEL TARGET
	     ===================================================== -->

	(if:_spellCard's "effect" is "shovel")[

		(if:$SelectedTargetType is not "creature")[

			(set:_spellCanResolve to false)

			(set:$CardGameMessage to
				"Shovel must target a creature."
			)

		]

	]


	<!-- =====================================================
	     VALIDATE PIE TOSS TARGET
	     ===================================================== -->

	(else-if:_spellCard's "effect" is "pie-toss")[
		(if:
			$SelectedTargetType is not "creature" or
			$SelectedTargetSide is not "enemy"
		)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to
				"Pie Toss must target an enemy creature."
			)
		]
	]


	<!-- =====================================================
	     VALIDATE GNOME SWEET GNOME TARGET
	     ===================================================== -->

	(else-if:_spellCard's "effect" is "gnome-sweet-gnome")[

		(if:
			$SelectedTargetType is not "creature" and
			$SelectedTargetType is not "player"
		)[

			(set:_spellCanResolve to false)

			(set:$CardGameMessage to
				"Gnome Sweet Gnome must target a creature or player."
			)

		]

	]


	<!-- =====================================================
	     VALIDATE BETRAYAL TARGET
	     ===================================================== -->

	(else-if:
		_spellCard's "effect" is
		"sacrifice-friendly-creature-for-health-damage"
	)[

		(if:
			$SelectedTargetType is not "creature" or
			$SelectedTargetSide is not "player"
		)[

			(set:_spellCanResolve to false)

			(set:$CardGameMessage to
				"Betrayal! must target a friendly creature."
			)

		]

		(else-if:
			$SelectedTargetLane < 1 or
			$SelectedTargetLane > 3 or
			(datanames:$PlayerBoard's ($SelectedTargetLane))'s length is 0
		)[

			(set:_spellCanResolve to false)

			(set:$CardGameMessage to
				"There is no friendly creature in that lane."
			)

		]

	]



	<!-- VALIDATE SACRIFICE SPELL -->

	(else-if:_spellCard's "effect" is "sacrifice-friendly-creature-draw-one")[
		(if:
			$SelectedTargetType is not "creature" or
			$SelectedTargetSide is not "player"
		)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "Sacrifice must target a friendly creature.")
		]
		(else-if:
			$SelectedTargetLane < 1 or
			$SelectedTargetLane > 3 or
			(datanames:$PlayerBoard's ($SelectedTargetLane))'s length is 0
		)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "There is no friendly creature in that lane.")
		]
	]

	<!-- VALIDATE TOLL -->

	(else-if:_spellCard's "effect" is "sacrifice-friendly-creature-heal-current-health")[
		(if:
			$SelectedTargetType is not "creature" or
			$SelectedTargetSide is not "player"
		)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "Toll must target a friendly creature.")
		]
		(else-if:
			$SelectedTargetLane < 1 or
			$SelectedTargetLane > 3 or
			(datanames:$PlayerBoard's ($SelectedTargetLane))'s length is 0
		)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "There is no friendly creature in that lane.")
		]
	]

	<!-- VALIDATE STARVING! -->

	(else-if:_spellCard's "effect" is "eat-creature-health-greater-than-player")[
		(if:$SelectedTargetType is not "creature")[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "Starving! must target a creature.")
		]
		(else-if:$SelectedTargetSide is "player")[
			(if:
				$SelectedTargetLane < 1 or
				$SelectedTargetLane > 3 or
				(datanames:$PlayerBoard's ($SelectedTargetLane))'s length is 0
			)[
				(set:_spellCanResolve to false)
				(set:$CardGameMessage to "There is no friendly creature in that lane.")
			]
			(else-if:$PlayerBoard's ($SelectedTargetLane)'s "hp" <= $PlayerHP)[
				(set:_spellCanResolve to false)
				(set:$CardGameMessage to "That creature must have more current Health than your hero.")
			]
		]
		(else-if:$SelectedTargetSide is "enemy")[
			(if:
				$SelectedTargetLane < 1 or
				$SelectedTargetLane > 3 or
				(datanames:$EnemyBoard's ($SelectedTargetLane))'s length is 0
			)[
				(set:_spellCanResolve to false)
				(set:$CardGameMessage to "There is no enemy creature in that lane.")
			]
			(else-if:$EnemyBoard's ($SelectedTargetLane)'s "hp" <= $PlayerHP)[
				(set:_spellCanResolve to false)
				(set:$CardGameMessage to "That creature must have more current Health than your hero.")
			]
		]
		(else:)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "Starving! must target a creature.")
		]
	]


	<!-- VALIDATE SMITE -->

	(else-if:_spellCard's "effect" is "destroy-any-creature")[
		(if:$SelectedTargetType is not "creature")[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to "Smite must target a creature.")
		]
	]

	<!-- =====================================================
	     VALIDATE ALL YOU CAN EAT

	     This spell requires no target.
	     ===================================================== -->

	(else-if:_spellCard's "effect" is "draw-by-food-consumed")[

		(set:_spellCanResolve to true)

	]


	<!-- =====================================================
	     VALIDATE NEXT UP!

	     The player must have at least one creature
	     remaining in the deck.
	     ===================================================== -->

	(else-if:_spellCard's "effect" is "search-deck-for-creature")[

		(set:_creaturesInDeck to 0)

		(for:each _deckCard,...$PlayerDeck)[
			(if:_deckCard's "type" is "creature")[
				(set:_creaturesInDeck to _creaturesInDeck + 1)
			]
		]

		(if:_creaturesInDeck is 0)[
			(set:_spellCanResolve to false)
			(set:$CardGameMessage to
				"There are no creatures remaining in your deck."
			)
		]

	]


	<!-- =====================================================
	     SPELL EFFECT NOT YET IMPLEMENTED
	     ===================================================== -->

	(else:)[

		(set:_spellCanResolve to false)

		(set:$CardGameMessage to
			"That spell does not yet have an implemented effect."
		)

	]


	<!-- =====================================================
	     PAY FOR AND REMOVE THE SPELL
	     ===================================================== -->

	(if:_spellCanResolve)[

		(set:$PlayerMana to
			$PlayerMana -
			_spellCard's "cost"
		)

		(set:$PlayerHand to
			$PlayerHand -
			(a:_spellCard)
		)


		<!-- =================================================
		     SHOVEL
		     ================================================= -->

		(if:_spellCard's "effect" is "shovel")[

			(if:$SelectedTargetSide is "player")[

				(set:_targetCreature to
					$PlayerBoard's ($SelectedTargetLane)
				)

				(set:_actualSpellDamage to
					(min:
						1,
						(max:0,_targetCreature's "hp")
					)
				)

				(set:$PlayerBoard's ($SelectedTargetLane)'s "hp" to
					(max:
						0,
						_targetCreature's "hp" - 1
					)
				)

				(set:_spellMessage to
					"You struck your " +
					_targetCreature's "name" +
					" with Shovel for 1 damage. "
				)

				(if:_actualSpellDamage > 0)[

					(set:$DamagedCreatureSide to "player")
					(set:$DamagedCreatureLane to $SelectedTargetLane)
					(set:$DamageActuallyDealt to _actualSpellDamage)

					(display:"Creature Took Damage")

					(set:_spellMessage to
						_spellMessage +
						$DamageTriggerMessage
					)

				]

			]


			(else-if:$SelectedTargetSide is "enemy")[

				(set:_targetCreature to
					$EnemyBoard's ($SelectedTargetLane)
				)

				(set:_actualSpellDamage to
					(min:
						1,
						(max:0,_targetCreature's "hp")
					)
				)

				(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to
					(max:
						0,
						_targetCreature's "hp" - 1
					)
				)

				(set:_spellMessage to
					"You struck the enemy " +
					_targetCreature's "name" +
					" with Shovel for 1 damage. "
				)

				(if:_actualSpellDamage > 0)[

					(set:$DamagedCreatureSide to "enemy")
					(set:$DamagedCreatureLane to $SelectedTargetLane)
					(set:$DamageActuallyDealt to _actualSpellDamage)

					(display:"Creature Took Damage")

					(set:_spellMessage to
						_spellMessage +
						$DamageTriggerMessage
					)

				]

			]


			<!-- =============================================
			     RESOLVE ANY CREATURE KILLED BY SHOVEL
			     ============================================= -->

			(set:$DeathMessage to "")

			(display:"Resolve Dead Creatures")

			(set:_spellMessage to
				_spellMessage +
				$DeathMessage
			)


			<!-- SHOVEL DRAWS ONE CARD -->

			(if:$PlayerDeck's length > 0)[

				(set:_drawnCard to
					$PlayerDeck's 1st
				)

				(set:$PlayerHand to
					$PlayerHand +
					(a:_drawnCard)
				)

				(if:$PlayerDeck's length is 1)[

					(set:$PlayerDeck to
						(a:)
					)

				]

				(else:)[

					(set:$PlayerDeck to
						(subarray:$PlayerDeck,2,-1)
					)

				]

				(set:_spellMessage to
					_spellMessage +
					"You drew " +
					_drawnCard's "name" +
					". "
				)

			]


			(else:)[

				(set:_spellMessage to
					_spellMessage +
					"Your deck was empty, so you could not draw a card. "
				)

			]

		]


		<!-- =================================================
		     PIE TOSS
		     ================================================= -->

		(else-if:_spellCard's "effect" is "pie-toss")[
			(set:_targetCreature to
				$EnemyBoard's ($SelectedTargetLane)
			)

			(set:_actualSpellDamage to
				(min:3,(max:0,_targetCreature's "hp"))
			)

			(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to
				(max:0,_targetCreature's "hp" - 3)
			)

			(set:_spellMessage to
				"Pie Toss dealt 3 damage to the enemy " +
				_targetCreature's "name" + ". "
			)

			(if:_actualSpellDamage > 0)[
				(set:$DamagedCreatureSide to "enemy")
				(set:$DamagedCreatureLane to $SelectedTargetLane)
				(set:$DamageActuallyDealt to _actualSpellDamage)
				(display:"Creature Took Damage")
				(set:_spellMessage to _spellMessage + $DamageTriggerMessage)
			]

			(set:$DeathMessage to "")
			(display:"Resolve Dead Creatures")
			(set:_spellMessage to _spellMessage + $DeathMessage)
		]


		<!-- =================================================
		     GNOME SWEET GNOME
		     ================================================= -->

		(else-if:_spellCard's "effect" is "gnome-sweet-gnome")[

			(set:_spellDamage to
				$PlayerGnomesDied
			)


			(if:$SelectedTargetType is "player")[

				(if:$SelectedTargetSide is "enemy")[

					(set:$EnemyHP to
						(max:
							0,
							$EnemyHP - _spellDamage
						)
					)

					(set:_spellMessage to
						"Gnome Sweet Gnome dealt " +
						(str:_spellDamage) +
						" damage to the enemy. "
					)

				]


				(else-if:$SelectedTargetSide is "player")[

					(set:$PlayerHP to
						(max:
							0,
							$PlayerHP - _spellDamage
						)
					)

					(set:_spellMessage to
						"Gnome Sweet Gnome dealt " +
						(str:_spellDamage) +
						" damage to you. "
					)

				]

			]


			(else-if:$SelectedTargetType is "creature")[

				(if:$SelectedTargetSide is "player")[

					(set:_targetCreature to
						$PlayerBoard's ($SelectedTargetLane)
					)

					(set:_actualSpellDamage to
						(min:
							(max:0,_spellDamage),
							(max:0,_targetCreature's "hp")
						)
					)

					(set:$PlayerBoard's ($SelectedTargetLane)'s "hp" to
						(max:
							0,
							_targetCreature's "hp" - _spellDamage
						)
					)

					(set:_spellMessage to
						"Gnome Sweet Gnome dealt " +
						(str:_spellDamage) +
						" damage to your " +
						_targetCreature's "name" +
						". "
					)

					(if:_actualSpellDamage > 0)[

						(set:$DamagedCreatureSide to "player")
						(set:$DamagedCreatureLane to $SelectedTargetLane)
						(set:$DamageActuallyDealt to _actualSpellDamage)

						(display:"Creature Took Damage")

						(set:_spellMessage to
							_spellMessage +
							$DamageTriggerMessage
						)

					]

				]


				(else-if:$SelectedTargetSide is "enemy")[

					(set:_targetCreature to
						$EnemyBoard's ($SelectedTargetLane)
					)

					(set:_actualSpellDamage to
						(min:
							(max:0,_spellDamage),
							(max:0,_targetCreature's "hp")
						)
					)

					(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to
						(max:
							0,
							_targetCreature's "hp" - _spellDamage
						)
					)

					(set:_spellMessage to
						"Gnome Sweet Gnome dealt " +
						(str:_spellDamage) +
						" damage to the enemy " +
						_targetCreature's "name" +
						". "
					)

					(if:_actualSpellDamage > 0)[

						(set:$DamagedCreatureSide to "enemy")
						(set:$DamagedCreatureLane to $SelectedTargetLane)
						(set:$DamageActuallyDealt to _actualSpellDamage)

						(display:"Creature Took Damage")

						(set:_spellMessage to
							_spellMessage +
							$DamageTriggerMessage
						)

					]

				]


				<!-- =========================================
				     RESOLVE ANY CREATURE KILLED BY THE SPELL
				     ========================================= -->

				(set:$DeathMessage to "")

				(display:"Resolve Dead Creatures")

				(set:_spellMessage to
					_spellMessage +
					$DeathMessage
				)

			]

		]


		<!-- =================================================
		     BETRAYAL!

		     Record the target's current Health, sacrifice it,
		     allow its Deathrattle to resolve, then deal the
		     recorded amount to the enemy hero.
		     ================================================= -->

		(else-if:
			_spellCard's "effect" is
			"sacrifice-friendly-creature-for-health-damage"
		)[

			(set:_targetCreature to
				$PlayerBoard's ($SelectedTargetLane)
			)

			(set:_betrayalDamage to
				(max:
					0,
					_targetCreature's "hp"
				)
			)

			(set:_betrayedName to
				_targetCreature's "name"
			)

			(set:$SacrificeSide to
				"player"
			)

			(set:$SacrificeLane to
				$SelectedTargetLane
			)

			(set:$SacrificeMessage to "")
			(set:$SacrificeSucceeded to false)

			(display:"Sacrifice Creature")

			(if:$SacrificeSucceeded)[

				(set:$EnemyHP to
					(max:
						0,
						$EnemyHP - _betrayalDamage
					)
				)

				(set:_spellMessage to
					"You sacrificed " +
					_betrayedName +
					". " +
					$SacrificeMessage +
					"Betrayal! dealt " +
					(str:_betrayalDamage) +
					" damage to the enemy. "
				)

			]

			(else:)[

				(set:_spellMessage to
					"Betrayal! failed because its target could not be sacrificed. "
				)

			]

		]



		<!-- SACRIFICE -->

		(else-if:_spellCard's "effect" is "sacrifice-friendly-creature-draw-one")[
			(set:_sacrificeTargetName to
				$PlayerBoard's ($SelectedTargetLane)'s "name"
			)

			(set:$SacrificeSide to "player")
			(set:$SacrificeLane to $SelectedTargetLane)
			(display:"Sacrifice Creature")

			(if:$SacrificeSucceeded)[
				(set:$DrawSide to "player")
				(display:"Draw Card")

				(set:_spellMessage to
					"You sacrificed " +
					_sacrificeTargetName +
					". " +
					$SacrificeMessage +
					$DrawMessage +
					" "
				)
			]
			(else:)[
				(set:_spellMessage to
					"Sacrifice failed. " +
					$SacrificeMessage
				)
			]
		]


		<!-- TOLL -->

		(else-if:_spellCard's "effect" is "sacrifice-friendly-creature-heal-current-health")[
			(set:_tollTarget to $PlayerBoard's ($SelectedTargetLane))
			(set:_tollTargetName to _tollTarget's "name")
			(set:_tollHealing to (max:0,_tollTarget's "hp"))

			(set:$SacrificeSide to "player")
			(set:$SacrificeLane to $SelectedTargetLane)
			(display:"Sacrifice Creature")

			(if:$SacrificeSucceeded)[
				(set:_oldPlayerHP to $PlayerHP)
				(set:$PlayerHP to
					(min:
						$PlayerMaxHP,
						$PlayerHP + _tollHealing
					)
				)
				(set:_actualTollHealing to $PlayerHP - _oldPlayerHP)

				(set:_spellMessage to
					"You paid the Toll with " +
					_tollTargetName +
					". " +
					$SacrificeMessage +
					"You restored " +
					(str:_actualTollHealing) +
					" Health. "
				)
			]
			(else:)[
				(set:_spellMessage to
					"Toll failed. " +
					$SacrificeMessage
				)
			]
		]

		<!-- STARVING! -->

		(else-if:_spellCard's "effect" is "eat-creature-health-greater-than-player")[
			(set:_starvingTarget to (dm:))
			(set:_starvingName to "")
			(set:_starvingHealing to 0)

			(if:$SelectedTargetSide is "player")[
				(set:_starvingTarget to $PlayerBoard's ($SelectedTargetLane))
				(set:_starvingName to _starvingTarget's "name")
				(set:_starvingHealing to (max:0,_starvingTarget's "hp"))
				(set:$PlayerBoard's ($SelectedTargetLane)'s "hp" to 0)
			]
			(else:)[
				(set:_starvingTarget to $EnemyBoard's ($SelectedTargetLane))
				(set:_starvingName to _starvingTarget's "name")
				(set:_starvingHealing to (max:0,_starvingTarget's "hp"))
				(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to 0)
			]

			(set:_oldPlayerHP to $PlayerHP)
			(set:$PlayerHP to
				(min:
					$PlayerMaxHP,
					$PlayerHP + _starvingHealing
				)
			)
			(set:_actualStarvingHealing to $PlayerHP - _oldPlayerHP)

			(set:$DeathMessage to "")
			(display:"Resolve Dead Creatures")

			(set:_spellMessage to
				"You ate " +
				_starvingName +
				" with Starving! and restored " +
				(str:_actualStarvingHealing) +
				" Health. " +
				$DeathMessage
			)
		]


		<!-- SMITE -->

		(else-if:_spellCard's "effect" is "destroy-any-creature")[
			(if:$SelectedTargetSide is "player")[
				(set:_smiteName to $PlayerBoard's ($SelectedTargetLane)'s "name")
				(set:$PlayerBoard's ($SelectedTargetLane)'s "hp" to 0)
			]
			(else:)[
				(set:_smiteName to $EnemyBoard's ($SelectedTargetLane)'s "name")
				(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to 0)
			]

			(set:$DeathMessage to "")
			(display:"Resolve Dead Creatures")

			(set:_spellMessage to
				"Smite destroyed " +
				_smiteName +
				". " +
				$DeathMessage
			)
		]

		<!-- =================================================
		     ALL YOU CAN EAT!

		     Draw one card, plus one additional card for every
		     friendly Food consumed during this battle.

		     The consumed-Food total is not reset by this spell.
		     ================================================= -->

		(else-if:_spellCard's "effect" is "draw-by-food-consumed")[

			(set:_cardsRequested to
				1 +
				$PlayerFoodConsumed
			)

			(set:_cardsDrawn to 0)

			(set:_drawnCardNames to "")


			(for:each _drawNumber,...(range:1,_cardsRequested))[

				(if:$PlayerDeck's length > 0)[

					(set:_drawnCard to
						$PlayerDeck's 1st
					)

					(set:$PlayerHand to
						$PlayerHand +
						(a:_drawnCard)
					)

					(set:_cardsDrawn to
						_cardsDrawn + 1
					)


					<!-- =====================================
					     ADD CARD NAME TO THE DRAW MESSAGE
					     ===================================== -->

					(if:_drawnCardNames is "")[

						(set:_drawnCardNames to
							_drawnCard's "name"
						)

					]


					(else:)[

						(set:_drawnCardNames to
							_drawnCardNames +
							", " +
							_drawnCard's "name"
						)

					]


					<!-- =====================================
					     REMOVE DRAWN CARD FROM THE DECK
					     ===================================== -->

					(if:$PlayerDeck's length is 1)[

						(set:$PlayerDeck to
							(a:)
						)

					]


					(else:)[

						(set:$PlayerDeck to
							(subarray:$PlayerDeck,2,-1)
						)

					]

				]

			]


			<!-- =============================================
			     BUILD ALL YOU CAN EAT MESSAGE
			     ============================================= -->

			(if:_cardsDrawn is 0)[

				(set:_spellMessage to
					"You cast All You Can Eat!, but your deck was empty. "
				)

			]


			(else-if:_cardsDrawn is 1)[

				(set:_spellMessage to
					"You cast All You Can Eat! and drew " +
					_drawnCardNames +
					". "
				)

			]


			(else:)[

				(set:_spellMessage to
					"You cast All You Can Eat! and drew " +
					(str:_cardsDrawn) +
					" cards: " +
					_drawnCardNames +
					". "
				)

			]


			(if:_cardsDrawn < _cardsRequested)[

				(set:_spellMessage to
					_spellMessage +
					"Your deck became empty before all " +
					(str:_cardsRequested) +
					" cards could be drawn. "
				)

			]

		]


		<!-- =================================================
		     NEXT UP!

		     The spell is held outside the normal zones while
		     the player chooses an exact creature from the deck.
		     It returns to the bottom of the deck after the choice.
		     ================================================= -->

		(else-if:_spellCard's "effect" is "search-deck-for-creature")[

			(set:$NextUpTargeting to true)
			(set:$NextUpSpellCard to _spellCard)
			(set:$NextUpChoiceCardID to "")
			(set:$NextUpMessage to "")

			(set:_spellMessage to
				"You cast Next Up! Choose a creature from your deck. "
			)

		]


		<!-- =================================================
		     USED SPELL RETURNS TO BOTTOM OF DECK

		     This occurs after All You Can Eat draws, so the
		     spell cannot immediately draw itself.
		     ================================================= -->

		(if:not $NextUpTargeting)[
			(set:$PlayerDeck to
				$PlayerDeck +
				(a:_spellCard)
			)
		]


		<!-- =================================================
		     CLEAR CARD AND TARGET SELECTION
		     ================================================= -->

		(set:$SelectedCard to
			(dm:)
		)

		(set:$TargetLane to 0)

		(set:$SelectedTargetSide to "")
		(set:$SelectedTargetType to "")
		(set:$SelectedTargetLane to 0)


		<!-- =================================================
		     CHECK PLAYER OR ENEMY DEFEAT
		     ================================================= -->

		(if:$EnemyHP <= 0)[

			(set:$EnemyHP to 0)
			(set:$GameOver to true)
			(set:$Winner to "player")
			(set:$CurrentCardTurn to "")

			(set:$CardGameMessage to
				_spellMessage +
				"You defeated the enemy!"
			)

		]


		(else-if:$PlayerHP <= 0)[

			(set:$PlayerHP to 0)
			(set:$GameOver to true)
			(set:$Winner to "enemy")
			(set:$CurrentCardTurn to "")

			(set:$CardGameMessage to
				_spellMessage +
				"You were defeated!"
			)

		]


		(else-if:$NextUpTargeting)[

			(set:$CardGameMessage to
				_spellMessage
			)

		]

		(else:)[

			(set:$CardGameMessage to
				_spellMessage +
				_spellCard's "name" +
				" returned to the bottom of your deck."
			)

		]

	]

]


