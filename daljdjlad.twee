:: Maze 2 Diamond Turn {"position":"10200,3750","size":"100,100"}
<!-- =====================================================
     DIAMOND 1
     ===================================================== -->

(set: _nextX to $Maze2Diamond1X + $Maze2Diamond1Direction)

(if: _nextX <= 1 or _nextX >= 18)[
	(set: $Maze2Diamond1Direction to 0 - $Maze2Diamond1Direction)
	(set: _nextX to $Maze2Diamond1X + $Maze2Diamond1Direction)
]

(set: $Maze2Diamond1X to _nextX)

(if:
	$Maze2Diamond1X is $Maze2PlayerX
	and
	$Maze2Diamond1Y is $Maze2PlayerY
)[
	(set: $Maze2GameOver to true)
