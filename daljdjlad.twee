:: InvInspectPanel {"position":"200,3350","size":"100,100"}
(if:$InvMessage is not "")[<div class="invMessage">(print:$InvMessage)</div>](if:$InspectItem is not "" and $InspectItem is not "Empty" and $InspectItem is not "None")[(set:_inspectData to ($ItemData's $InspectItem))<div class="invLine"><b>Item:</b> (print:$InspectItem)</div><div class="invLine"><b>Source:</b> (print:$InspectSource)</div><div class="invLine"><b>Slot:</b> (print:(_inspectData's slot))</div><div class="invLine"><b>Description:</b> (print:(_inspectData's desc))</div>(if:(_inspectData's slot) is not "Consumable" and (_inspectData's slot) is not "Collectible")[<div class="invLine">STR (print:(_inspectData's str)) / DEX (print:(_inspectData's dex)) / CON (print:(_inspectData's con)) / LEN (print:(_inspectData's len)) / OFF (print:(_inspectData's office))</div>(if:_inspectData contains "def")[<div class="invLine">DEF (print:(_inspectData's def))</div>]](if:_inspectData contains "breakDamageThreshold")[<div class="invLine"><b>Break effect:</b> Breaks when a single hit deals more than (print:(_inspectData's breakDamageThreshold)) damage.(if:_inspectData contains "blockDamageOnBreak" and (_inspectData's blockDamageOnBreak))[ The triggering damage is prevented.]</div>](if:_inspectData contains "onUnequipDamage")[<div class="invLine"><b>Unequip effect:</b> Take (print:(_inspectData's onUnequipDamage)) damage when unequipped.</div>](if:$InspectSource is "NakedStatus")[<div class="invLine"><b>Status:</b> Automatically active while both Torso and Legs are unequipped.</div>](else-if:$InspectSource is "InvSlot1" or $InspectSource is "InvSlot2" or $InspectSource is "InvSlot3" or $InspectSource is "InvSlot4" or $InspectSource is "InvSlot5" or $InspectSource is "InvSlot6")[(if:(_inspectData's slot) is "Consumable")[(display:"InvUseConsumable")](else-if:(_inspectData's slot) is "Collectible")[<div class="invLine"><b>Collectible:</b> This item cannot be equipped or consumed.</div>](else:)[(display:"InvEquipActions")]](else-if:$InspectSource is "EquipHead" or $InspectSource is "EquipTorso" or $InspectSource is "EquipHands" or $InspectSource is "EquipLegs" or $InspectSource is "EquipMisc1" or $InspectSource is "EquipMisc2")[(display:"InvUnequipActions")]](else:)[<div class="invLine">Click an equipped item or inventory slot to inspect it.</div>]


:: InvStatBonuses {"position":"100,3350","size":"100,100"}
(set:$OfficenessBonus to 0)(set:$STRBonus to 0)(set:$DEXBonus to 0)(set:$CONBonus to 0)(set:$LENBonus to 0)(set:$DEFBonus to 0)(set:$NakedActive to false)(for:each _eq,...(a:$EquipHead,$EquipTorso,$EquipHands,$EquipLegs,$EquipMisc1,$EquipMisc2))[(if:_eq is not "None")[(set:_idata to ($ItemData's _eq))(set:$STRBonus to $STRBonus + (_idata's str))(set:$DEXBonus to $DEXBonus + (_idata's dex))(set:$CONBonus to $CONBonus + (_idata's con))(set:$LENBonus to $LENBonus + (_idata's len))(set:$OfficenessBonus to $OfficenessBonus + (_idata's office))(if:_idata contains "def")[(set:$DEFBonus to $DEFBonus + (_idata's def))]]](if:$EquipTorso is "None" and $EquipLegs is "None")[(set:$NakedActive to true)(set:$DEXBonus to $DEXBonus + 1)(set:$OfficenessBonus to $OfficenessBonus - 6)](if:$ActiveStatuses is an array and $StatusData is a datamap)[(for:each _activeStatus,...$ActiveStatuses)[(set:_statusID to _activeStatus's "id")(if:$StatusData contains _statusID)[(set:_status to $StatusData's (_statusID))(if:_status contains "str")[(set:$STRBonus to $STRBonus + (_status's "str"))](if:_status contains "dex")[(set:$DEXBonus to $DEXBonus + (_status's "dex"))](if:_status contains "con")[(set:$CONBonus to $CONBonus + (_status's "con"))](if:_status contains "len")[(set:$LENBonus to $LENBonus + (_status's "len"))](if:_status contains "office")[(set:$OfficenessBonus to $OfficenessBonus + (_status's "office"))](if:_status contains "def")[(set:$DEFBonus to $DEFBonus + (_status's "def"))]]]](set:$PlayerDEF to 10 + $DEX + $DEXBonus + $DEFBonus)


