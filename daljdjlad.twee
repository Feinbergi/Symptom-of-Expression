/* =========================================================
   NOTICE BOARD — TEAM PHOTO OVERLAY
   ========================================================= */

.team-photo-overlay{
	position:fixed;
	inset:0;
	z-index:1000;
	display:flex;
	align-items:center;
	justify-content:center;
	pointer-events:auto;
}

.team-photo-backdrop{
	position:absolute;
	inset:0;
	background:rgba(0,0,0,0.55);
	backdrop-filter:blur(3px);
	-webkit-backdrop-filter:blur(3px);
	pointer-events:auto;
}

.team-photo-window{
	position:relative;
	width:75vw;
	height:75vh;
	display:flex;
	align-items:center;
	justify-content:center;
	z-index:1001;
	pointer-events:auto;
}

.team-photo-image{
	display:block;
	max-width:100%;
	max-height:100%;
	width:auto;
	height:auto;
	object-fit:contain;
	border:3px solid rgba(255,255,255,0.9);
	border-radius:4px;
	box-shadow:0 12px 45px rgba(0,0,0,0.9);
}
tw-hook[name="teamphotoclick"]{
	position:fixed;
	inset:0;
	display:block;
	z-index:1000;
	cursor:pointer;
}
