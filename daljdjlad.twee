	(set: $HUMANITY100 to $HUMANITY100 + 1)
	(display: "UpdateStats")
	(go-to: "We wait")
]
(set: $CheckpointSlot to "ABYSS_CHECKPOINT")

(save-game: $CheckpointSlot, "Abyss Auto Save")
