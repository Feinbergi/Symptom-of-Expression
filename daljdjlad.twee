/* ================================================= */
/* ================= TITLE SCREEN ================== */
/* ================================================= */

/* Fullscreen centering */
.titleScreen {
	position: fixed;
	inset: 0;

	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;

	text-align: center;
}

/* Main title styling */
.titleText {
	font-size: 6vw;
	letter-spacing: 0.12em;
	font-weight: 300;
	text-transform: uppercase;

	/* safe breathing glow (no opacity changes) */
	animation: breatheGlow 5s ease-in-out infinite;
}

/* Reserve space for the link so the title doesn't shift when it appears */
.beginSlot {
	margin-top: 2vh;
	height: 2.2em;          /* reserved subtitle space */
	display: flex;
	align-items: center;
	justify-content: center;
}

/* Style the Harlowe link */
.beginSlot tw-link {
	font-size: 1.5vw;
	letter-spacing: 0.05em;
	display: inline-block;
	text-decoration: none;
}

/* Optional hover feel (subtle) */
.beginSlot tw-link:hover {
	text-decoration: underline;
}

/* Breathing glow animation */
@keyframes breatheGlow {
	0%, 100% {
		text-shadow: 0 0 0 rgba(255,255,255,0);
		transform: translateY(0);
	}
	50% {
		text-shadow:
			0 0 8px rgba(255,255,255,0.22),
			0 0 18px rgba(255,255,255,0.12);
		transform: translateY(-0.2vh);
	}
}













/* PANELLEFT: full width story */
tw-story[tags~="PanelLeft"]{
  margin-right: 0;
  max-width: none;
  width: 100%;
}

/* PANELLEFT: left panel (scrolls normally) */
tw-story[tags~="PanelLeft"] tw-passage{
  position: fixed;
  left: 0;
  top: 0;

  height: 100vh;
  width: 42vw;
  max-width: 65ch;

  overflow-y: auto;
  overflow-x: visible;

  background: linear-gradient(to right, rgba(0,0,0,0.97), rgba(0,0,0,0.85));
  padding: 2rem 2.5rem;
  margin: 0;

  border-right: 1px solid rgba(255,255,255,0.15);
  box-shadow: 0 0 25px rgba(0,0,0,0.8);

  z-index: 10;
}


/* ORNATE DIVIDER: attach to tw-story so it can't be clipped by the scrolling panel */
tw-story[tags~="PanelLeft"]::after{
  content: "";

  position: fixed;
  top: 0;

  /* position it at the panel edge */
  left: calc(min(42vw, 65ch));  /* aligns to your panel width */
  transform: translateX(-45%);  /* center divider on the seam */

  height: 100vh;
  width: 1250px;

  background-image: url("https://i.ibb.co/60pCBZ0S/Chat-GPT-Image-Feb-18-2026-at-12-32-39-AM.png");
  background-size: 100% 105%;
  background-repeat: no-repeat;
  background-position: center;

  pointer-events: none;
  z-index: 9000;
}


