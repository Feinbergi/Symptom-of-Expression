(set:$ManagerDialogue to (dm:"npcName","Assistant Regional Manager","playerName","You","playerPortrait","https://i.ibb.co/zH6zBCBq/Screenshot-2026-07-21-at-01-03-39.png","npcPortrait","https://i.ibb.co/JDwtXg9/Screenshot-2026-07-21-at-01-00-06.png","opening","You are three minutes late.","exitPassage","Your Office","stages",(a:(dm:"id","start","choices",(a:(dm:"label","Why did you want to speak to me?","player","Why did you want to speak to me?","npc","Your quarterly performance report contains several troubling irregularities.","next","report"),(dm:"label","Did you steal my lunch?","player","Did you steal my lunch?","npc","Your lunch was unlabelled and therefore legally communal.","next","lunch"),(dm:"label","Stare at him silently.","player","...","npc","Please stop doing that.","next","staring"))),(dm:"id","report","choices",(a:(dm:"label","What irregularities?","player","What irregularities?","npc","According to these figures, you completed negative four assignments last Tuesday.","next","reportDetails"),(dm:"label","Those figures are probably wrong.","player","Those figures are probably wrong.","npc","They came directly from the spreadsheet, so they are beyond question.","next","spreadsheet"),(dm:"label","This conversation is over.","player","This conversation is over.","npc","I decide when mandatory conversations are over.","next","end"))),(dm:"id","lunch","choices",(a:(dm:"label","It had my name on it.","player","It had my name on it.","npc","I assumed that was the name of the sandwich.","next","sandwichName"),(dm:"label","You owe me a sandwich.","player","You owe me a sandwich.","npc","Submit a reimbursement request. Current processing time is eleven months.","next","reimbursement"),(dm:"label","Forget it.","player","Forget it.","npc","Already forgotten.","next","start"))),(dm:"id","staring","choices",(a:(dm:"label","Continue staring.","player","...","npc","This is becoming a workplace conduct issue.","next","staringMore"),(dm:"label","Blink.","player","I blink.","npc","Thank you.","next","start"))),(dm:"id","reportDetails","choices",(a:(dm:"label","That sounds impressive.","player","That sounds impressive.","npc","It is not.","next","end"),(dm:"label","The assignments deserved it.","player","The assignments deserved it.","npc","That answer will also be included in the report.","next","end"))),(dm:"id","spreadsheet","choices",(a:(dm:"label","Spreadsheets can lie.","player","Spreadsheets can lie.","npc","That is dangerously close to insubordination.","next","end"),(dm:"label","Fair enough.","player","Fair enough.","npc","Good. Your compliance has been noted.","next","end"))),(dm:"id","sandwichName","choices",(a:(dm:"label","My name is not Ham and Cheese.","player","My name is not Ham and Cheese.","npc","I will update the employee directory.","next","end"))),(dm:"id","reimbursement","choices",(a:(dm:"label","I'll wait.","player","I'll wait.","npc","Please do so outside my office.","next","end"))),(dm:"id","staringMore","choices",(a:(dm:"label","Keep staring.","player","...","npc","Meeting adjourned.","next","end"),(dm:"label","Stop staring.","player","Fine.","npc","Your cooperation is appreciated.","next","end"))))))


