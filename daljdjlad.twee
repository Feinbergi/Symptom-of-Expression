	),

	(dm:
		"id","identityCycles",
		"choices",(a:

			(dm:
				"label","What does that actually mean?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","What does that actually mean?"
					),
					(dm:
						"speaker","npc",
						"text","I stand where endings become beginnings."
					),
					(dm:
						"speaker","npc",
						"text","I return kings to soil."
					),
					(dm:
						"speaker","npc",
						"text","I raise forests from their bones."
					),
					(dm:
						"speaker","npc",
						"text","I tend the colonies beneath every stone and carry the memory of drowned civilisations in my spores."
					)
				),
				"next","identityAncientWar"
			)

		)
	),

	(dm:
		"id","identityAncientWar",
		"choices",(a:

			(dm:
				"label","Okay, but what is it you actually do?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Okay, but what is it you actua-"
					),
					(dm:
						"speaker","npc",
						"text","I watched the Green Sovereign fall beneath the nine diseased moons."
					),
					(dm:
						"speaker","npc",
						"text","I carried the last seed of the Black Orchard through a kingdom of salt."
					),
					(dm:
						"speaker","npc",
						"text","I have worn a thousand faces."
					),
					(dm:
						"speaker","npc",
						"text","None had dental coverage."
					)
				),
				"next","identityJob"
			)

		)
	),

	(dm:
		"id","identityJob",
		"choices",(a:

			(dm:
				"label","Okay. But what do you do here?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Okay. But what do you do here?"
					),
					(dm:
						"speaker","npc",
						"text","I am Omega Corporation's Senior Organic Asset Preservation Consultant."
					),
					(dm:
						"speaker","npc",
						"text","Facilities Management."
					),
					(dm:
						"speaker","npc",
						"text","I identify mould, maintain the office plants and retain archival records."
					),
					(dm:
						"speaker","npc",
						"text","I also mediate interdepartmental disputes when the roots grow hostile."
					)
				),
				"next","identitySimple"
			)

