(set:$JerryMenuChoices to (a:

	(dm:
		"label","How's the work coming along?",
		"events",(a:
			(dm:
				"speaker","player",
				"text","How's the work coming along?"
			),
			(dm:
				"speaker","npc",
				"text","All work comes along."
			),
			(dm:
				"speaker","npc",
				"text","It rises from intention, flowers briefly beneath the fluorescent sun, and is swallowed by the archive."
			)
		),
		"hideIfJerryWorkSeen",true,
		"next","workCycle"
	),

	(dm:
		"label","I need to complete your employee wellness check.",
		"events",(a:
			(dm:
				"speaker","player",
				"text","I need to complete your employee wellness check."
			),
			(dm:
				"speaker","npc",
				"text","Then let the questions be spoken."
			),
			(dm:
				"speaker","npc",
				"text","The fungus shall answer."
			)
		),
		"requiresWellbeingActive",true,
		"hideIfWellbeingComplete","jerry",
		"next","wellbeingQuestionOne"
	),

	(dm:
		"label","I've been feeling depressed.",
		"events",(a:
			(dm:
				"speaker","player",
				"text","I've been feeling depressed."
			),
			(dm:
				"speaker","action",
				"text","Jerry turns towards you. Something inside his collar emits a faint cloud of spores."
			),
			(dm:
				"speaker","npc",
				"text","Then you have begun to hear the oldest question."
			)
		),
		"hideIfJerryDepressionSeen",true,
		"next","depressionLifeGod"
	),

	(dm:
		"label","I don't mean to be rude, but what are you again?",
		"events",(a:
			(dm:
				"speaker","player",
				"text","I don't mean to be rude, but what are you again?"
			),
			(dm:
				"speaker","npc",
				"text","You ask the vessel to describe the ocean."
			)
		),
		"hideIfJerryIdentitySeen",true,
		"next","identityAvatar"
	),
	(dm:
		"label","I found that Flugiyo deck.",
		"events",(a:
			(dm:
				"speaker","player",
				"text","I found that Flugiyo deck."
			),
			(dm:
				"speaker","action",
				"text","Jerry studies the battered stack of cards."
			),
			(dm:
				"speaker","npc",
				"text","The Gnome Deck."
			),
			(dm:
				"speaker","npc",
				"text","A weak beginning."
			),
			(dm:
				"speaker","npc",
				"text","But all mould begins with a single spore."
			)
		),
		"requiresFlugiyoDeckFound",true,
		"hideIfJerryFlugiyoIntroduced",true,
		"next","flugiyoRulesOne"
	),

	(dm:
		"label","Challenge Jerry to Flugiyo.",
		"events",(a:
			(dm:
				"speaker","player",
				"text","I want another Flugiyo battle."
			),
			(dm:
				"speaker","npc",
				"text","Then place your deck upon the field."
			)
		),
		"requiresJerryFlugiyoIntroduced",true,
		"destination","Jerry Flugiyo Setup"
	),
	(dm:
