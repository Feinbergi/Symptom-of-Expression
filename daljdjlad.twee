(click-rerun:?allpurposecleaner)[
	(if:$InteractionPopupOpen is false)[

		(if:$LowerCupboardAllPurposeTaken)[
			(set:$InteractionPopupText to "You have already collected the All Purpose Cleaner.")
		]
		(else-if:$InvSlot1 is "Empty")[
			(set:$InvSlot1 to "All Purpose Cleaner")
			(set:$LowerCupboardAllPurposeTaken to true)
			(set:$InteractionPopupText to "All Purpose Cleaner added to Inventory.")
		]
		(else-if:$InvSlot2 is "Empty")[
			(set:$InvSlot2 to "All Purpose Cleaner")
			(set:$LowerCupboardAllPurposeTaken to true)
			(set:$InteractionPopupText to "All Purpose Cleaner added to Inventory.")
		]
		(else-if:$InvSlot3 is "Empty")[
			(set:$InvSlot3 to "All Purpose Cleaner")
			(set:$LowerCupboardAllPurposeTaken to true)
			(set:$InteractionPopupText to "All Purpose Cleaner added to Inventory.")
		]
		(else-if:$InvSlot4 is "Empty")[
			(set:$InvSlot4 to "All Purpose Cleaner")
			(set:$LowerCupboardAllPurposeTaken to true)
			(set:$InteractionPopupText to "All Purpose Cleaner added to Inventory.")
		]
		(else-if:$InvSlot5 is "Empty")[
			(set:$InvSlot5 to "All Purpose Cleaner")
			(set:$LowerCupboardAllPurposeTaken to true)
			(set:$InteractionPopupText to "All Purpose Cleaner added to Inventory.")
		]
		(else-if:$InvSlot6 is "Empty")[
			(set:$InvSlot6 to "All Purpose Cleaner")
			(set:$LowerCupboardAllPurposeTaken to true)
			(set:$InteractionPopupText to "All Purpose Cleaner added to Inventory.")
		]
		(else:)[
			(set:$InteractionPopupText to "Your Inventory is full.")
		]

		(set:$InteractionID to "BasicMessage")
		(set:$InteractionView to "main")
		(set:$InteractionPopupOpen to true)
		(rerun:?interactionPopup)
	]
]

