:: Maze Cleaner 2 Turn {"position":"10200,3600","size":"100,100"}
(set: _nextCleaner2Index to $MazeCleaner2RouteIndex + (2 * $MazeCleaner2Direction))

(if: _nextCleaner2Index > $MazeCleaner2Route's length)[
	(set: _nextCleaner2Index to 1)
]

(else-if: _nextCleaner2Index < 1)[
	(set: _nextCleaner2Index to $MazeCleaner2Route's length - 1)
]

(set: _nextCleaner2X to $MazeCleaner2Route's (_nextCleaner2Index))
(set: _nextCleaner2Y to $MazeCleaner2Route's (_nextCleaner2Index + 1))

(set: _cleaner2Row to $MazeRows's (_nextCleaner2Y))
(set: _cleaner2Tile to _cleaner2Row's (_nextCleaner2X))

(set: _cleaner2Walkable to false)
(set: _cleaner2Reverse to false)

(if: _cleaner2Tile is ".")[
	(set: _cleaner2Walkable to true)
]

(else-if: _cleaner2Tile is "D")[

	(set: _cleaner2DoorID to (str:_nextCleaner2X) + "," + (str:_nextCleaner2Y))

	(if: $MazeOpenDoors contains _cleaner2DoorID)[
		(set: _cleaner2Walkable to true)
	]

	(else:)[
		(set: _cleaner2Reverse to true)
	]

]

(else:)[
	(set: _cleaner2Reverse to true)
]


<!-- REVERSE IF WALL / CLOSED DOOR -->

(if: _cleaner2Reverse)[

	(set: $MazeCleaner2Direction to 0 - $MazeCleaner2Direction)

	(set: _nextCleaner2Index to $MazeCleaner2RouteIndex + (2 * $MazeCleaner2Direction))

	(if: _nextCleaner2Index > $MazeCleaner2Route's length)[
		(set: _nextCleaner2Index to 1)
	]

	(else-if: _nextCleaner2Index < 1)[
		(set: _nextCleaner2Index to $MazeCleaner2Route's length - 1)
	]

	(set: _nextCleaner2X to $MazeCleaner2Route's (_nextCleaner2Index))
	(set: _nextCleaner2Y to $MazeCleaner2Route's (_nextCleaner2Index + 1))

	(set: _cleaner2Row to $MazeRows's (_nextCleaner2Y))
	(set: _cleaner2Tile to _cleaner2Row's (_nextCleaner2X))
	(set: _cleaner2Walkable to false)

	(if: _cleaner2Tile is ".")[
		(set: _cleaner2Walkable to true)
	]

	(else-if: _cleaner2Tile is "D")[

		(set: _cleaner2DoorID to (str:_nextCleaner2X) + "," + (str:_nextCleaner2Y))

		(if: $MazeOpenDoors contains _cleaner2DoorID)[
			(set: _cleaner2Walkable to true)
		]

	]

]


<!-- OTHER ENEMIES BLOCK CLEANER 2 -->

(set: _cleaner2Blocked to false)

(if:
	(_nextCleaner2X is $MazeEnemyX and _nextCleaner2Y is $MazeEnemyY)
	or
	(_nextCleaner2X is $MazeEnemy3X and _nextCleaner2Y is $MazeEnemy3Y)
	or
	(_nextCleaner2X is $MazeEnemy2X and _nextCleaner2Y is $MazeEnemy2Y)
	or
	(_nextCleaner2X is $MazeCleanerX and _nextCleaner2Y is $MazeCleanerY)
	or
	(_nextCleaner2X is $MazeCleaner3X and _nextCleaner2Y is $MazeCleaner3Y)
)[
	(set: _cleaner2Blocked to true)
]


<!-- MOVE -->

(if:
	_cleaner2Walkable
	and
	_cleaner2Blocked is false
)[
	(set: $MazeCleaner2X to _nextCleaner2X)
	(set: $MazeCleaner2Y to _nextCleaner2Y)
	(set: $MazeCleaner2RouteIndex to _nextCleaner2Index)
]


<!-- PLAYER CAUGHT -->

(if:
	$MazeCleaner2X is $MazePlayerX
	and
	$MazeCleaner2Y is $MazePlayerY
)[
	(set: $MazeGameOver to true)
]


