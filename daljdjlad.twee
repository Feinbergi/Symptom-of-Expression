:: Start Player Card Turn {"position":"12600,0","size":"100,100"}
(set:$CurrentCardTurn to "player")

(set:$PoisonSide to "player")
(display:"Resolve Poison")

(set:$CardGameMessage to
	$CardGameMessage +
	" " +
	$PoisonMessage
)

(if:$GameOver)[
	(set:$CardGameMessage to
		$CardGameMessage +
		"You were defeated!"
	)
]

(else:)[
	(set:_normalPlayerMaxMana to
		(min:10,$PlayerTurnsTaken + 1)
	)

	(set:$PlayerMaxMana to
		_normalPlayerMaxMana +
		$PlayerPermanentManaBonus
	)

	(set:$PlayerMana to $PlayerMaxMana)

	(for:each _lane,...(range:1,3))[
		(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[
			(set:$PlayerBoard's (_lane)'s "ready" to true)
			(set:$PlayerBoard's (_lane)'s "canInitiateCombat" to true)
		]
	]

	(if:$TotalTurnsTaken > 0)[
		(set:$DrawSide to "player")
		(display:"Draw Card")

		(set:$CardGameMessage to
			$CardGameMessage +
			" " +
			$DrawMessage +
			" You have " +
			(str:$PlayerMana) +
			" Mana."
		)
	]
	(else:)[
		(set:$CardGameMessage to
			$CardGameMessage +
			" You have " +
			(str:$PlayerMana) +
			" Mana."
		)
	]

	(set:$SelectedCard to (dm:))
	(set:$TargetLane to 0)
	(set:$SelectedTargetSide to "")
	(set:$SelectedTargetType to "")
	(set:$SelectedTargetLane to 0)
]



