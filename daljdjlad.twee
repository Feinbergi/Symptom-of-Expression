	),


	(dm:
		"id","depressionLifeGod",
		"choices",(a:

			(dm:
				"label","What question?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","What question?"
					),
					(dm:
						"speaker","npc",
						"text","Why does the immortal heart continue beating when it no longer desires tomorrow?"
					),
					(dm:
						"speaker","npc",
						"text","Before the first root split stone, there lived a god of life."
					),
					(dm:
						"speaker","npc",
						"text","Every creature sprang from its breath."
					),
					(dm:
						"speaker","npc",
						"text","Every wound closed beneath its touch."
					)
				),
				"next","depressionUnhappy"
			)

		)
	),

	(dm:
		"id","depressionUnhappy",
		"choices",(a:

			(dm:
				"label","That sounds good.",
				"events",(a:
					(dm:
						"speaker","player",
						"text","That sounds good."
					),
					(dm:
						"speaker","npc",
						"text","It was not."
					),
					(dm:
						"speaker","npc",
						"text","The god could create every joy, yet none remained precious."
					),
					(dm:
						"speaker","npc",
						"text","Flowers returned whenever they wilted."
					),
					(dm:
						"speaker","npc",
						"text","Children returned whenever they fell."
					),
					(dm:
						"speaker","npc",
						"text","Nothing could be lost, and so nothing could be kept."
					)
				),
				"next","depressionJourney"
			)

		)
	),

	(dm:
		"id","depressionJourney",
		"choices",(a:

			(dm:
				"label","What did the god do?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","What did the god do?"
					),
					(dm:
						"speaker","npc",
						"text","It travelled beyond the flowering edge of creation."
					),
					(dm:
						"speaker","npc",
						"text","Across dead suns and seas whose names had rotted from memory."
					),
					(dm:
						"speaker","npc",
						"text","For eleven eons it sought the Obelisk of Decay."
					)
				),
				"next","depressionObelisk"
			)

		)
	),

	(dm:
		"id","depressionObelisk",
		"choices",(a:

			(dm:
				"label","What was at the obelisk?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","What was at the obelisk?"
					),
					(dm:
						"speaker","npc",
						"text","The god of death."
					),
					(dm:
						"speaker","npc",
						"text","It sat among the fading souls of its own progeny."
					),
					(dm:
						"speaker","npc",
						"text","And though each passing wounded it, the god of death was happy."
					)
				),
				"next","depressionDeathHappy"
			)

		)
	),

	(dm:
		"id","depressionDeathHappy",
		"choices",(a:

			(dm:
				"label","Why was the god of death happy?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Why was the god of death happy?"
					),
					(dm:
						"speaker","npc",
						"text","Because its children faded."
					),
					(dm:
						"speaker","npc",
						"text","It could not keep them forever."
					),
					(dm:
						"speaker","npc",
						"text","So it treasured every moment before the final one."
					),
					(dm:
						"speaker","npc",
						"text","Their laughter mattered because silence waited beyond it."
					)
				),
				"next","depressionLesson"
			)

		)
	),

	(dm:
		"id","depressionLesson",
		"choices",(a:

			(dm:
				"label","What did the god of life learn?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","What did the god of life learn?"
					),
					(dm:
						"speaker","action",
						"text","Jerry becomes silent for a long moment."
					),
					(dm:
						"speaker","npc",
						"text","That life is not made precious by pleasure."
					),
					(dm:
						"speaker","npc",
						"text","It is made precious by its boundary."
					),
					(dm:
						"speaker","npc",
						"text","A moment need not last forever to have been worth enduring."
					),
					(dm:
						"speaker","npc",
						"text","Even sorrow proves that something within you still wishes the world were different."
					)
				),
				"next","depressionMeaning"
			)

		)
	),

	(dm:
		"id","depressionMeaning",
		"choices",(a:

			(dm:
				"label","So what's the great message about existence?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","So what's the great message about existence?"
					),
					(dm:
						"speaker","npc",
						"text","I have forgotten."
					),
					(dm:
						"speaker","npc",
						"text","The final tablet was mostly mildew."
					),
					(dm:
						"speaker","npc",
						"text","But I believe it was encouraging."
					)
				),
				"setJerryDepressionSeen",true,
				"next","mainMenu"
			)

		)
	),


	(dm:
		"id","identityAvatar",
