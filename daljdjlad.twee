	cursor: pointer !important;
	pointer-events: auto !important;

	z-index: 10 !important;
}


.mop-closet-click-area tw-enchantment:hover,
.mop-closet-click-area tw-enchantment:focus,
.mop-closet-click-area tw-hook:hover,
.mop-closet-click-area tw-hook:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	background: transparent !important;
	color: transparent !important;
}


/* =========================================================
   HOVER LABEL BUTTONS
   ========================================================= */

.mop-closet-click-area::after {
	content: attr(data-label);

	position: absolute !important;
	left: 50% !important;
	top: 50% !important;

	display: block !important;

	transform: translate(-50%, -50%) !important;

	width: auto !important;
	height: auto !important;

	margin: 0 !important;
	padding: 7px 12px !important;

	border: 1px solid rgba(255, 255, 255, 0.75) !important;
	border-radius: 4px !important;

	background: rgba(0, 0, 0, 0.88) !important;
	color: #ffffff !important;

	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-align: center !important;

	white-space: nowrap !important;

	opacity: 0 !important;
	visibility: hidden !important;

	pointer-events: none !important;

	z-index: 1000 !important;
}


.mop-closet-click-area:hover::after,
.mop-closet-click-area:focus-within::after {
	opacity: 1 !important;
	visibility: visible !important;
}


/* =========================================================
   REMOVE GLOBAL ROOM HOTSPOT EFFECTS

   Prevents your general room-screen hook CSS from creating
   a second hover label around the named Harlowe hooks.
   ========================================================= */

.room-screen .mop-closet-click-area tw-hook,
.room-screen .mop-closet-click-area tw-hook:hover,
.room-screen .mop-closet-click-area tw-hook:focus,
.room-screen .mop-closet-click-area tw-hook:focus-within {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
}


.room-screen .mop-closet-click-area tw-hook::after,
.room-screen .mop-closet-click-area tw-hook:hover::after,
.room-screen .mop-closet-click-area tw-hook:focus::after,
.room-screen .mop-closet-click-area tw-hook:focus-within::after {
	content: none !important;
	display: none !important;
	opacity: 0 !important;
	visibility: hidden !important;
}















































/* =========================================================
   VENDO SHOP SCREEN
   ========================================================= */

#vendingScreen {
	width: min(1100px, calc(100% - 40px));
	margin: 30px auto;
	padding: 22px;

	color: #eeeeee;
	background: #101318;

	border: 2px solid #536170;
	border-radius: 8px;

	box-sizing: border-box;

	font-family: Arial, sans-serif;
}


/* =========================================================
   HEADER
   ========================================================= */

#vendingHeader {
	display: flex;
	align-items: center;
	justify-content: space-between;

	gap: 20px;

	margin: 0 0 20px 0;
	padding: 0 0 14px 0;

	border-bottom: 1px solid #536170;
}

#vendingTitle {
	color: #e8eef5;

	font-size: 2rem;
	font-weight: bold;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}

#vendingStars {
	padding: 8px 12px;

	color: #ffd94a;
	background: #090b0e;

	border: 1px solid #7f7340;
	border-radius: 5px;

	font-size: 1.1rem;
	font-weight: bold;

	text-shadow: 0 0 5px rgba(255, 215, 0, 0.55);
}


/* =========================================================
   TWO-PANEL LAYOUT
   ========================================================= */

#vendingBody {
	display: grid;
	grid-template-columns: minmax(280px, 0.85fr) minmax(360px, 1.4fr);

	align-items: stretch;
	gap: 20px;
}

#vendingItems,
#vendingDetail {
	min-height: 470px;
	padding: 18px;

	background: #080a0d;

	border: 1px solid #536170;
	border-radius: 5px;

	box-sizing: border-box;
}

.vendingPanelTitle {
	margin: 0 0 16px 0;
	padding: 0 0 10px 0;

	color: #dce7f1;

	border-bottom: 1px solid #39434d;

	font-size: 1.2rem;
	font-weight: bold;
}


/* =========================================================
   LEFT ITEM GRID
   ========================================================= */

#vendingGrid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));

	gap: 12px;
}

.vendingItem {
	position: relative;

	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;

	min-height: 135px;
	padding: 12px;

	background: #151a20;

	border: 1px solid #46525e;
	border-radius: 5px;

	box-sizing: border-box;

	text-align: center;

	transition:
		background 0.15s ease,
		border-color 0.15s ease,
		transform 0.15s ease;
}

.vendingItem:hover {
	background: #202833;
	border-color: #87a8c6;

	transform: translateY(-2px);
}

.vendingItem tw-link {
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;

	width: 58px !important;
	height: 58px !important;

	margin: 0 0 8px 0 !important;
	padding: 0 !important;

	color: white !important;
	background: #080a0d !important;

	border: 1px solid #738493 !important;
	border-radius: 6px !important;

	font-family: Arial, sans-serif !important;
	font-size: 34px !important;
	line-height: 58px !important;
	text-decoration: none !important;

	cursor: pointer !important;
}

.vendingItem tw-link:hover {
	color: white !important;
	background: #293542 !important;
}

.vendingItemName {
	min-height: 34px;

	color: #eeeeee;

	font-size: 0.95rem;
	font-weight: bold;
	line-height: 1.15;
}

.vendingItemPrice {
	margin-top: 6px;

	color: #ffd94a;

	font-size: 0.9rem;
	font-weight: bold;
}


/* =========================================================
   RIGHT DETAIL PANEL
   ========================================================= */

.vendingEmpty {
	padding: 40px 20px;

	color: #8996a2;

	text-align: center;
}

#vendingSelectedIcon {
	display: flex;
	align-items: center;
	justify-content: center;

	width: 90px;
	height: 90px;

	margin: 10px auto 12px auto;

	background: #151a20;

	border: 1px solid #647483;
	border-radius: 8px;

	font-size: 52px;
	line-height: 1;
}

#vendingSelectedName {
	margin-bottom: 20px;

	color: #f0f4f7;

	font-size: 1.55rem;
	font-weight: bold;
	text-align: center;
}

.vendingDetailLine {
	margin: 0 0 12px 0;

	color: #e1e6eb;

	font-size: 1rem;
	line-height: 1.45;
}

.vendingStats {
	margin: 18px 0 0 0;
	padding: 12px;

	color: #b9d6ef;
	background: #11171d;

	border: 1px solid #36434f;
	border-radius: 4px;

	font-family: monospace;
	font-size: 0.95rem;
	line-height: 1.4;
}


/* =========================================================
   BUY MESSAGE AND BUTTON
   ========================================================= */

.vendingMessage {
	margin: 18px 0 0 0;
	padding: 10px 12px;

	color: #f1e5ad;
	background: #211e12;

	border: 1px solid #746833;
	border-radius: 4px;

	line-height: 1.35;
}

#vendingBuy {
	margin-top: 20px;

	text-align: center;
}

#vendingBuy tw-link {
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;

	min-width: 180px !important;
	min-height: 42px !important;

	padding: 9px 18px !important;

	color: #ffffff !important;
	background: #2769ad !important;

	border: 1px solid #81b9ef !important;
	border-radius: 5px !important;

	font-family: Arial, sans-serif !important;
	font-size: 1rem !important;
	font-weight: bold !important;
	text-decoration: none !important;

	cursor: pointer !important;

	transition:
		background 0.15s ease,
		transform 0.15s ease !important;
}

#vendingBuy tw-link:hover {
	color: #ffffff !important;
	background: #3787d6 !important;

	transform: scale(1.04) !important;
}


/* =========================================================
   RETURN BUTTON
   ========================================================= */

#vendingBack {
	margin-top: 20px;

	text-align: center;
}

#vendingBack tw-link {
	display: inline-block;

	padding: 8px 16px;

	color: #eeeeee;
	background: #242a31;

	border: 1px solid #65717c;
	border-radius: 4px;

	text-decoration: none;
}

#vendingBack tw-link:hover {
	color: white;
	background: #38434e;
}


/* =========================================================
   SMALL SCREENS
   ========================================================= */

@media screen and (max-width: 800px) {
	#vendingScreen {
		width: calc(100% - 20px);
		margin: 10px auto;
		padding: 14px;
	}

	#vendingBody {
		grid-template-columns: 1fr;
	}

	#vendingItems,
	#vendingDetail {
		min-height: 0;
	}

	#vendingGrid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}

@media screen and (max-width: 450px) {
	#vendingGrid {
		grid-template-columns: 1fr;
	}
}
























/* OFFICE STORAGE */
.officeStorage {
	width: min(900px, 92vw);
	margin: 40px auto;
	padding: 24px;
	box-sizing: border-box;
	background: #17191e;
	border: 2px solid #505762;
	border-radius: 8px;
	color: #f2f2f2;
}

.officeStorage h2 {
	margin: 0 0 18px;
	text-align: center;
}

.storageColumns {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 18px;
	align-items: start;
}

.storagePanel {
	padding: 15px;
	background: #22252b;
	border: 1px solid #555c67;
	border-radius: 6px;
}

.storagePanel h3 {
	margin: 0 0 12px;
	padding-bottom: 8px;
	border-bottom: 1px solid #555c67;
}

.storageItem,
.storageEmpty {
	min-height: 26px;
	margin: 5px 0;
	padding: 8px 10px;
	box-sizing: border-box;
	border: 1px solid #454b55;
	border-radius: 4px;
	background: #181b20;
}

.storageItem {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 12px;
}

.storageItem tw-link {
	flex-shrink: 0;
	padding: 3px 9px;
	border: 1px solid #6e7784;
	border-radius: 3px;
}

.storageEmpty {
	color: #818894;
}

.storageMessage {
	margin-bottom: 16px;
	padding: 10px;
	text-align: center;
	background: #292d34;
	border: 1px solid #6a727e;
	border-radius: 4px;
}

.storageBack {
	margin-top: 18px;
	text-align: center;
}

@media (max-width: 700px) {
	.storageColumns {
		grid-template-columns: 1fr;
	}
}





































































/* Employee profile image */

.office-employee-photo-frame {
	box-sizing: border-box;
	width: min(280px, 100%);
	margin: 22px auto 4px;
	padding: 8px;
	border: 1px solid #4f9e64;
	background: #020805;
	box-shadow:
		0 0 12px rgba(119, 219, 145, 0.18),
		inset 0 0 14px rgba(0, 0, 0, 0.7);
}

.office-employee-photo {
	display: block;
	width: 100%;
	height: auto;
	max-height: 300px;
	object-fit: contain;
	filter:
		sepia(1)
		hue-rotate(75deg)
		saturate(0.8)
		contrast(1.08)
		brightness(0.88);
}

.office-employee-photo-caption {
	margin-top: 7px;
	font-size: 10px;
	line-height: 1.3;
	letter-spacing: 1px;
	text-align: center;
	color: #799782;
}
/* =========================================================
   EMPLOYEE DATABASE
   ========================================================= */

.office-database-intro {
	max-width: 760px;
	margin: 0 auto 22px;
	font-size: 15px;
	line-height: 1.55;
	color: #a3c9ad;
}

.office-database-search {
	box-sizing: border-box;
	max-width: 760px;
	margin: 0 auto 24px;
	padding: 11px 15px;
	border: 1px solid #315e3d;
	background: rgba(0, 0, 0, 0.22);
	font-size: 13px;
	line-height: 1.4;
	letter-spacing: 1px;
	text-align: left;
	color: #799782;
}

.office-database-search::before {
	content: "SEARCH: ";
	font-weight: bold;
	color: #b8ffc9;
}

.office-database-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14px;
	box-sizing: border-box;
	width: min(850px, 100%);
	margin: 0 auto;
}

.office-database-entry {
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	min-height: 145px;
	padding: 16px;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.22);
	text-align: left;
	box-shadow:
		inset 0 0 18px rgba(0, 0, 0, 0.35),
		0 0 8px rgba(119, 219, 145, 0.05);
}

.office-database-entry:hover {
	border-color: #77db91;
	background: rgba(119, 219, 145, 0.045);
	box-shadow:
		inset 0 0 18px rgba(0, 0, 0, 0.25),
		0 0 12px rgba(119, 219, 145, 0.16);
}

.office-database-entry-name {
	padding-bottom: 8px;
	border-bottom: 1px solid #315e3d;
	font-size: 16px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #d5ffdf;
}

.office-database-entry-id {
	margin-top: 8px;
	font-size: 11px;
	line-height: 1.4;
	letter-spacing: 1px;
	color: #799782;
}

.office-database-entry-position {
	flex: 1 1 auto;
	margin-top: 9px;
	font-size: 13px;
	line-height: 1.45;
	color: #a3c9ad;
}

.office-database-entry-link {
	margin-top: 14px;
}

.office-database-entry-link tw-expression {
	display: block;
	width: 100%;
	margin: 0;
	padding: 0;
}

.office-database-entry-link tw-link {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 8px 10px;
	border: 1px solid #77db91;
	background: transparent;
	color: #b8ffc9 !important;
	font-family: "Courier New", Courier, monospace;
	font-size: 12px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	text-align: center;
	text-decoration: none;
	cursor: pointer;
}

.office-database-entry-link tw-link::before {
	content: "> ";
}

.office-database-entry-link tw-link:hover {
	background: #77db91;
	color: #061009 !important;
	box-shadow: 0 0 10px rgba(119, 219, 145, 0.35);
}

/* Employee personnel document */

.office-employee-file {
	box-sizing: border-box;
	width: min(850px, 100%);
	margin: 0 auto;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.24);
	text-align: left;
	box-shadow:
		inset 0 0 28px rgba(0, 0, 0, 0.38),
		0 0 12px rgba(119, 219, 145, 0.08);
}

.office-employee-file-heading {
	padding: 16px 20px;
	border-bottom: 1px solid #4f9e64;
	background: rgba(119, 219, 145, 0.065);
}

.office-employee-file-name {
	font-size: clamp(20px, 3vw, 28px);
	font-weight: bold;
	line-height: 1.25;
	letter-spacing: 2px;
	color: #d5ffdf;
}

.office-employee-file-subtitle {
	margin-top: 6px;
	font-size: 11px;
	line-height: 1.4;
	letter-spacing: 2px;
	color: #799782;
}

.office-employee-file-content {
	padding: 20px;
}

.office-employee-section-title {
	margin: 22px 0 10px;
	padding-bottom: 7px;
	border-bottom: 1px solid #315e3d;
	font-size: 14px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 2px;
	color: #d5ffdf;
}

.office-employee-section-title:first-child {
	margin-top: 0;
}

.office-employee-data-grid {
	display: grid;
	grid-template-columns: minmax(150px, 0.7fr) minmax(0, 1.5fr);
	gap: 0;
	border-top: 1px solid #315e3d;
	border-left: 1px solid #315e3d;
}

.office-employee-label,
.office-employee-value {
	box-sizing: border-box;
	padding: 9px 12px;
	border-right: 1px solid #315e3d;
	border-bottom: 1px solid #315e3d;
	font-size: 13px;
	line-height: 1.45;
}

.office-employee-label {
	font-weight: bold;
	letter-spacing: 1px;
	color: #799782;
}

.office-employee-value {
	color: #b8ffc9;
}

.office-employee-text {
	padding: 14px 16px;
	border: 1px solid #315e3d;
	background: rgba(0, 0, 0, 0.17);
	font-size: 14px;
	line-height: 1.6;
	color: #a3c9ad;
}

.office-employee-skills {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
}

.office-employee-skill {
	display: inline-block;
	padding: 6px 9px;
	border: 1px solid #4f9e64;
	background: rgba(119, 219, 145, 0.035);
	font-size: 11px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #b8ffc9;
}

.office-employee-rating {
	display: inline-block;
	min-width: 50px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #d5ffdf;
}

.office-employee-redacted {
	display: inline-block;
	padding: 1px 5px;
	background: #b8ffc9;
	color: #b8ffc9;
	user-select: none;
}

.office-employee-warning {
	margin-top: 18px;
	padding: 12px 14px;
	border: 1px dashed #8bb998;
	font-size: 12px;
	line-height: 1.5;
	letter-spacing: 1px;
	color: #8bb998;
}

.office-database-return {
	width: min(520px, 100%);
	margin: 24px auto 0;
}

/* Database responsiveness */

@media (max-width: 700px) {
	.office-database-grid {
		grid-template-columns: 1fr;
	}

	.office-employee-data-grid {
		grid-template-columns: 1fr;
	}

	.office-employee-label {
		padding-bottom: 4px;
		border-bottom: 0;
	}

	.office-employee-value {
		padding-top: 4px;
	}

	.office-employee-file-content {
		padding: 15px;
	}
}
/* =========================================================
   OMEGA OFFICE COMPUTER — FULLSCREEN CRT TERMINAL
   ========================================================= */

.office-computer-screen {
	position: fixed;
	inset: 0;
	z-index: 300;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 100vw;
	height: 100vh;
	margin: 0;
	padding: 26px 5vw;
	overflow: hidden;
	background:
		radial-gradient(
			ellipse at center,
			#07150d 0%,
			#020805 72%,
			#000000 100%
		);
	font-family: "Courier New", Courier, monospace;
	color: #b8ffc9;
}

/* Physical monitor / black bezel */

.office-computer-window {
	position: relative;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	width: min(1100px, 90vw);
	height: calc(100vh - 52px);
	min-height: 0;
	margin: 0;
	overflow: hidden;
	background: #06170d;
	border: 3px solid #77db91;
	border-radius: 5px;
	box-shadow:
		0 0 0 8px #020704,
		0 0 0 11px #122017,
		0 0 34px rgba(119, 219, 145, 0.32),
		inset 0 0 55px rgba(0, 0, 0, 0.7);
	isolation: isolate;
}

/* Subtle curved CRT shading */

.office-computer-window::before {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 20;
	pointer-events: none;
	background:
		radial-gradient(
			ellipse at center,
			transparent 52%,
			rgba(0, 0, 0, 0.13) 82%,
			rgba(0, 0, 0, 0.3) 100%
		);
}

/* Fine scanlines */

.office-computer-window::after {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 21;
	pointer-events: none;
	opacity: 0.23;
	background:
		repeating-linear-gradient(
			0deg,
			rgba(0, 0, 0, 0.18) 0,
			rgba(0, 0, 0, 0.18) 1px,
			transparent 1px,
			transparent 4px
		);
	animation: omega-crt-flicker 7s infinite;
}

@keyframes omega-crt-flicker {
	0%,
	18%,
	20%,
	52%,
	54%,
	100% {
		opacity: 0.23;
	}

	19% {
		opacity: 0.19;
	}

	53% {
		opacity: 0.26;
	}
}

/* Terminal title bar */

.office-computer-header {
	position: relative;
	z-index: 10;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 100%;
	padding: 11px 18px;
	background: #77db91;
	color: #061009;
	font-size: 18px;
	font-weight: bold;
	line-height: 1.2;
	letter-spacing: 2px;
	text-align: left;
	text-shadow: none;
}

/* Scrollable terminal contents */

.office-computer-body {
	position: relative;
	z-index: 10;
	flex: 1 1 auto;
	min-height: 0;
	box-sizing: border-box;
	width: 100%;
	padding: 28px 42px 34px;
	overflow-x: hidden;
	overflow-y: auto;
	text-align: center;
	scrollbar-width: thin;
	scrollbar-color: #77db91 #071b10;
}

.office-computer-body::-webkit-scrollbar {
	width: 10px;
}

.office-computer-body::-webkit-scrollbar-track {
	background: #071b10;
	border-left: 1px solid #315e3d;
}

.office-computer-body::-webkit-scrollbar-thumb {
	background: #4f9e64;
	border: 2px solid #071b10;
}

.office-computer-body::-webkit-scrollbar-thumb:hover {
	background: #77db91;
}

/* Omega logo */

.office-computer-logo {
	margin: 4px 0 5px;
	font-family: Georgia, serif;
	font-size: clamp(58px, 7vh, 78px);
	font-weight: bold;
	line-height: 1;
	color: #d5ffdf;
	text-shadow:
		0 0 6px rgba(184, 255, 201, 0.8),
		0 0 18px rgba(184, 255, 201, 0.42);
}

.office-computer-title {
	margin: 8px 0;
	font-size: clamp(20px, 2.2vw, 27px);
	font-weight: bold;
	line-height: 1.25;
	letter-spacing: 3px;
	color: #d5ffdf;
	text-shadow: 0 0 8px rgba(184, 255, 201, 0.22);
}

.office-computer-version {
	margin-top: 5px;
	font-size: 13px;
	line-height: 1.3;
	letter-spacing: 2px;
	opacity: 0.72;
}

.office-computer-divider {
	width: 100%;
	height: 1px;
	margin: 22px 0;
	background: #4f9e64;
	box-shadow: 0 0 7px rgba(119, 219, 145, 0.4);
}

.office-computer-message {
	max-width: 680px;
	margin: 20px auto;
	font-size: 17px;
	line-height: 1.55;
}

/* Main terminal menu */

.office-computer-menu {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	box-sizing: border-box;
	width: min(520px, 100%);
	margin: 28px auto 0;
	gap: 10px;
}

.office-computer-menu tw-expression {
	display: block;
	width: 100%;
	margin: 0;
	padding: 0;
}

.office-computer-menu tw-link {
	position: relative;
	display: block;
	box-sizing: border-box;
	width: 100%;
	margin: 0;
	padding: 12px 18px;
	border: 1px solid #77db91;
	background: rgba(119, 219, 145, 0.035);
	color: #b8ffc9 !important;
	font-family: "Courier New", Courier, monospace;
	font-size: 16px;
	font-weight: bold;
	line-height: 1.25;
	letter-spacing: 1px;
	text-align: left;
	text-decoration: none;
	cursor: pointer;
	transition:
		background 0.08s linear,
		color 0.08s linear,
		box-shadow 0.08s linear;
}

.office-computer-menu tw-link::before {
	content: "> ";
}

.office-computer-menu tw-link::after {
	content: "█";
	margin-left: 8px;
	opacity: 0;
	animation: omega-cursor-blink 1s steps(1, end) infinite;
}

.office-computer-menu tw-link:hover {
	background: #77db91;
	color: #061009 !important;
	box-shadow:
		0 0 8px rgba(119, 219, 145, 0.5),
		0 0 18px rgba(119, 219, 145, 0.22);
}

.office-computer-menu tw-link:hover::after {
	opacity: 1;
}

@keyframes omega-cursor-blink {
	0%,
	49% {
		visibility: visible;
	}

	50%,
	100% {
		visibility: hidden;
	}
}

/* Fixed footer remains visible */

.office-computer-footer {
	position: relative;
	z-index: 10;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 100%;
	padding: 10px 16px;
	border-top: 1px solid #4f9e64;
	background: #06170d;
	font-size: 11px;
	line-height: 1.3;
	letter-spacing: 1px;
	text-align: center;
	opacity: 0.75;
}

/* =========================================================
   SAVE AND LOAD SLOTS
   ========================================================= */

.office-save-warning {
	box-sizing: border-box;
	max-width: 700px;
	margin: 0 auto 18px;
	padding: 12px 16px;
	border: 1px dashed #8bb998;
	font-size: 13px;
	line-height: 1.5;
	opacity: 0.82;
}

.office-save-message {
	min-height: 22px;
	margin: 14px auto 18px;
	font-size: 15px;
	font-weight: bold;
	line-height: 1.4;
	letter-spacing: 1px;
	color: #d5ffdf;
}

.office-save-message.success {
	color: #a9ffbd;
	text-shadow: 0 0 8px rgba(169, 255, 189, 0.5);
}

.office-save-message.error {
	color: #ffb3b3;
	text-shadow: 0 0 8px rgba(255, 80, 80, 0.35);
}

.office-save-slots {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 16px;
	box-sizing: border-box;
	width: 100%;
	margin: 10px auto;
}

.office-save-slot {
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	min-height: 190px;
	padding: 16px;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.2);
	text-align: left;
	box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.3);
}

.office-save-slot-heading {
	padding-bottom: 10px;
	border-bottom: 1px solid #315e3d;
	font-size: 15px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #d5ffdf;
}

.office-save-status {
	margin-top: 14px;
	font-size: 12px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
}

.office-save-status.occupied {
	color: #b8ffc9;
}

.office-save-status.empty {
	color: #799782;
}

.office-save-location {
	flex: 1 1 auto;
	margin-top: 12px;
	font-size: 14px;
	line-height: 1.45;
	color: #a3c9ad;
}

.office-save-actions {
	display: flex;
	gap: 8px;
	margin-top: 16px;
}

.office-save-actions tw-expression {
	display: block;
	flex: 1 1 0;
	margin: 0;
	padding: 0;
}

.office-save-actions tw-link {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 9px 8px;
	border: 1px solid #77db91;
	background: transparent;
	color: #b8ffc9 !important;
	font-family: "Courier New", Courier, monospace;
	font-size: 12px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	text-align: center;
	text-decoration: none;
	cursor: pointer;
}

.office-save-actions tw-link:hover {
	background: #77db91;
	color: #061009 !important;
	box-shadow: 0 0 10px rgba(119, 219, 145, 0.35);
}

.office-save-return {
	margin-top: 22px;
}

/* =========================================================
   RESPONSIVE TERMINAL
   ========================================================= */

@media (max-width: 900px) {
	.office-computer-screen {
		padding: 18px 3vw;
	}

	.office-computer-window {
		width: 94vw;
		height: calc(100vh - 36px);
	}

	.office-computer-body {
		padding: 25px 26px 30px;
	}

	.office-save-slots {
		grid-template-columns: 1fr;
	}

	.office-save-slot {
		min-height: 165px;
	}
}

@media (max-width: 560px) {
	.office-computer-screen {
		padding: 8px;
	}

	.office-computer-window {
		width: calc(100vw - 16px);
		height: calc(100vh - 16px);
		border-width: 2px;
		box-shadow:
			0 0 0 4px #020704,
			0 0 18px rgba(119, 219, 145, 0.28);
	}

	.office-computer-header {
		padding: 9px 12px;
		font-size: 14px;
		letter-spacing: 1px;
	}

	.office-computer-body {
		padding: 20px 14px 25px;
	}

	.office-computer-logo {
		font-size: 54px;
	}

	.office-computer-title {
		font-size: 19px;
		letter-spacing: 2px;
	}

	.office-computer-message {
		font-size: 15px;
	}

	.office-computer-menu tw-link {
		padding: 11px 12px;
		font-size: 14px;
	}

	.office-computer-footer {
		padding: 8px 10px;
		font-size: 9px;
	}

	.office-save-actions {
		flex-direction: column;
	}
}
/* =========================================================
   OMEGA MAIL SYSTEM
   Extends the existing office computer CRT interface
   ========================================================= */

.office-email-heading-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 20px;
	width: min(900px, 100%);
	margin: 0 auto;
	text-align: left;
}

.office-email-heading-row .office-computer-title,
.office-email-heading-row .office-computer-version {
	text-align: left;
}

.office-email-unread-counter {
	flex: 0 0 auto;
	box-sizing: border-box;
	padding: 9px 13px;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.24);
	font-size: 12px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #d5ffdf;
	box-shadow: inset 0 0 12px rgba(0, 0, 0, 0.35);
}

/* Inbox headings */

.office-email-column-headings {
	display: grid;
	grid-template-columns:
		80px
		minmax(145px, 0.8fr)
		minmax(240px, 1.7fr)
		110px;
	box-sizing: border-box;
	width: min(900px, 100%);
	margin: 0 auto;
	border: 1px solid #4f9e64;
	background: rgba(119, 219, 145, 0.08);
	text-align: left;
}

.office-email-column-headings > div {
	box-sizing: border-box;
	padding: 9px 11px;
	border-right: 1px solid #315e3d;
	font-size: 10px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #799782;
}

.office-email-column-headings > div:last-child {
	border-right: 0;
}

/* Inbox list */

.office-email-inbox {
	box-sizing: border-box;
	width: min(900px, 100%);
	margin: 0 auto;
	border-right: 1px solid #4f9e64;
	border-bottom: 1px solid #4f9e64;
	border-left: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.16);
	text-align: left;
	box-shadow:
		inset 0 0 24px rgba(0, 0, 0, 0.38),
		0 0 10px rgba(119, 219, 145, 0.06);
}

.office-email-row {
	display: grid;
	grid-template-columns:
		80px
		minmax(145px, 0.8fr)
		minmax(240px, 1.7fr)
		110px;
	align-items: stretch;
	min-height: 58px;
	border-bottom: 1px solid #315e3d;
}

.office-email-row:last-child {
	border-bottom: 0;
}

.office-email-row:hover {
	background: rgba(119, 219, 145, 0.045);
	box-shadow: inset 0 0 18px rgba(119, 219, 145, 0.025);
}

.office-email-row > div {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	min-width: 0;
	padding: 10px 11px;
	border-right: 1px solid #315e3d;
	font-size: 12px;
	line-height: 1.4;
}

.office-email-row > div:last-child {
	border-right: 0;
}

.office-email-status {
	justify-content: center;
	text-align: center;
}

.office-email-unread,
.office-email-read {
	display: inline-block;
	box-sizing: border-box;
	min-width: 45px;
	padding: 3px 5px;
	border: 1px solid;
	font-size: 9px;
	font-weight: bold;
	line-height: 1.2;
	letter-spacing: 1px;
	text-align: center;
}

.office-email-unread {
	border-color: #b8ffc9;
	background: rgba(184, 255, 201, 0.08);
	color: #d5ffdf;
	box-shadow: 0 0 7px rgba(184, 255, 201, 0.18);
}

.office-email-read {
	border-color: #315e3d;
	color: #66826d;
}

.office-email-sender {
	font-weight: bold;
	color: #a3c9ad;
}

.office-email-subject {
	display:block !important;
}

.office-email-subject tw-expression {
	display: inline;
	margin: 0;
	padding: 0;
}

.office-email-subject tw-link {
	color: #b8ffc9 !important;
	font-family: "Courier New", Courier, monospace;
	font-weight: bold;
	text-decoration: none;
}

.office-email-subject tw-link::before {
	content: "> ";
	color: #77db91;
}

.office-email-subject tw-link:hover {
	color: #ffffff !important;
	text-shadow: 0 0 8px rgba(184, 255, 201, 0.65);
}

.office-email-replied {
	display: inline-block;
	margin: 6px 0 0 7px;
	padding: 2px 5px;
	border: 1px solid #315e3d;
	font-size: 8px;
	font-weight: bold;
	line-height: 1.2;
	letter-spacing: 1px;
	color: #799782;
}

.office-email-date {
	justify-content: flex-end;
	color: #799782;
	text-align: right;
}

.office-email-return {
	width: min(520px, 100%);
	margin: 24px auto 0;
}

/* Opened email */

.office-email-opened {
	display: block;
	align-self: flex-start;
	flex: 0 0 auto;
	box-sizing: border-box;
	width: min(850px, 100%);
	height: auto;
	min-height: 0;
	margin: 0 auto;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.22);
	text-align: left;
	box-shadow:
		inset 0 0 28px rgba(0, 0, 0, 0.38),
		0 0 12px rgba(119, 219, 145, 0.08);
}

.office-email-opened-toolbar {
	padding: 11px 16px;
	border-bottom: 1px solid #315e3d;
	background: rgba(119, 219, 145, 0.035);
}

.office-email-opened-toolbar tw-link {
	color: #a3c9ad !important;
	font-family: "Courier New", Courier, monospace;
	font-size: 11px;
	font-weight: bold;
	letter-spacing: 1px;
	text-decoration: none;
}

.office-email-opened-toolbar tw-link:hover {
	color: #d5ffdf !important;
	text-shadow: 0 0 7px rgba(184, 255, 201, 0.4);
}

.office-email-opened-subject {
	padding: 17px 20px;
	border-bottom: 1px solid #4f9e64;
	background: rgba(119, 219, 145, 0.065);
	font-size: clamp(18px, 2.5vw, 24px);
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #d5ffdf;
}

.office-email-opened-details {
	padding: 13px 20px;
	border-bottom: 1px solid #315e3d;
	font-size: 11px;
	line-height: 1.7;
	color: #a3c9ad;
}

.office-email-opened-details span {
	display: inline-block;
	min-width: 58px;
	font-weight: bold;
	letter-spacing: 1px;
	color: #799782;
}

.office-email-opened-body {
	display: block;
	flex: none;
	box-sizing: border-box;
	width: 100%;
	height: auto;
	min-height: 0;
	margin: 0;
	padding: 24px 20px;
	white-space: pre-line;
	font-size: 14px;
	line-height: 1.65;
	color: #b8ffc9;
}

/* Reply area */

.office-email-reply-section {
	display: block;
	flex: none;
	box-sizing: border-box;
	height: auto;
	min-height: 0;
	padding: 20px;
	border-top: 1px solid #4f9e64;
	background: rgba(119, 219, 145, 0.025);
}

.office-email-section-title {
	margin-bottom: 15px;
	padding-bottom: 8px;
	border-bottom: 1px solid #315e3d;
	font-size: 13px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 2px;
	color: #d5ffdf;
}

.office-email-reply-choice {
	margin-top: 13px;
	padding: 14px;
	border: 1px solid #315e3d;
	background: rgba(0, 0, 0, 0.18);
}

.office-email-reply-choice:first-of-type {
	margin-top: 0;
}

.office-email-reply-type {
	margin-bottom: 8px;
	font-size: 10px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #799782;
}

.office-email-reply-preview {
	margin-bottom: 13px;
	padding: 11px 13px;
	border-left: 2px solid #4f9e64;
	background: rgba(0, 0, 0, 0.22);
	font-size: 13px;
	font-style: italic;
	line-height: 1.55;
	color: #a3c9ad;
}

.office-email-reply-button tw-expression {
	display: block;
	width: 100%;
	margin: 0;
	padding: 0;
}

.office-email-reply-button tw-link {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 9px 11px;
	border: 1px solid #77db91;
	background: transparent;
	color: #b8ffc9 !important;
	font-family: "Courier New", Courier, monospace;
	font-size: 11px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	text-align: center;
	text-decoration: none;
}

.office-email-reply-button tw-link::before {
	content: "> ";
}

.office-email-reply-button tw-link:hover {
	background: #77db91;
	color: #061009 !important;
	box-shadow: 0 0 10px rgba(119, 219, 145, 0.35);
}

/* Existing response */

.office-email-existing-reply {
	display: block;
	flex: none;
	box-sizing: border-box;
	height: auto;
	min-height: 0;
	margin: 0 20px 20px;
	padding: 15px;
	border: 1px solid #4f9e64;
	background: rgba(119, 219, 145, 0.035);
}

.office-email-existing-reply-heading {
	margin-bottom: 10px;
	padding-bottom: 7px;
	border-bottom: 1px solid #315e3d;
	font-size: 10px;
	font-weight: bold;
	line-height: 1.3;
	letter-spacing: 1px;
	color: #799782;
}

.office-email-existing-reply-text {
	white-space: pre-line;
	font-size: 13px;
	line-height: 1.55;
	color: #a3c9ad;
}

/* Sent confirmation */

.office-email-sent-confirmation {
	box-sizing: border-box;
	width: min(650px, 100%);
	height: auto;
	min-height: 0;
	margin: 20px auto;
	padding: 30px;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.22);
	text-align: center;
	box-shadow:
		inset 0 0 28px rgba(0, 0, 0, 0.4),
		0 0 14px rgba(119, 219, 145, 0.1);
}

.office-email-sent-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 62px;
	height: 62px;
	margin: 0 auto 20px;
	border: 2px solid #77db91;
	border-radius: 50%;
	font-size: 31px;
	font-weight: bold;
	color: #d5ffdf;
	box-shadow:
		0 0 12px rgba(119, 219, 145, 0.3),
		inset 0 0 10px rgba(119, 219, 145, 0.08);
}

.office-email-sent-subject {
	margin: 18px 0 10px;
	font-size: 14px;
	font-weight: bold;
	line-height: 1.4;
	color: #d5ffdf;
}

.office-email-sent-classification {
	margin-bottom: 18px;
	font-size: 11px;
	line-height: 1.4;
	letter-spacing: 1px;
	color: #799782;
}

.office-email-sent-message {
	margin: 18px 0;
	padding: 16px;
	border: 1px solid #315e3d;
	background: rgba(0, 0, 0, 0.2);
	white-space: pre-line;
	font-size: 13px;
	font-style: italic;
	line-height: 1.55;
	text-align: left;
	color: #a3c9ad;
}

.office-email-sent-warning {
	margin: 18px 0 24px;
	font-size: 10px;
	line-height: 1.5;
	letter-spacing: 1px;
	color: #799782;
}

/* Error */

.office-email-error {
	box-sizing: border-box;
	width: min(650px, 100%);
	height: auto;
	min-height: 0;
	margin: 30px auto;
	padding: 25px;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.2);
}

/* Email responsiveness */

@media (max-width: 760px) {
	.office-email-column-headings {
		display: none;
	}

	.office-email-row {
		grid-template-columns: 65px 1fr;
		padding: 8px 0;
	}

	.office-email-row > div {
		border-right: 0;
	}

	.office-email-status {
		grid-row: 1 / span 3;
	}

	.office-email-sender {
		padding-bottom: 3px !important;
	}

	.office-email-subject {
		padding-top: 3px !important;
		padding-bottom: 3px !important;
	}

	.office-email-date {
		justify-content: flex-start;
		padding-top: 3px !important;
		color: #66826d;
		text-align: left;
	}

	.office-email-heading-row {
		align-items: flex-start;
	}

	.office-email-opened-body,
	.office-email-reply-section {
		padding: 17px 15px;
	}

	.office-email-existing-reply {
		margin-right: 15px;
		margin-left: 15px;
	}
}

@media (max-width: 500px) {
	.office-email-heading-row {
		display: block;
	}

	.office-email-unread-counter {
		display: inline-block;
		margin-top: 12px;
	}

	.office-email-sent-confirmation {
		padding: 20px 15px;
	}
}
/* =========================================================
   RE-HAPPINESS PROTOCOL
   ========================================================= */

.rehappiness-body {
	padding: 18px 26px 24px;
	background:
		radial-gradient(circle at center, rgba(119, 219, 145, 0.05), transparent 68%),
		#06170d;
}

.rehappiness-launch {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 100%;
	height: 100%;
	min-height: 420px;
	cursor: pointer;
}

.rehappiness-launch img {
	display: block;
	width: min(1000px, 100%);
	max-height: calc(100vh - 150px);
	object-fit: contain;
	border: 1px solid #77db91;
	box-shadow: 0 0 25px rgba(119, 219, 145, 0.25);
}

.rehappiness-core {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	min-height: 100%;
	padding: 22px;
}

.rehappiness-core-image {
	display: block;
	width: min(820px, 100%);
	max-height: 480px;
	object-fit: contain;
	border: 1px solid #77db91;
	box-shadow: 0 0 24px rgba(119, 219, 145, 0.22);
}

.rehappiness-core .office-computer-menu {
	margin-top: 18px;
}

.rehappiness-interface {
	display: grid;
	grid-template-columns: minmax(0, 1.45fr) minmax(230px, 0.55fr);
	align-items: start;
	gap: 20px;
	box-sizing: border-box;
	width: min(950px, 100%);
	margin: 0 auto;
	text-align: left;
}

.rehappiness-dialogue-panel {
	box-sizing: border-box;
	min-height: 460px;
	padding: 24px;
	border: 1px solid #4f9e64;
	background: rgba(0, 0, 0, 0.28);
	box-shadow:
		inset 0 0 30px rgba(0, 0, 0, 0.45),
		0 0 12px rgba(119, 219, 145, 0.08);
}

.rehappiness-speaker {
	margin-bottom: 16px;
	padding-bottom: 9px;
	border-bottom: 1px solid #315e3d;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #d5ffdf;
}

.rehappiness-text {
	white-space: pre-line;
	font-size: 15px;
	line-height: 1.65;
	color: #b8ffc9;
}

.rehappiness-choices {
	display: flex;
	flex-direction: column;
	gap: 9px;
	margin-top: 24px;
}

.rehappiness-choices tw-expression {
	display: block;
	width: 100%;
	margin: 0;
	padding: 0;
}

.rehappiness-choices tw-link {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 11px 14px;
	border: 1px solid #77db91;
	background: rgba(119, 219, 145, 0.025);
	color: #b8ffc9 !important;
	font-family: "Courier New", Courier, monospace;
	font-size: 13px;
	font-weight: bold;
	line-height: 1.35;
	text-align: left;
	text-decoration: none;
	cursor: pointer;
}

.rehappiness-choices tw-link::before {
	content: "> ";
}

.rehappiness-choices tw-link:hover {
	background: #77db91;
	color: #061009 !important;
	box-shadow: 0 0 12px rgba(119, 219, 145, 0.3);
}

.rehappiness-mascot-panel {
	position: sticky;
	top: 0;
	align-self: start;
	display: flex;
	align-items: flex-end;
	justify-content: center;
	box-sizing: border-box;
	width: 100%;
	height: 460px;
	min-height: 460px;
	background: transparent;
	border: none;
	overflow: visible;
}

.rehappiness-mascot {
	display: block;
	width: 100%;
	max-height: 460px;
	object-fit: contain;
	object-position: center bottom;
}

.rehappiness-counter {
	margin-bottom: 18px;
	padding: 12px;
	border: 1px dashed #77db91;
	font-size: 14px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
	color: #d5ffdf;
}

.rehappiness-box-description {
	margin-top: 18px;
	padding: 15px;
	border: 1px solid #315e3d;
	background: rgba(0, 0, 0, 0.25);
	color: #a3c9ad;
}

.rehappiness-glitch {
	animation: rehappiness-glitch 0.14s steps(2, end) infinite;
}

@keyframes rehappiness-glitch {
	0% {
		transform: translate(0, 0);
		opacity: 1;
	}

	35% {
		transform: translate(-3px, 1px);
		opacity: 0.72;
	}

	70% {
		transform: translate(3px, -1px);
		opacity: 0.9;
	}

	100% {
		transform: translate(0, 0);
		opacity: 1;
	}
}

.rehappiness-video-placeholder {
	box-sizing: border-box;
	width: min(760px, 100%);
	margin: 20px auto;
	padding: 70px 25px;
	border: 1px solid #77db91;
	background: #010403;
	font-size: 18px;
	font-weight: bold;
	letter-spacing: 2px;
	text-align: center;
	color: #d5ffdf;
	box-shadow: inset 0 0 35px rgba(119, 219, 145, 0.06);
}

@media (max-width: 760px) {
	.rehappiness-interface {
		grid-template-columns: 1fr;
	}

	.rehappiness-mascot-panel {
		position: relative;
		top: auto;
		height: 260px;
		min-height: 260px;
	}

	.rehappiness-mascot {
		max-height: 300px;
	}

	.rehappiness-dialogue-panel {
		min-height: 0;
		padding: 18px;
	}
}

/* =========================================================
   RE-HAPPINESS IMAGE CRT FILTER
   Matches employee database image treatment
   ========================================================= */

.rehappiness-launch img,
.rehappiness-core-image,
.rehappiness-mascot {
	filter:
		sepia(1)
		hue-rotate(75deg)
		saturate(0.8)
		contrast(1.08)
		brightness(0.88);
}

.rehappiness-video-player {
	width: min(900px, 100%);
	margin: 0 auto 20px;
}

.rehappiness-video-player video {
	display: block;
	width: 100%;
	height: auto;
	border: 1px solid #77db91;
	box-shadow: 0 0 25px rgba(119, 219, 145, 0.22);
	filter:
		sepia(1)
		hue-rotate(75deg)
		saturate(0.8)
		contrast(1.08)
		brightness(0.88);
}




























/* =========================================================
   DESK HOTSPOTS
   ========================================================= */

.desk-click-area {
	position: absolute !important;
	box-sizing: border-box !important;
	overflow: visible !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.desk-mug {
	left: 41.8%;
	top: 30.2%;
	width: 18%;
	height: 40.5%;
	z-index: 20;
}

.desk-review {
	left: 0.8%;
	top: 49.5%;
	width: 33.8%;
	height: 44%;
	z-index: 21;
}

.desk-handbook {
	left: 67.5%;
	top: 22.8%;
	width: 31%;
	height: 54.5%;
	z-index: 22;
}

.desk-leave {
	left: 30%;
	top: 77%;
	width: 40%;
	height: 23%;
	z-index: 30;
}


/* =========================================================
   INVISIBLE HARLOWE HOTSPOT CONTENT
   ========================================================= */

.desk-click-area > tw-hook,
.desk-click-area > tw-expression,
.desk-click-area > tw-link {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.desk-click-area tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 10 !important;
}

.desk-click-area tw-enchantment:hover,
.desk-click-area tw-enchantment:focus,
.desk-click-area tw-hook:hover,
.desk-click-area tw-hook:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
}


/* =========================================================
   HOVER LABELS
   ========================================================= */

.desk-click-area::after {
	content: attr(data-label);
	position: absolute !important;
	left: 50% !important;
	top: 50% !important;
	display: block !important;
	transform: translate(-50%, -50%) !important;
	padding: 7px 12px !important;
	border: 1px solid rgba(255,255,255,.75) !important;
	border-radius: 4px !important;
	background: rgba(0,0,0,.88) !important;
	color: white !important;
	font-family: Arial,sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	white-space: nowrap !important;
	opacity: 0 !important;
	visibility: hidden !important;
	pointer-events: none !important;
	z-index: 1000 !important;
}

.desk-click-area:hover::after,
.desk-click-area:focus-within::after {
	opacity: 1 !important;
	visibility: visible !important;
}

/* =========================================================
   DESK DRAWER HOTSPOTS
   ========================================================= */

.drawer-click-area {
	position: absolute !important;
	box-sizing: border-box !important;
	overflow: visible !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.drawer-magazine {
	left: 29%;
	top: 13%;
	width: 32%;
	height: 58%;
	z-index: 20;
}

.drawer-star {
	left: 53%;
	top: 56%;
	width: 15%;
	height: 18%;
	z-index: 32;
}

.drawer-glasses {
	left: 56%;
	top: 40%;
	width: 22%;
	height: 18%;
	z-index: 31;
}

.drawer-handle {
	left: 23%;
	top: 74%;
	width: 34%;
	height: 16%;
	z-index: 40;
}


/* =========================================================
   INVISIBLE HARLOWE HOTSPOT CONTENT
   ========================================================= */

.drawer-click-area > tw-hook,
.drawer-click-area > tw-expression,
.drawer-click-area > tw-link {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.drawer-click-area tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 10 !important;
}

.drawer-click-area tw-enchantment:hover,
.drawer-click-area tw-enchantment:focus,
.drawer-click-area tw-hook:hover,
.drawer-click-area tw-hook:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
}


/* =========================================================
   HOVER LABELS
   ========================================================= */

.drawer-click-area::after {
	content: attr(data-label);
	position: absolute !important;
	left: 50% !important;
	top: 50% !important;
	display: block !important;
	transform: translate(-50%, -50%) !important;
	padding: 7px 12px !important;
	border: 1px solid rgba(255, 255, 255, 0.75) !important;
	border-radius: 4px !important;
	background: rgba(0, 0, 0, 0.88) !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	white-space: nowrap !important;
	opacity: 0 !important;
	visibility: hidden !important;
	pointer-events: none !important;
	z-index: 1000 !important;
}

.drawer-click-area:hover::after,
.drawer-click-area:focus-within::after {
	opacity: 1 !important;
	visibility: visible !important;
}


/* =========================================================
   DRAWER POPUP CONTAINER
   ========================================================= */

.drawer-popup-layer {
	position: fixed !important;
	inset: 0 !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	z-index: 3000000 !important;
	pointer-events: none !important;
}


/* Permanent named popup hook */

.room-screen .drawer-popup-layer tw-hook[name="drawerpopupmessage"] {
	position: fixed !important;
	inset: 0 !important;
	display: block !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	font-size: initial !important;
	line-height: normal !important;
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
	z-index: 3000001 !important;
	pointer-events: none !important;
}


/* Activate the popup hook only while popup content exists */

.room-screen .drawer-popup-layer tw-hook[name="drawerpopupmessage"]:has(.drawer-popup-blocker) {
	pointer-events: auto !important;
}


/* =========================================================
   HARLOWE CLICK WRAPPER
   ========================================================= */

.room-screen .drawer-popup-layer tw-hook[name="drawerpopupmessage"] > tw-enchantment {
	position: fixed !important;
	inset: 0 !important;
	display: block !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	z-index: 3000002 !important;
	pointer-events: none !important;
}


/* Enable the click wrapper only while the popup is visible */

.room-screen .drawer-popup-layer tw-hook[name="drawerpopupmessage"]:has(.drawer-popup-blocker) > tw-enchantment {
	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Remove all hover/focus styling from the popup hook */

.room-screen tw-hook[name="drawerpopupmessage"]:hover,
.room-screen tw-hook[name="drawerpopupmessage"]:focus,
.room-screen tw-hook[name="drawerpopupmessage"]:focus-within {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
}


/* Remove normal room hover labels from the popup hook */

.room-screen tw-hook[name="drawerpopupmessage"]::after,
.room-screen tw-hook[name="drawerpopupmessage"]:hover::after,
.room-screen tw-hook[name="drawerpopupmessage"]:focus::after,
.room-screen tw-hook[name="drawerpopupmessage"]:focus-within::after {
	content: none !important;
	display: none !important;
	opacity: 0 !important;
	visibility: hidden !important;
}


/* Remove visible styling from the Harlowe click wrapper */

.room-screen tw-hook[name="drawerpopupmessage"] > tw-enchantment:hover,
.room-screen tw-hook[name="drawerpopupmessage"] > tw-enchantment:focus {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
	text-decoration: none !important;
}


/* =========================================================
   FULL-SCREEN CLICK BLOCKER
   ========================================================= */

.drawer-popup-blocker {
	position: fixed !important;
	inset: 0 !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	background: rgba(0, 0, 0, 0.35) !important;
	cursor: pointer !important;
	pointer-events: none !important;
	z-index: 3000003 !important;
}


/* =========================================================
   VISIBLE POPUP MESSAGE
   ========================================================= */

.drawer-popup-message {
	position: relative !important;
	display: block !important;
	min-width: 300px !important;
	max-width: 520px !important;
	margin: 0 !important;
	padding: 22px 28px !important;
	color: #ffffff !important;
	background: rgba(12, 12, 12, 0.96) !important;
	border: 2px solid rgba(255, 255, 255, 0.8) !important;
	border-radius: 8px !important;
	box-shadow: 0 8px 35px rgba(0, 0, 0, 0.75) !important;
	font-family: Arial, sans-serif !important;
	font-size: 19px !important;
	font-weight: bold !important;
	line-height: 1.4 !important;
	text-align: center !important;
	box-sizing: border-box !important;
	cursor: pointer !important;
	pointer-events: none !important;
	z-index: 3000004 !important;
}

.room-screen .drawer-popup-layer tw-hook[name="drawerpopupmessage"]:hover .drawer-popup-message {
	background: rgba(26, 26, 26, 0.98) !important;
	border-color: #ffffff !important;
	box-shadow: 0 8px 40px rgba(0, 0, 0, 0.9) !important;
}

.drawer-popup-text {
	position: relative !important;
	display: block !important;
	width: auto !important;
	height: auto !important;
	margin: 0 !important;
	padding: 0 !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 19px !important;
	font-weight: bold !important;
	line-height: 1.4 !important;
	text-align: center !important;
	pointer-events: none !important;
	z-index: 2 !important;
}


/* =========================================================
   SMALL SCREENS
   ========================================================= */

@media screen and (max-width: 700px) {
	.drawer-click-area::after {
		max-width: 170px !important;
		padding: 6px 10px !important;
		font-size: 13px !important;
		white-space: normal !important;
		text-align: center !important;
	}

	.drawer-popup-message {
		min-width: 0 !important;
		max-width: calc(100vw - 60px) !important;
		margin: 0 30px !important;
		padding: 18px 22px !important;
		font-size: 17px !important;
	}

	.drawer-popup-text {
		font-size: 17px !important;
	}
}










































/* =========================================================
   CONVERSATION UI
   ========================================================= */

.conversation-screen {
	position: fixed !important;
	inset: 0 !important;
	display: flex !important;
	flex-direction: column !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 18px !important;
	box-sizing: border-box !important;
	overflow: hidden !important;
	background:
		radial-gradient(circle at center, rgba(55, 55, 55, 0.95), rgba(10, 10, 10, 0.98)) !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	z-index: 2000000 !important;
}


/* =========================================================
   TOP CONVERSATION AREA
   ========================================================= */

.conversation-main-panel {
	position: relative !important;
	display: grid !important;
	grid-template-columns: minmax(150px, 20%) minmax(300px, 60%) minmax(150px, 20%) !important;
	width: 100% !important;
	flex: 1 1 auto !important;
	min-height: 0 !important;
	margin: 0 0 14px 0 !important;
	padding: 14px !important;
	box-sizing: border-box !important;
	background: rgba(15, 15, 15, 0.9) !important;
	border: 2px solid rgba(255, 255, 255, 0.65) !important;
	border-radius: 8px !important;
	box-shadow: 0 8px 30px rgba(0, 0, 0, 0.75) !important;
	overflow: hidden !important;
}


/* =========================================================
   PORTRAIT COLUMNS
   ========================================================= */

.conversation-portrait-column {
	position: relative !important;
	display: flex !important;
	flex-direction: column !important;
	align-items: center !important;
	justify-content: center !important;
	min-width: 0 !important;
	height: 100% !important;
	padding: 10px !important;
	box-sizing: border-box !important;
	overflow: hidden !important;
}

.conversation-player-column {
	grid-column: 1 !important;
}

.conversation-npc-column {
	grid-column: 3 !important;
}

.conversation-portrait-frame {
	position: relative !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	width: min(220px, 100%) !important;
	height: min(360px, 65vh) !important;
	margin: 0 auto !important;
	background: rgba(35, 35, 35, 0.96) !important;
	border: 2px solid rgba(255, 255, 255, 0.65) !important;
	border-radius: 8px !important;
	box-shadow: 0 7px 24px rgba(0, 0, 0, 0.65) !important;
	overflow: hidden !important;
}

.conversation-portrait-frame img {
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	object-fit: contain !important;
	object-position: center bottom !important;
  transform: scale(2.2) !important;
	transform-origin: center !important;
}

.conversation-placeholder-portrait {
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	width: 100% !important;
	height: 100% !important;
	padding: 20px !important;
	box-sizing: border-box !important;
	color: rgba(255, 255, 255, 0.78) !important;
	font-size: 18px !important;
	font-weight: bold !important;
	text-align: center !important;
}

.conversation-speaker-name {
	display: block !important;
	width: 100% !important;
	margin: 10px 0 0 0 !important;
	padding: 7px 10px !important;
	box-sizing: border-box !important;
	color: #ffffff !important;
	background: rgba(0, 0, 0, 0.85) !important;
	border: 1px solid rgba(255, 255, 255, 0.55) !important;
	border-radius: 4px !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-align: center !important;
}


/* =========================================================
   SCROLLABLE TRANSCRIPT
   ========================================================= */

.conversation-transcript {
	grid-column: 2 !important;
	position: relative !important;
	display: flex !important;
	flex-direction: column !important;
	gap: 14px !important;
	min-width: 0 !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 18px !important;
	box-sizing: border-box !important;
	overflow-x: hidden !important;
	overflow-y: auto !important;
	scroll-behavior: smooth !important;
	background: rgba(0, 0, 0, 0.35) !important;
	border-left: 1px solid rgba(255, 255, 255, 0.25) !important;
	border-right: 1px solid rgba(255, 255, 255, 0.25) !important;
}


/* =========================================================
   DIALOGUE ROWS AND BUBBLES
   ========================================================= */

.dialogue-row {
	display: flex !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	box-sizing: border-box !important;
}

.dialogue-row-player {
	justify-content: flex-start !important;
}

.dialogue-row-npc {
	justify-content: flex-end !important;
}

.dialogue-bubble {
	display: block !important;
	width: fit-content !important;
	max-width: 78% !important;
	margin: 0 !important;
	padding: 13px 17px !important;
	box-sizing: border-box !important;
	color: #ffffff !important;
	border: 1px solid rgba(255, 255, 255, 0.65) !important;
	border-radius: 8px !important;
	box-shadow: 0 4px 13px rgba(0, 0, 0, 0.45) !important;
	font-size: 17px !important;
	line-height: 1.4 !important;
	white-space: normal !important;
	overflow-wrap: anywhere !important;
}

.dialogue-bubble-player {
	background: rgba(40, 67, 82, 0.96) !important;
	border-top-left-radius: 2px !important;
}

.dialogue-bubble-npc {
	background: rgba(78, 46, 46, 0.96) !important;
	border-top-right-radius: 2px !important;
}

.dialogue-speaker-label {
	display: block !important;
	margin: 0 0 5px 0 !important;
	padding: 0 !important;
	color: rgba(255, 255, 255, 0.72) !important;
	font-size: 12px !important;
	font-weight: bold !important;
	letter-spacing: 0.6px !important;
	text-transform: uppercase !important;
}


/* =========================================================
   BOTTOM CHOICE PANEL
   ========================================================= */

.conversation-choice-panel {
	position: relative !important;
	display: flex !important;
	flex: 0 0 auto !important;
	flex-direction: column !important;
	width: 100% !important;
	max-height: 30vh !important;
	min-height: 150px !important;
	margin: 0 !important;
	padding: 14px 18px !important;
	box-sizing: border-box !important;
	background: rgba(15, 15, 15, 0.96) !important;
	border: 2px solid rgba(255, 255, 255, 0.65) !important;
	border-radius: 8px !important;
	box-shadow: 0 8px 30px rgba(0, 0, 0, 0.75) !important;
	overflow-x: hidden !important;
	overflow-y: auto !important;
}

.conversation-choice-heading {
	display: block !important;
	margin: 0 0 10px 0 !important;
	padding: 0 0 8px 0 !important;
	color: rgba(255, 255, 255, 0.75) !important;
	border-bottom: 1px solid rgba(255, 255, 255, 0.25) !important;
	font-size: 14px !important;
	font-weight: bold !important;
	letter-spacing: 0.7px !important;
	text-transform: uppercase !important;
}

.conversation-choice-list {
	display: flex !important;
	flex-direction: column !important;
	gap: 8px !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}


/* =========================================================
   HARLOWE CHOICE LINKS
   ========================================================= */

.conversation-choice-list tw-link,
.conversation-choice-list tw-enchantment {
	display: block !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 10px 14px !important;
	box-sizing: border-box !important;
	color: #ffffff !important;
	background: rgba(40, 40, 40, 0.95) !important;
	border: 1px solid rgba(255, 255, 255, 0.5) !important;
	border-radius: 5px !important;
	box-shadow: none !important;
	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: normal !important;
	line-height: 1.3 !important;
	text-decoration: none !important;
	cursor: pointer !important;
}

.conversation-choice-list tw-link:hover,
.conversation-choice-list tw-link:focus,
.conversation-choice-list tw-enchantment:hover,
.conversation-choice-list tw-enchantment:focus {
	color: #ffffff !important;
	background: rgba(70, 70, 70, 0.98) !important;
	border-color: #ffffff !important;
	outline: none !important;
	box-shadow: 0 0 12px rgba(255, 255, 255, 0.16) !important;
	text-decoration: none !important;
}


/* =========================================================
   EXIT BUTTON
   ========================================================= */

.conversation-exit-button {
	position: absolute !important;
	top: 10px !important;
	right: 10px !important;
	z-index: 30 !important;
}

.conversation-exit-button tw-link,
.conversation-exit-button tw-enchantment {
	display: block !important;
	margin: 0 !important;
	padding: 7px 12px !important;
	color: #ffffff !important;
	background: rgba(0, 0, 0, 0.88) !important;
	border: 1px solid rgba(255, 255, 255, 0.6) !important;
	border-radius: 4px !important;
	font-family: Arial, sans-serif !important;
	font-size: 14px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-decoration: none !important;
	cursor: pointer !important;
}

.conversation-exit-button tw-link:hover,
.conversation-exit-button tw-enchantment:hover {
	background: rgba(75, 30, 30, 0.98) !important;
	border-color: #ffffff !important;
}


/* =========================================================
   PREVENT NORMAL PASSAGE SPACING
   ========================================================= */

tw-passage:has(.conversation-screen) {
	width: 100% !important;
	max-width: none !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}

tw-story:has(.conversation-screen) {
	margin: 0 !important;
	padding: 0 !important;
}
/* Dialogue bubble spacing fix */

.conversation-transcript tw-hook {
	display: flex !important;
	flex-direction: column !important;
	gap: 16px !important;
}

.conversation-transcript .dialogue-row {
	margin-bottom: 16px !important;
}

.conversation-transcript .dialogue-row:last-child {
	margin-bottom: 0 !important;
}


/* =========================================================
   SMALLER SCREENS
   ========================================================= */

@media screen and (max-width: 850px) {
	.conversation-screen {
		padding: 8px !important;
	}

	.conversation-main-panel {
		grid-template-columns: 105px minmax(180px, 1fr) 105px !important;
		padding: 7px !important;
	}

	.conversation-portrait-column {
		padding: 4px !important;
	}

	.conversation-portrait-frame {
		height: min(280px, 55vh) !important;
	}

	.conversation-speaker-name {
		font-size: 12px !important;
	}

	.conversation-transcript {
		padding: 10px !important;
	}

	.dialogue-bubble {
		max-width: 92% !important;
		padding: 10px 12px !important;
		font-size: 14px !important;
	}

	.conversation-choice-panel {
		min-height: 130px !important;
		padding: 10px !important;
	}

	.conversation-choice-list tw-link,
	.conversation-choice-list tw-enchantment {
		padding: 8px 10px !important;
		font-size: 14px !important;
	}
}

/* =========================================================
   DYNAMIC CONVERSATION HOOK FIXES
   ========================================================= */

.conversation-transcript > tw-hook {
	display: flex !important;
	flex-direction: column !important;
	gap: 14px !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	box-sizing: border-box !important;
}

.conversation-choice-list > tw-hook {
	display: flex !important;
	flex-direction: column !important;
	gap: 8px !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	box-sizing: border-box !important;
}

.conversation-main-panel > tw-hook {
	min-width: 0 !important;
	min-height: 0 !important;
}

.dialogue-row-action,
.dialogue-row-narration {
	display: flex !important;
	justify-content: center !important;
	width: 100% !important;
	margin: 10px 0 18px 0 !important;
	box-sizing: border-box !important;
}

.dialogue-bubble-action,
.dialogue-bubble-narration {
	display: block !important;
	width: auto !important;
	max-width: 75% !important;
	padding: 0 !important;
	margin: 0 !important;
	background: transparent !important;
	border: none !important;
	border-radius: 0 !important;
	box-shadow: none !important;
	color: rgba(255, 255, 255, 0.88) !important;
	text-align: center !important;
	font-style: italic !important;
	line-height: 1.45 !important;
}

/* =========================================================
   CONVERSATION ROOM BACKGROUND TEST
   FIXED BEHIND SCROLLING TRANSCRIPT
   ========================================================= */

/* The main panel does not scroll, so it safely holds the image. */
.conversation-main-panel {
	position: relative !important;
	isolation: isolate !important;
	overflow: hidden !important;
}

/* Fixed room image behind the middle transcript column. */
.conversation-main-panel::before {
	content: "" !important;
	position: absolute !important;

	/*
	   The main desktop grid is:
	   20% portrait | 60% transcript | 20% portrait
	*/
	top: 0 !important;
	bottom: 0 !important;
	left: 20% !important;
	right: 20% !important;

	background-image:
	linear-gradient(
		rgba(0, 0, 0, 0.55),
		rgba(0, 0, 0, 0.55)
	),
	var(--conversation-background) !important;

	background-size: cover !important;
	background-position: center !important;
	background-repeat: no-repeat !important;

	filter: blur(5px) !important;
	transform: scale(1.06) !important;
	transform-origin: center !important;

	pointer-events: none !important;
	z-index: 0 !important;
}

/* Keep all actual interface elements above the room image. */
.conversation-main-panel > * {
	position: relative !important;
	z-index: 1 !important;
}

/* The transcript now scrolls independently over the fixed image. */
.conversation-transcript {
	position: relative !important;
	z-index: 2 !important;

	background: rgba(0, 0, 0, 0.12) !important;

	overflow-x: hidden !important;
	overflow-y: auto !important;
}

/* Disable the previous scrolling transcript background. */
.conversation-transcript::before {
	content: none !important;
	display: none !important;
	background: none !important;
}

/* Keep transcript contents above everything. */
.conversation-transcript > * {
	position: relative !important;
	z-index: 3 !important;
}

/* =========================================================
   SMALL-SCREEN POSITIONING
   Matches your existing 105px / centre / 105px grid
   ========================================================= */

@media screen and (max-width: 850px) {
	.conversation-main-panel::before {
		left: 112px !important;
		right: 112px !important;
	}
}



























































/* =========================================================
   OFFICE MOUSE HOLE INVENTORY POPUP
   ========================================================= */

.mousehole-popup-layer {
	position: fixed !important;
	inset: 0 !important;
	display: block !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	z-index: 3000000 !important;
	pointer-events: none !important;
}

.mousehole-popup-layer tw-hook[name="mouseholepopup"] {
	position: fixed !important;
	inset: 0 !important;
	display: block !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	pointer-events: none !important;
	z-index: 3000001 !important;
}

.mousehole-popup-layer tw-hook[name="mouseholepopup"]:has(.mousehole-popup-blocker) {
	pointer-events: auto !important;
}

.mousehole-popup-blocker {
	position: fixed !important;
	inset: 0 !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 20px !important;
	box-sizing: border-box !important;
	background: rgba(0, 0, 0, 0.48) !important;
	z-index: 3000002 !important;
	pointer-events: auto !important;
}

.mousehole-popup-message {
	position: relative !important;
	display: block !important;
	width: min(560px, calc(100vw - 60px)) !important;
	max-height: calc(100vh - 60px) !important;
	overflow-y: auto !important;
	margin: 0 !important;
	padding: 24px 28px !important;
	box-sizing: border-box !important;
	color: #ffffff !important;
	background: rgba(12, 12, 12, 0.97) !important;
	border: 2px solid rgba(255, 255, 255, 0.8) !important;
	border-radius: 8px !important;
	box-shadow: 0 8px 35px rgba(0, 0, 0, 0.8) !important;
	font-family: Arial, sans-serif !important;
	text-align: center !important;
	z-index: 3000003 !important;
	pointer-events: auto !important;
}

.mousehole-popup-text {
	display: block !important;
	margin: 0 0 22px 0 !important;
	padding: 0 !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 19px !important;
	font-weight: bold !important;
	line-height: 1.45 !important;
	text-align: center !important;
}

.mousehole-popup-heading {
	display: block !important;
	margin: 0 0 12px 0 !important;
	padding-top: 16px !important;
	border-top: 1px solid rgba(255, 255, 255, 0.28) !important;
	color: rgba(255, 255, 255, 0.72) !important;
	font-family: Arial, sans-serif !important;
	font-size: 14px !important;
	font-weight: bold !important;
	letter-spacing: 1px !important;
	text-transform: uppercase !important;
}

.mousehole-popup-options {
	display: flex !important;
	flex-direction: column !important;
	gap: 8px !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}

.mousehole-popup-options tw-expression,
.mousehole-popup-options tw-link {
	position: relative !important;
	display: block !important;
	width: 100% !important;
	height: auto !important;
	inset: auto !important;
	margin: 0 !important;
	padding: 11px 14px !important;
	box-sizing: border-box !important;
	background: rgba(48, 48, 48, 0.96) !important;
	border: 1px solid rgba(255, 255, 255, 0.55) !important;
	border-radius: 5px !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-align: left !important;
	text-decoration: none !important;
	cursor: pointer !important;
	opacity: 1 !important;
}

.mousehole-popup-options tw-link:hover {
	background: rgba(75, 75, 75, 0.98) !important;
	border-color: #ffffff !important;
	color: #ffffff !important;
}

.mousehole-popup-empty {
	display: block !important;
	width: 100% !important;
	padding: 12px !important;
	box-sizing: border-box !important;
	color: rgba(255, 255, 255, 0.65) !important;
	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-style: italic !important;
	text-align: center !important;
}

.mousehole-popup-close {
	display: block !important;
	margin-top: 18px !important;
	padding-top: 16px !important;
	border-top: 1px solid rgba(255, 255, 255, 0.28) !important;
	text-align: center !important;
}

.mousehole-popup-close tw-expression,
.mousehole-popup-close tw-link {
	position: relative !important;
	display: inline-block !important;
	width: auto !important;
	height: auto !important;
	inset: auto !important;
	margin: 0 !important;
	padding: 9px 24px !important;
	background: transparent !important;
	border: 1px solid rgba(255, 255, 255, 0.65) !important;
	border-radius: 5px !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 15px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	opacity: 1 !important;
}

.mousehole-popup-close tw-link:hover {
	background: rgba(255, 255, 255, 0.12) !important;
	border-color: #ffffff !important;
	color: #ffffff !important;
}

@media screen and (max-width: 700px) {
	.mousehole-popup-blocker {
		padding: 15px !important;
	}

	.mousehole-popup-message {
		width: calc(100vw - 30px) !important;
		max-height: calc(100vh - 30px) !important;
		padding: 20px !important;
	}

	.mousehole-popup-text {
		font-size: 17px !important;
	}

	.mousehole-popup-options tw-expression,
	.mousehole-popup-options tw-link {
		font-size: 14px !important;
	}
}

/* =========================================================
   MOUSE HOLE POPUP â€” VISUAL FIXES
   Keep this beneath the original mouse-hole popup CSS.
   ========================================================= */


/* ---------------------------------------------------------
   Hide the visible "Mouse Hole" hook text while preserving
   the full clickable hotspot.
   --------------------------------------------------------- */

.office-mousehole {
	overflow: visible !important;
}

.office-mousehole > tw-hook,
.office-mousehole > tw-hook > tw-enchantment,
.office-mousehole > tw-hook > tw-enchantment > tw-hook {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}


/* ---------------------------------------------------------
   Harlowe creates tw-expression wrappers for every (if:).
   They must take up no visual space.
   --------------------------------------------------------- */

.mousehole-popup-options tw-expression,
.mousehole-popup-close tw-expression {
	display: contents !important;
	width: auto !important;
	height: auto !important;
	min-width: 0 !important;
	min-height: 0 !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: inherit !important;
	font-size: inherit !important;
	line-height: inherit !important;
}


/* ---------------------------------------------------------
   Only genuine inventory links should look like item buttons.
   Empty inventory slots now produce absolutely nothing.
   --------------------------------------------------------- */

.mousehole-popup-options tw-link {
	position: relative !important;
	inset: auto !important;
	display: block !important;
	width: 100% !important;
	height: auto !important;
	min-height: 0 !important;
	margin: 0 !important;
	padding: 11px 14px !important;
	box-sizing: border-box !important;
	background: rgba(48, 48, 48, 0.96) !important;
	border: 1px solid rgba(255, 255, 255, 0.55) !important;
	border-radius: 5px !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-align: left !important;
	text-decoration: none !important;
	cursor: pointer !important;
	opacity: 1 !important;
}

.mousehole-popup-options tw-link:hover {
	background: rgba(75, 75, 75, 0.98) !important;
	border-color: #ffffff !important;
	color: #ffffff !important;
}


/* ---------------------------------------------------------
   Only the actual Close link should look like a button.
   This removes the rogue empty rectangle beside it.
   --------------------------------------------------------- */

.mousehole-popup-close tw-link {
	position: relative !important;
	inset: auto !important;
	display: inline-block !important;
	width: auto !important;
	height: auto !important;
	min-width: 0 !important;
	min-height: 0 !important;
	margin: 0 !important;
	padding: 9px 24px !important;
	box-sizing: border-box !important;
	background: transparent !important;
	border: 1px solid rgba(255, 255, 255, 0.65) !important;
	border-radius: 5px !important;
	color: #ffffff !important;
	font-family: Arial, sans-serif !important;
	font-size: 15px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	opacity: 1 !important;
}

.mousehole-popup-close tw-link:hover {
	background: rgba(255, 255, 255, 0.12) !important;
	border-color: #ffffff !important;
	color: #ffffff !important;
}

/* =========================================================
   OFFICE MOUSE-HOLE HOTSPOT
   Uses the same proven structure as the desk-drawer hotspots.
   ========================================================= */

.office-mousehole {
	position: absolute !important;
	box-sizing: border-box !important;
	overflow: visible !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Hide all real Harlowe content while keeping it clickable */

.office-mousehole > tw-hook,
.office-mousehole > tw-expression,
.office-mousehole > tw-link {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Harlowe's click-rerun enchantment must fill the hotspot */

.office-mousehole tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 10 !important;
}


/* Hide any nested hook/link text Harlowe generates */

.office-mousehole tw-enchantment tw-hook,
.office-mousehole tw-enchantment tw-expression,
.office-mousehole tw-enchantment tw-link {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Prevent Harlowe from adding its own hover appearance */

.office-mousehole tw-enchantment:hover,
.office-mousehole tw-enchantment:focus,
.office-mousehole tw-hook:hover,
.office-mousehole tw-hook:focus,
.office-mousehole tw-link:hover,
.office-mousehole tw-link:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	text-decoration: none !important;
}


/* Keep the outer custom hover label above the invisible click layer */

.office-mousehole::after {
	pointer-events: none !important;
	z-index: 1000 !important;
}

.office-mousehole,
.office-mousehole:hover,
.office-mousehole:focus,
.office-mousehole:focus-within,
.office-mousehole tw-hook,
.office-mousehole tw-hook:hover,
.office-mousehole tw-hook:focus,
.office-mousehole tw-enchantment,
.office-mousehole tw-enchantment:hover,
.office-mousehole tw-enchantment:focus {
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
}

/* =========================================================
   MOUSE HOLE â€” COMPLETELY INVISIBLE HARLOWE CLICK LAYER
   ========================================================= */

tw-story .your-office-room .office-mousehole tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;

	opacity: 0 !important;
	visibility: visible !important;

	border: none !important;
	outline: none !important;
	box-shadow: none !important;
	background: transparent !important;

	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 10 !important;
}

/* Keep everything generated inside the enchantment invisible */

tw-story .your-office-room .office-mousehole tw-enchantment *,
tw-story .your-office-room .office-mousehole tw-enchantment::before,
tw-story .your-office-room .office-mousehole tw-enchantment::after {
	opacity: 0 !important;
	border: none !important;
	outline: none !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	text-shadow: none !important;
}

/* Remove the slight hotspot shading when hovering */

tw-story .your-office-room .office-mousehole:hover,
tw-story .your-office-room .office-mousehole:focus,
tw-story .your-office-room .office-mousehole:focus-within {
	background: transparent !important;
	border: none !important;
	outline: none !important;
	box-shadow: none !important;
}

/* =========================================================
   OFFICE RAT AFTERMATH NOTE
   ========================================================= */

.mousehole-popup-note {
	display: block !important;
	width: 100% !important;
	max-height: 330px !important;
	overflow-y: auto !important;
	margin: 0 0 18px 0 !important;
	padding: 18px 20px !important;
	box-sizing: border-box !important;
	background: rgba(235, 227, 201, 0.96) !important;
	border: 1px solid rgba(80, 66, 45, 0.8) !important;
	border-radius: 4px !important;
	color: #28231d !important;
	font-family: Georgia, serif !important;
	font-size: 14px !important;
	line-height: 1.38 !important;
	text-align: left !important;
	box-shadow: inset 0 0 18px rgba(60, 45, 25, 0.18) !important;
}

.mousehole-popup-note p {
	display: block !important;
	margin: 0 0 10px 0 !important;
	padding: 0 !important;
	color: #28231d !important;
	font-family: Georgia, serif !important;
	font-size: 14px !important;
	line-height: 1.38 !important;
	text-align: left !important;
}

.mousehole-note-heading {
	display: block !important;
	margin: 0 0 12px 0 !important;
	color: #28231d !important;
	font-family: Georgia, serif !important;
	font-size: 15px !important;
	font-weight: bold !important;
	text-align: left !important;
}

.mousehole-note-signature {
	display: block !important;
	margin-top: 14px !important;
	color: #28231d !important;
	font-family: Georgia, serif !important;
	font-size: 14px !important;
	line-height: 1.35 !important;
	text-align: left !important;
}

.mousehole-note-signature span {
	font-size: 12px !important;
	font-style: italic !important;
	opacity: 0.8 !important;
}
























































/* =========================================================
   CAPTAIN PRODUCTIVITY DIALOGUE SCENE
   ========================================================= */

.captain-speech-bubble {
	position: absolute !important;
	left: 4.5% !important;
	top: 12% !important;
	width: 48% !important;
	min-height: 190px !important;
	display: flex !important;
	flex-direction: column !important;
	align-items: center !important;
	justify-content: flex-start !important;
	box-sizing: border-box !important;
	padding: 34px 42px 48px !important;
	background: rgba(245, 241, 225, 0.97) !important;
	border: 4px solid rgba(25, 25, 25, 0.95) !important;
	border-radius: 28px !important;
	box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55) !important;
	color: #181818 !important;
	text-align: center !important;
	pointer-events: none !important;
	z-index: 200 !important;
	animation: captainBubbleAppear 0.22s ease-out;
}

.captain-speech-bubble tw-hook[name="captainprompt"] {
	display: contents !important;
	margin: 0 !important;
	padding: 0 !important;
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	pointer-events: none !important;
}


/* Speech-bubble tail border */

.captain-speech-bubble::before {
	content: "" !important;
	position: absolute !important;
	right: -48px !important;
	bottom: 24px !important;
	width: 0 !important;
	height: 0 !important;
	border-top: 30px solid transparent !important;
	border-bottom: 8px solid transparent !important;
	border-left: 50px solid rgba(25, 25, 25, 0.95) !important;
}


/* Speech-bubble tail interior */

.captain-speech-bubble::after {
	content: "" !important;
	position: absolute !important;
	right: -39px !important;
	bottom: 29px !important;
	width: 0 !important;
	height: 0 !important;
	border-top: 24px solid transparent !important;
	border-bottom: 6px solid transparent !important;
	border-left: 42px solid rgba(245, 241, 225, 0.97) !important;
}


.captain-speech-text {
	position: relative !important;
	display: block !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	color: #181818 !important;
	font-family: Arial, sans-serif !important;
	font-size: clamp(20px, 1.75vw, 27px) !important;
	font-weight: bold !important;
	line-height: 1.3 !important;
	text-align: center !important;
	overflow-wrap: break-word !important;
	word-break: normal !important;
	pointer-events: none !important;
	z-index: 2 !important;
}

.captain-speech-text tw-hook[name="captainspeech"] {
	display: block !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	color: inherit !important;
	font: inherit !important;
	line-height: inherit !important;
	text-align: inherit !important;
	pointer-events: none !important;
}


.captain-speech-prompt {
	position: absolute !important;
	left: 0 !important;
	right: 0 !important;
	bottom: 12px !important;
	color: rgba(25, 25, 25, 0.62) !important;
	font-family: Arial, sans-serif !important;
	font-size: 13px !important;
	font-weight: normal !important;
	font-style: italic !important;
	line-height: 1.2 !important;
	text-align: center !important;
	pointer-events: none !important;
}

/* =========================================================
   FULL-SCREEN DIALOGUE CLICK AREA
   ========================================================= */

.captain-advance-area {
	position: fixed !important;
	inset: 0 !important;
	display: block !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 1000 !important;
}

.captain-advance-area > tw-hook,
.captain-advance-area > tw-expression,
.captain-advance-area > tw-link {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.captain-advance-area tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 10 !important;
}

.captain-advance-area tw-enchantment:hover,
.captain-advance-area tw-enchantment:focus,
.captain-advance-area tw-hook:hover,
.captain-advance-area tw-hook:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	background: transparent !important;
	color: transparent !important;
	text-decoration: none !important;
}

.captain-advance-area::after,
.captain-advance-area tw-hook::after {
	content: none !important;
	display: none !important;
}


/* Prevent ordinary room hotspot labels */

.room-screen tw-hook[name="captainadvance"]::after,
.room-screen tw-hook[name="captainadvance"]:hover::after,
.room-screen tw-hook[name="captainadvance"]:focus::after {
	content: none !important;
	display: none !important;
	opacity: 0 !important;
	visibility: hidden !important;
}


/* =========================================================
   SPEECH-BUBBLE ENTRANCE
   ========================================================= */

@keyframes captainBubbleAppear {
	from {
		opacity: 0;
		transform: scale(0.96);
	}

	to {
		opacity: 1;
		transform: scale(1);
	}
}


/* =========================================================
   SMALL SCREENS
   ========================================================= */

@media screen and (max-width: 800px) {
	.captain-speech-bubble {
		left: 5% !important;
		top: 10% !important;
		width: 52% !important;
		min-height: 120px !important;
		padding: 22px 25px 36px !important;
		border-width: 3px !important;
		border-radius: 20px !important;
	}

	.captain-speech-text {
		font-size: 19px !important;
	}

	.captain-speech-prompt {
		font-size: 11px !important;
	}
}

/* =========================================================
   ONE-TIME OFFICE MUSIC TUTORIAL BUBBLE
   ========================================================= */

.office-tutorial-bubble {
	position: fixed !important;
	left: 35% !important;
	top: 7% !important;
	width: 39% !important;
	min-height: 180px !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	box-sizing: border-box !important;
	margin: 0 !important;
	padding: 30px 38px !important;
	background: rgba(245, 241, 225, 0.97) !important;
	border: 4px solid rgba(25, 25, 25, 0.95) !important;
	border-radius: 28px !important;
	box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55) !important;
	color: #181818 !important;
	text-align: center !important;
	pointer-events: none !important;
	z-index: 1100 !important;
	animation: captainBubbleAppear 0.22s ease-out;
}

.office-tutorial-bubble::before {
	content: "" !important;
	position: absolute !important;
	right: -48px !important;
	bottom: 28px !important;
	width: 0 !important;
	height: 0 !important;
	border-top: 30px solid transparent !important;
	border-bottom: 8px solid transparent !important;
	border-left: 50px solid rgba(25, 25, 25, 0.95) !important;
}

.office-tutorial-bubble::after {
	content: "" !important;
	position: absolute !important;
	right: -39px !important;
	bottom: 33px !important;
	width: 0 !important;
	height: 0 !important;
	border-top: 24px solid transparent !important;
	border-bottom: 6px solid transparent !important;
	border-left: 42px solid rgba(245, 241, 225, 0.97) !important;
}

.office-tutorial-text {
	position: relative !important;
	display: block !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	color: #181818 !important;
	font-family: Arial, sans-serif !important;
	font-size: clamp(18px, 1.45vw, 24px) !important;
	font-weight: bold !important;
	line-height: 1.3 !important;
	text-align: center !important;
	overflow-wrap: break-word !important;
	word-break: normal !important;
	white-space: normal !important;
	pointer-events: none !important;
	z-index: 2 !important;
}

.office-tutorial-advance {
	position: fixed !important;
	inset: 0 !important;
	display: block !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	cursor: pointer !important;
	pointer-events: auto !important;
	z-index: 1000 !important;
}

.office-tutorial-advance > tw-hook,
.office-tutorial-advance > tw-expression,
.office-tutorial-advance > tw-link,
.office-tutorial-advance tw-enchantment {
	position: absolute !important;
	inset: 0 !important;
	display: block !important;
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	color: transparent !important;
	font-size: 0 !important;
	line-height: 0 !important;
	text-decoration: none !important;
	cursor: pointer !important;
	pointer-events: auto !important;
}

.office-tutorial-advance tw-enchantment:hover,
.office-tutorial-advance tw-enchantment:focus,
.office-tutorial-advance tw-hook:hover,
.office-tutorial-advance tw-hook:focus {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;
	color: transparent !important;
}

@media screen and (max-width: 800px) {
	.office-tutorial-bubble {
		left: 26% !important;
		top: 6% !important;
		width: 50% !important;
		min-height: 145px !important;
		padding: 22px 25px !important;
		border-width: 3px !important;
		border-radius: 20px !important;
	}

	.office-tutorial-text {
		font-size: 17px !important;
	}
}































/*TALENT*/


.talent-screen {
	position: fixed;
	inset: 0;
	z-index: 10000;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	padding: 26px;
	background: #090909;
	color: #eee;
	font-family: Georgia, serif;
}

.talent-topbar {
	min-height: 94px;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 16px 20px;
	border: 2px solid #ccc;
	background: #111;
}

.talent-title {
	font-size: 27px;
	letter-spacing: 3px;
}

.talent-subtitle {
	font-size: 13px;
	letter-spacing: 1px;
	color: #999;
}

.talent-points {
	padding: 12px 16px;
	border: 1px solid #666;
	font-size: 16px;
}

.talent-point-number {
	color: #65afff;
	font-weight: bold;
}

.talent-main {
	display: grid;
	grid-template-columns: minmax(0, 3fr) 340px;
	gap: 18px;
	flex: 1;
	min-height: 0;
	margin-top: 18px;
}

.talent-tree-panel {
	position: relative;
	min-height: 0;
	overflow: auto;
	border: 2px solid #ccc;
	background: #0c0c0c;
}

.talent-tree-content {
	width: 100%;
	max-width: 850px;
	min-height: 610px;
	margin: 0 auto;
	padding: 34px 30px;
	box-sizing: border-box;
}

.talent-row {
	position: relative;
	z-index: 2;
	display: grid;
	align-items: center;
	justify-content: center;
}

.talent-row-one {
	grid-template-columns: 82px;
}

.talent-row-two {
	grid-template-columns: repeat(2, 82px);
	gap: 150px;
}

.talent-row-four {
	grid-template-columns: repeat(4, 82px);
	gap: 52px;
}

.talent-node {
	width: 82px;
	height: 82px;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	border: 2px solid #444;
	background: #141414;
	font-size: 15px;
	font-weight: bold;
	user-select: none;
}

.talent-node tw-link {
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	color: inherit;
	text-decoration: none;
}

.talent-node tw-link:hover {
	color: inherit;
	text-decoration: none;
	background: rgba(255,255,255,0.04);
}

.talent-node.learned {
	border-color: #eee;
	background: #315d83;
	color: #fff;
}

.talent-node.available {
	border-color: #4fa3ff;
	color: #79baff;
}

.talent-node.locked {
	border-color: #333;
	color: #555;
	opacity: .55;
}

.talent-connector {
	width: 2px;
	height: 42px;
	margin: 0 auto;
	background: #666;
}

.talent-connector.bottom {
	height: 42px;
}

.talent-branch {
	position: relative;
	width: 234px;
	height: 38px;
	margin: 0 auto;
	border-top: 2px solid #666;
}

.talent-branch::before,
.talent-branch::after {
	content: "";
	position: absolute;
	top: -2px;
	width: 2px;
	height: 38px;
	background: #666;
}

.talent-branch::before {
	left: 0;
}

.talent-branch::after {
	right: 0;
}

.talent-child-connectors {
	display: grid;
	grid-template-columns: repeat(2, 2px);
	justify-content: center;
	gap: 230px;
	height: 56px;
}

.talent-child-connectors div {
	height: 56px;
	background: #666;
}

.talent-info-panel {
	min-height: 0;
	box-sizing: border-box;
	padding: 20px;
	overflow-y: auto;
	border: 2px solid #ccc;
	background: #111;
}

.talent-info-heading {
	padding-bottom: 12px;
	border-bottom: 1px solid #555;
	color: #999;
	font-size: 14px;
	letter-spacing: 2px;
}

.talent-info-name {
	margin-top: 24px;
	font-size: 25px;
}

.talent-info-description {
	min-height: 110px;
	margin-top: 18px;
	color: #d1d1d1;
	font-size: 17px;
	line-height: 1.5;
}

.talent-info-requirement {
	margin-top: 18px;
	padding-top: 15px;
	border-top: 1px solid #444;
	color: #bbb;
	line-height: 1.5;
}

.talent-info-cost {
	margin-top: 18px;
	padding-top: 15px;
	border-top: 1px solid #444;
	font-size: 16px;
}

.talent-status,
.talent-learn-button {
	margin-top: 18px;
}

.talent-status {
	padding: 13px;
	border: 1px solid #555;
	text-align: center;
	font-size: 13px;
	letter-spacing: 1px;
}

.learned-status {
	border-color: #ddd;
	background: #315d83;
	color: #fff;
}

.locked-status {
	border-color: #444;
	color: #777;
}

.talent-learn-button tw-link {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 13px;
	border: 1px solid #888;
	background: #151515;
	color: #65afff;
	text-align: center;
	text-decoration: none;
	font-size: 14px;
	letter-spacing: 1px;
}

.talent-learn-button tw-link:hover {
	border-color: #fff;
	background: #202020;
	color: #a2d0ff;
}

.talent-footer {
	display: flex;
	justify-content: flex-end;
	margin-top: 14px;
}

.talent-footer tw-link {
	padding: 10px 18px;
	border: 1px solid #888;
	background: #111;
	color: #65afff;
	text-decoration: none;
}

@media (max-width: 900px) {
	.talent-main {
		grid-template-columns: 1fr;
		overflow-y: auto;
	}

	.talent-tree-panel {
		min-height: 620px;
	}

	.talent-info-panel {
		min-height: 340px;
	}
}












































/* =========================================================
   PAINTING BACKGROUND

   Keep your current hosted image URL here.
   The existing .room-screen class handles all positioning,
   sizing, centring and aspect ratio.
   ========================================================= */

.painting-bg {
	background-image: url("https://i.ibb.co/Z1Y4FzNN/Chat-GPT-Image-Jul-24-2026-at-10-51-32-PM.png");
}

/* =========================================================
   PAINTING HOTSPOTS

   Same mechanics as DESK DRAWER HOTSPOTS.
   ========================================================= */

.painting-click-area {
	position: absolute !important;
	box-sizing: border-box !important;

	overflow: visible !important;

	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Note */

.painting-note {
	left: 76.2% !important;
	top: 76.3% !important;

	width: 5.5% !important;
	height: 11.5% !important;

	z-index: 40 !important;
}


/* Little Gnome */

.painting-gnome {
	left: 29.2% !important;
	top: 52.2% !important;

	width: 7% !important;
	height: 15% !important;

	z-index: 32 !important;
}


/* Leave Painting */

.painting-leave {
	left: 34% !important;
	top: 88% !important;

	width: 32% !important;
	height: 9% !important;

	z-index: 30 !important;
}


/* =========================================================
   INVISIBLE HARLOWE HOTSPOT CONTENT

   Same mechanics as the desk drawer.
   ========================================================= */

.painting-click-area > tw-hook,
.painting-click-area > tw-expression,
.painting-click-area > tw-link {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	background: transparent !important;
	color: transparent !important;

	font-size: 0 !important;
	line-height: 0 !important;

	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Harlowe wrapper created by (click:) */

.painting-click-area tw-enchantment {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	background: transparent !important;
	color: transparent !important;

	font-size: 0 !important;
	line-height: 0 !important;

	cursor: pointer !important;
	pointer-events: auto !important;

	z-index: 10 !important;
}


.painting-click-area tw-enchantment:hover,
.painting-click-area tw-enchantment:focus,
.painting-click-area tw-hook:hover,
.painting-click-area tw-hook:focus {
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	background: transparent !important;
	color: transparent !important;
}


/* =========================================================
   HOVER LABELS

   Same data-label system as the desk drawer.
   ========================================================= */

.painting-click-area::after {
	content: attr(data-label);

	position: absolute !important;
	left: 50% !important;
	top: 50% !important;

	display: block !important;

	transform: translate(-50%, -50%) !important;

	width: auto !important;
	height: auto !important;

	margin: 0 !important;
	padding: 7px 12px !important;

	border: 1px solid rgba(255, 255, 255, 0.75) !important;
	border-radius: 4px !important;

	background: rgba(0, 0, 0, 0.88) !important;
	color: #ffffff !important;

	font-family: Arial, sans-serif !important;
	font-size: 16px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
	text-align: center !important;

	white-space: nowrap !important;

	opacity: 0 !important;
	visibility: hidden !important;

	pointer-events: none !important;

	z-index: 1000 !important;
}


.painting-click-area:hover::after,
.painting-click-area:focus-within::after {
	opacity: 1 !important;
	visibility: visible !important;
}


/* =========================================================
   REMOVE GLOBAL ROOM HOTSPOT EFFECTS

   Prevent the named hooks inside each painting hotspot
   from making their own ugly second hover box.
   ========================================================= */

.room-screen .painting-click-area tw-hook,
.room-screen .painting-click-area tw-hook:hover,
.room-screen .painting-click-area tw-hook:focus,
.room-screen .painting-click-area tw-hook:focus-within {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
}


.room-screen .painting-click-area tw-hook::after,
.room-screen .painting-click-area tw-hook:hover::after,
.room-screen .painting-click-area tw-hook:focus::after,
.room-screen .painting-click-area tw-hook:focus-within::after {
	content: none !important;
	display: none !important;
	opacity: 0 !important;
	visibility: hidden !important;
}
/* =========================================================
   PAINTING POPUP CONTAINER

   Same mechanics as the final desk-drawer popup.
   ========================================================= */

.painting-popup-layer {
	position: fixed !important;
	inset: 0 !important;

	width: 100vw !important;
	height: 100vh !important;

	margin: 0 !important;
	padding: 0 !important;

	z-index: 3000000 !important;
	pointer-events: none !important;
}


/* Permanent named popup message hook */

.room-screen .painting-popup-layer
tw-hook[name="paintingpopupmessage"] {
	position: fixed !important;
	inset: 0 !important;

	display: block !important;

	width: 100vw !important;
	height: 100vh !important;

	margin: 0 !important;
	padding: 0 !important;

	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	font-size: initial !important;
	line-height: normal !important;

	pointer-events: none !important;

	z-index: 3000001 !important;
}


/* Only activate the popup message hook when content exists */

.room-screen .painting-popup-layer
tw-hook[name="paintingpopupmessage"]:has(.painting-popup-blocker) {
	pointer-events: auto !important;
}


/* =========================================================
   FULLSCREEN POPUP BLOCKER
   ========================================================= */

.painting-popup-blocker {
	position: fixed !important;
	inset: 0 !important;

	display: flex !important;
	align-items: center !important;
	justify-content: center !important;

	width: 100vw !important;
	height: 100vh !important;

	margin: 0 !important;
	padding: 0 !important;

	background: rgba(0, 0, 0, 0.25) !important;

	cursor: default !important;
	pointer-events: auto !important;

	z-index: 3000002 !important;
}


/* =========================================================
   VISIBLE POPUP MESSAGE
   ========================================================= */

.painting-popup-message {
	position: relative !important;

	display: block !important;

	min-width: 300px !important;
	max-width: 520px !important;

	margin: 0 !important;
	padding: 22px 28px !important;

	box-sizing: border-box !important;

	background: rgba(12, 12, 12, 0.96) !important;
	color: #ffffff !important;

	border: 2px solid rgba(255, 255, 255, 0.8) !important;
	border-radius: 8px !important;

	box-shadow: 0 8px 35px rgba(0, 0, 0, 0.75) !important;

	font-family: Arial, sans-serif !important;
	font-size: 19px !important;
	font-weight: bold !important;
	line-height: 1.4 !important;
	text-align: center !important;

	cursor: pointer !important;
	pointer-events: none !important;

	z-index: 3000004 !important;
}


.painting-popup-text {
	position: relative !important;

	display: block !important;

	width: auto !important;
	height: auto !important;

	margin: 0 !important;
	padding: 0 !important;

	color: #ffffff !important;

	font-family: Arial, sans-serif !important;
	font-size: 19px !important;
	font-weight: bold !important;
	line-height: 1.4 !important;
	text-align: center !important;

	pointer-events: none !important;

	z-index: 2 !important;
}


/* =========================================================
   REMOVE GLOBAL ROOM EFFECTS FROM POPUP MESSAGE
   ========================================================= */

.room-screen tw-hook[name="paintingpopupmessage"],
.room-screen tw-hook[name="paintingpopupmessage"]:hover,
.room-screen tw-hook[name="paintingpopupmessage"]:focus,
.room-screen tw-hook[name="paintingpopupmessage"]:focus-within {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
}


.room-screen tw-hook[name="paintingpopupmessage"]::after,
.room-screen tw-hook[name="paintingpopupmessage"]:hover::after {
	content: none !important;
	display: none !important;
	opacity: 0 !important;
	visibility: hidden !important;
}


/* Remove visible styling from any Harlowe wrapper */

.room-screen tw-hook[name="paintingpopupmessage"] > tw-enchantment,
.room-screen tw-hook[name="paintingpopupmessage"] > tw-enchantment:hover,
.room-screen tw-hook[name="paintingpopupmessage"] > tw-enchantment:focus {
	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	outline-offset: 0 !important;
	box-shadow: none !important;
	text-decoration: none !important;
}


/* =========================================================
   DEDICATED INVISIBLE POPUP CLOSE LAYER

   This directly mirrors drawerpopupclose.
   ========================================================= */

.room-screen .painting-popup-layer
tw-hook[name="paintingpopupclose"] {
	position: fixed !important;
	inset: 0 !important;

	display: block !important;

	width: 100vw !important;
	height: 100vh !important;

	margin: 0 !important;
	padding: 0 !important;

	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	font-size: 0 !important;
	line-height: 0 !important;

	pointer-events: none !important;

	z-index: 3000010 !important;
}


/* Only turn the close hook on when the close area exists */

.room-screen .painting-popup-layer
tw-hook[name="paintingpopupclose"]:has(.painting-popup-close-area) {
	pointer-events: auto !important;
	cursor: pointer !important;
}


/* Fullscreen Harlowe click wrapper */

.room-screen .painting-popup-layer
tw-hook[name="paintingpopupclose"] > tw-enchantment {
	position: fixed !important;
	inset: 0 !important;

	display: block !important;

	width: 100vw !important;
	height: 100vh !important;

	margin: 0 !important;
	padding: 0 !important;

	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	font-size: 0 !important;
	line-height: 0 !important;

	pointer-events: auto !important;
	cursor: pointer !important;

	z-index: 3000011 !important;
}


/* Invisible content which activates the close hook */

.painting-popup-close-area {
	position: fixed !important;
	inset: 0 !important;

	display: block !important;

	width: 100vw !important;
	height: 100vh !important;

	margin: 0 !important;
	padding: 0 !important;

	background: transparent !important;
	border: 0 !important;
	outline: 0 !important;
	box-shadow: none !important;

	font-size: 0 !important;
	line-height: 0 !important;

	pointer-events: none !important;
}


/* Remove normal room label from close hook */

.room-screen tw-hook[name="paintingpopupclose"]::after,
.room-screen tw-hook[name="paintingpopupclose"]:hover::after {
	content: none !important;
	display: none !important;
	opacity: 0 !important;
	visibility: hidden !important;
}


/* =========================================================
   SMALL SCREENS
   ========================================================= */

@media screen and (max-width: 700px) {

	.painting-popup-message {
		min-width: 0 !important;
		max-width: calc(100vw - 60px) !important;

