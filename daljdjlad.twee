:: Calculate Creature Attack {"position":"13100,0","size":"100,100"}
<!-- =========================================================
     SHARED CREATURE ATTACK CALCULATION

     Before displaying this passage, set:

     $AttackCard to the creature being calculated
     $AttackSide to either "player" or "enemy"

     The result is stored in:

     $CalculatedAttack
     ========================================================= -->

(set:$CalculatedAttack to 0)


(if:(datanames:$AttackCard)'s length > 0)[

	<!-- BEGIN WITH THE CREATURE'S STORED ATTACK -->

	(set:$CalculatedAttack to
		$AttackCard's "damage"
	)


	<!-- =====================================================
	     GNOME WARRIOR

	     Attack equals the number of friendly Gnomes currently
	     on the board, including this creature.
	     ===================================================== -->

	(if:$AttackCard's "effect" is "gnome-warrior")[

		(set:$CalculatedAttack to 0)


		(if:$AttackSide is "player")[

			(for:each _lane,...(range:1,3))[

				(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[

					(set:_friendlyCreature to
						$PlayerBoard's (_lane)
					)

					(if:_friendlyCreature's "tribe" is "Gnome")[

						(set:$CalculatedAttack to
							$CalculatedAttack + 1
						)

					]

				]

			]

		]


		(else-if:$AttackSide is "enemy")[

			(for:each _lane,...(range:1,3))[

				(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[

					(set:_friendlyCreature to
						$EnemyBoard's (_lane)
					)

					(if:_friendlyCreature's "tribe" is "Gnome")[

						(set:$CalculatedAttack to
							$CalculatedAttack + 1
						)

					]

				]

			]

		]

	]


	<!-- =====================================================
	     HEDGEHOG KNIGHT

	     Attack equals the number of friendly Gnomes that have
	     died during this battle.
	     ===================================================== -->

	(else-if:$AttackCard's "effect" is "hedgehog-knight")[

		(if:$AttackSide is "player")[

			(set:$CalculatedAttack to
				$PlayerGnomesDied
			)

		]


		(else-if:$AttackSide is "enemy")[

			(set:$CalculatedAttack to
				$EnemyGnomesDied
			)

		]

	]


	<!-- =====================================================
	     GRUFFALLO

	     Attack is fixed when the creature enters play, using
	     the owner's missing hero Health at that moment.

	     Its stored Damage is therefore already the correct
	     value here and needs no additional calculation.
	     ===================================================== -->

	(else-if:$AttackCard's "effect" is "gruffallo-missing-health-stats")[

		(set:$CalculatedAttack to
			$AttackCard's "damage"
		)

	]

]


<!-- ATTACK CAN NEVER BE BELOW ZERO -->

(set:$CalculatedAttack to
	(max:0,$CalculatedAttack)
)



:: Call out to the voice [PanelLeft Eggs] {"position":"225,5325","size":"100,100"}
