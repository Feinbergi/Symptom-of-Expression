:: StoryScript [script]
/*MUSIC ON MUSE POSING*/
(function () {
  if (window.twineBGM) return;

  const audio = document.createElement("audio");
  audio.id = "bgm";
  audio.preload = "auto";
  audio.volume = 0.5;

  audio.src = audio.src = "https://dl.dropboxusercontent.com/scl/fi/suamovwpup5jm77ec3k95/Flock.m4a?rlkey=tv16hul4oe7kqfm9sqsbo3903";


  document.body.appendChild(audio);
  window.twineBGM = audio;
})();


/* COD MUSIC */
(function () {
  if (window.twineCOD) return;

  const audio = document.createElement("audio");
  audio.id = "codmusic";
  audio.preload = "auto";
  audio.volume = 0.1;
  audio.loop = true;   // <-- makes it loop

  audio.src = "https://dl.dropboxusercontent.com/scl/fi/vf0j66gfax6hlepupwizn/CoD-music.m4a?rlkey=7lnjilegwps7fvdtfr797ahke";

  document.body.appendChild(audio);
  window.twineCOD = audio;
})();

/* MENU MUSIC */
(function () {
  if (window.twineMenu) return;

  const audio = document.createElement("audio");
  audio.id = "menumusic";
  audio.preload = "auto";
  audio.volume = 0.35;
  audio.loop = true;

  audio.src = "https://dl.dropboxusercontent.com/scl/fi/ifxdu4rqtu3uuxsmn0zfy/Office-Menu.m4a?rlkey=mr116qb8p72b6t1q4sbklg3lt";

  document.body.appendChild(audio);
  window.twineMenu = audio;
})();

/* OFFICE TUTORIAL ANTHEM */
(function () {
  if (window.twineOfficeAnthem) return;

  const audio = document.createElement("audio");
  audio.id = "officeanthem";
  audio.preload = "auto";
  audio.volume = 0.35;
  audio.loop = true;

  audio.src = "https://www.dropbox.com/scl/fi/h5w9d7iuq0nfj7j5n8p8b/office-game-24_07_2026-15.40.m4a?rlkey=9ia80v5x4nqzvbks4acrlnywk&raw=1";

  document.body.appendChild(audio);
  window.twineOfficeAnthem = audio;
})();


































/* REVOLVER GUNSHOT SOUND */
(function () {
  if (window.revolverGunshot_SETUP) return;
  window.revolverGunshot_SETUP = true;

  const GUNSHOT_SRC =
  "https://dl.dropboxusercontent.com/scl/fi/q8jijkud93veu28e1nhu8/Revolver.mp3?rlkey=d7kj1s50appw6oly6j4wurpvn";

  const POOL_SIZE = 3;
  const VOLUME = 0.65;

  const pool = [];
  let idx = 0;

  for (let i = 0; i < POOL_SIZE; i++) {
    const audio = document.createElement("audio");
    audio.preload = "auto";
    audio.src = GUNSHOT_SRC;
    audio.volume = VOLUME;
    audio.playsInline = true;
    document.body.appendChild(audio);
    pool.push(audio);
  }

  window.playRevolverGunshot = function () {
    const audio = pool[idx];
    idx = (idx + 1) % pool.length;

    try {
      audio.currentTime = 0;

      const playPromise = audio.play();

      if (
        playPromise &&
        typeof playPromise.catch === "function"
      ) {
        playPromise.catch(() => {});
      }
    } catch (_) {}
  };
})();

























/*PANEL LEFT FIX FOR HUD OVERLAY*/
(function () {
  if (window.HUD_GLOBAL_SETUP) return;
  window.HUD_GLOBAL_SETUP = true;

  const hud = document.createElement("div");
  hud.id = "HUD_GLOBAL";
  document.body.appendChild(hud);

  function getLastHudDataHook() {
    const nodes = document.querySelectorAll(
      'tw-hook[name="HUDDATA"], tw-hook[hookname="HUDDATA"], tw-hook[name="huddata"], tw-hook[hookname="huddata"]'
    );
    return nodes.length ? nodes[nodes.length - 1] : null;
  }

  function readUrlsFromDom() {
    const data = getLastHudDataHook();
    if (!data) return [];

    const items = data.querySelectorAll(
      'tw-hook[name="HUDITEM"], tw-hook[hookname="HUDITEM"], tw-hook[name="huditem"], tw-hook[hookname="huditem"]'
    );

    return [...items]
      .map((el) => el.textContent.trim())
      .filter(Boolean);
  }

  let scheduled = false;
  function render() {
    if (scheduled) return;
    scheduled = true;

    requestAnimationFrame(() => {
      scheduled = false;

      const urls = readUrlsFromDom();
      hud.innerHTML = "";

      for (const src of urls) {
        const d = document.createElement("div");
        d.className = "hudPortrait";
        d.style.backgroundImage = `url("${src}")`;
        hud.appendChild(d);
      }
    });
  }

  const story = document.querySelector("tw-story");
  if (story) {
    const obs = new MutationObserver(render);
    obs.observe(story, { childList: true, subtree: true });
  }

  render();
})();




























/* HP FIXED OVERLAY (bottom-right, above portraits) */
(function () {
  if (window.HP_GLOBAL_SETUP) return;
  window.HP_GLOBAL_SETUP = true;

  const hp = document.createElement("div");
  hp.id = "HP_GLOBAL";
  document.body.appendChild(hp);

  function getLastHpDataHook() {
    const nodes = document.querySelectorAll(
      'tw-hook[name="HPDATA"], tw-hook[hookname="HPDATA"], tw-hook[name="hpdata"], tw-hook[hookname="hpdata"]'
    );
    return nodes.length ? nodes[nodes.length - 1] : null;
  }

  function readHpFromDom() {
    const data = getLastHpDataHook();
    if (!data) return null;

    const hpValEl = data.querySelector('tw-hook[name="HPVAL"], tw-hook[hookname="HPVAL"], tw-hook[name="hpval"], tw-hook[hookname="hpval"]');
    const hpMaxEl = data.querySelector('tw-hook[name="HPMAX"], tw-hook[hookname="HPMAX"], tw-hook[name="hpmax"], tw-hook[hookname="hpmax"]');
    const hpPctEl = data.querySelector('tw-hook[name="HPPCT"], tw-hook[hookname="HPPCT"], tw-hook[name="hppct"], tw-hook[hookname="hppct"]');

    if (!hpValEl || !hpMaxEl || !hpPctEl) return null;

    const HP = parseInt(hpValEl.textContent.trim(), 10);
    const MaxHP = parseInt(hpMaxEl.textContent.trim(), 10);
    const HPpct = parseInt(hpPctEl.textContent.trim(), 10);

    if (!Number.isFinite(HP) || !Number.isFinite(MaxHP) || !Number.isFinite(HPpct)) return null;

    return { HP, MaxHP, HPpct };
  }

  let scheduled = false;
  function render() {
    if (scheduled) return;
    scheduled = true;

    requestAnimationFrame(() => {
      scheduled = false;

      const d = readHpFromDom();
      if (!d) {
        hp.innerHTML = "";
        return;
      }

      hp.innerHTML = `
        <div class="hpRow">
          <div class="hpText">HP: ${d.HP}/${d.MaxHP}</div>
        </div>
        <div class="hpBox"><div class="hpFill"></div></div>
      `;

      const fill = hp.querySelector(".hpFill");
      if (fill) fill.style.width = `${Math.max(0, Math.min(100, d.HPpct))}%`;
    });
  }

  const story = document.querySelector("tw-story");
  if (story) {
    const obs = new MutationObserver(render);
    obs.observe(story, { childList: true, subtree: true });
  }

  render();
})();















/* UI BORDER */
(function () {
  if (window.twineUIBorder) return;

  const img = document.createElement("img");
  img.id = "uiBorder";
  img.src = "https://i.ibb.co/sJmLrCPB/Chat-GPT-Image-Mar-17-2026-at-03-02-25-PM-3-2.png";
  img.style.position = "fixed";
  img.style.top = "0";
  img.style.left = "0";
  img.style.width = "100vw";
  img.style.height = "100vh";
  img.style.objectFit = "fill";
  img.style.pointerEvents = "none";
  img.style.zIndex = "9999";
  img.style.display = "none";

  document.body.appendChild(img);
  window.twineUIBorder = img;
})();






