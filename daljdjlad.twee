(set:_hasSelectedCard to false)

(if:(datanames:$SelectedCard)'s length > 0)[
	(set:_hasSelectedCard to true)
]


(set:_selectedCardType to "")
(set:_selectedCardEffect to "")
(set:_selectedCardDefinitionID to "")
(set:_selectedCardTribe to "")


(if:_hasSelectedCard)[

