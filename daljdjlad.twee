		and _chaseMoveFound is false
	)[
		(if: _enemyMoves contains "UP")[
			(set: _enemyMove to "UP")
			(set: _chaseMoveFound to true)
		]
	]

	(if:
		$MazeEnemy3X is $MazeEnemy3LastSeenX
		and
		$MazeEnemy3Y is $MazeEnemy3LastSeenY
	)[

		(if:
			$MazeEnemy3LastMove is "RIGHT"
			and _enemyMoves contains "RIGHT"
		)[
			(set: _enemyMove to "RIGHT")
		]

		(else-if:
			$MazeEnemy3LastMove is "LEFT"
			and _enemyMoves contains "LEFT"
		)[
			(set: _enemyMove to "LEFT")
		]

		(else-if:
			$MazeEnemy3LastMove is "DOWN"
			and _enemyMoves contains "DOWN"
		)[
			(set: _enemyMove to "DOWN")
		]

		(else-if:
			$MazeEnemy3LastMove is "UP"
			and _enemyMoves contains "UP"
		)[
			(set: _enemyMove to "UP")
		]

		(else-if: _enemyMoves's length > 0)[
			(set: _enemyMove to _enemyMoves's (random:1,_enemyMoves's length))
		]

	]

]


(if: _enemyMove is "RIGHT")[
	(set: $MazeEnemy3X to $MazeEnemy3X + 1)
	(set: $MazeEnemy3LastMove to "RIGHT")
]

(else-if: _enemyMove is "LEFT")[
	(set: $MazeEnemy3X to $MazeEnemy3X - 1)
	(set: $MazeEnemy3LastMove to "LEFT")
]

(else-if: _enemyMove is "DOWN")[
