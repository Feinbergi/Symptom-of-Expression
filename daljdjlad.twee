:: Create Runtime Card {"position":"13500,0","size":"100,100"}
<!-- =========================================================
     CREATE A FRESH RUNTIME CARD
     ========================================================= -->

(set:$CreatedCard to (dm:))
(set:$CreateSucceeded to false)
(set:$CreateMessage to "")

(if:$CreateDefinitionID is "")[
	(set:$CreateMessage to "No card definition was supplied.")
]

(else-if:not ($CardData contains $CreateDefinitionID))[
	(set:$CreateMessage to
		"The card definition '" +
		$CreateDefinitionID +
		"' does not exist."
	)
]

(else:)[
	(set:_template to $CardData's ($CreateDefinitionID))
	(set:_sidePrefix to "Generated")

	(if:$CreateSide is "player")[
		(set:_sidePrefix to "PlayerGenerated")
	]
	(else-if:$CreateSide is "enemy")[
		(set:_sidePrefix to "EnemyGenerated")
	]

	(set:_newRuntimeID to
		_sidePrefix + "-" + (str:$NextRuntimeCardID)
	)
	(set:$NextRuntimeCardID to $NextRuntimeCardID + 1)

	(set:$CreatedCard to (dm:
		"id",_newRuntimeID,
		"definitionID",_template's "definitionID",
		"name",_template's "name",
		"type",_template's "type",
		"tribe",_template's "tribe",
		"cost",_template's "cost",
		"baseDamage",_template's "baseDamage",
		"damage",_template's "baseDamage",
		"baseMaxHP",_template's "baseMaxHP",
		"maxHP",_template's "baseMaxHP",
		"hp",_template's "baseMaxHP",
		"effect",_template's "effect",
		"targetType",_template's "targetType",
		"battlecry",_template's "battlecry",
		"deathrattle",_template's "deathrattle",
		"turnStart",_template's "turnStart",
		"turnEnd",_template's "turnEnd",
		"damagedTrigger",_template's "damagedTrigger",
		"friendlyDeathTrigger",_template's "friendlyDeathTrigger",
		"continuousEffect",_template's "continuousEffect",
		"keywords",_template's "keywords",
		"resetOnDeckReturn",_template's "resetOnDeckReturn",
		"description",_template's "description",
		"attackBonus",0,
		"healthBonus",0,
		"temporaryDamage",0,
		"temporaryMaxHP",0,
		"silenced",false,
		"ready",false,
		"canInitiateCombat",false,
		"poison",0
	))

	(set:$CreateSucceeded to true)
]



:: Creature Took Damage {"position":"13500,100","size":"100,100"}
<!-- =========================================================
     CREATURE TOOK DAMAGE

     INPUTS

     $DamagedCreatureSide
         "player" or "enemy"

     $DamagedCreatureLane
         The lane containing the creature that was damaged.

     $DamageActuallyDealt
         The amount of Health actually removed by this damage event.

     OUTPUT

     $DamageTriggerMessage
         Text generated by damaged triggers.

     RULES

     - A damaged trigger occurs once per damage event.
     - The amount of damage does not create multiple triggers.
     - The trigger resolves before dead creatures are removed.
     - Therefore, lethal damage still triggers Shipwreck.
     - Shipwreck adds a newly generated Oyster to its owner's hand.
     - Maximum hand size is 12.
     - If the hand is full, no Oyster is created.
     ========================================================= -->

(set:$DamageTriggerMessage to "")

(set:_damageTriggerBoard to
	(a:)
)

(set:_validDamageTriggerSide to false)


<!-- =========================================================
     LOAD THE CORRECT BOARD
     ========================================================= -->

(if:$DamagedCreatureSide is "player")[

	(set:_damageTriggerBoard to
		$PlayerBoard
	)

	(set:_validDamageTriggerSide to true)

]


(else-if:$DamagedCreatureSide is "enemy")[

	(set:_damageTriggerBoard to
		$EnemyBoard
	)

	(set:_validDamageTriggerSide to true)

]


<!-- =========================================================
     VALIDATE THE DAMAGE EVENT
     ========================================================= -->

(if:
	_validDamageTriggerSide and
	$DamageActuallyDealt > 0 and
	$DamagedCreatureLane >= 1 and
	$DamagedCreatureLane <= 3
)[

	(if:(datanames:_damageTriggerBoard's ($DamagedCreatureLane))'s length > 0)[

		(set:_damagedCreature to
			_damageTriggerBoard's ($DamagedCreatureLane)
		)


		<!-- =================================================
		     SHIPWRECK

		     Add one Oyster per damage event, including lethal
		     damage. A full hand prevents the Oyster from being
		     created.
		     ================================================= -->

		(if:
			_damagedCreature's "damagedTrigger" is
			"create-oyster-when-damaged"
		)[

			(if:$DamagedCreatureSide is "player")[

				(if:$PlayerHand's length < 12)[

					(set:$CreateDefinitionID to
						"oyster"
					)

					(set:$CreateSide to
						"player"
					)

					(display:"Create Runtime Card")

					(if:$CreateSucceeded)[

						(set:$PlayerHand to
							$PlayerHand +
							(a:$CreatedCard)
						)

						(set:$DamageTriggerMessage to
							"Shipwreck was damaged and added an Oyster to your hand. "
						)

					]

					(else:)[

						(set:$DamageTriggerMessage to
							"Shipwreck was damaged, but its Oyster could not be created. "
						)

					]

				]


				(else:)[

					(set:$DamageTriggerMessage to
						"Shipwreck was damaged, but your hand was full, so no Oyster was added. "
					)

				]

			]


			(else-if:$DamagedCreatureSide is "enemy")[

				(if:$EnemyHand's length < 12)[

					(set:$CreateDefinitionID to
						"oyster"
					)

					(set:$CreateSide to
						"enemy"
					)

					(display:"Create Runtime Card")

					(if:$CreateSucceeded)[

						(set:$EnemyHand to
							$EnemyHand +
							(a:$CreatedCard)
						)

						(set:$DamageTriggerMessage to
							"The enemy Shipwreck was damaged and added an Oyster to the enemy hand. "
						)

					]

					(else:)[

						(set:$DamageTriggerMessage to
							"The enemy Shipwreck was damaged, but its Oyster could not be created. "
						)

					]

				]


				(else:)[

					(set:$DamageTriggerMessage to
						"The enemy Shipwreck was damaged, but the enemy hand was full, so no Oyster was added. "
					)

				]

			]

		]


		<!-- =================================================
		     BIG TOP
		     ================================================= -->

		(else-if:
			_damagedCreature's "damagedTrigger" is
			"draw-card-when-damaged"
		)[

			(if:$DamagedCreatureSide is "player")[

				(if:$PlayerHand's length < 12)[
					(set:$DrawSide to "player")
					(display:"Draw Card")
					(set:$DamageTriggerMessage to
						"Big Top was damaged. " + $DrawMessage + " "
					)
				]
				(else:)[
					(set:$DamageTriggerMessage to
						"Big Top was damaged, but your hand was full, so you could not draw a card. "
					)
				]
			]

			(else-if:$DamagedCreatureSide is "enemy")[

				(if:$EnemyHand's length < 12)[
					(set:$DrawSide to "enemy")
					(display:"Draw Card")
					(set:$DamageTriggerMessage to
						"The enemy Big Top was damaged. " + $DrawMessage + " "
					)
				]
				(else:)[
					(set:$DamageTriggerMessage to
						"The enemy Big Top was damaged, but the enemy hand was full, so it could not draw a card. "
					)
				]
			]

		]

	]

]



