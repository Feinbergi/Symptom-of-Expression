:: Resolve Battlecry {"position":"13300,0","size":"100,100"}
<!-- =========================================================
     GENERIC BATTLECRY RESOLUTION
     ========================================================= -->

(set:$TriggerMessage to "")

(if:(datanames:$TriggerCard)'s length > 0)[
	(set:_battlecryID to $TriggerCard's "battlecry")

	(if:
		_battlecryID is "" or
		_battlecryID is "none"
	)[
	]

	(else-if:_battlecryID is "add-two-oysters")[
		(set:_oystersAdded to 0)

		(for:each _creationAttempt,...(range:1,2))[
			(if:$TriggerSide is "player")[
				(if:$PlayerHand's length < 12)[
					(set:$CreateDefinitionID to "oyster")
					(set:$CreateSide to "player")
					(display:"Create Runtime Card")
					(if:$CreateSucceeded)[
						(set:$PlayerHand to $PlayerHand + (a:$CreatedCard))
						(set:_oystersAdded to _oystersAdded + 1)
					]
				]
			]
			(else-if:$TriggerSide is "enemy")[
				(if:$EnemyHand's length < 12)[
					(set:$CreateDefinitionID to "oyster")
					(set:$CreateSide to "enemy")
					(display:"Create Runtime Card")
					(if:$CreateSucceeded)[
						(set:$EnemyHand to $EnemyHand + (a:$CreatedCard))
						(set:_oystersAdded to _oystersAdded + 1)
					]
				]
			]
		]

		(if:$TriggerSide is "player")[
			(set:$TriggerMessage to
				$TriggerCard's "name" +
				" added " +
				(str:_oystersAdded) +
				" Oysters to your hand. "
			)
		]
		(else:)[
			(set:$TriggerMessage to
				$TriggerCard's "name" +
				" added " +
				(str:_oystersAdded) +
				" Oysters to the enemy hand. "
			)
		]
	]

	(else-if:_battlecryID is "consume-adjacent-food")[
		(set:_walrusGrowth to 0)
		(set:_foodsConsumed to 0)
		(set:_walrusMessage to "")
		(set:_leftLane to $TriggerLane - 1)
		(set:_rightLane to $TriggerLane + 1)

		(if:_leftLane >= 1)[
			(set:$ConsumeSide to $TriggerSide)
			(set:$ConsumeLane to _leftLane)
			(set:$ConsumerLane to $TriggerLane)
			(set:$ConsumerDefinitionID to "walrus")
			(display:"Consume Friendly Food")

			(if:$ConsumeSucceeded)[
				(set:_foodsConsumed to _foodsConsumed + 1)
				(set:_walrusGrowth to _walrusGrowth + $ConsumedFoodValue)
				(set:_walrusMessage to _walrusMessage + $ConsumeMessage)
			]
		]

		(if:_rightLane <= 3)[
			(set:$ConsumeSide to $TriggerSide)
			(set:$ConsumeLane to _rightLane)
			(set:$ConsumerLane to $TriggerLane)
			(set:$ConsumerDefinitionID to "walrus")
			(display:"Consume Friendly Food")

			(if:$ConsumeSucceeded)[
				(set:_foodsConsumed to _foodsConsumed + 1)
				(set:_walrusGrowth to _walrusGrowth + $ConsumedFoodValue)
				(set:_walrusMessage to _walrusMessage + $ConsumeMessage)
			]
		]

		(if:_walrusGrowth > 0)[
			(if:$TriggerSide is "player")[
				(if:(datanames:$PlayerBoard's ($TriggerLane))'s length > 0)[
					(set:$PlayerBoard's ($TriggerLane)'s "maxHP" to
						$PlayerBoard's ($TriggerLane)'s "maxHP" + _walrusGrowth
					)
					(set:$PlayerBoard's ($TriggerLane)'s "hp" to
						$PlayerBoard's ($TriggerLane)'s "hp" + _walrusGrowth
					)
				]
			]
			(else-if:$TriggerSide is "enemy")[
				(if:(datanames:$EnemyBoard's ($TriggerLane))'s length > 0)[
					(set:$EnemyBoard's ($TriggerLane)'s "maxHP" to
						$EnemyBoard's ($TriggerLane)'s "maxHP" + _walrusGrowth
					)
					(set:$EnemyBoard's ($TriggerLane)'s "hp" to
						$EnemyBoard's ($TriggerLane)'s "hp" + _walrusGrowth
					)
				]
			]

			(set:$TriggerMessage to
				_walrusMessage +
				$TriggerCard's "name" +
				" permanently gained " +
				(str:_walrusGrowth) +
				" maximum Health from consuming " +
				(str:_foodsConsumed) +
				" adjacent Food. "
			)
		]
		(else:)[
			(set:$TriggerMessage to
				$TriggerCard's "name" +
				" found no adjacent Food to consume. "
			)
		]
	]

	(else-if:_battlecryID is "deal-two-to-enemy-creature")[
		(set:_enemyCreatureExists to false)

		(for:each _enemyLane,...(range:1,3))[
			(if:(datanames:$EnemyBoard's (_enemyLane))'s length > 0)[
				(set:_enemyCreatureExists to true)
			]
		]

		(if:$TriggerSide is "player")[
			(if:_enemyCreatureExists)[
				(set:$ClownTargeting to true)
				(set:$ClownSide to "player")
				(set:$ClownLane to $TriggerLane)
				(set:$ClownCardID to $TriggerCard's "id")
				(set:$TriggerMessage to
					"Clown entered play. Choose an enemy creature to take 2 damage. "
				)
			]
			(else:)[
				(set:$TriggerMessage to
					"Clown entered play, but there was no enemy creature to hit. "
				)
			]
		]
		(else:)[
			(set:$TriggerMessage to
				"The enemy Clown requires targeted Battlecry logic that is not enabled for the test AI. "
			)
		]
	]

	(else-if:_battlecryID is "deal-strongest-friendly-beast-damage")[
		(if:$TriggerSide is "player")[
			(set:_strongestFriendlyBeastDamage to 0)

			(for:each _beastLane,...(range:1,3))[
				(if:(datanames:$PlayerBoard's (_beastLane))'s length > 0)[
					(set:_possibleBeast to $PlayerBoard's (_beastLane))

					(if:_possibleBeast's "tribe" is "Beast")[
						(set:_strongestFriendlyBeastDamage to
							(max:
								_strongestFriendlyBeastDamage,
								(max:0,_possibleBeast's "damage")
							)
						)
					]
				]
			]

			(set:$RingmasterTargeting to true)
			(set:$RingmasterSide to "player")
			(set:$RingmasterLane to $TriggerLane)
			(set:$RingmasterCardID to $TriggerCard's "id")
			(set:$RingmasterDamage to _strongestFriendlyBeastDamage)
			(set:$TriggerMessage to
				"Ringmaster entered play. Choose the enemy player or an enemy creature to take " +
				(str:$RingmasterDamage) +
				" damage. "
			)
		]
		(else:)[
			(set:$TriggerMessage to
				"The enemy Ringmaster requires targeted Battlecry logic that is not enabled for the test AI. "
			)
		]
	]

	(else-if:_battlecryID is "sacrifice-another-friendly-draw-health")[
		(if:$TriggerSide is "player")[
			(set:$JudasTargeting to true)
			(set:$JudasSide to "player")
			(set:$JudasLane to $TriggerLane)
			(set:$JudasCardID to $TriggerCard's "id")
			(set:$TriggerMessage to
				"Judas entered play. Choose another friendly creature to sacrifice. "
			)
		]
		(else:)[
			(set:$TriggerMessage to
				"The enemy Judas requires targeted Battlecry logic that is not enabled for the test AI. "
			)
		]
	]
]



:: Resolve Clown Battlecry Target {"position":"13400,250","size":"100,100"}
<!-- =========================================================
     RESOLVE CLOWN BATTLECRY TARGET
     ========================================================= -->

(set:$ClownMessage to "")

(if:not $ClownTargeting)[
	(set:$ClownMessage to "Clown is not waiting for a target.")
]

(else-if:
	$SelectedTargetSide is not "enemy" or
	$SelectedTargetType is not "creature" or
	$SelectedTargetLane < 1 or
	$SelectedTargetLane > 3 or
	(datanames:$EnemyBoard's ($SelectedTargetLane))'s length is 0
)[
	(set:$ClownMessage to "Choose an enemy creature for Clown's Battlecry.")
]

(else:)[
	(set:_targetCreature to $EnemyBoard's ($SelectedTargetLane))
	(set:_actualDamage to (min:2,(max:0,_targetCreature's "hp")))

	(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to
		(max:0,_targetCreature's "hp" - 2)
	)

	(set:$ClownMessage to
		"Clown dealt 2 damage to the enemy " +
		_targetCreature's "name" + ". "
	)

	(if:_actualDamage > 0)[
		(set:$DamagedCreatureSide to "enemy")
		(set:$DamagedCreatureLane to $SelectedTargetLane)
		(set:$DamageActuallyDealt to _actualDamage)
		(display:"Creature Took Damage")
		(set:$ClownMessage to $ClownMessage + $DamageTriggerMessage)
	]

	(set:$ClownTargeting to false)
	(set:$ClownSide to "")
	(set:$ClownLane to 0)
	(set:$ClownCardID to "")

	(set:$DeathMessage to "")
	(display:"Resolve Dead Creatures")
	(set:$ClownMessage to $ClownMessage + $DeathMessage)

	(if:$EnemyHP <= 0)[
		(set:$EnemyHP to 0)
		(set:$GameOver to true)
		(set:$Winner to "player")
		(set:$CurrentCardTurn to "")
		(set:$ClownMessage to $ClownMessage + "You defeated the enemy!")
	]
]

(set:$SelectedTargetSide to "")
(set:$SelectedTargetType to "")
(set:$SelectedTargetLane to 0)



:: Resolve Creature Placement {"position":"13200,100","size":"100,100"}
============================================================
PASSAGE: Resolve Creature Placement
============================================================

<!-- =========================================================
     RESOLVE CREATURE PLACEMENT

     GENERIC FOOD RULES

     - Identical Food stacks with identical Food.
     - Different Food cannot stack.
     - A non-Food, non-Object creature may be played onto Food.
       The Food is consumed, its Deathrattle resolves, and the
       new creature takes the lane.
     - Cooking Pot may also be played onto Food. It consumes the
       Food, deals 1 damage to the opposing hero, and takes the lane.
     - Food played onto any non-Food, non-Object creature is consumed.
     - Food played onto Cooking Pot is also consumed.
     - Walrus permanently gains Damage, current Health and
       maximum Health equal to consumed Food's current Health.
     ========================================================= -->

(set:$PlacementSucceeded to false)
(set:$PlacementCardOnBoard to false)
(set:$PlacementMessage to "")

(set:_playedCreature to $PlacementCard)
(set:_playedLane to $PlacementLane)
(set:_targetOccupied to false)

(if:(datanames:$PlayerBoard's (_playedLane))'s length > 0)[
	(set:_targetOccupied to true)
]


<!-- =========================================================
     EMPTY LANE — PLACE NORMALLY
     ========================================================= -->

(if:not _targetOccupied)[

	(set:$PlayerBoard's (_playedLane) to _playedCreature)

	(set:$PlacementSucceeded to true)
	(set:$PlacementCardOnBoard to true)

	(set:$PlacementMessage to
		"You played " +
		_playedCreature's "name" +
		" in Lane " +
		(str:_playedLane) +
		". "
	)


	<!-- FOOD PLAYED BESIDE A WALRUS -->

	(if:_playedCreature's "tribe" is "Food")[

		(set:_consumerWalrusLane to 0)

		(if:_playedLane > 1)[
			(if:(datanames:$PlayerBoard's (_playedLane - 1))'s length > 0)[
				(set:_possibleLeftWalrus to
					$PlayerBoard's (_playedLane - 1)
				)

				(if:_possibleLeftWalrus's "definitionID" is "walrus")[
					(set:_consumerWalrusLane to _playedLane - 1)
				]
			]
		]

		(if:
			_consumerWalrusLane is 0 and
			_playedLane < 3
		)[
			(if:(datanames:$PlayerBoard's (_playedLane + 1))'s length > 0)[
				(set:_possibleRightWalrus to
					$PlayerBoard's (_playedLane + 1)
				)

				(if:_possibleRightWalrus's "definitionID" is "walrus")[
					(set:_consumerWalrusLane to _playedLane + 1)
				]
			]
		]

		(if:_consumerWalrusLane > 0)[

			(set:$ConsumeSide to "player")
			(set:$ConsumeLane to _playedLane)
			(set:$ConsumerLane to _consumerWalrusLane)
			(set:$ConsumerDefinitionID to "walrus")

			(display:"Consume Friendly Food")

			(if:$ConsumeSucceeded)[

				(set:_foodValue to $ConsumedFoodValue)

				(set:$PlayerBoard's (_consumerWalrusLane)'s "damage" to
					$PlayerBoard's (_consumerWalrusLane)'s "damage" +
					_foodValue
				)

				(set:$PlayerBoard's (_consumerWalrusLane)'s "maxHP" to
					$PlayerBoard's (_consumerWalrusLane)'s "maxHP" +
					_foodValue
				)

				(set:$PlayerBoard's (_consumerWalrusLane)'s "hp" to
					$PlayerBoard's (_consumerWalrusLane)'s "hp" +
					_foodValue
				)

				(set:$PlacementCardOnBoard to false)

				(set:$PlacementMessage to
					$PlacementMessage +
					$PlayerBoard's (_consumerWalrusLane)'s "name" +
					" immediately consumed it and permanently gained +" +
					(str:_foodValue) +
					" Damage and +" +
					(str:_foodValue) +
					" maximum Health. " +
					$ConsumeMessage
				)

			]

		]

	]

]


<!-- =========================================================
     OCCUPIED LANE
     ========================================================= -->

(else:)[

	(set:_targetCreature to $PlayerBoard's (_playedLane))


	<!-- =====================================================
	     IDENTICAL FOOD ONTO IDENTICAL FOOD — STACK

	     The stack combines:
	     - stored Damage;
	     - current Health;
	     - maximum Health;
	     - stack count for future scalable Food effects.

	     This is not consumption. No Deathrattle resolves.
	     ===================================================== -->

	(if:
		_playedCreature's "tribe" is "Food" and
		_targetCreature's "tribe" is "Food" and
		_playedCreature's "definitionID" is
		_targetCreature's "definitionID"
	)[

		(set:_addedDamage to
			(max:0,_playedCreature's "damage")
		)

		(set:_addedCurrentHP to
			(max:0,_playedCreature's "hp")
		)

		(set:_addedMaxHP to
			(max:0,_playedCreature's "maxHP")
		)

		(set:_targetStackCount to 1)
		(set:_playedStackCount to 1)

		(if:(datanames:_targetCreature) contains "stackCount")[
			(set:_targetStackCount to
				_targetCreature's "stackCount"
			)
		]

		(if:(datanames:_playedCreature) contains "stackCount")[
			(set:_playedStackCount to
				_playedCreature's "stackCount"
			)
		]

		(set:$PlayerBoard's (_playedLane)'s "damage" to
			$PlayerBoard's (_playedLane)'s "damage" +
			_addedDamage
		)

		(set:$PlayerBoard's (_playedLane)'s "hp" to
			$PlayerBoard's (_playedLane)'s "hp" +
			_addedCurrentHP
		)

		(set:$PlayerBoard's (_playedLane)'s "maxHP" to
			$PlayerBoard's (_playedLane)'s "maxHP" +
			_addedMaxHP
		)

		(set:$PlayerBoard's (_playedLane)'s "stackCount" to
			_targetStackCount +
			_playedStackCount
		)


		<!-- RESET THE MERGED CARD BEFORE RETURNING IT -->

		(if:_playedCreature's "resetOnDeckReturn")[

			(set:_foodTemplate to
				$CardData's (_playedCreature's "definitionID")
			)

			(set:_playedCreature's "damage" to
				_foodTemplate's "baseDamage"
			)

			(set:_playedCreature's "maxHP" to
				_foodTemplate's "baseMaxHP"
			)

			(set:_playedCreature's "hp" to
				_foodTemplate's "baseMaxHP"
			)

		]

		(else:)[
			(set:_playedCreature's "hp" to
				_playedCreature's "maxHP"
			)
		]

		(set:_playedCreature's "attackBonus" to 0)
		(set:_playedCreature's "healthBonus" to 0)
		(set:_playedCreature's "temporaryDamage" to 0)
		(set:_playedCreature's "temporaryMaxHP" to 0)
		(set:_playedCreature's "silenced" to false)
		(set:_playedCreature's "ready" to false)
		(set:_playedCreature's "canInitiateCombat" to false)
		(set:_playedCreature's "stackCount" to 1)

		(set:$PlayerDeck to
			$PlayerDeck +
			(a:_playedCreature)
		)

		(set:$PlacementSucceeded to true)
		(set:$PlacementCardOnBoard to false)

		(set:$PlacementMessage to
			"You stacked " +
			_playedCreature's "name" +
			" onto the matching Food in Lane " +
			(str:_playedLane) +
			". The stack now has " +
			(str:$PlayerBoard's (_playedLane)'s "damage") +
			" Damage, " +
			(str:$PlayerBoard's (_playedLane)'s "hp") +
			"/" +
			(str:$PlayerBoard's (_playedLane)'s "maxHP") +
			" Health, and " +
			(str:$PlayerBoard's (_playedLane)'s "stackCount") +
			" combined copies. No Deathrattle activated. "
		)

	]


	<!-- =====================================================
	     FOOD DIRECTLY ONTO WALRUS
	     ===================================================== -->

	(else-if:
		_playedCreature's "tribe" is "Food" and
		_targetCreature's "definitionID" is "walrus"
	)[

		(set:_walrusCard to _targetCreature)

		(set:$PlayerBoard's (_playedLane) to _playedCreature)

		(set:$ConsumeSide to "player")
		(set:$ConsumeLane to _playedLane)
		(set:$ConsumerLane to _playedLane)
		(set:$ConsumerDefinitionID to "walrus")

		(display:"Consume Friendly Food")

		(set:$PlayerBoard's (_playedLane) to _walrusCard)

		(if:$ConsumeSucceeded)[

			(set:_foodValue to $ConsumedFoodValue)

			(set:$PlayerBoard's (_playedLane)'s "damage" to
				$PlayerBoard's (_playedLane)'s "damage" +
				_foodValue
			)

			(set:$PlayerBoard's (_playedLane)'s "maxHP" to
				$PlayerBoard's (_playedLane)'s "maxHP" +
				_foodValue
			)

			(set:$PlayerBoard's (_playedLane)'s "hp" to
				$PlayerBoard's (_playedLane)'s "hp" +
				_foodValue
			)

			(set:$PlacementSucceeded to true)
			(set:$PlacementCardOnBoard to false)

			(set:$PlacementMessage to
				"You fed " +
				_playedCreature's "name" +
				" directly to " +
				_walrusCard's "name" +
				". It permanently gained +" +
				(str:_foodValue) +
				" Damage and +" +
				(str:_foodValue) +
				" maximum Health. " +
				$ConsumeMessage
			)

		]

	]


	<!-- =====================================================
	     FOOD DIRECTLY ONTO COOKING POT
	     ===================================================== -->

	(else-if:
		_playedCreature's "tribe" is "Food" and
		_targetCreature's "definitionID" is "cooking-pot"
	)[

		(set:_targetPot to _targetCreature)

		(set:$PlayerBoard's (_playedLane) to _playedCreature)

		(set:$ConsumeSide to "player")
		(set:$ConsumeLane to _playedLane)
		(set:$ConsumerLane to _playedLane)
		(set:$ConsumerDefinitionID to "cooking-pot")

		(display:"Consume Friendly Food")

		(set:$PlayerBoard's (_playedLane) to _targetPot)

		(if:$ConsumeSucceeded)[

			(set:$PlacementSucceeded to true)
			(set:$PlacementCardOnBoard to false)

			(set:$PlacementMessage to
				"You placed " +
				_playedCreature's "name" +
				" into Cooking Pot. It was consumed. " +
				$ConsumeMessage
			)

		]

	]


	<!-- =====================================================
	     FOOD DIRECTLY ONTO A NON-FOOD, NON-OBJECT CREATURE

	     The existing creature consumes the Food and remains in
	     the lane. Walrus is handled above so it can also gain its
	     unique permanent growth.
	     ===================================================== -->

	(else-if:
		_playedCreature's "tribe" is "Food" and
		_targetCreature's "tribe" is not "Food" and
		_targetCreature's "tribe" is not "Object"
	)[

		(set:_consumerCreature to _targetCreature)

		(set:$PlayerBoard's (_playedLane) to _playedCreature)

		(set:$ConsumeSide to "player")
		(set:$ConsumeLane to _playedLane)
		(set:$ConsumerLane to _playedLane)
		(set:$ConsumerDefinitionID to
			_consumerCreature's "definitionID"
		)

		(display:"Consume Friendly Food")

		(set:$PlayerBoard's (_playedLane) to _consumerCreature)

		(if:$ConsumeSucceeded)[

			(set:$PlacementSucceeded to true)
			(set:$PlacementCardOnBoard to false)

			(set:$PlacementMessage to
				"You fed " +
				_playedCreature's "name" +
				" to " +
				_consumerCreature's "name" +
				". The Food was consumed and " +
				_consumerCreature's "name" +
				" remained in the lane. " +
				$ConsumeMessage
			)

		]

	]


	<!-- =====================================================
	     CREATURE OR COOKING POT ONTO FOOD

	     This is the generic consume-and-replace rule.

	     Walrus receives its unique permanent growth after the
	     shared consumption has resolved.

	     Cooking Pot is the only Object allowed to use this rule.
	     Its 1 damage effect resolves inside Consume Friendly Food.
	     ===================================================== -->

	(else-if:
		(_playedCreature's "tribe" is not "Food") and
		(
			(_playedCreature's "tribe" is not "Object") or
			(_playedCreature's "definitionID" is "cooking-pot")
		) and
		(_targetCreature's "tribe" is "Food")
	)[

		(set:$ConsumeSide to "player")
		(set:$ConsumeLane to _playedLane)
		(set:$ConsumerLane to _playedLane)
		(set:$ConsumerDefinitionID to
			_playedCreature's "definitionID"
		)

		(display:"Consume Friendly Food")

		(if:$ConsumeSucceeded)[

			(set:_foodValue to $ConsumedFoodValue)

			(if:_playedCreature's "definitionID" is "walrus")[

				(set:_playedCreature's "damage" to
					_playedCreature's "damage" +
					_foodValue
				)

				(set:_playedCreature's "maxHP" to
					_playedCreature's "maxHP" +
					_foodValue
				)

				(set:_playedCreature's "hp" to
					_playedCreature's "hp" +
					_foodValue
				)

			]

			(set:$PlayerBoard's (_playedLane) to _playedCreature)

			(set:$PlacementSucceeded to true)
			(set:$PlacementCardOnBoard to true)

			(if:_playedCreature's "definitionID" is "walrus")[

				(set:$PlacementMessage to
					"You played " +
					_playedCreature's "name" +
					" directly onto " +
					_targetCreature's "name" +
					". It consumed the Food and permanently gained +" +
					(str:_foodValue) +
					" Damage and +" +
					(str:_foodValue) +
					" maximum Health. " +
					$ConsumeMessage
				)

			]

			(else-if:_playedCreature's "definitionID" is "cooking-pot")[

				(set:$PlacementMessage to
					"You played Cooking Pot onto " +
					_targetCreature's "name" +
					". Cooking Pot consumed the Food and took its lane. " +
					$ConsumeMessage
				)

			]

			(else:)[

				(set:$PlacementMessage to
					"You played " +
					_playedCreature's "name" +
					" onto " +
					_targetCreature's "name" +
					". The Food was consumed and the new creature took its lane. " +
					$ConsumeMessage
				)

			]

		]

	]


	<!-- DIFFERENT FOOD, OBJECTS, AND OTHER OCCUPIED PLAYS -->

	(else:)[

		(set:$PlacementMessage to
			"That creature cannot be played onto the card occupying this lane."
		)

	]

]


<!-- =========================================================
     GRUFFALLO ENTERS WITH MISSING-HEALTH STATS

     This is intentionally resolved after all placement and
     Food interactions, and only if the played card actually
     remains on the board.
     ========================================================= -->

(if:
	$PlacementSucceeded and
	$PlacementCardOnBoard and
	(datanames:$PlayerBoard's (_playedLane))'s length > 0
)[
	(if:$PlayerBoard's (_playedLane)'s "definitionID" is "gruffallo")[
		(set:_gruffalloValue to
			(max:
				1,
				$PlayerMaxHP - $PlayerHP
			)
		)

		(set:$PlayerBoard's (_playedLane)'s "baseDamage" to
			_gruffalloValue
		)
		(set:$PlayerBoard's (_playedLane)'s "damage" to
			_gruffalloValue
		)
		(set:$PlayerBoard's (_playedLane)'s "baseMaxHP" to
			_gruffalloValue
		)
		(set:$PlayerBoard's (_playedLane)'s "maxHP" to
			_gruffalloValue
		)
		(set:$PlayerBoard's (_playedLane)'s "hp" to
			_gruffalloValue
		)

		(set:$PlacementMessage to
			$PlacementMessage +
			"Gruffallo entered as a " +
			(str:_gruffalloValue) +
			"/" +
			(str:_gruffalloValue) +
			". "
		)
	]
]




:: Resolve Dead Creatures {"position":"13200,0","size":"100,100"}
<!-- =========================================================
     SHARED DEATH RESOLUTION
     ========================================================= -->


<!-- RESOLVE DEAD PLAYER CREATURES -->

(for:each _lane,...(range:1,3))[
	(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[
		(set:_deadCreature to $PlayerBoard's (_lane))

		(if:_deadCreature's "hp" <= 0)[
			(set:_deadName to _deadCreature's "name")
			(set:_deadID to _deadCreature's "id")

			(if:_deadCreature's "tribe" is "Gnome")[
				(set:$PlayerGnomesDied to $PlayerGnomesDied + 1)
			]

			<!-- FRIENDLY DEATH TRIGGERS -->
			(for:each _observerLane,...(range:1,3))[
				(if:(datanames:$PlayerBoard's (_observerLane))'s length > 0)[
					(set:_observer to $PlayerBoard's (_observerLane))

					(if:
						_observer's "id" is not _deadID and
						_observer's "hp" > 0
					)[
						(if:
							_observer's "friendlyDeathTrigger" is "king-gnome-growth" and
							_deadCreature's "tribe" is "Gnome"
						)[
							(set:$PlayerBoard's (_observerLane)'s "damage" to _observer's "damage" + 1)
							(set:$PlayerBoard's (_observerLane)'s "maxHP" to _observer's "maxHP" + 1)
							(set:$PlayerBoard's (_observerLane)'s "hp" to _observer's "hp" + 1)
							(set:$DeathMessage to $DeathMessage + "King Gnome grew stronger. ")
						]

						(else-if:
							_observer's "friendlyDeathTrigger" is
							"grow-when-another-friendly-creature-dies"
						)[
							(set:$PlayerBoard's (_observerLane)'s "damage" to _observer's "damage" + 1)
							(set:$PlayerBoard's (_observerLane)'s "maxHP" to _observer's "maxHP" + 1)
							(set:$PlayerBoard's (_observerLane)'s "hp" to _observer's "hp" + 1)
							(set:$DeathMessage to
								$DeathMessage +
								("" + _observer's "name" + " permanently gained +1/+1. ")
							)
						]
					]
				]
			]


			<!-- DITCH DRAWS WHEN ANOTHER CREATURE DIES -->

			(for:each _ditchLane,...(range:1,3))[
				(if:(datanames:$PlayerBoard's (_ditchLane))'s length > 0)[
					(set:_ditchObserver to $PlayerBoard's (_ditchLane))
					(if:
						_ditchObserver's "id" is not _deadID and
						_ditchObserver's "hp" > 0 and
						_ditchObserver's "definitionID" is "ditch"
					)[
						(set:$DrawSide to "player")
						(display:"Draw Card")
						(set:$DeathMessage to
							$DeathMessage +
							"Ditch witnessed " +
							_deadName +
							" die. " +
							$DrawMessage +
							" "
						)
					]
				]
			]

			(for:each _ditchLane,...(range:1,3))[
				(if:(datanames:$EnemyBoard's (_ditchLane))'s length > 0)[
					(set:_ditchObserver to $EnemyBoard's (_ditchLane))
					(if:
						_ditchObserver's "id" is not _deadID and
						_ditchObserver's "hp" > 0 and
						_ditchObserver's "definitionID" is "ditch"
					)[
						(set:$DrawSide to "enemy")
						(display:"Draw Card")
						(set:$DeathMessage to
							$DeathMessage +
							"The enemy Ditch witnessed " +
							_deadName +
							" die. " +
							$DrawMessage +
							" "
						)
					]
				]
			]


			(set:$TriggerCard to _deadCreature)
			(set:$TriggerSide to "player")
			(set:$TriggerLane to _lane)
			(set:$TriggerMessage to "")
			(display:"Resolve Deathrattle")
			(set:$DeathMessage to $DeathMessage + $TriggerMessage)

			(set:$PlayerBoard's (_lane) to (dm:))

			<!-- MONKEY RETURNS TO HAND -->
			(if:_deadCreature's "definitionID" is "monkey")[
				(set:_template to $CardData's "monkey")
				(set:_deadCreature's "damage" to _template's "baseDamage")
				(set:_deadCreature's "maxHP" to _template's "baseMaxHP")
				(set:_deadCreature's "hp" to _template's "baseMaxHP")
				(set:_deadCreature's "poison" to 0)
				(set:_deadCreature's "attackBonus" to 0)
				(set:_deadCreature's "healthBonus" to 0)
				(set:_deadCreature's "temporaryDamage" to 0)
				(set:_deadCreature's "temporaryMaxHP" to 0)
				(set:_deadCreature's "silenced" to false)
				(set:_deadCreature's "ready" to false)
				(set:_deadCreature's "canInitiateCombat" to false)

				(if:$TriggerSide is "player")[
					(if:$PlayerHand's length < 12)[
						(set:$PlayerHand to $PlayerHand + (a:_deadCreature))
					]
					(else:)[
						(set:$PlayerDeck to $PlayerDeck + (a:_deadCreature))
						(set:$DeathMessage to $DeathMessage + "Your hand was full, so Monkey returned to the bottom of your deck. ")
					]
				]
				(else:)[
					(if:$EnemyHand's length < 12)[
						(set:$EnemyHand to $EnemyHand + (a:_deadCreature))
					]
					(else:)[
						(set:$EnemyDeck to $EnemyDeck + (a:_deadCreature))
						(set:$DeathMessage to $DeathMessage + "The enemy hand was full, so Monkey returned to the bottom of the enemy deck. ")
					]
				]
			]

			<!-- JESUS RETURNS TO HAND WITH PERMANENT GROWTH -->
			(else-if:_deadCreature's "definitionID" is "jesus")[
				(set:_deadCreature's "damage" to _deadCreature's "damage" + 1)
				(set:_deadCreature's "maxHP" to _deadCreature's "maxHP" + 1)
				(set:_deadCreature's "hp" to _deadCreature's "maxHP")
				(set:_deadCreature's "poison" to 0)
				(set:_deadCreature's "attackBonus" to 0)
				(set:_deadCreature's "healthBonus" to 0)
				(set:_deadCreature's "temporaryDamage" to 0)
				(set:_deadCreature's "temporaryMaxHP" to 0)
				(set:_deadCreature's "silenced" to false)
				(set:_deadCreature's "ready" to false)
				(set:_deadCreature's "canInitiateCombat" to false)

				(if:$PlayerHand's length < 12)[
					(set:$PlayerHand to $PlayerHand + (a:_deadCreature))
					(set:$DeathMessage to
						$DeathMessage +
						_deadName +
						" returned to your hand. "
					)
				]
				(else:)[
					(set:$PlayerDeck to $PlayerDeck + (a:_deadCreature))
					(set:$DeathMessage to
						$DeathMessage +
						_deadName +
						" could not enter your hand, so it returned to the bottom of your deck. "
					)
				]
			]

			(else:)[
				(if:_deadCreature's "resetOnDeckReturn")[
					(set:_template to $CardData's (_deadCreature's "definitionID"))
					(set:_deadCreature's "name" to _template's "name")
					(set:_deadCreature's "type" to _template's "type")
					(set:_deadCreature's "tribe" to _template's "tribe")
					(set:_deadCreature's "cost" to _template's "cost")
					(set:_deadCreature's "baseDamage" to _template's "baseDamage")
					(set:_deadCreature's "damage" to _template's "baseDamage")
					(set:_deadCreature's "baseMaxHP" to _template's "baseMaxHP")
					(set:_deadCreature's "maxHP" to _template's "baseMaxHP")
					(set:_deadCreature's "hp" to _template's "baseMaxHP")
					(set:_deadCreature's "effect" to _template's "effect")
					(set:_deadCreature's "targetType" to _template's "targetType")
					(set:_deadCreature's "battlecry" to _template's "battlecry")
					(set:_deadCreature's "deathrattle" to _template's "deathrattle")
					(set:_deadCreature's "turnStart" to _template's "turnStart")
					(set:_deadCreature's "turnEnd" to _template's "turnEnd")
					(set:_deadCreature's "damagedTrigger" to _template's "damagedTrigger")
					(set:_deadCreature's "friendlyDeathTrigger" to _template's "friendlyDeathTrigger")
					(set:_deadCreature's "continuousEffect" to _template's "continuousEffect")
					(set:_deadCreature's "keywords" to _template's "keywords")
					(set:_deadCreature's "description" to _template's "description")
				]
				(else:)[
					(set:_deadCreature's "hp" to _deadCreature's "maxHP")
				]

				(set:_deadCreature's "poison" to 0)
				(set:_deadCreature's "attackBonus" to 0)
				(set:_deadCreature's "healthBonus" to 0)
				(set:_deadCreature's "temporaryDamage" to 0)
				(set:_deadCreature's "temporaryMaxHP" to 0)
				(set:_deadCreature's "silenced" to false)
				(set:_deadCreature's "ready" to false)
				(set:_deadCreature's "canInitiateCombat" to false)

				(set:$PlayerDeck to $PlayerDeck + (a:_deadCreature))
				(set:$DeathMessage to
					$DeathMessage +
					_deadName +
					" was defeated and returned to the bottom of your deck. "
				)
			]
		]
	]
]

<!-- RESOLVE DEAD ENEMY CREATURES -->

(for:each _lane,...(range:1,3))[
	(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[
		(set:_deadCreature to $EnemyBoard's (_lane))

		(if:_deadCreature's "hp" <= 0)[
			(set:_deadName to _deadCreature's "name")
			(set:_deadID to _deadCreature's "id")

			(if:_deadCreature's "tribe" is "Gnome")[
				(set:$EnemyGnomesDied to $EnemyGnomesDied + 1)
			]

			<!-- FRIENDLY DEATH TRIGGERS -->
			(for:each _observerLane,...(range:1,3))[
				(if:(datanames:$EnemyBoard's (_observerLane))'s length > 0)[
					(set:_observer to $EnemyBoard's (_observerLane))

					(if:
						_observer's "id" is not _deadID and
						_observer's "hp" > 0
					)[
						(if:
							_observer's "friendlyDeathTrigger" is "king-gnome-growth" and
							_deadCreature's "tribe" is "Gnome"
						)[
							(set:$EnemyBoard's (_observerLane)'s "damage" to _observer's "damage" + 1)
							(set:$EnemyBoard's (_observerLane)'s "maxHP" to _observer's "maxHP" + 1)
							(set:$EnemyBoard's (_observerLane)'s "hp" to _observer's "hp" + 1)
							(set:$DeathMessage to $DeathMessage + "The enemy King Gnome grew stronger. ")
						]

						(else-if:
							_observer's "friendlyDeathTrigger" is
							"grow-when-another-friendly-creature-dies"
						)[
							(set:$EnemyBoard's (_observerLane)'s "damage" to _observer's "damage" + 1)
							(set:$EnemyBoard's (_observerLane)'s "maxHP" to _observer's "maxHP" + 1)
							(set:$EnemyBoard's (_observerLane)'s "hp" to _observer's "hp" + 1)
							(set:$DeathMessage to
								$DeathMessage +
								("The enemy " + _observer's "name" + " permanently gained +1/+1. ")
							)
						]
					]
				]
			]


			<!-- DITCH DRAWS WHEN ANOTHER CREATURE DIES -->

			(for:each _ditchLane,...(range:1,3))[
				(if:(datanames:$PlayerBoard's (_ditchLane))'s length > 0)[
					(set:_ditchObserver to $PlayerBoard's (_ditchLane))
					(if:
						_ditchObserver's "id" is not _deadID and
						_ditchObserver's "hp" > 0 and
						_ditchObserver's "definitionID" is "ditch"
					)[
						(set:$DrawSide to "player")
						(display:"Draw Card")
						(set:$DeathMessage to
							$DeathMessage +
							"Ditch witnessed " +
							_deadName +
							" die. " +
							$DrawMessage +
							" "
						)
					]
				]
			]

			(for:each _ditchLane,...(range:1,3))[
				(if:(datanames:$EnemyBoard's (_ditchLane))'s length > 0)[
					(set:_ditchObserver to $EnemyBoard's (_ditchLane))
					(if:
						_ditchObserver's "id" is not _deadID and
						_ditchObserver's "hp" > 0 and
						_ditchObserver's "definitionID" is "ditch"
					)[
						(set:$DrawSide to "enemy")
						(display:"Draw Card")
						(set:$DeathMessage to
							$DeathMessage +
							"The enemy Ditch witnessed " +
							_deadName +
							" die. " +
							$DrawMessage +
							" "
						)
					]
				]
			]


			(set:$TriggerCard to _deadCreature)
			(set:$TriggerSide to "enemy")
			(set:$TriggerLane to _lane)
			(set:$TriggerMessage to "")
			(display:"Resolve Deathrattle")
			(set:$DeathMessage to $DeathMessage + $TriggerMessage)

			(set:$EnemyBoard's (_lane) to (dm:))

			<!-- MONKEY RETURNS TO HAND -->
			(if:_deadCreature's "definitionID" is "monkey")[
				(set:_template to $CardData's "monkey")
				(set:_deadCreature's "damage" to _template's "baseDamage")
				(set:_deadCreature's "maxHP" to _template's "baseMaxHP")
				(set:_deadCreature's "hp" to _template's "baseMaxHP")
				(set:_deadCreature's "poison" to 0)
				(set:_deadCreature's "attackBonus" to 0)
				(set:_deadCreature's "healthBonus" to 0)
				(set:_deadCreature's "temporaryDamage" to 0)
				(set:_deadCreature's "temporaryMaxHP" to 0)
				(set:_deadCreature's "silenced" to false)
				(set:_deadCreature's "ready" to false)
				(set:_deadCreature's "canInitiateCombat" to false)

				(if:$TriggerSide is "player")[
					(if:$PlayerHand's length < 12)[
						(set:$PlayerHand to $PlayerHand + (a:_deadCreature))
					]
					(else:)[
						(set:$PlayerDeck to $PlayerDeck + (a:_deadCreature))
						(set:$DeathMessage to $DeathMessage + "Your hand was full, so Monkey returned to the bottom of your deck. ")
					]
				]
				(else:)[
					(if:$EnemyHand's length < 12)[
						(set:$EnemyHand to $EnemyHand + (a:_deadCreature))
					]
					(else:)[
						(set:$EnemyDeck to $EnemyDeck + (a:_deadCreature))
						(set:$DeathMessage to $DeathMessage + "The enemy hand was full, so Monkey returned to the bottom of the enemy deck. ")
					]
				]
			]

			<!-- JESUS RETURNS TO HAND WITH PERMANENT GROWTH -->
			(else-if:_deadCreature's "definitionID" is "jesus")[
				(set:_deadCreature's "damage" to _deadCreature's "damage" + 1)
				(set:_deadCreature's "maxHP" to _deadCreature's "maxHP" + 1)
				(set:_deadCreature's "hp" to _deadCreature's "maxHP")
				(set:_deadCreature's "poison" to 0)
				(set:_deadCreature's "attackBonus" to 0)
				(set:_deadCreature's "healthBonus" to 0)
				(set:_deadCreature's "temporaryDamage" to 0)
				(set:_deadCreature's "temporaryMaxHP" to 0)
				(set:_deadCreature's "silenced" to false)
				(set:_deadCreature's "ready" to false)
				(set:_deadCreature's "canInitiateCombat" to false)

				(if:$EnemyHand's length < 12)[
					(set:$EnemyHand to $EnemyHand + (a:_deadCreature))
					(set:$DeathMessage to
						$DeathMessage +
						_deadName +
						" returned to the enemy hand. "
					)
				]
				(else:)[
					(set:$EnemyDeck to $EnemyDeck + (a:_deadCreature))
					(set:$DeathMessage to
						$DeathMessage +
						_deadName +
						" could not enter the enemy hand, so it returned to the bottom of the enemy deck. "
					)
				]
			]

			(else:)[
				(if:_deadCreature's "resetOnDeckReturn")[
					(set:_template to $CardData's (_deadCreature's "definitionID"))
					(set:_deadCreature's "name" to _template's "name")
					(set:_deadCreature's "type" to _template's "type")
					(set:_deadCreature's "tribe" to _template's "tribe")
					(set:_deadCreature's "cost" to _template's "cost")
					(set:_deadCreature's "baseDamage" to _template's "baseDamage")
					(set:_deadCreature's "damage" to _template's "baseDamage")
					(set:_deadCreature's "baseMaxHP" to _template's "baseMaxHP")
					(set:_deadCreature's "maxHP" to _template's "baseMaxHP")
					(set:_deadCreature's "hp" to _template's "baseMaxHP")
					(set:_deadCreature's "effect" to _template's "effect")
					(set:_deadCreature's "targetType" to _template's "targetType")
					(set:_deadCreature's "battlecry" to _template's "battlecry")
					(set:_deadCreature's "deathrattle" to _template's "deathrattle")
					(set:_deadCreature's "turnStart" to _template's "turnStart")
					(set:_deadCreature's "turnEnd" to _template's "turnEnd")
					(set:_deadCreature's "damagedTrigger" to _template's "damagedTrigger")
					(set:_deadCreature's "friendlyDeathTrigger" to _template's "friendlyDeathTrigger")
					(set:_deadCreature's "continuousEffect" to _template's "continuousEffect")
					(set:_deadCreature's "keywords" to _template's "keywords")
					(set:_deadCreature's "description" to _template's "description")
				]
				(else:)[
					(set:_deadCreature's "hp" to _deadCreature's "maxHP")
				]

				(set:_deadCreature's "poison" to 0)
				(set:_deadCreature's "attackBonus" to 0)
				(set:_deadCreature's "healthBonus" to 0)
				(set:_deadCreature's "temporaryDamage" to 0)
				(set:_deadCreature's "temporaryMaxHP" to 0)
				(set:_deadCreature's "silenced" to false)
				(set:_deadCreature's "ready" to false)
				(set:_deadCreature's "canInitiateCombat" to false)

				(set:$EnemyDeck to $EnemyDeck + (a:_deadCreature))
				(set:$DeathMessage to
					$DeathMessage +
					_deadName +
					" was defeated and returned to the bottom of the enemy deck. "
				)
			]
		]
	]
]



:: Resolve Deathrattle {"position":"13400,0","size":"100,100"}
<!-- =========================================================
     GENERIC DEATHRATTLE RESOLUTION
     ========================================================= -->

(set:$TriggerMessage to "")

(if:(datanames:$TriggerCard)'s length > 0)[
	(set:_deathrattleID to $TriggerCard's "deathrattle")

	(if:
		_deathrattleID is "" or
		_deathrattleID is "none"
	)[
	]

	(else-if:_deathrattleID is "restore-owner-equal-food-value")[
		(set:_healingAmount to (max:0,$TriggerCard's "maxHP"))

		(if:$TriggerSide is "player")[
			(set:_healthBefore to $PlayerHP)
			(set:$PlayerHP to
				(min:$PlayerMaxHP,$PlayerHP + _healingAmount)
			)
			(set:_actualHealing to $PlayerHP - _healthBefore)

			(if:_actualHealing > 0)[
				(set:$TriggerMessage to
					$TriggerCard's "name" +
					"'s Deathrattle restored " +
					(str:_actualHealing) +
					" Health to you. "
				)
			]
			(else:)[
				(set:$TriggerMessage to
					$TriggerCard's "name" +
					"'s Deathrattle activated, but you were already at full Health. "
				)
			]
		]

		(else-if:$TriggerSide is "enemy")[
			(set:_healthBefore to $EnemyHP)
			(set:$EnemyHP to
				(min:$EnemyMaxHP,$EnemyHP + _healingAmount)
			)
			(set:_actualHealing to $EnemyHP - _healthBefore)

			(if:_actualHealing > 0)[
				(set:$TriggerMessage to
					$TriggerCard's "name" +
					"'s Deathrattle restored " +
					(str:_actualHealing) +
					" Health to the enemy. "
				)
			]
			(else:)[
				(set:$TriggerMessage to
					$TriggerCard's "name" +
					"'s Deathrattle activated, but the enemy was already at full Health. "
				)
			]
		]
	]

	(else-if:_deathrattleID is "return-to-owner-hand")[
		(set:$TriggerMessage to
			$TriggerCard's "name" +
			"'s Deathrattle returned it to its owner's hand. "
		)
	]

	(else-if:_deathrattleID is "return-to-hand-with-permanent-growth")[
		(set:$TriggerMessage to
			$TriggerCard's "name" +
			" rose again with permanent +1 Attack and +1 Maximum Health. "
		)
	]
]



:: Resolve Judas Battlecry Target {"position":"13300,250","size":"100,100"}
<!-- =========================================================
     RESOLVE JUDAS BATTLECRY TARGET

     INPUT: $SelectedTargetLane set by Card Game UI.
     ========================================================= -->

(set:$JudasMessage to "")

(if:not $JudasTargeting)[
	(set:$JudasMessage to "Judas is not waiting for a target. ")
]

(else-if:$JudasSide is not "player")[
	(set:$JudasMessage to "Only player Judas targeting is currently supported. ")
]

(else-if:
	$SelectedTargetLane < 1 or
	$SelectedTargetLane > 3
)[
	(set:$JudasMessage to "Choose another friendly creature. ")
]

(else-if:$SelectedTargetLane is $JudasLane)[
	(set:$JudasMessage to "Judas cannot sacrifice himself. ")
]

(else-if:(datanames:$PlayerBoard's ($SelectedTargetLane))'s length is 0)[
	(set:$JudasMessage to "There is no friendly creature in that lane. ")
]

(else:)[
	(set:_judasVictim to $PlayerBoard's ($SelectedTargetLane))
	(set:_judasVictimName to _judasVictim's "name")
	(set:_judasDrawsRequested to (max:0,_judasVictim's "hp"))

	(set:$SacrificeSide to "player")
	(set:$SacrificeLane to $SelectedTargetLane)
	(display:"Sacrifice Creature")

	(if:$SacrificeSucceeded)[
		(set:_judasCardsDrawn to 0)
		(set:_judasDrawMessage to "")

		(if:_judasDrawsRequested > 0)[
			(for:each _drawAttempt,...(range:1,_judasDrawsRequested))[
				(set:$DrawSide to "player")
				(display:"Draw Card")

				(if:$DrawSucceeded)[
					(set:_judasCardsDrawn to _judasCardsDrawn + 1)
				]

				(set:_judasDrawMessage to
					_judasDrawMessage +
					$DrawMessage +
					" "
				)
			]
		]

		(set:$JudasMessage to
			"Judas sacrificed " +
			_judasVictimName +
			". " +
			$SacrificeMessage +
			"Judas attempted to draw " +
			(str:_judasDrawsRequested) +
			" cards and successfully drew " +
			(str:_judasCardsDrawn) +
			". " +
			_judasDrawMessage
		)

		(set:$JudasTargeting to false)
		(set:$JudasSide to "")
		(set:$JudasLane to 0)
		(set:$JudasCardID to "")
	]
]



:: Resolve Next Up Choice {"position":"13600,250","size":"100,100"}
<!-- =========================================================
     RESOLVE NEXT UP! CREATURE CHOICE

     Before displaying this passage, set:

     $NextUpChoiceCardID

     The chosen runtime creature is removed from the deck and
     placed into the player's hand. The used Next Up! spell then
     returns to the bottom of the deck.
     ========================================================= -->

(set:$NextUpMessage to "")
(set:_chosenCreatureFound to false)
(set:_chosenCreature to (dm:))
(set:_rebuiltDeck to (a:))

(if:not $NextUpTargeting)[

	(set:$NextUpMessage to
		"There is no unresolved Next Up! search."
	)

]

(else:)[

	(for:each _deckCard,...$PlayerDeck)[

		(if:
			not _chosenCreatureFound and
			_deckCard's "id" is $NextUpChoiceCardID and
			_deckCard's "type" is "creature"
		)[

			(set:_chosenCreatureFound to true)
			(set:_chosenCreature to _deckCard)

		]

		(else:)[

			(set:_rebuiltDeck to
				_rebuiltDeck +
				(a:_deckCard)
			)

		]

	]


	(if:not _chosenCreatureFound)[

		(set:$NextUpMessage to
			"That creature is no longer available in your deck."
		)

	]


	(else:)[

		(if:$PlayerHand's length < 12)[

			(set:$PlayerDeck to _rebuiltDeck)

			(set:$PlayerHand to
				$PlayerHand +
				(a:_chosenCreature)
			)

			(set:$PlayerDeck to
				$PlayerDeck +
				(a:$NextUpSpellCard)
			)

			(set:$NextUpMessage to
				"Next Up! found " +
				_chosenCreature's "name" +
				" and put it into your hand. Next Up! returned to the bottom of your deck."
			)

			(set:$NextUpTargeting to false)
			(set:$NextUpSpellCard to (dm:))
			(set:$NextUpChoiceCardID to "")

			(set:$SelectedCard to (dm:))
			(set:$TargetLane to 0)
			(set:$SelectedTargetSide to "")
			(set:$SelectedTargetType to "")
			(set:$SelectedTargetLane to 0)

		]


		(else:)[

			(set:$NextUpMessage to
				"Your hand became full before the chosen creature could be added."
			)

		]

	]

]


:: Resolve Poison {"position":"13200,200","size":"100,100"}
<!-- =========================================================
     RESOLVE POISON AT START OF A SIDE'S TURN

     INPUT: $PoisonSide = "player" or "enemy"
     OUTPUT: $PoisonMessage
     ========================================================= -->

(set:$PoisonMessage to "")

(if:$PoisonSide is "player")[
	(if:$PlayerPoison > 0)[
		(set:$PlayerHP to (max:0,$PlayerHP - 1))
		(set:$PlayerPoison to $PlayerPoison - 1)
		(set:$PoisonMessage to
			$PoisonMessage +
			"You took 1 Poison damage. "
		)
	]

	(for:each _lane,...(range:1,3))[
		(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[
			(set:_poisonedCreature to $PlayerBoard's (_lane))

			(if:_poisonedCreature's "poison" > 0)[
				(set:_actualPoisonDamage to
					(min:1,(max:0,_poisonedCreature's "hp"))
				)
				(set:$PlayerBoard's (_lane)'s "hp" to
					_poisonedCreature's "hp" - 1
				)
				(set:$PlayerBoard's (_lane)'s "poison" to
					_poisonedCreature's "poison" - 1
				)

				(if:_actualPoisonDamage > 0)[
					(set:$DamagedCreatureSide to "player")
					(set:$DamagedCreatureLane to _lane)
					(set:$DamageActuallyDealt to _actualPoisonDamage)
					(display:"Creature Took Damage")
					(set:$PoisonMessage to
						$PoisonMessage +
						_poisonedCreature's "name" +
						" took 1 Poison damage. " +
						$DamageTriggerMessage
					)
				]
			]
		]
	]
]

(else-if:$PoisonSide is "enemy")[
	(if:$EnemyPoison > 0)[
		(set:$EnemyHP to (max:0,$EnemyHP - 1))
		(set:$EnemyPoison to $EnemyPoison - 1)
		(set:$PoisonMessage to
			$PoisonMessage +
			"The enemy took 1 Poison damage. "
		)
	]

	(for:each _lane,...(range:1,3))[
		(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[
			(set:_poisonedCreature to $EnemyBoard's (_lane))

			(if:_poisonedCreature's "poison" > 0)[
				(set:_actualPoisonDamage to
					(min:1,(max:0,_poisonedCreature's "hp"))
				)
				(set:$EnemyBoard's (_lane)'s "hp" to
					_poisonedCreature's "hp" - 1
				)
				(set:$EnemyBoard's (_lane)'s "poison" to
					_poisonedCreature's "poison" - 1
				)

				(if:_actualPoisonDamage > 0)[
					(set:$DamagedCreatureSide to "enemy")
					(set:$DamagedCreatureLane to _lane)
					(set:$DamageActuallyDealt to _actualPoisonDamage)
					(display:"Creature Took Damage")
					(set:$PoisonMessage to
						$PoisonMessage +
						"The enemy " +
						_poisonedCreature's "name" +
						" took 1 Poison damage. " +
						$DamageTriggerMessage
					)
				]
			]
		]
	]
]

(set:$DeathMessage to "")
(display:"Resolve Dead Creatures")
(set:$PoisonMessage to $PoisonMessage + $DeathMessage)

(if:$PlayerHP <= 0)[
	(set:$PlayerHP to 0)
	(set:$GameOver to true)
	(set:$Winner to "enemy")
	(set:$CurrentCardTurn to "")
]

(else-if:$EnemyHP <= 0)[
	(set:$EnemyHP to 0)
	(set:$GameOver to true)
	(set:$Winner to "player")
	(set:$CurrentCardTurn to "")
]



:: Resolve Ringmaster Battlecry Target {"position":"13500,250","size":"100,100"}
<!-- =========================================================
     RESOLVE RINGMASTER BATTLECRY TARGET
     ========================================================= -->

(set:$RingmasterMessage to "")

(if:not $RingmasterTargeting)[
	(set:$RingmasterMessage to "Ringmaster is not waiting for a target.")
]

(else-if:
	$SelectedTargetSide is not "enemy" or
	(
		$SelectedTargetType is not "creature" and
		$SelectedTargetType is not "player"
	)
)[
	(set:$RingmasterMessage to
		"Choose the enemy player or an enemy creature for Ringmaster's Battlecry."
	)
]

(else-if:$SelectedTargetType is "creature" and (
	$SelectedTargetLane < 1 or
	$SelectedTargetLane > 3 or
	(datanames:$EnemyBoard's ($SelectedTargetLane))'s length is 0
))[
	(set:$RingmasterMessage to "Choose an enemy creature that is currently on the board.")
]

(else:)[
	(set:_ringmasterDamage to (max:0,$RingmasterDamage))

	(if:$SelectedTargetType is "player")[
		(set:_actualDamage to (min:_ringmasterDamage,(max:0,$EnemyHP)))
		(set:$EnemyHP to (max:0,$EnemyHP - _ringmasterDamage))
		(set:$RingmasterMessage to
			"Ringmaster dealt " +
			(str:_ringmasterDamage) +
			" damage to the enemy player. "
		)
	]

	(else:)[
		(set:_targetCreature to $EnemyBoard's ($SelectedTargetLane))
		(set:_actualDamage to
			(min:_ringmasterDamage,(max:0,_targetCreature's "hp"))
		)

		(set:$EnemyBoard's ($SelectedTargetLane)'s "hp" to
			(max:0,_targetCreature's "hp" - _ringmasterDamage)
		)

		(set:$RingmasterMessage to
			"Ringmaster dealt " +
			(str:_ringmasterDamage) +
			" damage to the enemy " +
			_targetCreature's "name" +
			". "
		)

		(if:_actualDamage > 0)[
			(set:$DamagedCreatureSide to "enemy")
			(set:$DamagedCreatureLane to $SelectedTargetLane)
			(set:$DamageActuallyDealt to _actualDamage)
			(display:"Creature Took Damage")
			(set:$RingmasterMessage to $RingmasterMessage + $DamageTriggerMessage)
		]

		(set:$DeathMessage to "")
		(display:"Resolve Dead Creatures")
		(set:$RingmasterMessage to $RingmasterMessage + $DeathMessage)
	]

	(set:$RingmasterTargeting to false)
	(set:$RingmasterSide to "")
	(set:$RingmasterLane to 0)
	(set:$RingmasterCardID to "")
	(set:$RingmasterDamage to 0)

	(if:$EnemyHP <= 0)[
		(set:$EnemyHP to 0)
		(set:$GameOver to true)
		(set:$Winner to "player")
		(set:$CurrentCardTurn to "")
		(set:$RingmasterMessage to $RingmasterMessage + "You defeated the enemy!")
	]
]

(set:$SelectedTargetSide to "")
(set:$SelectedTargetType to "")
(set:$SelectedTargetLane to 0)



