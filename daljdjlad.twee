:: Play Creature Logic {"position":"12900,0","size":"100,100"}
============================================================
PASSAGE: Play Creature Logic
============================================================

(set:_hasSelectedCard to false)

(if:(datanames:$SelectedCard)'s length > 0)[
	(set:_hasSelectedCard to true)
]

(if:$JudasTargeting)[
	(set:$CardGameMessage to
		"Resolve Judas's Battlecry before playing another card."
	)
]

(else-if:$ClownTargeting)[
	(set:$CardGameMessage to
		"Resolve Clown's Battlecry before playing another card."
	)
]

(else-if:$RingmasterTargeting)[
	(set:$CardGameMessage to
		"Resolve Ringmaster's Battlecry before playing another card."
	)
]

(else-if:$CurrentCardTurn is not "player")[
	(set:$CardGameMessage to "You cannot play a card during the enemy turn.")
]

(else-if:$GameOver)[
	(set:$CardGameMessage to "The match has already ended.")
]

(else-if:not _hasSelectedCard)[
	(set:$CardGameMessage to "No card has been selected.")
]

(else-if:$SelectedCard's "type" is not "creature")[
	(set:$CardGameMessage to
		$SelectedCard's "name" +
		" is a spell and cannot be placed in a lane."
	)
]

(else-if:$TargetLane < 1 or $TargetLane > 3)[
	(set:$CardGameMessage to "Choose one of your three lanes.")
]

(else-if:$SelectedCard's "cost" > $PlayerMana)[
	(set:$CardGameMessage to
		"You do not have enough Mana to play " +
		$SelectedCard's "name" +
		"."
	)
]

(else:)[
	(set:_playedCard to $SelectedCard)
	(set:_playedCardID to _playedCard's "id")
	(set:_playedLane to $TargetLane)

	(set:_judasHasVictim to true)

	(if:_playedCard's "definitionID" is "judas")[
		(set:_judasHasVictim to false)

		(for:each _checkLane,...(range:1,3))[
			(if:_checkLane is not _playedLane)[
				(if:(datanames:$PlayerBoard's (_checkLane))'s length > 0)[
					(set:_judasHasVictim to true)
				]
			]
		]
	]

	(if:not _judasHasVictim)[
		(set:$CardGameMessage to
			"Judas cannot be played unless another friendly creature is available to sacrifice."
		)
	]

	(else:)[
		(set:_placementIsLegal to false)

		(if:(datanames:$PlayerBoard's (_playedLane))'s length is 0)[
			(set:_placementIsLegal to true)
		]
		(else:)[
			(set:_targetCreature to $PlayerBoard's (_playedLane))

			(if:
				_playedCard's "tribe" is "Food" and
				_targetCreature's "tribe" is "Food" and
				_playedCard's "definitionID" is _targetCreature's "definitionID"
			)[
				(set:_placementIsLegal to true)
			]
			(else-if:
				_playedCard's "tribe" is "Food" and
				(
					(
						_targetCreature's "tribe" is not "Food" and
						_targetCreature's "tribe" is not "Object"
					) or
					_targetCreature's "definitionID" is "cooking-pot"
				)
			)[
				(set:_placementIsLegal to true)
			]
			(else-if:
				(_playedCard's "tribe" is not "Food") and
				(
					(_playedCard's "tribe" is not "Object") or
					(_playedCard's "definitionID" is "cooking-pot")
				) and
				(_targetCreature's "tribe" is "Food")
			)[
				(set:_placementIsLegal to true)
			]
		]

		(if:not _placementIsLegal)[
			(set:$CardGameMessage to
				"That creature cannot be played onto the card occupying this lane."
			)
		]
		(else:)[
			(set:$PlayerMana to $PlayerMana - _playedCard's "cost")

			(set:_rebuiltPlayerHand to (a:))
			(for:each _handCard,...$PlayerHand)[
				(if:_handCard's "id" is not _playedCardID)[
					(set:_rebuiltPlayerHand to
						_rebuiltPlayerHand + (a:_handCard)
					)
				]
			]
			(set:$PlayerHand to _rebuiltPlayerHand)

			(set:_playedCard's "hp" to _playedCard's "maxHP")
			(set:_playedCard's "ready" to false)
			(set:_playedCard's "canInitiateCombat" to false)

			(set:$PlacementCard to _playedCard)
			(set:$PlacementSide to "player")
			(set:$PlacementLane to _playedLane)
			(display:"Resolve Creature Placement")

			(if:$PlacementSucceeded)[
				(set:$CardGameMessage to $PlacementMessage)

				(if:$PlacementCardOnBoard)[
					(set:$TriggerCard to _playedCard)
					(set:$TriggerSide to "player")
					(set:$TriggerLane to _playedLane)
					(set:$TriggerMessage to "")
					(display:"Resolve Battlecry")

					(if:$TriggerMessage is not "")[
						(set:$CardGameMessage to
							$CardGameMessage + " " + $TriggerMessage
						)
					]
				]

				(set:$DeathMessage to "")
				(display:"Resolve Dead Creatures")

				(if:$DeathMessage is not "")[
					(set:$CardGameMessage to
						$CardGameMessage + " " + $DeathMessage
					)
				]

				(if:$EnemyHP <= 0)[
					(set:$EnemyHP to 0)
					(set:$GameOver to true)
					(set:$Winner to "player")
					(set:$CurrentCardTurn to "")
					(set:$CardGameMessage to
						$CardGameMessage + " You defeated the enemy!"
					)
				]
			]
			(else:)[
				(set:$PlayerMana to $PlayerMana + _playedCard's "cost")
				(set:$PlayerHand to $PlayerHand + (a:_playedCard))
				(set:$CardGameMessage to $PlacementMessage)
			]
		]
	]
]

(set:$SelectedCard to (dm:))
(set:$TargetLane to 0)
(set:$SelectedTargetSide to "")
(set:$SelectedTargetType to "")
(set:$SelectedTargetLane to 0)



:: Player End Turn Logic {"position":"12800,0","size":"100,100"}
(set:_combatMessage to "")
(set:_playerInitiatedCombat to false)

(set:_hasSelectedCard to false)

(if:(datanames:$SelectedCard)'s length > 0)[
	(set:_hasSelectedCard to true)
]


<!-- =========================================================
     DO NOT RESOLVE A TURN WHILE TARGETING OR PLACING A CARD
     ========================================================= -->

(if:$JudasTargeting)[

	(set:$CardGameMessage to
		"Choose Judas's sacrifice target before ending the turn."
	)

]

(else-if:$ClownTargeting)[

	(set:$CardGameMessage to
		"Choose Clown's Battlecry target before ending the turn."
	)

]

(else-if:$RingmasterTargeting)[

	(set:$CardGameMessage to
		"Choose Ringmaster's Battlecry target before ending the turn."
	)

]

(else-if:$NextUpTargeting)[

	(set:$CardGameMessage to
		"Choose a creature for Next Up! before ending the turn."
	)

]

(else-if:_hasSelectedCard)[

	(set:$CardGameMessage to
		"Cancel or play your selected card before ending the turn."
	)

]

(else-if:$GameOver)[

	(set:$CardGameMessage to
		"The match has already ended."
	)

]

(else-if:$CurrentCardTurn is not "player")[

	(set:$CardGameMessage to
		"It is not your turn."
	)

]

(else:)[

	<!-- =====================================================
	     SIMULTANEOUS COMBAT STORAGE

	     Food and Objects have their Attack calculated because
	     they may retaliate, but they cannot initiate combat.
	     ===================================================== -->

	(set:_playerAttackSnapshot to
		(a:0,0,0)
	)

	(set:_enemyAttackSnapshot to
		(a:0,0,0)
	)

	(set:_damageToPlayerCreatures to
		(a:0,0,0)
	)

	(set:_damageToEnemyCreatures to
		(a:0,0,0)
	)

	(set:_damageToEnemyHero to 0)

	<!-- DAMAGE DEALT TO THE PLAYER BY GOAT ATTACKS -->

	(set:_damageToPlayerHeroFromGoats to 0)

	(set:_poisonToPlayerCreatures to
		(a:0,0,0)
	)

	(set:_poisonToEnemyCreatures to
		(a:0,0,0)
	)

	(set:_poisonToEnemyHero to 0)


	<!-- =====================================================
	     PHASE 1: SNAPSHOT ALL CURRENT ATTACK VALUES
	     ===================================================== -->

	(for:each _lane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[

			(set:$AttackCard to
				$PlayerBoard's (_lane)
			)

			(set:$AttackSide to
				"player"
			)

			(display:"Calculate Creature Attack")

			(set:_playerAttackSnapshot's (_lane) to
				$CalculatedAttack
			)

		]


		(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[

			(set:$AttackCard to
				$EnemyBoard's (_lane)
			)

			(set:$AttackSide to
				"enemy"
			)

			(display:"Calculate Creature Attack")

			(set:_enemyAttackSnapshot's (_lane) to
				$CalculatedAttack
			)

		]

	]


	<!-- =====================================================
	     PHASE 2: ASSIGN ALL COMBAT DAMAGE
	     ===================================================== -->

	(for:each _lane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[

			(set:_playerCreature to
				$PlayerBoard's (_lane)
			)


			(if:_playerCreature's "canInitiateCombat")[

				(if:_playerCreature's "ready")[

					(if:_playerCreature's "tribe" is not "Food")[

						(if:_playerCreature's "tribe" is not "Object")[

							(set:_playerInitiatedCombat to true)

							(set:_playerDamage to
								_playerAttackSnapshot's (_lane)
							)


							<!-- EMPTY ENEMY LANE -->

							(if:(datanames:$EnemyBoard's (_lane))'s length is 0)[

								(set:_damageToEnemyHero to
									_damageToEnemyHero +
									_playerDamage
								)


								<!-- =========================================
								     GOAT AND BILLY THE GOAT

								     When either creature damages the enemy
								     hero, the player's hero takes the same
								     amount of damage.
								     ========================================= -->

								(if:
									_playerCreature's "effect" is
									"self-damage-when-hitting-enemy-hero" and
									_playerDamage > 0
								)[

									(set:_damageToPlayerHeroFromGoats to
										_damageToPlayerHeroFromGoats +
										_playerDamage
									)

								]


								(if:
									_playerCreature's "definitionID" is
									"leper" and
									_playerDamage > 0
								)[

									(set:_poisonToEnemyHero to
										_poisonToEnemyHero + 1
									)

								]


								(set:_combatMessage to
									_combatMessage +
									_playerCreature's "name" +
									" attacked through Lane " +
									(str:_lane) +
									" and dealt " +
									(str:_playerDamage) +
									" damage to the enemy. "
								)

							]


							<!-- OCCUPIED ENEMY LANE -->

							(else:)[

								(set:_enemyCreature to
									$EnemyBoard's (_lane)
								)

								(set:_enemyDamage to
									_enemyAttackSnapshot's (_lane)
								)

								(set:_damageToEnemyCreatures's (_lane) to
									_damageToEnemyCreatures's (_lane) +
									_playerDamage
								)

								(set:_damageToPlayerCreatures's (_lane) to
									_damageToPlayerCreatures's (_lane) +
									_enemyDamage
								)


								(if:
									_playerCreature's "definitionID" is
									"leper" and
									_playerDamage > 0
								)[

									(set:_poisonToEnemyCreatures's (_lane) to
										_poisonToEnemyCreatures's (_lane) + 1
									)

								]


								(if:
									_enemyCreature's "definitionID" is
									"leper" and
									_enemyDamage > 0
								)[

									(set:_poisonToPlayerCreatures's (_lane) to
										_poisonToPlayerCreatures's (_lane) + 1
									)

								]


								(set:_combatMessage to
									_combatMessage +
									_playerCreature's "name" +
									" and " +
									_enemyCreature's "name" +
									" fought in Lane " +
									(str:_lane) +
									". " +
									_playerCreature's "name" +
									" dealt " +
									(str:_playerDamage) +
									" damage, while " +
									_enemyCreature's "name" +
									" dealt " +
									(str:_enemyDamage) +
									" damage in return. "
								)

							]

						]

					]

				]

			]

		]

	]


	<!-- =====================================================
	     PHASE 3: APPLY ALL STORED DAMAGE AND RESOLVE DAMAGE
	     TRIGGERS BEFORE REMOVING DEAD CREATURES
	     ===================================================== -->

	(set:$EnemyHP to
		(max:
			0,
			$EnemyHP - _damageToEnemyHero
		)
	)

	(set:$EnemyPoison to
		$EnemyPoison + _poisonToEnemyHero
	)


	<!-- =====================================================
	     APPLY GOAT AND BILLY SELF-DAMAGE
	     ===================================================== -->

	(if:_damageToPlayerHeroFromGoats > 0)[

		(set:$PlayerHP to
			(max:
				0,
				$PlayerHP - _damageToPlayerHeroFromGoats
			)
		)

		(set:_combatMessage to
			_combatMessage +
			"Your attacking Goats also dealt " +
			(str:_damageToPlayerHeroFromGoats) +
			" damage to you. "
		)

	]


	<!-- =====================================================
	     APPLY DAMAGE TO CREATURES
	     ===================================================== -->

	(for:each _lane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[

			(set:_playerCreatureBeingDamaged to
				$PlayerBoard's (_lane)
			)

			(set:_storedPlayerCreatureDamage to
				_damageToPlayerCreatures's (_lane)
			)

			(set:_playerCreatureCurrentHP to
				_playerCreatureBeingDamaged's "hp"
			)

			(set:_actualPlayerCreatureDamage to
				(min:
					(max:0,_storedPlayerCreatureDamage),
					(max:0,_playerCreatureCurrentHP)
				)
			)

			(set:_playerCreatureNewHP to
				_playerCreatureCurrentHP -
				_storedPlayerCreatureDamage
			)

			(set:$PlayerBoard's (_lane)'s "hp" to
				_playerCreatureNewHP
			)

			(set:$PlayerBoard's (_lane)'s "poison" to
				$PlayerBoard's (_lane)'s "poison" +
				_poisonToPlayerCreatures's (_lane)
			)


			(if:_actualPlayerCreatureDamage > 0)[

				(set:$DamagedCreatureSide to
					"player"
				)

				(set:$DamagedCreatureLane to
					_lane
				)

				(set:$DamageActuallyDealt to
					_actualPlayerCreatureDamage
				)

				(display:"Creature Took Damage")

				(set:_combatMessage to
					_combatMessage +
					$DamageTriggerMessage
				)

			]

		]


		(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[

			(set:_enemyCreatureBeingDamaged to
				$EnemyBoard's (_lane)
			)

			(set:_storedEnemyCreatureDamage to
				_damageToEnemyCreatures's (_lane)
			)

			(set:_enemyCreatureCurrentHP to
				_enemyCreatureBeingDamaged's "hp"
			)

			(set:_actualEnemyCreatureDamage to
				(min:
					(max:0,_storedEnemyCreatureDamage),
					(max:0,_enemyCreatureCurrentHP)
				)
			)

			(set:_enemyCreatureNewHP to
				_enemyCreatureCurrentHP -
				_storedEnemyCreatureDamage
			)

			(set:$EnemyBoard's (_lane)'s "hp" to
				_enemyCreatureNewHP
			)

			(set:$EnemyBoard's (_lane)'s "poison" to
				$EnemyBoard's (_lane)'s "poison" +
				_poisonToEnemyCreatures's (_lane)
			)


			(if:_actualEnemyCreatureDamage > 0)[

				(set:$DamagedCreatureSide to
					"enemy"
				)

				(set:$DamagedCreatureLane to
					_lane
				)

				(set:$DamageActuallyDealt to
					_actualEnemyCreatureDamage
				)

				(display:"Creature Took Damage")

				(set:_combatMessage to
					_combatMessage +
					$DamageTriggerMessage
				)

			]

		]

	]


	<!-- =====================================================
	     OLD BRIDGE

	     If the player's attacking creature dealt the fatal
	     combat damage to an enemy Old Bridge, that attacking
	     creature is destroyed.
	     ===================================================== -->

	(for:each _lane,...(range:1,3))[

		(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[

			(set:_possibleOldBridge to
				$EnemyBoard's (_lane)
			)

			(if:
				_possibleOldBridge's "definitionID" is "old-bridge" and
				_possibleOldBridge's "hp" <= 0 and
				_damageToEnemyCreatures's (_lane) > 0
			)[

				(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[

					(set:_possibleBridgeAttacker to
						$PlayerBoard's (_lane)
					)

					(if:_possibleBridgeAttacker's "canInitiateCombat")[

						(if:_possibleBridgeAttacker's "ready")[

							(if:_possibleBridgeAttacker's "tribe" is not "Food")[

								(if:_possibleBridgeAttacker's "tribe" is not "Object")[

									(set:$PlayerBoard's (_lane)'s "hp" to 0)

									(set:_combatMessage to
										_combatMessage +
										"Old Bridge collapsed beneath " +
										_possibleBridgeAttacker's "name" +
										", destroying it. "
									)

								]

							]

						]

					]

				]

			]

		]

	]


	<!-- =====================================================
	     TROLL AND GRUFFALLO

	     Surviving Trolls and Gruffallos on either side heal to
	     full after combat resolves.
	     ===================================================== -->

	(for:each _lane,...(range:1,3))[

		(if:(datanames:$PlayerBoard's (_lane))'s length > 0)[

			(set:_playerCombatHealer to
				$PlayerBoard's (_lane)
			)

			(if:_playerCombatHealer's "hp" > 0)[

				(if:
					_playerCombatHealer's "definitionID" is "troll" or
					_playerCombatHealer's "definitionID" is "gruffallo"
				)[

					(if:
						_playerCombatHealer's "hp" <
						_playerCombatHealer's "maxHP"
					)[

						(set:$PlayerBoard's (_lane)'s "hp" to
							_playerCombatHealer's "maxHP"
						)

						(set:_combatMessage to
							_combatMessage +
							_playerCombatHealer's "name" +
							" healed to full Health after combat. "
						)

					]

				]

			]

		]


		(if:(datanames:$EnemyBoard's (_lane))'s length > 0)[

			(set:_enemyCombatHealer to
				$EnemyBoard's (_lane)
			)

			(if:_enemyCombatHealer's "hp" > 0)[

				(if:
					_enemyCombatHealer's "definitionID" is "troll" or
					_enemyCombatHealer's "definitionID" is "gruffallo"
				)[

					(if:
						_enemyCombatHealer's "hp" <
						_enemyCombatHealer's "maxHP"
					)[

						(set:$EnemyBoard's (_lane)'s "hp" to
							_enemyCombatHealer's "maxHP"
						)

						(set:_combatMessage to
							_combatMessage +
							"The enemy " +
							_enemyCombatHealer's "name" +
							" healed to full Health after combat. "
						)

					]

				]

			]

		]

	]


	<!-- =====================================================
	     PHASE 4: RESOLVE ALL COMBAT DEATHS
	     ===================================================== -->

	(set:$DeathMessage to "")

	(display:"Resolve Dead Creatures")

	(set:_combatMessage to
		_combatMessage +
		$DeathMessage
	)


	(if:not _playerInitiatedCombat)[

		(set:_combatMessage to
			_combatMessage +
			"None of your eligible non-Food, non-Object creatures initiated combat. "
		)

	]


	<!-- =====================================================
	     FINISH PLAYER TURN
	     ===================================================== -->

	(set:$PlayerTurnsTaken to
		$PlayerTurnsTaken + 1
	)

	(set:$TotalTurnsTaken to
		$TotalTurnsTaken + 1
	)

	(set:$SelectedCard to
		(dm:)
	)

	(set:$TargetLane to 0)

	(set:$SelectedTargetSide to "")
	(set:$SelectedTargetType to "")
	(set:$SelectedTargetLane to 0)


	<!-- =====================================================
	     CHECK FOR VICTORY OR DEFEAT

	     Enemy defeat is checked first. Therefore, if a Goat
	     attack reduces both heroes to zero, the player wins.
	     ===================================================== -->

	(if:$EnemyHP <= 0)[

		(set:$EnemyHP to 0)
		(set:$GameOver to true)
		(set:$Winner to "player")
		(set:$CurrentCardTurn to "")

		(set:$CardGameMessage to
			_combatMessage +
			"You defeated the enemy!"
		)

	]

	(else-if:$PlayerHP <= 0)[

		(set:$PlayerHP to 0)
		(set:$GameOver to true)
		(set:$Winner to "enemy")
		(set:$CurrentCardTurn to "")

		(set:$CardGameMessage to
			_combatMessage +
			"You were defeated!"
		)

	]

	(else:)[

		(set:$CardGameMessage to
			_combatMessage
		)

		(display:"Enemy Turn Logic")

	]

]


:: PlayerAttack {"position":"7100,4700","size":"100,100"}
(set:$BattleTurn to "Player")
(set:$BattleStage to "Player Attack")
(set:$BattleInputLocked to true)

(set:$PlayerAttackRoll to (max:0,(random:1,20) + $DEX + $DEXBonus + $PlayerBattleDEXPenalty))

(set:$PlayerDamage to 0)
(set:$PlayerAttackHit to false)
(set:$BattlePopup to "")
(set:$BattlePopupType to "")

(set:_damageDie to 4)
(set:_weaponStat to "str")
(set:_damageBonus to 0)
(set:_weaponName to "")
(set:_weaponData to (dm:))

(set:_hotMugAttack to false)
(set:_revolverAttack to false)
(set:_attackCanResolve to true)

(rerun:?battleToolbarHook)
(rerun:?battlePopupHook)

(if:$EquipHands is not "")[
	(set:_weaponName to $EquipHands)
	(set:_weaponData to $ItemData's ($EquipHands))

	(if:(datanames:_weaponData) contains "weaponDamage")[
		(if:_weaponData's "weaponDamage" > 0)[
			(set:_damageDie to _weaponData's "weaponDamage")
		]
	]

	(if:(datanames:_weaponData) contains "weaponStat")[
		(set:_weaponStat to _weaponData's "weaponStat")
	]
]

(if:$EquipHands is "Coffee Mug" and $CoffeeMugHot)[
	(set:_damageDie to 12)
	(set:_hotMugAttack to true)
	(set:$CoffeeMugHot to false)
]

(if:$EquipHands is "Revolver")[
	(if:$RevolverBullets > 0)[
		(set:_revolverAttack to true)
		(set:$RevolverBullets to $RevolverBullets - 1)

		<script>
		if(window.playRevolverGunshot){
			window.playRevolverGunshot();
		}
		</script>
	]
	(else:)[
		(set:_attackCanResolve to false)
		(set:$BattleMessages to (a:
			"You point the Revolver at " + $EnemyName + ".",
			"Click!",
			"The Revolver is empty."
		))
	]
]

(if:($OfficeBoyTalent is true) and (_weaponStat is "str" or _weaponStat is "dex"))[
	(set:_damageBonus to $Officeness + $OfficenessBonus)
]
(else-if:_weaponStat is "dex")[
	(set:_damageBonus to $DEX + $DEXBonus + $PlayerBattleDEXPenalty)
]
(else-if:_weaponStat is "len")[
	(set:_damageBonus to $LEN + $LENBonus)
]
(else-if:_weaponStat is "office")[
	(set:_damageBonus to $Officeness + $OfficenessBonus)
]
(else:)[
	(set:_damageBonus to $STR + $STRBonus + $PlayerBattleSTRPenalty)
]

(if:_attackCanResolve)[
	(if:$PlayerAttackRoll >= $EnemyDEF)[
		(set:$PlayerAttackHit to true)

		(if:_revolverAttack)[
			(set:$PlayerDamage to (max:1,(random:1,6) + (random:1,6) + _damageBonus))
		]
		(else:)[
			(set:$PlayerDamage to (max:1,(random:1,_damageDie) + _damageBonus))
		]

		(if:$EnemyPaperCut)[
			(set:$PlayerDamage to $PlayerDamage + 1)
		]

		(if:_revolverAttack)[
			(set:$BattleMessages to (a:
				"You fire the Revolver at " + $EnemyName + "!",
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"HIT!",
				"The bullet deals " + (str:$PlayerDamage) + " damage to " + $EnemyName + ".",
				"Bullets remaining: " + (str:$RevolverBullets) + "."
			))
		]
		(else-if:_hotMugAttack)[
			(set:$BattleMessages to (a:
				"You throw the mug's scalding water at " + $EnemyName + "!",
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"HIT!",
				"The scalding water deals " + (str:$PlayerDamage) + " damage to " + $EnemyName + ".",
				"The Coffee Mug is now empty."
			))
		]
		(else-if:$EquipHands is "Penis")[
			(set:$BattleMessages to (a:
				"You attack " + $EnemyName + " with your Penis.",
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"HIT!",
				"Your Penis deals " + (str:$PlayerDamage) + " damage to " + $EnemyName + "."
			))
		]
		(else:)[
			(set:$BattleMessages to (a:
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"HIT!",
				"You deal " + (str:$PlayerDamage) + " damage to " + $EnemyName + "."
			))
		]
	]
	(else:)[
		(set:$PlayerAttackHit to false)

		(if:_revolverAttack)[
			(set:$BattleMessages to (a:
				"You fire the Revolver at " + $EnemyName + "!",
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"MISS!",
				"The bullet misses " + $EnemyName + ".",
				"Bullets remaining: " + (str:$RevolverBullets) + "."
			))
		]
		(else-if:_hotMugAttack)[
			(set:$BattleMessages to (a:
				"You throw the mug's scalding water at " + $EnemyName + "!",
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"MISS!",
				"The scalding water misses " + $EnemyName + ".",
				"The Coffee Mug is now empty."
			))
		]
		(else-if:$EquipHands is "Penis")[
			(set:$BattleMessages to (a:
				"You attack " + $EnemyName + " with your Penis.",
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"MISS!",
				"Your Penis misses."
			))
		]
		(else:)[
			(set:$BattleMessages to (a:
				"You roll " + (str:$PlayerAttackRoll) + " against " + $EnemyName + "'s DEF " + (str:$EnemyDEF) + ".",
				"MISS!",
				"Your attack misses."
			))
		]
	]
]

(set:$BattleAdvanceAction to "FinishPlayerAttack")
(display:"BattleShowMessages")


:: Please [PanelLeft Cave] {"position":"325,9100","size":"100,100"}
(text-colour:#d29d00)[Woman: Stop.]

Her voice is sharper now.

(text-colour:#d29d00)[Stop trying to pull me.]

She presses herself harder into the stone.

(text-colour:#d29d00)[Just go.]

A tremor passes through her.

Her voice rises- but only for a breath.

It falters before it can become a scream.

She swallows it.

(text-colour:#d29d00)[Let me be nothing.]

A breath.

(text-colour:#d29d00)[Let me be.]

You understand.

She has chosen.

[[Go|outsidedagger]]

[[Leave your dagger beside her]]


