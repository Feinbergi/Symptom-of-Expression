}

.bullpen-hotspot tw-link {
	border: 0 !important;
	background: transparent !important;
	color: transparent !important;

	font-size: 0 !important;
	line-height: 0 !important;

	cursor: pointer !important;
	text-decoration: none !important;
}


/* Character name label */

.bullpen-hotspot::after {
	content: attr(data-label);

	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);

	width: max-content;
	max-width: 240px;

	padding: 7px 12px;

	border: 1px solid rgba(255, 255, 255, 0.75);
	border-radius: 4px;

	background: rgba(0, 0, 0, 0.88);
	color: #ffffff;

	font-family: Arial, sans-serif;
	font-size: 16px;
	font-weight: bold;
	line-height: 1.2;
	text-align: center;
	white-space: nowrap;

	opacity: 0;
	pointer-events: none;

	transition: opacity 0.12s ease;

	z-index: 200;
}

.bullpen-hotspot:hover::after {
	opacity: 1;
}


/* Slight visible highlight on hover */

.bullpen-hotspot:hover {
	background: transparent;
	outline: none;
}


/* =========================================================
   BULLPEN HOTSPOT POSITIONS
   Based on the 1648 × 928 source image
   ========================================================= */

/* Jennifer */

.photocopier-jennifer {
	left: 0%;
	top: 25.32%;
	width: 15.17%;
	height: 46.34%;
}


/* George */

.george {
	left: 15.47%;
	top: 46.34%;
	width: 21.84%;
	height: 53.66%;
}


/* Jerry */

.jerry {
	left: 25.79%;
	top: 14.55%;
	width: 19.11%;
	height: 38.25%;
}

/* Kitchen */

.bullpenkitchen {
	left: 45.79%;
	top: 9.55%;
	width: 19.11%;
	height: 38.25%;
}


/* Benjamin Walker */

.benjamin-walker {
	left: 64.57%;
	top: 28.02%;
	width: 15.17%;
	height: 50.65%;
}


/* Halley */

.halley {
	left: 79.34%;
	top: 25.86%;
	width: 15.47%;
	height: 54.42%;
}


















































/* Floogiyo — complete fixed one-screen three-lane card-game UI */

/* =========================================================
   FULL-SCREEN GAME SHELL
   ========================================================= */

.lane-game {
	background: #111417;
	box-sizing: border-box;
	color: #f4f4f4;
	display: grid !important;
	font-family: Arial, sans-serif;
	gap: 5px;
	grid-template-rows: 42px 58px minmax(0, 1fr) 158px;
	height: 100vh;
	inset: 0;
	margin: 0;
	overflow: hidden;
	padding: 10px 16px;
	position: fixed;
	width: 100vw;
	z-index: 999;
}

.lane-game *,
.lane-game *::before,
.lane-game *::after {
	box-sizing: border-box;
}

/* =========================================================
   HARLOWE-SPECIFIC LAYOUT PROTECTION
   Scoped entirely to this card game.

   Harlowe wraps (if:), (for:), (display:) and hook output in
   tw-expression / tw-hook elements. Those wrappers must not
   become extra grid or flex children.
   ========================================================= */

/* Remove generated line-break spacer nodes. */

.lane-game br,
.lane-game tw-consecutive-br {
	display: none !important;
}

/* Neutralise structural Harlowe wrappers throughout the UI. */

.lane-game > tw-hook,
.lane-game > tw-expression,

.lane-game .combatant-row > tw-hook,
.lane-game .combatant-row > tw-expression,

.lane-game .combatant-box > tw-hook,
.lane-game .combatant-box > tw-expression,

.lane-game .hud-identity > tw-hook,
.lane-game .hud-identity > tw-expression,

.lane-game .hud-mana > tw-hook,
.lane-game .hud-mana > tw-expression,

.lane-game .mana-row tw-hook,
.lane-game .mana-row tw-expression,

.lane-game .battlefield > tw-hook,
.lane-game .battlefield > tw-expression,

.lane-game .board-half > tw-hook,
.lane-game .board-half > tw-expression,

.lane-game .lane-row tw-hook,
.lane-game .lane-row tw-expression,

.lane-game .lane-column > tw-hook,
.lane-game .lane-column > tw-expression,

.lane-game .hand-area > tw-hook,
.lane-game .hand-area > tw-expression,

.lane-game .player-hand tw-hook,
.lane-game .player-hand tw-expression,

.lane-game .game-controls tw-hook,
.lane-game .game-controls tw-expression {
	display: contents !important;
	margin: 0 !important;
	padding: 0 !important;
}

/* Stop Harlowe enchantment wrappers from changing card flow. */

.lane-game .player-hand tw-enchantment,
.lane-game .lane-row tw-enchantment {
	display: contents !important;
}

/* =========================================================
   MESSAGE BAR
   ========================================================= */

.lane-game .game-message {
	align-items: center;
	background: #20252b;
	border: 1px solid #4b535d;
	border-radius: 6px;
	display: flex;
	font-size: 14px;
	gap: 10px;
	height: 42px;
	line-height: 1.2;
	margin: 0;
	min-height: 42px;
	overflow: hidden;
	padding: 7px 10px;
	white-space: nowrap;
}

.lane-game .turn-indicator {
	background: #dfc159;
	border-radius: 4px;
	color: #111;
	flex: 0 0 auto;
	font-size: 11px;
	font-weight: bold;
	padding: 5px 8px;
}

.lane-game .message-text {
	display: block;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* =========================================================
   VICTORY / DEFEAT
   ========================================================= */

.lane-game .game-result {
	border-radius: 8px;
	font-size: 34px;
	font-weight: bold;
	left: 50%;
	padding: 18px 32px;
	position: absolute;
	text-align: center;
	top: 50%;
	transform: translate(-50%, -50%);
	z-index: 30;
}

.lane-game .victory-result {
	background: #425c2f;
	border: 2px solid #9bc76f;
}

.lane-game .defeat-result {
	background: #602c2c;
	border: 2px solid #c96d6d;
}

/* =========================================================
   COMPACT HUD ROW
   ========================================================= */

.lane-game .combatant-row {
	display: grid !important;
	gap: 10px;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	height: 58px;
	margin: 0;
	min-height: 58px;
	overflow: hidden;
}

.lane-game .combatant-box {
	align-items: center;
	background: #20252b;
	border: 1px solid #4b535d;
	border-radius: 7px;
	display: grid !important;
	gap: 10px;
	grid-template-columns: auto 1px minmax(0, 1fr) auto;
	height: 58px;
	margin: 0;
	min-height: 58px;
	min-width: 0;
	overflow: hidden;
	padding: 7px 12px;
}

.lane-game .hud-identity {
	align-items: center;
	display: flex;
	gap: 9px;
	min-width: 0;
	white-space: nowrap;
}

.lane-game .combatant-title {
	font-size: 15px;
	font-weight: bold;
	margin: 0;
}

.lane-game .hp-number {
	font-size: 14px;
	font-weight: bold;
	white-space: nowrap;
}

.lane-game .enemy-hp-number {
	color: #e26464;
}

.lane-game .player-hp-number {
	color: #69ca79;
}

.lane-game .hud-divider {
	background: rgba(255,255,255,0.28);
	height: 28px;
	width: 1px;
}

.lane-game .hud-mana {
	align-items: center;
	display: flex;
	gap: 7px;
	min-width: 0;
	overflow: hidden;
}

.lane-game .hud-label {
	color: #d5d7da;
	font-size: 12px;
	white-space: nowrap;
}

.lane-game .mana-row {
	align-items: center !important;
	display: flex !important;
	flex-direction: row !important;
	flex-wrap: nowrap !important;
	gap: 4px !important;
	justify-content: flex-start !important;
	margin: 0 !important;
	min-width: 0;
	overflow: hidden;
	width: auto !important;
}

.lane-game .mana-gem {
	background: #12171c;
	border: 2px solid #4f7698;
	border-radius: 50%;
	display: inline-block !important;
	flex: 0 0 14px !important;
	height: 14px !important;
	margin: 0 !important;
	width: 14px !important;
}

.lane-game .filled-mana {
	background: #3496e8;
	box-shadow:
		inset 0 0 3px #d9efff,
		0 0 3px rgba(72,163,235,0.7);
}

.lane-game .deck-information {
	color: #c0c4ca;
	font-size: 10px;
	margin: 0;
	white-space: nowrap;
}

/* =========================================================
   BATTLEFIELD
   ========================================================= */

.lane-game .battlefield {
	background-color: #14251a;
	border: 1px solid #314838;
	border-radius: 9px;
	display: grid !important;
	gap: 0;
	grid-template-rows: minmax(0, 1fr) 18px minmax(0, 1fr);
	margin: 0;
	min-height: 0;
	overflow: hidden;
	padding: 6px 14px;
	position: relative;
	width: 100%;
}

.lane-game .board-half {
	display: grid !important;
	gap: 2px;
	grid-template-rows: 16px minmax(0, 1fr);
	margin: 0;
	min-height: 0;
	overflow: hidden;
}

.lane-game .board-label {
	align-items: center;
	color: rgba(255,255,255,0.78);
	display: flex;
	font-size: 10px;
	font-weight: bold;
	justify-content: center;
	letter-spacing: 1.6px;
	line-height: 16px;
	margin: 0;
	text-align: center;
}

.lane-game .lane-row,
.lane-game .enemy-lanes,
.lane-game .player-lanes {
	align-items: center !important;
	display: grid !important;
	flex-direction: initial !important;
	flex-wrap: initial !important;
	gap: clamp(28px, 7vw, 140px) !important;
	grid-template-columns: repeat(3, minmax(90px, 130px));
	justify-content: center !important;
	margin: 0;
	min-height: 0;
	overflow: hidden;
	width: 100% !important;
}

.lane-game .lane-column {
	align-items: center !important;
	display: grid !important;
	flex: none !important;
	grid-template-rows: 14px minmax(0, 1fr);
	justify-items: center;
	margin: 0 !important;
	max-width: none !important;
	min-height: 0;
	min-width: 0 !important;
	overflow: hidden;
	position: relative;
	width: 100% !important;
}

.lane-game .lane-number {
	color: rgba(255,255,255,0.54);
	font-size: 9px;
	font-weight: bold;
	line-height: 14px;
	margin: 0;
	text-align: center;
	white-space: nowrap;
}

.lane-game .battle-divider {
	align-items: center;
	display: flex !important;
	gap: 8px;
	height: 18px;
	margin: 0;
	width: 100%;
}

.lane-game .battle-divider::before,
.lane-game .battle-divider::after {
	background: rgba(255,255,255,0.24);
	content: "";
	flex: 1;
	height: 1px;
}

.lane-game .battle-divider span {
	color: rgba(255,255,255,0.58);
	font-size: 12px;
}

/* =========================================================
   BOARD CARDS AND EMPTY LANES
   ========================================================= */

.lane-game .empty-creature-slot,
.lane-game .creature-card {
	height: min(100%, 142px);
	margin: 0;
	max-height: 142px;
	max-width: 118px;
	min-height: 82px;
	width: 100%;
}

.lane-game .empty-creature-slot {
	align-items: center;
	background: rgba(0,0,0,0.13);
	border: 2px dashed rgba(255,255,255,0.28);
	border-radius: 7px;
	color: rgba(255,255,255,0.43);
	display: flex !important;
	font-size: 10px;
	font-weight: bold;
	justify-content: center;
	overflow: hidden;
	position: relative;
	text-align: center;
}

.lane-game .playable-empty-slot {
	background: rgba(211,184,73,0.08);
	border-color: #d6bb4e;
	box-shadow:
		inset 0 0 12px rgba(224,196,82,0.14),
		0 0 7px rgba(224,196,82,0.25);
}

.lane-game .playable-empty-slot:hover {
	background: rgba(211,184,73,0.16);
	box-shadow:
		inset 0 0 16px rgba(224,196,82,0.22),
		0 0 10px rgba(224,196,82,0.4);
}

.lane-game .playable-empty-slot tw-link {
	align-items: center;
	color: #ead778;
	display: flex;
	height: 100%;
	justify-content: center;
	text-decoration: none;
	width: 100%;
}

.lane-game .creature-card {
	background: #ede6d3;
	border: 3px solid #171717;
	border-radius: 8px;
	color: #171717;
	display: block;
	padding: 8px 6px;
	position: relative;
	text-align: center;
}

.lane-game .enemy-creature-card {
	background: #d9d1c1;
}

.lane-game .player-creature-card {
	background: #f1ead8;
}

.lane-game .creature-cost {
	align-items: center;
	background: #397ec0;
	border: 2px solid #183852;
	border-radius: 50%;
	color: white;
	display: flex;
	font-size: 11px;
	font-weight: bold;
	height: 23px;
	justify-content: center;
	left: 4px;
	position: absolute;
	top: 4px;
	width: 23px;
}

.lane-game .creature-name {
	font-size: clamp(11px, 0.95vw, 14px);
	font-weight: bold;
	line-height: 1.05;
	margin: 25px 2px 9px;
	overflow-wrap: break-word;
}

.lane-game .creature-status {
	color: #666;
	font-size: 8px;
	font-weight: bold;
	letter-spacing: 0.4px;
	margin: 0;
}

.lane-game .creature-stats {
	bottom: 5px;
	display: flex;
	font-size: 10px;
	font-weight: bold;
	justify-content: space-between;
	left: 6px;
	position: absolute;
	right: 6px;
}

.lane-game .damage-stat {
	color: #7e481a;
}

.lane-game .health-stat {
	color: #9d2222;
}

/* =========================================================
   HAND BAR
   ========================================================= */

.lane-game .hand-area {
	align-items: stretch;
	background: #20252b;
	border: 1px solid #4b535d;
	border-radius: 8px;
	display: grid !important;
	gap: 10px;
	grid-template-columns: 32px minmax(0, 1fr) 130px;
	height: 158px;
	margin: 0;
	min-height: 158px;
	overflow: hidden;
	padding: 8px 10px;
}

.lane-game .hand-title {
	align-items: center;
	color: #c8ccd1;
	display: flex;
	font-size: 10px;
	font-weight: bold;
	justify-content: center;
	letter-spacing: 1.2px;
	margin: 0;
	writing-mode: vertical-rl;
}

.lane-game .player-hand {
	align-items: center;
	display: flex !important;
	flex-direction: row !important;
	flex-wrap: nowrap !important;
	gap: 10px;
	justify-content: center;
	margin: 0;
	min-width: 0;
	overflow: hidden;
	padding: 4px 5px;
}

.lane-game .hand-creature-card {
	background: #efe8d7;
	border: 3px solid #161616;
	border-radius: 8px;
	color: #151515;
	flex: 0 0 92px;
	height: 132px;
	margin: 0;
	padding: 34px 7px 8px;
	position: relative;
	text-align: center;
	transition:
		transform 0.12s ease,
		box-shadow 0.12s ease;
	width: 92px;
}

.lane-game .hand-creature-card:hover {
	transform: translateY(-4px);
}

.lane-game .hand-creature-card tw-link {
	align-items: center;
	color: #151515;
	display: flex;
	font-size: 13px;
	font-weight: bold;
	height: 100%;
	justify-content: center;
	line-height: 1.05;
	text-decoration: none;
	width: 100%;
}

.lane-game .selected-hand-card {
	box-shadow:
		0 0 0 3px #e2c552,
		0 0 12px rgba(226,197,82,0.65);
	transform: translateY(-4px);
}

.lane-game .disabled-hand-card {
	filter: grayscale(0.75);
	opacity: 0.42;
}

.lane-game .disabled-hand-card:hover {
	transform: none;
}

.lane-game .hand-card-name {
	align-items: center;
	display: flex;
	font-size: 13px;
	font-weight: bold;
	height: 100%;
	justify-content: center;
	line-height: 1.05;
}

.lane-game .hand-cost {
	align-items: center;
	background: #397ec0;
	border: 2px solid #183852;
	border-radius: 50%;
	color: white;
	display: flex;
	font-size: 12px;
	font-weight: bold;
	height: 25px;
	justify-content: center;
	left: 5px;
	position: absolute;
	top: 5px;
	width: 25px;
}

.lane-game .hand-stats {
	bottom: 7px;
	font-size: 11px;
	font-weight: bold;
	left: 4px;
	position: absolute;
	right: 4px;
}

.lane-game .empty-hand-message {
	align-self: center;
	color: #aaa;
	font-size: 13px;
}

/* =========================================================
   CONTROLS
   ========================================================= */

.lane-game .game-controls {
	align-items: stretch;
	display: flex !important;
	flex-direction: column !important;
	gap: 8px;
	justify-content: center;
	margin: 0;
	min-width: 0;
}

.lane-game .game-control-button {
	border: 2px solid #111;
	border-radius: 6px;
	display: block;
	font-size: 13px;
	font-weight: bold;
	text-align: center;
}

.lane-game .game-control-button tw-link {
	align-items: center;
	color: #141414;
	display: flex;
	justify-content: center;
	min-height: 46px;
	padding: 10px 12px;
	text-decoration: none;
	width: 100%;
}

.lane-game .end-turn-control {
	background: #dfc159;
	font-size: 15px;
}

.lane-game .end-turn-control:hover {
	background: #ecd270;
}

.lane-game .cancel-control {
	background: #ca8686;
}

.lane-game .cancel-control:hover {
	background: #dfa0a0;
}

.lane-game .reset-control {
	background: #d9d9d9;
}

/* =========================================================
   HIDE OBSOLETE ELEMENTS FROM EARLIER VERSIONS
   ========================================================= */

.lane-game-heading,
.round-banner,
.lane-hp-bar,
.lane-hp-fill,
.hud-main,
.hud-side,
.selection-panel,
.lane-play-button,
.bottom-deck-information {
	display: none !important;
}

/* =========================================================
   MEDIUM WIDTH SCREENS
   ========================================================= */

@media (max-width: 1100px) {
	.lane-game {
		gap: 6px;
		padding: 7px;
	}

	.lane-game .combatant-box {
		gap: 6px;
		padding: 6px 8px;
	}

	.lane-game .deck-information {
		font-size: 9px;
	}

	.lane-game .lane-row,
	.lane-game .enemy-lanes,
	.lane-game .player-lanes {
		gap: clamp(12px, 4vw, 48px) !important;
		grid-template-columns: repeat(3, minmax(78px, 112px));
	}

	.lane-game .hand-area {
		grid-template-columns: 26px minmax(0, 1fr) 110px;
	}

	.lane-game .hand-creature-card {
		flex-basis: 82px;
		width: 82px;
	}

	.lane-game .player-hand {
		gap: 3px;
	}

	.lane-game .player-hand .hand-creature-card + .hand-creature-card {
		margin-left: -7px;
	}
}

/* =========================================================
   SMALL WIDTH SCREENS
   ========================================================= */

@media (max-width: 760px) {
	.lane-game {
		grid-template-rows: 36px 52px minmax(0, 1fr) 126px;
	}

	.lane-game .game-message {
		font-size: 11px;
		height: 36px;
		min-height: 36px;
		padding: 5px 7px;
	}

	.lane-game .turn-indicator {
		font-size: 9px;
		padding: 4px 5px;
	}

	.lane-game .combatant-row {
		gap: 5px;
		height: 52px;
		min-height: 52px;
	}

	.lane-game .combatant-box {
		gap: 5px;
		grid-template-columns: auto 1px minmax(0, 1fr);
		height: 52px;
		min-height: 52px;
		padding: 5px 6px;
	}

	.lane-game .deck-information {
		display: none;
	}

	.lane-game .combatant-title,
	.lane-game .hp-number {
		font-size: 12px;
	}

	.lane-game .hud-label {
		display: none;
	}

	.lane-game .mana-gem {
		flex-basis: 11px !important;
		height: 11px !important;
		width: 11px !important;
	}

	.lane-game .lane-row,
	.lane-game .enemy-lanes,
	.lane-game .player-lanes {
		gap: 8px !important;
		grid-template-columns: repeat(3, minmax(64px, 96px));
	}

	.lane-game .empty-creature-slot,
	.lane-game .creature-card {
		max-width: 92px;
		min-height: 70px;
	}

	.lane-game .hand-area {
		grid-template-columns: minmax(0, 1fr) 90px;
		height: 126px;
		min-height: 126px;
		padding: 6px;
	}

	.lane-game .hand-title {
		display: none;
	}

	.lane-game .hand-creature-card {
		flex-basis: 72px;
		height: 105px;
		width: 72px;
	}

	.lane-game .player-hand {
		gap: 0;
		justify-content: flex-start;
		padding-left: 4px;
	}

	.lane-game .player-hand .hand-creature-card + .hand-creature-card {
		margin-left: -13px;
	}

	.lane-game .game-control-button tw-link {
		min-height: 40px;
		padding: 7px 6px;
	}
}

/* =========================================================
   SHORT SCREENS
   ========================================================= */

@media (max-height: 760px) {
	.lane-game {
		gap: 5px;
		grid-template-rows: 34px 50px minmax(0, 1fr) 120px;
		padding-bottom: 5px;
		padding-top: 5px;
	}

	.lane-game .game-message {
		height: 34px;
		min-height: 34px;
	}

	.lane-game .combatant-row {
		height: 50px;
		min-height: 50px;
	}

	.lane-game .combatant-box {
		height: 50px;
		min-height: 50px;
		padding-bottom: 4px;
		padding-top: 4px;
	}

	.lane-game .battlefield {
		padding-bottom: 4px;
		padding-top: 4px;
	}

	.lane-game .board-half {
		grid-template-rows: 13px minmax(0, 1fr);
	}

	.lane-game .board-label {
		line-height: 13px;
	}

	.lane-game .empty-creature-slot,
	.lane-game .creature-card {
		max-height: 108px;
		min-height: 66px;
	}

	.lane-game .hand-area {
		height: 120px;
		min-height: 120px;
	}

	.lane-game .hand-creature-card {
		height: 104px;
	}
}
.disabled-control {
	opacity: 0.4;
	cursor: not-allowed;
	filter: grayscale(1);
	pointer-events: none;
}
/* =========================================================
   CARD ABILITY TOOLTIP
   ========================================================= */

.lane-game .card-ability-tooltip {
	background: rgba(22, 26, 30, 0.97);
	border: 1px solid #d8bd58;
	border-radius: 7px;
	box-shadow:
		0 5px 18px rgba(0, 0, 0, 0.55),
		inset 0 0 12px rgba(216, 189, 88, 0.05);
	color: #eeeeee;
	display: none;
	font-family: Arial, sans-serif;
	left: auto;
	max-width: 250px;
	min-height: 74px;
	padding: 12px 14px;
	pointer-events: none;
	position: fixed;
	right: 3.5vw;
	text-align: left;
	top: 65%;
	transform: translateY(-50%);
	width: 250px;
	z-index: 2000;
}

.lane-game .creature-card:hover .card-ability-tooltip,
.lane-game .hand-creature-card:hover .card-ability-tooltip {
	display: block;
}

.lane-game .ability-tooltip-title {
	border-bottom: 1px solid rgba(216, 189, 88, 0.45);
	color: #e5ca65;
	font-size: 14px;
	font-weight: bold;
	line-height: 1.2;
	margin-bottom: 7px;
	padding-bottom: 6px;
}

.lane-game .ability-tooltip-text {
	color: #e5e5e5;
	font-size: 12px;
	font-weight: normal;
	line-height: 1.4;
}


/* Fixed tooltips should not inherit transformed card positioning. */

.lane-game .hand-creature-card:hover {
	box-shadow: 0 5px 12px rgba(0, 0, 0, 0.35);
	transform: none;
}

.lane-game .selected-hand-card {
	box-shadow:
		0 0 0 3px #e2c552,
		0 0 12px rgba(226,197,82,0.65);
	transform: none;
}

.lane-game .disabled-hand-card {
	filter: none;
	opacity: 0.42;
}


/* Move the tooltip inward on narrower displays. */

@media (max-width: 1100px) {
	.lane-game .card-ability-tooltip {
		max-width: 210px;
		right: 18px;
		width: 210px;
	}
}


/* On very small screens, place it centrally above the hand. */

@media (max-width: 760px) {
	.lane-game .card-ability-tooltip {
		bottom: 138px;
		left: 50%;
		max-width: 260px;
		right: auto;
		top: auto;
		transform: translateX(-50%);
		width: calc(100vw - 30px);
	}
}
/* Allow tooltips on greyed-out cards */

.lane-game .disabled-hand-card {
	cursor: default;
	filter: none;
	opacity: 1;
	pointer-events: auto;
}

.lane-game .disabled-hand-card .hand-card-name,
.lane-game .disabled-hand-card .hand-cost,
.lane-game .disabled-hand-card .hand-stats {
	filter: grayscale(0.75);
	opacity: 0.42;
}

.lane-game .disabled-hand-card:hover .card-ability-tooltip {
	display: block;
	filter: none;
	opacity: 1;
}
/* =========================================================
   NEXT UP! CREATURE-SEARCH OVERLAY

   Append this complete block to the END of Story Stylesheet.
   It does not replace or remove any of your existing CSS.
   ========================================================= */

/* Harlowe wrappers inside the modal must not interrupt its grid. */

.lane-game .next-up-overlay > tw-hook,
.lane-game .next-up-overlay > tw-expression,
.lane-game .next-up-panel > tw-hook,
.lane-game .next-up-panel > tw-expression,
.lane-game .next-up-choice-grid > tw-hook,
.lane-game .next-up-choice-grid > tw-expression {
	display: contents !important;
	margin: 0 !important;
	padding: 0 !important;
}

.lane-game .next-up-choice-grid tw-enchantment {
	display: contents !important;
}

.lane-game .next-up-overlay {
	align-items: center;
	background: rgba(5, 8, 10, 0.82);
	display: flex !important;
	inset: 0;
	justify-content: center;
	padding: 24px;
	position: absolute;
	z-index: 1000;
}

.lane-game .next-up-panel {
	background: #20252b;
	border: 1px solid #d8bd58;
	border-radius: 10px;
	box-shadow:
		0 18px 55px rgba(0, 0, 0, 0.72),
		inset 0 0 24px rgba(216, 189, 88, 0.04);
	display: grid !important;
	gap: 18px;
	grid-template-rows: auto minmax(0, 1fr);
	margin: 0;
	max-height: calc(100vh - 80px);
	max-width: 920px;
	overflow: hidden;
	padding: 16px 18px 20px;
	width: min(920px, calc(100vw - 48px));
}

.lane-game .next-up-heading {
	align-items: center;
	border-bottom: 1px solid rgba(216, 189, 88, 0.32);
	display: flex;
	gap: 12px;
	margin: 0;
	padding: 0 0 13px;
}

.lane-game .next-up-badge {
	background: #dfc159;
	border-radius: 4px;
	color: #111;
	flex: 0 0 auto;
	font-size: 11px;
	font-weight: bold;
	padding: 6px 9px;
}

.lane-game .next-up-title {
	color: #f2f2f2;
	font-size: 17px;
	font-weight: bold;
	line-height: 1.2;
}

.lane-game .next-up-choice-grid {
	align-items: center;
	display: grid !important;
	gap: 14px;
	grid-template-columns: repeat(auto-fit, 118px);
	justify-content: center;
	margin: 0;
	max-height: 430px;
	overflow-x: hidden;
	overflow-y: auto;
	padding: 4px 6px 8px;
}

.lane-game .next-up-choice-card {
	background: #f1ead8;
	border: 3px solid #171717;
	border-radius: 8px;
	box-shadow: 0 5px 12px rgba(0, 0, 0, 0.36);
	color: #171717;
	height: 152px;
	margin: 0;
	padding: 34px 7px 27px;
	position: relative;
	text-align: center;
	transition:
		transform 0.12s ease,
		box-shadow 0.12s ease,
		border-color 0.12s ease;
	width: 118px;
}

.lane-game .next-up-choice-card:hover {
	border-color: #d8bd58;
	box-shadow:
		0 0 0 2px rgba(216, 189, 88, 0.34),
		0 8px 18px rgba(0, 0, 0, 0.52);
	transform: translateY(-4px);
}

.lane-game .next-up-choice-cost {
	align-items: center;
	background: #397ec0;
	border: 2px solid #183852;
	border-radius: 50%;
	color: white;
	display: flex;
	font-size: 12px;
	font-weight: bold;
	height: 26px;
	justify-content: center;
	left: 5px;
	position: absolute;
	top: 5px;
	width: 26px;
}

.lane-game .next-up-choice-name {
	align-items: center;
	display: flex;
	height: 100%;
	justify-content: center;
	margin: 0;
}

.lane-game .next-up-choice-name tw-link {
	align-items: center;
	color: #171717;
	display: flex;
	font-size: 14px;
	font-weight: bold;
	height: 100%;
	justify-content: center;
	line-height: 1.08;
	overflow-wrap: break-word;
	text-decoration: none;
	width: 100%;
}

.lane-game .next-up-choice-stats {
	bottom: 7px;
	display: flex;
	font-size: 11px;
	font-weight: bold;
	justify-content: space-between;
	left: 7px;
	position: absolute;
	right: 7px;
}

/* Use the existing ability tooltip inside Next Up! cards. */

.lane-game .next-up-choice-card:hover .card-ability-tooltip {
	display: block;
}

/* Keep this modal's tooltip above its dark backdrop and panel. */

.lane-game .next-up-choice-card .card-ability-tooltip {
	z-index: 2100;
}

@media (max-width: 760px) {
	.lane-game .next-up-overlay {
		padding: 12px;
	}

	.lane-game .next-up-panel {
		gap: 12px;
		max-height: calc(100vh - 24px);
		padding: 12px;
		width: calc(100vw - 24px);
	}

	.lane-game .next-up-heading {
		gap: 8px;
		padding-bottom: 10px;
	}

	.lane-game .next-up-title {
		font-size: 14px;
	}

	.lane-game .next-up-choice-grid {
		gap: 9px;
		grid-template-columns: repeat(auto-fit, 94px);
		max-height: calc(100vh - 115px);
	}

	.lane-game .next-up-choice-card {
		height: 126px;
		padding: 30px 5px 24px;
		width: 94px;
	}

	.lane-game .next-up-choice-name tw-link {
		font-size: 12px;
	}
}

@media (max-height: 760px) {
	.lane-game .next-up-panel {
		gap: 10px;
		max-height: calc(100vh - 24px);
		padding-bottom: 12px;
		padding-top: 12px;
	}

	.lane-game .next-up-heading {
		padding-bottom: 9px;
	}

	.lane-game .next-up-choice-grid {
		max-height: calc(100vh - 105px);
	}

	.lane-game .next-up-choice-card {
		height: 126px;
	}
}





























/* =========================================================
   PRINTER TASK MARKER
   ========================================================= */

tw-hook[name="printertaskhotspot"] {
	position: fixed !important;

	left: 7.4% !important;
	top: 66% !important;

	display: flex !important;
	align-items: center !important;
	justify-content: center !important;

	width: 38px !important;
	height: 38px !important;

	margin: 0 !important;
	padding: 0 !important;

	box-sizing: border-box !important;

	border: 2px solid #ffffff !important;
	border-radius: 50% !important;

	background: rgba(0, 0, 0, 0.92) !important;
	color: #ffffff !important;

	font-family: Arial, sans-serif !important;
	font-size: 23px !important;
	font-weight: bold !important;
	line-height: 1 !important;
	text-align: center !important;

	box-shadow:
		0 0 8px rgba(255, 255, 255, 0.9),
		0 0 18px rgba(255, 255, 255, 0.6);

	cursor: pointer !important;
	pointer-events: auto !important;

	z-index: 500 !important;

	animation: printerTaskPulse 1.3s ease-in-out infinite;
}

/* Harlowe adds an enchantment after applying click-rerun */

tw-hook[name="printertaskhotspot"] > tw-enchantment {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

	border-radius: 50% !important;
	cursor: pointer !important;
}

tw-hook[name="printertaskhotspot"]:hover {
	background: rgba(20, 20, 20, 0.96) !important;

	box-shadow:
		0 0 12px rgba(255, 255, 255, 1),
		0 0 26px rgba(255, 255, 255, 0.8);
}

tw-hook[name="printertaskhotspot"]::after,
tw-hook[name="printertaskhotspot"]:hover::after {
	content: none !important;
	display: none !important;
}

@keyframes printerTaskPulse {
	0%, 100% {
		transform: scale(1);
	}

	50% {
		transform: scale(1.14);
	}
}
/* =========================================================
   FLUGIYO RECYCLING BIN MARKER
   ========================================================= */

tw-hook[name="flugiyobin"]{
	position:fixed !important;

	left:2% !important;
	top:86% !important;

	display:flex !important;
	align-items:center !important;
	justify-content:center !important;

	width:38px !important;
	height:38px !important;

	margin:0 !important;
	padding:0 !important;

	box-sizing:border-box !important;

	border:2px solid #ffffff !important;
	border-radius:50% !important;

	background:rgba(20,20,20,0.9) !important;
	color:#ffffff !important;

	font-family:Arial,sans-serif !important;
	font-size:23px !important;
	font-weight:bold !important;
	line-height:1 !important;
	text-align:center !important;

	box-shadow:
		0 0 8px rgba(255,255,255,0.9),
		0 0 18px rgba(255,255,255,0.6);

	cursor:pointer !important;
	pointer-events:auto !important;

	z-index:500 !important;

	animation:flugiyoBinPulse 1.3s ease-in-out infinite;
}

/* Harlowe adds this after applying click-rerun */

tw-hook[name="flugiyobin"] > tw-enchantment{
	position:absolute !important;
	inset:0 !important;

	display:block !important;

	width:100% !important;
	height:100% !important;

	margin:0 !important;
	padding:0 !important;

	border-radius:50% !important;
	cursor:pointer !important;
}

tw-hook[name="flugiyobin"]:hover{
	background:rgba(20,20,20,0.96) !important;

	box-shadow:
		0 0 12px rgba(255,255,255,1),
		0 0 26px rgba(255,255,255,0.8);
}

tw-hook[name="flugiyobin"]::after,
tw-hook[name="flugiyobin"]:hover::after{
	content:none !important;
	display:none !important;
}

@keyframes flugiyoBinPulse{
	0%,100%{
		transform:scale(1);
	}

	50%{
		transform:scale(1.14);
	}
}



































/* =========================================================
   BULL-PEN — AMBIENT NPC DIALOGUE
   ========================================================= */

.bullpen-ambient{
	position:fixed;
	max-width:15%;
	padding:6px 9px;
	background:rgba(0,0,0,0.72);
	border:1px solid rgba(255,255,255,0.65);
	border-radius:5px;
	color:#fff;
	font-family:Arial,sans-serif;
	font-size:13px;
	line-height:1.25;
	text-align:center;
	text-shadow:0 1px 2px #000;
	box-shadow:0 2px 6px rgba(0,0,0,0.55);
	pointer-events:none;
	z-index:300;
}

.bullpen-ambient:empty{
	display:none;
}

.ambient-jennifer{
	left:1%;
	top:22%;
}

.ambient-george{
	left:19%;
	top:40%;
}

.ambient-jerry{
	left:28%;
	top:12%;
}

.ambient-benjamin{
	left:65%;
	top:19%;
}

.ambient-halley{
	left:80%;
	top:17%;
}
































/* =========================================================
   JANITOR MAZE
   Completely isolated from existing story layout
   ========================================================= */


/* Undo normal story right-side character space
   ONLY when the Janitor Maze exists in the passage */
tw-story:has(.janitor-maze) {
	margin-right: 0 !important;
	width: 100vw !important;
	max-width: none !important;
}


/* Make the actual passage full screen width too */
tw-passage:has(.janitor-maze) {
	width: 100vw !important;
	max-width: none !important;

	margin: 0 !important;
	padding: 0 !important;
}


/* Main maze screen */
.janitor-maze {
	position: relative !important;

	width: 100vw !important;
	min-height: 100vh !important;

	margin: 0 !important;
	padding: 40px 0 !important;

	box-sizing: border-box !important;

	text-align: center !important;
	font-family: monospace !important;

	user-select: none !important;
}


/* =========================================================
   TITLE
   ========================================================= */

.janitor-maze .maze-title {
	display: block !important;

	margin: 0 0 8px 0 !important;
	padding: 0 !important;

	font-size: 22px !important;
	line-height: 1.2 !important;

	text-align: center !important;
}


/* =========================================================
   TURN COUNTER
   ========================================================= */

.janitor-maze .maze-info {
	display: block !important;

	margin: 0 0 24px 0 !important;
	padding: 0 !important;

	font-size: 14px !important;
	line-height: 1.2 !important;

	text-align: center !important;
}


/* =========================================================
   MAZE GRID
   ========================================================= */

.janitor-maze .maze-grid {
	display: inline-flex !important;
	flex-direction: column !important;

	width: auto !important;
	height: auto !important;

	margin: 0 auto !important;
	padding: 0 !important;

	line-height: 0 !important;

	vertical-align: top !important;
}


/* Each maze row */
.janitor-maze .maze-row {
	display: flex !important;
	flex-direction: row !important;

	width: auto !important;
	height: 24px !important;

	margin: 0 !important;
	padding: 0 !important;

	line-height: 0 !important;

	white-space: nowrap !important;
}


/* IMPORTANT:
   Harlowe creates tw-hook wrappers around generated content.
   Let those wrappers disappear from the layout so the actual
   maze tiles become the flex items. */

.janitor-maze .maze-row tw-hook {
	display: contents !important;

	margin: 0 !important;
	padding: 0 !important;
}


/* Also handle any deeper nested hooks produced by
   if/else and loop macros */

.janitor-maze .maze-row tw-hook tw-hook {
	display: contents !important;
}


/* =========================================================
   INDIVIDUAL TILES
   ========================================================= */

.janitor-maze .maze-tile {
	display: inline-flex !important;

	flex: 0 0 24px !important;

	width: 24px !important;
	min-width: 24px !important;
	max-width: 24px !important;

	height: 24px !important;
	min-height: 24px !important;
	max-height: 24px !important;

	margin: 0 !important;
	padding: 0 !important;

	box-sizing: border-box !important;

	align-items: center !important;
	justify-content: center !important;

	font-size: 16px !important;
	line-height: 24px !important;

	text-align: center !important;
	vertical-align: middle !important;
}


/* =========================================================
   WALL
   ========================================================= */

.janitor-maze .maze-wall {
	opacity: 0.65 !important;
}


/* =========================================================
   FLOOR
   ========================================================= */

.janitor-maze .maze-floor {
	opacity: 0.35 !important;
}


/* =========================================================
   PLAYER
   ========================================================= */

.janitor-maze .maze-player {
	opacity: 1 !important;

	font-size: 18px !important;
	font-weight: bold !important;
}


/* =========================================================
   ENEMY
   ========================================================= */

.janitor-maze .maze-enemy {
	opacity: 1 !important;

	font-size: 18px !important;
}


/* =========================================================
   CLICKABLE MOVEMENT TILE
   ========================================================= */

.janitor-maze .maze-move {
	opacity: 1 !important;
}


/* Harlowe movement link */

.janitor-maze .maze-move tw-link {
	display: flex !important;

	width: 24px !important;
	height: 24px !important;

	margin: 0 !important;
	padding: 0 !important;

	align-items: center !important;
	justify-content: center !important;

	box-sizing: border-box !important;

	line-height: 24px !important;
	text-align: center !important;

	text-decoration: none !important;
}


/* Movement hover */

.janitor-maze .maze-move tw-link:hover {
	background: rgba(255,255,255,0.15) !important;
}


/* =========================================================
   GAME OVER
   ========================================================= */

.janitor-maze .maze-gameover {
	display: block !important;

	margin: 30px !important;
	padding: 0 !important;

	font-size: 26px !important;
	font-weight: bold !important;
	line-height: 1.2 !important;

	text-align: center !important;
}
/* =========================================================
   FOG OF WAR
   ========================================================= */

.janitor-maze .maze-hidden {
	visibility: hidden !important;
	pointer-events: none !important;
}
/* =========================================================
   MAZE OBJECTIVE
   ========================================================= */

.janitor-maze .maze-key {
	color: #ffd700 !important;
	font-weight: bold !important;
	font-size: 20px !important;
}

.janitor-maze .maze-exit-locked {
	color: #777 !important;
	font-weight: bold !important;
	font-size: 20px !important;
}

.janitor-maze .maze-exit-ready {
	color: #ffd700 !important;
	font-weight: bold !important;
	font-size: 20px !important;
}
.janitor-maze .maze-door {
	opacity: 1 !important;
	font-weight: bold !important;
	font-size: 18px !important;
}
.janitor-maze .maze-message {
	margin: 0 auto 12px auto !important;
	font-size: 16px !important;
	font-weight: bold !important;
	text-align: center !important;
}
.janitor-maze .maze-message {
	position: absolute !important;
	top: 78px !important;
	left: 50% !important;
	transform: translateX(-50%) !important;

	margin: 0 !important;
	padding: 6px 12px !important;

	font-size: 16px !important;
	font-weight: bold !important;
	text-align: center !important;

	white-space: nowrap !important;

	z-index: 20 !important;

	pointer-events: none !important;
}
.janitor-maze .maze-star {
	color: #ffd700 !important;
	font-weight: bold !important;
	font-size: 20px !important;
}



























/* =========================================================
   MOP CLOSET -> FLESH TUNNEL TRANSITION
   ========================================================= */

@keyframes mopClosetCameraZoom {
	from {
		transform: translate(-50%, -50%) scale(1);
	}

	to {
		transform: translate(-50%, -50%) scale(1.35);
	}
}

@keyframes mopClosetFadeBlack {
	from {
		opacity: 0;
	}

	to {
		opacity: 1;
	}
}

.mop-closet-transition {
	animation: mopClosetCameraZoom 1.4s ease-in forwards !important;
	pointer-events: none !important;
}

.mop-closet-transition-black {
	position: fixed;
	inset: 0;

	background: #000;
	opacity: 0;

	z-index: 99999999;
	pointer-events: all;

	animation: mopClosetFadeBlack 1s ease-in 0.25s forwards;
}


/* =========================================================
   OFFICE BATTLE INTRO
   ========================================================= */

#officeBattleIntro {
	position:fixed !important;
	inset:0 !important;

	width:100vw !important;
	height:100vh !important;

	margin:0 !important;
	padding:0 !important;

	background:#000;

	z-index:999999999 !important;

	display:flex !important;
	align-items:center !important;
	justify-content:center !important;

	overflow:hidden !important;
	pointer-events:all !important;

	animation:
		officeBattleScreenFlash 0.65s linear 0.85s forwards,
		officeBattleIntroFadeOut 0.55s ease 2.60s forwards;
}


/* =========================================================
   FULL SCREEN FLASH
   ========================================================= */

@keyframes officeBattleScreenFlash {

	0% {
		background:#000;
	}

	10% {
		background:#fff;
	}

	20% {
		background:#000;
	}

	32% {
		background:#fff;
	}

	42% {
		background:#000;
	}

	55% {
		background:#fff;
	}

	66% {
		background:#000;
	}

	80% {
		background:#fff;
	}

	100% {
		background:#000;
	}
}


/* =========================================================
   OFFICE BATTLE TITLE
   ========================================================= */

#officeBattleTitle {
	position:relative !important;

	z-index:2 !important;

	font-size:clamp(48px, 8vw, 120px) !important;
	font-weight:900 !important;

	color:#fff !important;

	letter-spacing:0.06em !important;
	text-align:center !important;
	white-space:nowrap !important;

	opacity:0;
	visibility:hidden;

	transform:scale(2.2);

	text-shadow:
		0 5px 0 #000,
		5px 0 0 #000,
		-5px 0 0 #000,
		0 -5px 0 #000;

	animation:
		officeBattleTitleAppear 0.35s cubic-bezier(.2,1.4,.4,1) 1.30s forwards,
		officeBattleTitleDisappear 0.4s ease 2.15s forwards;
}


@keyframes officeBattleTitleAppear {

	0% {
		opacity:0;
		visibility:hidden;
		transform:scale(2.2);
	}

	1% {
		opacity:0;
		visibility:visible;
		transform:scale(2.2);
	}

	100% {
		opacity:1;
		visibility:visible;
		transform:scale(1);
	}
}


@keyframes officeBattleTitleDisappear {

	0% {
		opacity:1;
		visibility:visible;
		transform:scale(1);
	}

	100% {
		opacity:0;
		visibility:hidden;
		transform:scale(0.9);
	}
}


/* =========================================================
   REVEAL BATTLE
   ========================================================= */

@keyframes officeBattleIntroFadeOut {

	0% {
		opacity:1;
		visibility:visible;
	}

	100% {
		opacity:0;
		visibility:hidden;
		pointer-events:none;
	}
}