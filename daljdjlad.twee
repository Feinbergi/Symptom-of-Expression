    (replace: ?tw)[(substring: $t, 1, $i)]
    (set: $i to $i + 1)
  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
  [[Be free, my paper boat princess. Be free!]]
    ]
    (stop:)
  ]
]


