/*WASD MAZE GAME*/
$(document).off("keydown.janitorMaze");

$(document).on("keydown.janitorMaze", function (event) {

	if (!$(".janitor-maze").length) {
		return;
	}

	const key = event.key.toLowerCase();

	if (!["w", "a", "s", "d"].includes(key)) {
		return;
	}

	event.preventDefault();

	const maze = $(".janitor-maze");
	const tiles = maze.find(".maze-tile");
	const player = maze.find(".maze-player");

	if (!player.length) {
		return;
	}

	const playerIndex = tiles.index(player);

	if (playerIndex < 0) {
		return;
	}

	/* Automatically detect maze width */
	const mazeWidth = maze.find(".maze-row").first().find(".maze-tile").length;

	if (!mazeWidth) {
		return;
	}

	let targetIndex = playerIndex;

	switch (key) {

		case "w":
			targetIndex = playerIndex - mazeWidth;
			break;

		case "s":
			targetIndex = playerIndex + mazeWidth;
			break;

		case "a":
			targetIndex = playerIndex - 1;
			break;

		case "d":
			targetIndex = playerIndex + 1;
			break;

	}

	if (targetIndex < 0 || targetIndex >= tiles.length) {
		return;
	}

	const targetTile = tiles.eq(targetIndex);
	const moveLink = targetTile.find("tw-link");

	if (moveLink.length) {
		moveLink.trigger("click");
	}

});



