:: Card Game {"position":"12600,200","size":"100,100"}
|GameUI>[(display:"Card Game UI")]



:: Card Game Setup {"position":"12400,200","size":"100,100"}
<!-- =========================================================
     LOAD THE MASTER CARD LIBRARY AND CURRENT DECK LIST
     ========================================================= -->

(display:"Card Data")




<!-- =========================================================
     RESET MATCH ZONES
     ========================================================= -->

(set:$PlayerDeck to (a:))
(set:$EnemyDeck to (a:))

(set:$PlayerHand to (a:))
(set:$EnemyHand to (a:))

(set:$PlayerBoard to (a:
	(dm:),
	(dm:),
	(dm:)
))

(set:$EnemyBoard to (a:
	(dm:),
	(dm:),
	(dm:)
))


<!-- =========================================================
     RESET SELECTION AND TARGETING
     ========================================================= -->

(set:$SelectedCard to (dm:))
(set:$TargetLane to 0)

(set:$SelectedTargetSide to "")
(set:$SelectedTargetType to "")
(set:$SelectedTargetLane to 0)


<!-- =========================================================
     RESET PLAYER AND ENEMY HEALTH
     ========================================================= -->

(set:$PlayerMaxHP to 20)
(set:$PlayerHP to $PlayerMaxHP)

(set:$EnemyMaxHP to 20)
(set:$EnemyHP to $EnemyMaxHP)


<!-- =========================================================
     RESET MANA
     ========================================================= -->

(set:$PlayerMaxMana to 0)
(set:$PlayerMana to 0)

(set:$EnemyMaxMana to 0)
(set:$EnemyMana to 0)
<!-- =========================================================
     RESET MANA
     ========================================================= -->

(set:$PlayerMaxMana to 0)
(set:$PlayerMana to 0)

(set:$EnemyMaxMana to 0)
(set:$EnemyMana to 0)


<!-- =========================================================
     RESET PERMANENT MANA BONUSES

     Pearl increases this value whenever it witnesses friendly
     Food being consumed.

     This bonus does not provide Mana immediately. It is added
     when maximum Mana is calculated at the beginning of each
     future player turn.

     It may take maximum Mana above the normal cap of 10.
     ========================================================= -->

(set:$PlayerPermanentManaBonus to 0)
(set:$EnemyPermanentManaBonus to 0)

<!-- =========================================================
     RESET TURN COUNTERS
     ========================================================= -->

(set:$PlayerTurnsTaken to 0)
(set:$EnemyTurnsTaken to 0)
(set:$TotalTurnsTaken to 0)

(set:$CurrentCardTurn to "")
(set:$StartingPlayer to (either:"player","enemy"))


<!-- =========================================================
     RESET MATCH RESULT
     ========================================================= -->

(set:$GameOver to false)
(set:$Winner to "")

(set:$CardGameMessage to "")


<!-- =========================================================
     SHARED CARD CALCULATION VARIABLES
     ========================================================= -->

(set:$AttackCard to (dm:))
(set:$AttackSide to "")
(set:$CalculatedAttack to 0)
(set:$DeathMessage to "")


<!-- =========================================================
     GENERIC TRIGGER VARIABLES

     These will be used by shared passages such as:

     Resolve Battlecry
     Resolve Deathrattle
     Resolve Turn Start Trigger
     Resolve Turn End Trigger
     Resolve Damaged Trigger
     ========================================================= -->

(set:$TriggerCard to (dm:))
(set:$TriggerSide to "")
(set:$TriggerLane to 0)
(set:$TriggerMessage to "")


<!-- =========================================================
     RESET TRIBE DEATH COUNTERS
     ========================================================= -->

(set:$PlayerGnomesDied to 0)
(set:$EnemyGnomesDied to 0)


(set:$PlayerFoodConsumed to 0)
(set:$EnemyFoodConsumed to 0)

<!-- POISON -->
(set:$PlayerPoison to 0)
(set:$EnemyPoison to 0)
(set:$PoisonMessage to "")

<!-- JUDAS TARGETED BATTLECRY -->
(set:$JudasTargeting to false)
(set:$JudasSide to "")
(set:$JudasLane to 0)
(set:$JudasCardID to "")
(set:$JudasMessage to "")


<!-- CLOWN TARGETED BATTLECRY -->
(set:$ClownTargeting to false)
(set:$ClownSide to "")
(set:$ClownLane to 0)
(set:$ClownCardID to "")
(set:$ClownMessage to "")

<!-- RINGMASTER TARGETED BATTLECRY -->
(set:$RingmasterTargeting to false)
(set:$RingmasterSide to "")
(set:$RingmasterLane to 0)
(set:$RingmasterCardID to "")
(set:$RingmasterDamage to 0)
(set:$RingmasterMessage to "")

<!-- NEXT UP! DECK SEARCH -->
(set:$NextUpTargeting to false)
(set:$NextUpSpellCard to (dm:))
(set:$NextUpChoiceCardID to "")
(set:$NextUpMessage to "")

<!-- =========================================================
     RUNTIME CARD CREATION
     ========================================================= -->

(set:$NextRuntimeCardID to 1)
<!-- =========================================================
     BUILD FRESH PLAYER CARD INSTANCES

     $CardData holds the permanent printed card definitions.

     $PlayerDeckList holds only definition IDs.

     This loop creates a separate mutable card for every copy,
     so damage and buffs affect only that individual card.
     ========================================================= -->

(set:_playerCardNumber to 0)

(for:each _cardDefinitionID,...$PlayerDeckList)[

	(set:_playerCardNumber to _playerCardNumber + 1)

	(set:_template to
		$CardData's (_cardDefinitionID)
	)

	(set:_newPlayerCard to (dm:
		"id",
			"P" + (str:_playerCardNumber),

		"definitionID",
			_template's "definitionID",

		"name",
			_template's "name",

		"type",
			_template's "type",

		"tribe",
			_template's "tribe",

		"cost",
			_template's "cost",

		"baseDamage",
			_template's "baseDamage",

		"damage",
			_template's "baseDamage",

		"baseMaxHP",
			_template's "baseMaxHP",

		"maxHP",
			_template's "baseMaxHP",

		"hp",
			_template's "baseMaxHP",

		"effect",
			_template's "effect",

		"targetType",
			_template's "targetType",

		"battlecry",
			_template's "battlecry",

		"deathrattle",
			_template's "deathrattle",

		"turnStart",
			_template's "turnStart",

		"turnEnd",
			_template's "turnEnd",

		"damagedTrigger",
			_template's "damagedTrigger",

		"friendlyDeathTrigger",
			_template's "friendlyDeathTrigger",

		"continuousEffect",
			_template's "continuousEffect",

		"keywords",
			_template's "keywords",

		"resetOnDeckReturn",
			_template's "resetOnDeckReturn",

		"description",
			_template's "description",

		"attackBonus",
			0,

		"healthBonus",
			0,

		"temporaryDamage",
			0,

		"temporaryMaxHP",
			0,

		"silenced",
			false,

		"ready",
			false,

		"canInitiateCombat",
			false,

		"poison",
			0
	))

	(set:$PlayerDeck to
		$PlayerDeck +
		(a:_newPlayerCard)
	)

]


