/* =========================================================
   GLOBAL UI ABOVE POINT-AND-CLICK ROOMS
   ========================================================= */

#mapUI {
	position: fixed !important;
	right: 22px !important;
	bottom: 22px !important;

	display: flex !important;
	align-items: center !important;
	justify-content: flex-end !important;
	gap: 11px !important;

	margin: 0 !important;
	padding: 7px 9px !important;

	background: rgba(10, 12, 18, 0.78) !important;
	border: 1px solid rgba(255, 255, 255, 0.22) !important;
	border-radius: 8px !important;

	box-shadow: 0 3px 12px rgba(0, 0, 0, 0.55) !important;

	font-family: Arial, sans-serif !important;
	line-height: 1 !important;

	z-index: 20000 !important;
}

#starsUI,
#inventoryButton,
#taskButton,
#mapButton {
	position: relative !important;
	z-index: 20001 !important;
}

#inventoryButton tw-link,
#taskButton tw-link,
#mapButton tw-link,
#mapButton a {
	position: relative !important;
	z-index: 20002 !important;
	cursor: pointer !important;
}

#invOverlay {
	position: fixed;
	z-index: 30000 !important;
}


/* =========================================================
   GOLDEN STAR COUNTER
   ========================================================= */

#starsUI {
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;

	min-width: 30px !important;
	height: 30px !important;

	margin: 0 !important;
	padding: 0 4px !important;

	color: #ffd94a !important;

	font-size: 18px !important;
	font-weight: bold !important;
	line-height: 30px !important;

	text-shadow:
		0 1px 3px #000,
		0 0 6px rgba(255, 215, 0, 0.55) !important;
}


/* =========================================================
   INVENTORY, TASK AND MAP WRAPPERS
   ========================================================= */

#inventoryButton,
#taskButton,
#mapButton {
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;

	width: 32px !important;
	height: 32px !important;

	margin: 0 !important;
	padding: 0 !important;
}


/* =========================================================
   SHARED BUTTON LINK STYLING
   ========================================================= */

#inventoryButton tw-link,
#taskButton tw-link,
#mapButton tw-link,
#mapButton a {
	display: inline-flex !important;
	align-items: center !important;
	justify-content: center !important;

	width: 32px !important;
	height: 32px !important;

	margin: 0 !important;
	padding: 0 !important;

	box-sizing: border-box !important;

	color: white !important;
	border-radius: 6px !important;

	font-family: Arial, sans-serif !important;
	font-size: 19px !important;
	font-weight: normal !important;
	line-height: 32px !important;
	text-align: center !important;
	text-decoration: none !important;

	cursor: pointer !important;

	transition:
		background 0.15s ease,
		border-color 0.15s ease,
		transform 0.15s ease,
		box-shadow 0.15s ease !important;
}


/* =========================================================
   INVENTORY BUTTON — BLUE
   ========================================================= */

#inventoryButton tw-link {
	background: rgba(45, 124, 255, 0.55) !important;
	border: 1px solid rgba(100, 170, 255, 0.85) !important;
}

#inventoryButton tw-link:hover {
	background: rgba(55, 140, 255, 0.88) !important;
	border-color: rgba(175, 215, 255, 1) !important;

	box-shadow: 0 0 8px rgba(70, 145, 255, 0.7) !important;

	transform: scale(1.08) !important;
}


/* =========================================================
   TASK BUTTON — ORANGE
   ========================================================= */

#taskButton tw-link {
	background: rgba(200, 112, 20, 0.78) !important;
	border: 1px solid rgba(255, 185, 95, 0.95) !important;
}

#taskButton tw-link:hover {
	background: rgba(235, 135, 30, 0.96) !important;
	border-color: rgba(255, 225, 175, 1) !important;

	box-shadow: 0 0 8px rgba(255, 145, 35, 0.72) !important;

	transform: scale(1.08) !important;
}


/* =========================================================
   TASK BUTTON — OPEN/GREY
   ========================================================= */

#taskButton.open tw-link {
	background: rgba(95, 98, 105, 0.9) !important;
	border-color: rgba(205, 210, 220, 0.95) !important;

	box-shadow:
		inset 0 0 7px rgba(0, 0, 0, 0.4),
		0 0 7px rgba(190, 195, 205, 0.25) !important;
}

#taskButton.open tw-link:hover {
	background: rgba(125, 128, 135, 0.98) !important;
	border-color: white !important;

	box-shadow: 0 0 9px rgba(220, 225, 235, 0.5) !important;
}


/* =========================================================
   MAP BUTTON — RED
   ========================================================= */

#mapButton tw-link,
#mapButton a {
	background: rgba(185, 40, 40, 0.78) !important;
	border: 1px solid rgba(255, 155, 155, 0.9) !important;
}

#mapButton tw-link:hover,
#mapButton a:hover {
	background: rgba(225, 55, 55, 0.96) !important;
	border-color: rgba(255, 220, 220, 1) !important;

	box-shadow: 0 0 8px rgba(255, 70, 70, 0.7) !important;

	transform: scale(1.08) !important;
}


/* =========================================================
   TASK LOG PANEL
   ========================================================= */

#taskLogPanel {
	position: fixed !important;
	right: 22px !important;
	bottom: 80px !important;

	box-sizing: border-box !important;
	width: 310px !important;
	max-width: calc(100vw - 44px) !important;

	padding: 15px 17px 17px !important;

	background:
		linear-gradient(
			180deg,
			rgba(68, 70, 75, 0.97),
			rgba(39, 41, 46, 0.97)
		) !important;

	border: 1px solid rgba(205, 208, 215, 0.58) !important;
	border-radius: 6px !important;

	box-shadow:
		0 5px 18px rgba(0, 0, 0, 0.72),
		inset 0 0 18px rgba(0, 0, 0, 0.22) !important;

	color: #d0d0d0 !important;

	font-family: Arial, sans-serif !important;
	text-align: left !important;

	z-index: 19999 !important;
}

#taskLogTitle {
	margin: 0 0 12px !important;
	padding: 0 0 9px !important;

	border-bottom: 1px solid rgba(255, 255, 255, 0.22) !important;

	color: #ededed !important;

	font-size: 15px !important;
	font-weight: bold !important;
	letter-spacing: 2px !important;
	line-height: 1.2 !important;
	text-shadow: 0 1px 2px #000 !important;
}

#taskLogList {
	display: flex !important;
	flex-direction: column !important;
	gap: 9px !important;
}

.taskLogEntry {
	display: flex !important;
	align-items: flex-start !important;
	gap: 8px !important;

	box-sizing: border-box !important;
	width: 100% !important;

	padding: 8px 9px !important;

	background: rgba(0, 0, 0, 0.18) !important;
	border-left: 3px solid rgba(225, 135, 35, 0.85) !important;

	color: #d2d2d2 !important;

	font-size: 13px !important;
	font-weight: normal !important;
	line-height: 1.35 !important;
}

.taskLogMarker {
	flex: 0 0 auto !important;
	width: 16px !important;

	color: #ffb04a !important;

	font-size: 14px !important;
	font-weight: bold !important;
	text-align: center !important;
}

.taskLogEntry.complete {
	opacity: 0.55 !important;
	border-left-color: rgba(170, 175, 180, 0.65) !important;
}

.taskLogEntry.complete .taskLogText {
	text-decoration: line-through !important;
}

.taskLogEntry.complete .taskLogMarker {
	color: #c7cbd0 !important;
}


/* =========================================================
   MOBILE UI
   ========================================================= */

@media screen and (max-width: 700px) {
	#mapUI {
		right: 12px !important;
		bottom: 12px !important;

		gap: 8px !important;
		padding: 5px 7px !important;
	}

	#starsUI {
		min-width: 27px !important;
		height: 29px !important;

		font-size: 16px !important;
		line-height: 29px !important;
	}

	#inventoryButton,
	#taskButton,
	#mapButton,
	#inventoryButton tw-link,
	#taskButton tw-link,
	#mapButton tw-link,
	#mapButton a {
		width: 29px !important;
		height: 29px !important;

		font-size: 17px !important;
		line-height: 29px !important;
	}

	#taskLogPanel {
		right: 12px !important;
		bottom: 63px !important;

		width: 285px !important;
		max-width: calc(100vw - 24px) !important;

		padding: 13px 14px 15px !important;
	}
}




































/*=================== BATTLE SCREEN ===================*/

#battleScreen{
	position:fixed !important;
	inset:0 !important;

	width:100vw !important;
	height:100vh !important;

	margin:0 !important;
	padding:0 !important;

	display:block !important;

	background:#000 !important;
	color:#fff !important;

	z-index:90000 !important;
	overflow:hidden !important;
	box-sizing:border-box !important;
}


/* Remove normal Twine passage constraints during battle */

tw-passage:has(#battleScreen){
	width:100% !important;
	max-width:none !important;

	height:100% !important;
	min-height:0 !important;

	margin:0 !important;
	padding:0 !important;

	overflow:hidden !important;
}


/*=================== BATTLE ARENA ===================*/

#battleArena{
	position:absolute !important;
	inset:0 !important;

	width:100% !important;
	height:100% !important;

	margin:0 !important;
	padding:0 !important;

	display:block !important;

	overflow:hidden !important;
	box-sizing:border-box !important;
}


/*=================== CHARACTER SIDES ===================*/

.battleSide{
	position:absolute !important;
	top:120px !important;

	width:430px !important;

	margin:0 !important;
	padding:0 !important;

	display:flex !important;
	flex-direction:column !important;

	box-sizing:border-box !important;
}


/* Enemy on left */

.enemySide{
	left:46px !important;
	right:auto !important;

	align-items:flex-start !important;
	text-align:left !important;

	z-index:10 !important;
}


/* Player on right */

.playerSide{
	right:46px !important;
	left:auto !important;

	align-items:flex-end !important;
	text-align:right !important;

	z-index:10 !important;
}


/*=================== CHARACTER NAMES ===================*/

.battleName{
	display:block !important;

	width:430px !important;
	max-width:430px !important;

	margin:0 0 16px 0 !important;
	padding:0 !important;

	font-size:2rem !important;
	font-weight:bold !important;
	line-height:1.15 !important;

	overflow-wrap:anywhere !important;
	box-sizing:border-box !important;
}

.playerSide .battleName{
	text-align:right !important;
}


/*=================== PORTRAITS ===================*/

.battlePortraitFrame {
	display: flex !important;
	align-items: flex-start !important;
	justify-content: center !important;

	flex: none !important;

	width: 430px !important;
	height: 430px !important;

	margin: 0 !important;
	padding: 0 !important;

	border: 2px solid #fff !important;
	background: #111 !important;

	overflow: hidden !important;
	box-sizing: border-box !important;
}

.battlePortrait {
	display: block !important;

	width: 100% !important;
	height: 100% !important;

	object-fit: contain !important;
	object-position: center top !important;

	transform: scale(1.3) !important;
	transform-origin: center top !important;
}



/*=================== ENEMY BATTLE HP ===================*/

/*
The named Harlowe hook now wraps the complete HP widget.

The hook itself is given no visual dimensions or background.
The permanent visible element inside it is #enemyHPAnchor.
*/

#battleArena > tw-hook{
	position:static !important;

	display:block !important;

	width:0 !important;
	height:0 !important;

	margin:0 !important;
	padding:0 !important;

	overflow:visible !important;
	pointer-events:none !important;
}


/* Enemy HP overlay */

#enemyHPAnchor{
	position:fixed !important;

	left:46px !important;
	right:auto !important;

	top:auto !important;
	bottom:105px !important;

	display:block !important;

	width:430px !important;
	height:52px !important;
	min-height:52px !important;

	margin:0 !important;
	padding:0 !important;

	color:#fff !important;
	background:transparent !important;

	visibility:visible !important;
	opacity:1 !important;

	z-index:90040 !important;
	pointer-events:none !important;

	overflow:visible !important;
	box-sizing:border-box !important;
}


/* Complete enemy HP widget */

#enemyBattleHP{
	position:static !important;

	display:block !important;

	width:430px !important;
	height:52px !important;
	min-height:52px !important;

	margin:0 !important;
	padding:0 !important;

	color:#fff !important;
	background:transparent !important;

	visibility:visible !important;
	opacity:1 !important;

	overflow:visible !important;
	box-sizing:border-box !important;
}


/* Enemy HP text */

#enemyBattleHPText{
	position:static !important;

	display:block !important;

	width:430px !important;
	height:20px !important;

	margin:0 0 7px 0 !important;
	padding:0 !important;

	color:#fff !important;
	background:transparent !important;

	font-size:1rem !important;
	font-weight:bold !important;
	line-height:20px !important;
	text-align:left !important;

	visibility:visible !important;
	opacity:1 !important;

	box-sizing:border-box !important;
}


/* Enemy HP bar */

#enemyBattleHPBar{
	position:static !important;

	display:block !important;

	width:430px !important;
	height:22px !important;

	margin:0 !important;
	padding:0 !important;

	border:2px solid #fff !important;
	background:#222 !important;

	visibility:visible !important;
	opacity:1 !important;

	overflow:hidden !important;
	box-sizing:border-box !important;
}


/* Enemy HP fill */

#enemyBattleHPFill{
	position:static !important;

	display:block !important;

	height:100% !important;
	min-height:18px !important;

	margin:0 !important;
	padding:0 !important;

	background:#fff !important;

	visibility:visible !important;
	opacity:1 !important;

	transition:width 0.35s ease !important;
}
/*=================== CENTRE POPUP ===================*/

#battleCentre{
	position:absolute !important;

	left:50% !important;
	top:44% !important;

	transform:translate(-50%, -50%) !important;

	width:auto !important;
	height:auto !important;

	margin:0 !important;
	padding:0 !important;

	display:block !important;

	z-index:15 !important;
	pointer-events:none !important;
}

#battleCentre tw-hook{
	display:block !important;

	width:auto !important;
	height:auto !important;

	margin:0 !important;
	padding:0 !important;
}

.battlePopup{
	display:block !important;

	margin:0 !important;
	padding:0 !important;

	font-size:4rem !important;
	font-weight:bold !important;

	text-align:center !important;
	white-space:nowrap !important;

	text-shadow:
		3px 3px 0 #000,
		-3px 3px 0 #000,
		3px -3px 0 #000,
		-3px -3px 0 #000 !important;

	animation:battlePopupAnimation 0.25s ease-out !important;
}

@keyframes battlePopupAnimation{
	from{
		transform:scale(0.4);
		opacity:0;
	}

	to{
		transform:scale(1);
		opacity:1;
	}
}


/*=================== MESSAGE AND TOOLBAR LAYER ===================*/

#battleBottom{
	position:absolute !important;
	inset:0 !important;

	width:100% !important;
	height:100% !important;

	margin:0 !important;
	padding:0 !important;

	display:block !important;

	pointer-events:none !important;
	overflow:visible !important;

	z-index:30 !important;
	box-sizing:border-box !important;
}


/*
Keep Harlowe's rerunnable hooks intact.
Do not collapse them to zero width or height.
*/

#battleBottom > tw-hook{
	position:static !important;

	display:block !important;

	width:auto !important;
	height:auto !important;
	min-width:0 !important;
	min-height:0 !important;

	margin:0 !important;
	padding:0 !important;

	pointer-events:none !important;
	overflow:visible !important;

	box-sizing:border-box !important;
}


/*=================== TOP INFORMATION BOX ===================*/

#battleMessage{
	position:fixed !important;

	top:72px !important;
	left:50% !important;
	right:auto !important;
	bottom:auto !important;

	transform:translateX(-50%) !important;

	display:flex !important;
	flex-direction:column !important;
	align-items:stretch !important;
	justify-content:center !important;

	width:560px !important;
	min-height:54px !important;
	height:auto !important;

	margin:0 !important;
	padding:10px 16px !important;

	border:1px solid #fff !important;
	background:#000 !important;

	box-sizing:border-box !important;
	overflow:hidden !important;

	font-size:1rem !important;
	line-height:1.35 !important;
	text-align:center !important;

	z-index:90030 !important;
	pointer-events:auto !important;
}


/* Remove outer padding when the whole message is clickable */

#battleMessage:has(tw-link){
	padding:0 !important;
}


/* Clickable battle message */

#battleMessage tw-link{
	display:flex !important;
	align-items:center !important;
	justify-content:center !important;

	width:100% !important;
	min-height:54px !important;

	margin:0 !important;
	padding:10px 16px 18px 16px !important;

	color:#fff !important;
	background:#000 !important;

	text-decoration:none !important;
	text-align:center !important;
	line-height:1.35 !important;

	cursor:pointer !important;
	box-sizing:border-box !important;
}

#battleMessage tw-link:hover{
	color:#fff !important;
	background:#111 !important;
}

#battleMessage tw-link:active{
	background:#222 !important;
}


/* Click-to-continue prompt */

.battleContinueHint{
	position:absolute !important;

	right:8px !important;
	bottom:4px !important;

	margin:0 !important;
	padding:0 !important;

	font-size:0.7rem !important;
	line-height:1 !important;
	opacity:0.55 !important;

	pointer-events:none !important;
}


/*=================== TOOLBAR ===================*/

/*
Compact vertical action box beneath the centre popup.

Two 38px buttons
+ 10px gap
+ 28px combined vertical padding
+ 2px border
= 116px required content.

The box is 124px high to provide slight breathing room.
*/

#battleToolbar{
	position:fixed !important;

	left:50% !important;
	right:auto !important;
	top:69% !important;
	bottom:auto !important;

	transform:translate(-50%, -50%) !important;

	display:flex !important;
	flex-direction:column !important;
	align-items:center !important;
	justify-content:center !important;

	gap:10px !important;

	width:199px !important;
	min-width:199px !important;
	max-width:199px !important;

	height:124px !important;
	min-height:124px !important;
	max-height:124px !important;

	margin:0 !important;
	padding:14px !important;

	border:1px solid #fff !important;
	background:#000 !important;

	box-sizing:border-box !important;

	z-index:90030 !important;
	pointer-events:auto !important;

	overflow:hidden !important;
}


/*
Harlowe wraps link macros in tw-expression and sometimes
tw-hook elements. Remove those wrappers from the flex layout
while leaving the actual links functional.
*/

#battleToolbar tw-expression,
#battleToolbar tw-hook{
	display:contents !important;
}


/* Active toolbar buttons */

#battleToolbar tw-link{
	position:static !important;

	display:flex !important;
	flex:0 0 38px !important;

	align-items:center !important;
	justify-content:center !important;

	width:169px !important;
	min-width:169px !important;
	max-width:169px !important;

	height:38px !important;
	min-height:38px !important;
	max-height:38px !important;

	margin:0 !important;
	padding:0 10px !important;

	border:1px solid #fff !important;

	color:#fff !important;
	background:#000 !important;

	box-sizing:border-box !important;

	text-align:center !important;
	text-decoration:none !important;
	line-height:1 !important;
}

#battleToolbar tw-link:hover{
	background:#fff !important;
	color:#000 !important;
}

#battleToolbar tw-link:active{
	background:#222 !important;
	color:#fff !important;
}


/* Disabled toolbar buttons */

#battleToolbar .battleDisabled{
	position:static !important;

	display:flex !important;
	flex:0 0 38px !important;

	align-items:center !important;
	justify-content:center !important;

	width:169px !important;
	min-width:169px !important;
	max-width:169px !important;

	height:38px !important;
	min-height:38px !important;
	max-height:38px !important;

	margin:0 !important;
	padding:0 10px !important;

	border:1px solid #555 !important;

	color:#777 !important;
	background:#000 !important;

	box-sizing:border-box !important;

	text-align:center !important;
	line-height:1 !important;
	cursor:not-allowed !important;
}



/*energy bar*/

#playerEnergyAnchor {
	position: absolute;
	right: 3.2%;
	bottom: 2.2%;
	width: 18.5%;
	z-index: 20;
}

#playerBattleEnergy {
	width: 100%;
}

#playerBattleEnergyText {
	margin-bottom: 5px;
	font-size: 0.95rem;
	font-weight: bold;
	color: white;
}

#playerBattleEnergyBar {
	width: 100%;
	height: 20px;
	box-sizing: border-box;
	border: 2px solid white;
	background: #222;
	overflow: hidden;
}

#playerBattleEnergyFill {
	height: 100%;
	background: #e5c229;
	transition: width 0.25s ease;
}




/*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*//*SPELLS*/

#spellOverlay {
	position: fixed;
	inset: 0;
	z-index: 10000;
	background: rgba(0,0,0,0.82);
	display: flex;
	align-items: center;
	justify-content: center;
}

#spellInner {
	width: min(520px,90vw);
	background: #080808;
	border: 2px solid white;
	padding: 20px;
	box-sizing: border-box;
}

#spellTop {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 16px;
}

#spellTitle {
	font-size: 1.5em;
	font-weight: bold;
}

#spellEnergy {
	margin-bottom: 16px;
}

.spellEntry {
	border: 1px solid white;
	padding: 14px;
}

.spellName {
	font-size: 1.25em;
	font-weight: bold;
	margin-bottom: 8px;
}

.spellDescription,
.spellCost {
	margin-bottom: 8px;
}

.spellUnavailable {
	opacity: 0.55;
}

.spellAvailable {
	font-weight: bold;
}


/*scrollable spell tab*/
#spellInner {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	max-height: 82vh;
	overflow: hidden;
}

#spellTop {
	flex: 0 0 auto;
}

#spellEnergy {
	flex: 0 0 auto;
}

#spellList {
	box-sizing: border-box;
	flex: 1 1 auto;
	min-height: 0;
	overflow-y: auto;
	overflow-x: hidden;
	padding-right: 10px;
	margin-top: 8px;
}

#spellList::-webkit-scrollbar {
	width: 9px;
}

#spellList::-webkit-scrollbar-track {
	background: rgba(0, 0, 0, 0.3);
}

#spellList::-webkit-scrollbar-thumb {
	background: rgba(255, 255, 255, 0.35);
	border-radius: 5px;
}

#spellList::-webkit-scrollbar-thumb:hover {
	background: rgba(255, 255, 255, 0.55);
}























/* =========================================================
   SHARED POINT-AND-CLICK ROOM SYSTEM

   Use:
   <div class="room-screen breakroom-bg">

   or:
   <div class="room-screen freezer-bg">
   ========================================================= */

.room-screen {
	position: fixed;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);

	width: min(100vw, calc(100vh * 1648 / 928));
	height: min(100vh, calc(100vw * 928 / 1648));

	margin: 0;
	padding: 0;

	background-repeat: no-repeat;
	background-position: center;
	background-size: 100% 100%;

	overflow: hidden;
	user-select: none;

	z-index: 100;

	box-shadow: 0 0 0 100vmax #000;
}


/* =========================================================
   ROOM BACKGROUNDS

   Add future backgrounds here.
   ========================================================= */

.breakroom-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Jul%2022%2C%202026%20at%2004_06_04%20PM.png");
}

.freezer-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Jul%2023%2C%202026%20at%2012_06_54%20AM.png");
}

.office-drawers-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Aug%205%2C%202026%20at%2006_53_07%20PM.png");
}

.fridge-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Aug%205%2C%202026%20at%2006_55_02%20PM.png");
}

.captain-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Aug%205%2C%202026%20at%2006_54_56%20PM.png");
}

.desk-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Aug%205%2C%202026%20at%2006_55_17%20PM.png");
}

.noticeboard-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Aug%205%2C%202026%20at%2007_23_17%20PM.png");
}

.mopcloset-bg {
	background-image: url("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/ChatGPT%20Image%20Aug%206%2C%202026%20at%2012_23_18%20AM.png");
}


/* =========================================================
   SHARED HOTSPOT RULES
   ========================================================= */

.room-screen tw-hook {
	position: absolute;
	display: block;

	margin: 0 !important;
	padding: 0 !important;

	font-size: 0;
	line-height: 0;

	cursor: pointer;
	z-index: 10;
}


/* =========================================================
   INVISIBLE LINKS FILL THE HOTSPOTS
   ========================================================= */

.room-screen tw-hook > tw-expression,
.room-screen tw-hook tw-link {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

	box-sizing: border-box;
}

.room-screen tw-hook tw-link {
	color: transparent !important;
	background: transparent !important;
	border: none !important;

	font-size: 0 !important;
	line-height: 0 !important;

	cursor: pointer !important;
	text-decoration: none !important;
}

.room-screen tw-hook tw-link:hover {
	color: transparent !important;
	background: transparent !important;
}


/* =========================================================
   NORMAL HOTSPOT HOVER EFFECT
   ========================================================= */

.room-screen tw-hook:not([name="ceilingtile"]):hover {
	background: rgba(255, 255, 255, 0.05);
	outline: 2px solid rgba(255, 255, 255, 0.45);
	outline-offset: -2px;
}


/* =========================================================
   HOTSPOT HOVER LABELS
   ========================================================= */

.room-screen tw-hook:not([name="ceilingtile"])::after {
	content: "";

	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);

	display: block;

	width: max-content;
	max-width: 240px;
	box-sizing: border-box;

	padding: 8px 14px;

	color: #ffffff;
	background: rgba(0, 0, 0, 0.9);

	border: 1px solid rgba(255, 255, 255, 0.8);
	border-radius: 7px;

	font-family: Arial, sans-serif;
	font-size: 16px;
	font-weight: bold;
	line-height: 1.2;
	text-align: center;
	white-space: nowrap;

	opacity: 0;
	pointer-events: none;

	transition: opacity 0.12s ease;

	z-index: 30;
}

.room-screen tw-hook:not([name="ceilingtile"]):hover::after {
	opacity: 1;
}


/* =========================================================
   BREAK ROOM LABELS
   ========================================================= */

.room-screen tw-hook[name="noticeboard"]::after {
	content: "Notice Board";
}

.room-screen tw-hook[name="vendingmachine"]::after {
	content: "Vending Machine";
}

.room-screen tw-hook[name="fridge"]::after {
	content: "Fridge";
}

.room-screen tw-hook[name="freezer"]::after {
	content: "Freezer";
}

.room-screen tw-hook[name="microwave"]::after {
	content: "Microwave";
}

.room-screen tw-hook[name="lowercupboards"]::after {
	content: "Lower Cupboards";
}

.room-screen tw-hook[name="sink"]::after {
	content: "Sink";
}

.room-screen tw-hook[name="kettle"]::after {
	content: "Kettle";
}

.room-screen tw-hook[name="watercooler"]::after {
	content: "Water Cooler";
}

.room-screen tw-hook[name="uppercupboards"]::after {
	content: "Upper Cupboards";
}

.room-screen tw-hook[name="table"]::after {
	content: "Table";
}


/* =========================================================
   FREEZER LABELS
   ========================================================= */

.room-screen tw-hook[name="severedhead"]::after {
	content: "Severed Head";
}

.room-screen tw-hook[name="icecream"]::after {
	content: "Ice Cream";
}

.room-screen tw-hook[name="readymeals"]::after {
	content: "Ready Meals";
}


