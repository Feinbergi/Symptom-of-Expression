  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
      [[Yeah, it was an amazing f*cking pen, and I want it back.]]
      
      [[I want to find true love. I want a new car. I want a nice house. I want to feel the wind through my hair, the sun on my back, and my heart beating to the symphony of life!|I want to fall in love. I want a family. I want a new car. I want a nice house. I want to feel the wind through my hair, the sun on my back, and my heart beating to the symphony of life! ]]
    ]
    (stop:)
  ]
]


