|tw>[ ]  <!-- hook for typewriter text -->
|links>[ ]  <!-- hook for the links, initially empty -->

(live: 0.01s)[
  (if: (substring: $t, 1, $i) is not $t)[
    (replace: ?tw)[(substring: $t, 1, $i)]
    (set: $i to $i + 1)
  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
      [[I'm going to mash his face up with my lightning-fast fists|I'm going to mash his face up with my lightning-fast fist]]
      
      [[Fine. I'll play ball... for now.]]
    ]
    (stop:)
  ]
]


:: George Conversation {"position":"5200,5100","size":"100,100"}
(set:$DialogueStage to "start")
(display:"George Conversation Data")

(if:$GeorgeState is "met")[
	(set:$ActiveDialogue to $GeorgeReturningDialogue)
]
(else:)[
	(set:$GeorgeState to "met")
	(set:$ActiveDialogue to $GeorgeDialogue)
]

(display:"Conversation UI")


