:: Battle {"position":"6800,4700","size":"100,100"}
<audio autoplay loop style="display:none;">
	<source src="https://dl.dropboxusercontent.com/scl/fi/8du1vmjqxes8snrtfup80/BATTLE.m4a?rlkey=pykirnqx9td2zhc19r7hr2oq2&st=eead7v05">
</audio>
(set:_playerEnergyPercent to
	(max:0,
		(min:100,
			(round:(100 * $Energy / $EnergyMax))
		)
	)
)

<div id="battleScreen"><div id="officeBattleIntro"><div id="officeBattleTitle">OFFICE BATTLE!</div></div><div id="battleArena"><div class="battleSide enemySide"><div class="battleName">(print:$EnemyName)</div><div class="battlePortraitFrame">(print:'<img class="battlePortrait enemyPortrait" src="' + $EnemyImage + '">')</div></div>|enemyHPHook>[(set:_enemyHPPercent to (max:0,(min:100,(round:($EnemyHP / $EnemyMaxHP) * 100))))<div id="enemyHPAnchor"><div id="enemyBattleHP"><div id="enemyBattleHPText">HP: (print:$EnemyHP)/(print:$EnemyMaxHP)</div><div id="enemyBattleHPBar"><div id="enemyBattleHPFill" style="width:(print:_enemyHPPercent)%;"></div></div></div></div>]<div id="battleCentre">|battlePopupHook>[(if:$BattlePopup is not "")[<div class="battlePopup">(print:$BattlePopup)</div>]]</div><div class="battleSide playerSide"><div class="battleName">You</div><div class="battlePortraitFrame">(print:'<img class="battlePortrait playerPortrait" src="' + $PlayerImage + '">')</div></div>|playerEnergyHook>[(set:_playerEnergyPercent to (max:0,(min:100,(round:(100 * $Energy / $EnergyMax)))))<div id="playerEnergyAnchor"><div id="playerBattleEnergy"><div id="playerBattleEnergyText">Energy: (print:$Energy)/(print:$EnergyMax)</div><div id="playerBattleEnergyBar"><div id="playerBattleEnergyFill" style="width:(print:_playerEnergyPercent)%;"></div></div></div></div>]<div id="battleBottom">|battleMessageHook>[<div id="battleMessage">(if:$BattleWaitingForClick)[(link-repeat:$BattleMessage)[(if:$BattleMessageIndex < $BattleMessages's length)[(set:$BattleMessageIndex to $BattleMessageIndex + 1)(set:$BattleMessage to $BattleMessages's $BattleMessageIndex)(rerun:?battleMessageHook)](else:)[(set:$BattleWaitingForClick to false)(set:$BattleMessages to (a:))(set:$BattleMessageIndex to 1)(if:$BattleAdvanceAction is "BattleNewRound")[(set:$BattleAdvanceAction to "")(display:"BattleNewRound")](else-if:$BattleAdvanceAction is "EnemyTurn")[(set:$BattleAdvanceAction to "")(display:"EnemyTurn")](else-if:$BattleAdvanceAction is "FinishPlayerAttack")[(display:"FinishPlayerAttack")](else-if:$BattleAdvanceAction is "FinishEnemyAttack")[(display:"FinishEnemyAttack")](else-if:$BattleAdvanceAction is "BattleContinueTurn")[(display:"BattleContinueTurn")](else-if:$BattleAdvanceAction is "YouDied")[(set:$BattleAdvanceAction to "")(go-to:"You Died")](else-if:$BattleAdvanceAction is "FinishQuiver")[(set:$BattleAdvanceAction to "")(set:$BattleInputLocked to false)(set:$BattleMessage to "Choose an action.")(rerun:?battleToolbarHook)(rerun:?battleMessageHook)](else:)[(set:$BattleAdvanceAction to "")(rerun:?battleMessageHook)])]]<div class="battleContinueHint">Click to continue</div>](else:)[(print:$BattleMessage)]</div>]|battleToolbarHook>[<div id="battleToolbar">(if:$BattleEnded)[[[Continue->You Died]]](else-if:$BattleTurn is "Player" and not $BattleInputLocked)[(link-repeat:"ATTACK")[(set:$BattleInputLocked to true)(rerun:?battleToolbarHook)(display:"PlayerAttack")](link:"SPELLS")[(replace:?spellOverlayHook)[(display:"BattleSpells")]](link:"INVENTORY")[(set:$InspectItem to "")(set:$InspectSource to "")(set:$InvMessage to "")(show:?invOverlay)]](else:)[<span class="battleDisabled">ATTACK</span><span class="battleDisabled">SPELLS</span><span class="battleDisabled">INVENTORY</span>]</div>]</div></div>

|spellOverlayHook>[]

(if:$BattleStage is "Starting")[
	(set:$BattleMessages to
		(a:
			$EnemyName + " blocks your path!"
		)
	)
	(set:$BattleAdvanceAction to "BattleNewRound")
	(display:"BattleShowMessages")
]


:: BattleContinueTurn {"position":"7200,4700","size":"100,100"}
(set: $BattlePopup to "")
(set: $BattlePopupType to "")
(rerun: ?battlePopupHook)

(if: $PlayerHasActed and $EnemyHasActed)[

	(set: $BattleMessage to "The round is over.")
	(set: $BattleTurn to "None")
	(set: $BattleInputLocked to true)

	(rerun: ?battleMessageHook)
	(rerun: ?battleToolbarHook)

	(after: 0.8s)[
		(display: "BattleNewRound")
	]

]
(else-if: not $PlayerHasActed)[

	(set: $BattleTurn to "Player")
	(set: $BattleStage to "Player Turn")
	(set: $BattleInputLocked to false)
	(set: $BattleMessage to "Your turn.")

	(rerun: ?battleMessageHook)
	(rerun: ?battleToolbarHook)

]
(else-if: not $EnemyHasActed)[

	(set: $BattleTurn to "Enemy")
	(set: $BattleStage to "Enemy Turn")
	(set: $BattleInputLocked to true)
	(set: $BattleMessage to $EnemyName + "'s turn.")

	(rerun: ?battleMessageHook)
	(rerun: ?battleToolbarHook)

	(after: 0.8s)[
		(display: "EnemyTurn")
	]

]


:: BattleDefeat {"position":"7400,4750","size":"100,100"}
(set:$HP to 0)
(set:$BattleEnded to true)
(set:$InBattle to false)
(set:$BattleInputLocked to true)
(set:$BattleTurn to "None")
(set:$BattleStage to "Defeat")
(set:$ShowHP to false)
(set:$EnemyBattleSTRBonus to 0)
(set:$EnemyBattleDEXBonus to 0)
(set:$PlayerBattleSTRPenalty to 0)
(set:$PlayerBattleDEXPenalty to 0)
(set:$EnemyActionCount to 0)

(set:$BattlePopup to "DEFEAT!")
(set:$BattlePopupType to "defeatPopup")

(set:$BattleMessage to
	"You have been defeated by "
	+ $EnemyName
	+ "."
)

(set:$BattleWaitingForClick to false)
(set:$BattleAdvanceAction to "")

(rerun:?battlePopupHook)
(rerun:?battleMessageHook)
(rerun:?battleToolbarHook)


:: BattleNewRound {"position":"7000,4700","size":"100,100"}
(set:$BattleRound to $BattleRound + 1)

(set:$PlayerHasActed to false)
(set:$EnemyHasActed to false)

(set:$BattleInputLocked to true)
(set:$BattleTurn to "None")
(set:$BattleStage to "Initiative")

(set:$PlayerRoll to (random:1,20))
(set:$EnemyRoll to (random:1,20))

(set:$PlayerInitiative to
	$PlayerRoll
	+ $DEX
	+ $DEXBonus
	+ $PlayerBattleDEXPenalty
)

(set:$EnemyInitiative to
	$EnemyRoll
	+ $EnemyDEX
	+ $EnemyBattleDEXBonus
)

(set:$BattlePopup to "")
(set:$BattlePopupType to "")

(if:$PlayerInitiative >= $EnemyInitiative)[
	(set:$BattleTurn to "Player")
	(set:$BattleStage to "Player Turn")
	(set:$BattleInputLocked to false)

	(set:$BattleMessage to
		"You won initiative."
	)

	(rerun:?battleMessageHook)
	(rerun:?battleToolbarHook)
]
(else:)[
	(set:$BattleTurn to "Enemy")
	(set:$BattleStage to "Enemy Turn")
	(set:$BattleInputLocked to true)

	(set:$BattleMessages to
		(a:
			$EnemyName + " won initiative."
		)
	)

	(set:$BattleAdvanceAction to "EnemyTurn")

	(display:"BattleShowMessages")
]


:: BattleShowMessages {"position":"7150,4550","size":"100,100"}
(if:$BattleMessages's length > 0)[

	(set:$BattleMessageIndex to 1)
	(set:$BattleMessage to $BattleMessages's 1st)
	(set:$BattleWaitingForClick to true)

	(rerun:?battleMessageHook)
	(rerun:?battleToolbarHook)

]


:: BattleSpells {"position":"7000,4550","size":"100,100"}
<div id="spellOverlay"><div id="spellInner"><div id="spellTop"><div id="spellTitle">Spells</div><div id="spellClose">(link:"Close")[(replace:?spellOverlayHook)[](rerun:?battleToolbarHook)]</div></div><div id="spellEnergy">Energy: (print:$Energy)/(print:$EnergyMax)</div><div id="spellList">(for:each _spellID,...$KnownSpells)[(set:_spell to $SpellData's (_spellID))<div class="spellEntry"><div class="spellName">(print:_spell's "name")</div><div class="spellDescription">(print:_spell's "description")</div><div class="spellSchool">School: (print:_spell's "school")</div><div class="spellActionType">Action: (print:_spell's "actionType")</div><div class="spellCost">Cost: (print:_spell's "cost") Energy</div>(if:_spellID is "Quiver")[<div class="spellRequirement">Requires Length (print:_spell's "lengthMaximum") or lower.</div><div class="spellRequirement">Requires Officeness (print:_spell's "minimumOfficeness") or higher.</div>(if:$EnemySkipNextTurn)[<div class="spellUnavailable">The enemy is already affected.</div>](else-if:$Length + $LENBonus > _spell's "lengthMaximum")[<div class="spellUnavailable">You cannot make yourself appear sufficiently insignificant.</div>](else-if:$Officeness + $OfficeBonus < _spell's "minimumOfficeness")[<div class="spellUnavailable">Your Officeness is too low.</div>](else-if:$Energy < _spell's "cost")[<div class="spellUnavailable">Not enough Energy.</div>](else:)[<div class="spellAvailable">(link:"Cast " + (_spell's "name"))[(if:not $EnemySkipNextTurn and $Energy >= _spell's "cost" and $Length + $LENBonus <= _spell's "lengthMaximum" and $Officeness + $OfficeBonus >= _spell's "minimumOfficeness")[(set:$BattleInputLocked to true)(set:$Energy to $Energy - (_spell's "cost"))(set:$EnemySkipNextTurn to true)(replace:?spellOverlayHook)[](rerun:?playerEnergyHook)(rerun:?battleToolbarHook)(set:$BattleMessages to (a:"You shrink back and quiver pathetically before " + $EnemyName + ".",$EnemyName + " stares at you with a mixture of disgust and pity.","You still have time to perform an action."))(set:$BattleAdvanceAction to "FinishQuiver")(display:"BattleShowMessages")]]</div>]](else-if:_spellID is "Paper Cut")[<div class="spellRequirement">Requires Officeness (print:_spell's "minimumOfficeness") or higher.</div>(if:$EnemyPaperCut)[<div class="spellUnavailable">The enemy is already covered in paper cuts.</div>](else-if:$Officeness + $OfficeBonus < _spell's "minimumOfficeness")[<div class="spellUnavailable">Your Officeness is too low.</div>](else-if:$Energy < _spell's "cost")[<div class="spellUnavailable">Not enough Energy.</div>](else:)[<div class="spellAvailable">(link:"Cast " + (_spell's "name"))[(if:not $EnemyPaperCut and $Energy >= _spell's "cost" and $Officeness + $OfficeBonus >= _spell's "minimumOfficeness")[(set:$BattleInputLocked to true)(set:$Energy to $Energy - (_spell's "cost"))(set:$EnemyPaperCut to true)(replace:?spellOverlayHook)[](rerun:?playerEnergyHook)(rerun:?battleToolbarHook)(set:$BattleMessages to (a:"You conjure a swirling cloud of razor-edged office paper.","The sheets slice across " + $EnemyName + ", covering them in countless tiny paper cuts.",$EnemyName + " will now take 1 additional damage whenever they are damaged.","You still have time to perform an action."))(set:$BattleAdvanceAction to "FinishQuiver")(display:"BattleShowMessages")]]</div>]]</div>]</div></div></div>


:: BattleVictory {"position":"7400,4650","size":"100,100"}
(set:$EnemyHP to 0)
(set:$BattleEnded to true)
(set:$InBattle to false)
(set:$BattleInputLocked to true)
(set:$BattleTurn to "None")
(set:$BattleStage to "Victory")

(set:$EnemyBattleSTRBonus to 0)
(set:$EnemyBattleDEXBonus to 0)
(set:$PlayerBattleSTRPenalty to 0)
(set:$PlayerBattleDEXPenalty to 0)
(set:$EnemyActionCount to 0)

(set:$DefeatedEnemies to it + (dm:$EnemyID,true))

(set:$BattlePopup to "VICTORY!")
(set:$BattlePopupType to "victoryPopup")

(set:$BattleMessage to
	"You defeated "
	+ $EnemyName
	+ "!"
)

(rerun:?battlePopupHook)
(rerun:?battleMessageHook)

(replace:?battleToolbarHook)[
	<div id="battleToolbar">
		(link:"Continue")[
			(go-to:$ReturnPassage)
		]
	</div>
]


:: Be free, my paper boat princess. Be free! {"position":"6300,2150","size":"100,100"}
(set: $i to 1)
(set: $t to "That was... beautiful.

I've never seen a paper boat fly... 

I'm actually flabbergasted. It should have just fallen to the ground...

Lets not get hung up on the details.

Don't get your hopes up.

It's not symbolic or anything.
")

|tw>[ ]  <!-- hook for typewriter text -->
|links>[ ]  <!-- hook for the links, initially empty -->

(live: 0.01s)[
  (if: (substring: $t, 1, $i) is not $t)[
    (replace: ?tw)[(substring: $t, 1, $i)]
    (set: $i to $i + 1)
  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
 [[It could be symbolic of my aspirations and dreams...]]
    ]
    (stop:)
  ]
]




