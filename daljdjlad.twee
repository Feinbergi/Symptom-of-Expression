:: Sacrifice Creature {"position":"13400,100","size":"100,100"}
<!-- =========================================================
     SACRIFICE CREATURE

     Before displaying this passage, set:

     $SacrificeSide
         "player" or "enemy".

     $SacrificeLane
         The lane containing the creature to sacrifice.

     Outputs:

     $SacrificeSucceeded
         true if a creature was successfully sacrificed.

     $SacrificeMessage
         Deathrattle and death-resolution text.

     $LastSacrificedCreature
         A reference to the creature that was sacrificed.

     $LastSacrificeName
     $LastSacrificeDefinitionID
     $LastSacrificeTribe
     $LastSacrificeHP
     $LastSacrificeDamage
     $LastSacrificeSide
     $LastSacrificeLane

     Sacrifice is not damage. The creature is placed at 0 Health
     directly, then the normal death pipeline resolves its
     Deathrattle, removes it, and returns it to its owner's deck.
     ========================================================= -->

(set:$SacrificeSucceeded to false)
(set:$SacrificeMessage to "")

(set:$LastSacrificedCreature to (dm:))
(set:$LastSacrificeName to "")
(set:$LastSacrificeDefinitionID to "")
(set:$LastSacrificeTribe to "")
(set:$LastSacrificeHP to 0)
(set:$LastSacrificeDamage to 0)
(set:$LastSacrificeSide to "")
(set:$LastSacrificeLane to 0)


<!-- =========================================================
     VALIDATE THE REQUEST
     ========================================================= -->

(if:
	$SacrificeSide is not "player" and
	$SacrificeSide is not "enemy"
)[

	(set:$SacrificeMessage to
		"No valid sacrifice side was provided. "
	)

]

(else-if:
	$SacrificeLane < 1 or
	$SacrificeLane > 3
)[

	(set:$SacrificeMessage to
		"No valid sacrifice lane was provided. "
	)

]


<!-- =========================================================
     SACRIFICE A PLAYER CREATURE
     ========================================================= -->

(else-if:$SacrificeSide is "player")[

	(if:
		(datanames:$PlayerBoard's ($SacrificeLane))'s length is 0
	)[

		(set:$SacrificeMessage to
			"There was no creature to sacrifice. "
		)

	]

	(else:)[

		(set:_sacrificedCreature to
			$PlayerBoard's ($SacrificeLane)
		)

		(set:$LastSacrificedCreature to
			_sacrificedCreature
		)

		(set:$LastSacrificeName to
			_sacrificedCreature's "name"
		)

		(set:$LastSacrificeDefinitionID to
			_sacrificedCreature's "definitionID"
		)

		(set:$LastSacrificeTribe to
			_sacrificedCreature's "tribe"
		)

		(set:$LastSacrificeHP to
			(max:
				0,
				_sacrificedCreature's "hp"
			)
		)

		(set:$LastSacrificeDamage to
			(max:
				0,
				_sacrificedCreature's "damage"
			)
		)

		(set:$LastSacrificeSide to
			"player"
		)

		(set:$LastSacrificeLane to
			$SacrificeLane
		)

		(set:$PlayerBoard's ($SacrificeLane)'s "hp" to
			0
		)

		(set:$DeathMessage to "")

		(display:"Resolve Dead Creatures")

		(set:$SacrificeMessage to
			$DeathMessage
		)

		(set:$SacrificeSucceeded to true)

	]

]


<!-- =========================================================
     SACRIFICE AN ENEMY CREATURE

     This is included for future cards and effects even though
     Betrayal! currently sacrifices only friendly creatures.
     ========================================================= -->

(else-if:$SacrificeSide is "enemy")[

	(if:
		(datanames:$EnemyBoard's ($SacrificeLane))'s length is 0
	)[

		(set:$SacrificeMessage to
			"There was no creature to sacrifice. "
		)

	]

	(else:)[

		(set:_sacrificedCreature to
			$EnemyBoard's ($SacrificeLane)
		)

		(set:$LastSacrificedCreature to
			_sacrificedCreature
		)

		(set:$LastSacrificeName to
			_sacrificedCreature's "name"
		)

		(set:$LastSacrificeDefinitionID to
			_sacrificedCreature's "definitionID"
		)

		(set:$LastSacrificeTribe to
			_sacrificedCreature's "tribe"
		)

		(set:$LastSacrificeHP to
			(max:
				0,
				_sacrificedCreature's "hp"
			)
		)

		(set:$LastSacrificeDamage to
			(max:
				0,
				_sacrificedCreature's "damage"
			)
		)

		(set:$LastSacrificeSide to
			"enemy"
		)

		(set:$LastSacrificeLane to
			$SacrificeLane
		)

		(set:$EnemyBoard's ($SacrificeLane)'s "hp" to
			0
		)

		(set:$DeathMessage to "")

		(display:"Resolve Dead Creatures")

		(set:$SacrificeMessage to
			$DeathMessage
		)

		(set:$SacrificeSucceeded to true)

	]

]


