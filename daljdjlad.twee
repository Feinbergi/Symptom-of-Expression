:: Office - Window {"position":"9000,4900","size":"100,100"}
(set:$CurrentRoom to "Window")
(set:$InteractionPopupOpen to false)
(set:$InteractionPopupText to "")
(set:$InteractionView to "main")
(set:$InteractionID to "")

(set:_WindowChanged to $WindowVisited and $MapVisitedSinceWindow)

(if:_WindowChanged)[
	<div class="room-screen window-returned-bg">
		<div class="window-click-area window-open-hotspot" data-label="Window Opposite">
			|windowopenhotspot>[Open Window Hotspot]
		</div>

		<div class="window-click-area leave-window-hotspot" data-label="Leave Window">
			|leavewindowhotspot>[Leave Window Hotspot]
		</div>
	</div>
]
(else:)[
	<div class="room-screen window-first-bg">
		<div class="window-click-area window-open-hotspot" data-label="Window Opposite">
			|windowopenhotspot>[Open Window Hotspot]
		</div>

		<div class="window-click-area leave-window-hotspot" data-label="Leave Window">
			|leavewindowhotspot>[Leave Window Hotspot]
		</div>
	</div>
]

(display:"Interaction Popup UI")

(click-rerun:?windowopenhotspot)[
	(if:$InteractionPopupOpen is false)[
		(set:$InteractionID to "OpenWindow")
		(set:$InteractionPopupOpen to true)
		(set:$InteractionView to "main")

		(if:_WindowChanged)[
			(set:$InteractionPopupText to "Police tape fills the window...")
		]
		(else:)[
			(set:$InteractionPopupText to "An ugly little man is perched precariously on a window ledge. He pays you no mind.")
		]

		(rerun:?interactionPopup)
	]
]

(click:?leavewindowhotspot)[
	(go-to:"Your Office")
]

(set:$WindowVisited to true)


