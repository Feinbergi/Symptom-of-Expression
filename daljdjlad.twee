	"friendlyDeathTrigger","none",
	"continuousEffect","none",
	"keywords",(a:),
	"resetOnDeckReturn",true,
	"description","No special effect.",
	"attackBonus",0,
	"healthBonus",0,
	"temporaryDamage",0,
	"temporaryMaxHP",0,
	"silenced",false,
	"ready",false,
	"canInitiateCombat",false,
	"poison",0
)))

(set:$EnemyDeck to $EnemyDeck + (a:(dm:
	"id","E12",
	"definitionID","enemy-dragon",
	"name","Dragon",
	"type","creature",
	"tribe","",
	"cost",5,
	"baseDamage",6,
	"damage",6,
	"baseMaxHP",6,
	"maxHP",6,
	"hp",6,
	"effect","none",
	"targetType","lane",
	"battlecry","none",
	"deathrattle","none",
	"turnStart","none",
	"turnEnd","none",
	"damagedTrigger","none",
	"friendlyDeathTrigger","none",
	"continuousEffect","none",
	"keywords",(a:),
	"resetOnDeckReturn",true,
	"description","No special effect.",
	"attackBonus",0,
	"healthBonus",0,
	"temporaryDamage",0,
	"temporaryMaxHP",0,
	"silenced",false,
	"ready",false,
	"canInitiateCombat",false,
	"poison",0
)))


<!-- =========================================================
     SHUFFLE BOTH DECKS
     ========================================================= -->

(set:$PlayerDeck to
	(shuffled:...$PlayerDeck)
)

(set:$EnemyDeck to
	(shuffled:...$EnemyDeck)
)


<!-- =========================================================
     DEAL THREE OPENING CARDS TO EACH PLAYER
     ========================================================= -->

(for:each _draw,...(range:1,3))[

	(if:$PlayerDeck's length > 0)[

		(set:$PlayerHand to
			$PlayerHand +
			(a:$PlayerDeck's 1st)
		)

		(if:$PlayerDeck's length is 1)[

			(set:$PlayerDeck to (a:))

		]

		(else:)[

			(set:$PlayerDeck to
				(subarray:$PlayerDeck,2,-1)
			)

		]

	]

	(if:$EnemyDeck's length > 0)[

		(set:$EnemyHand to
			$EnemyHand +
			(a:$EnemyDeck's 1st)
		)

		(if:$EnemyDeck's length is 1)[

			(set:$EnemyDeck to (a:))

		]

		(else:)[

			(set:$EnemyDeck to
				(subarray:$EnemyDeck,2,-1)
			)

		]

	]

]


<!-- =========================================================
     BEGIN THE FIRST TURN
     ========================================================= -->

(if:$StartingPlayer is "player")[

	(set:$CardGameMessage to
		"The coin toss chooses you to go first. As the first player, you do not draw on this turn."
	)

	(display:"Start Player Card Turn")

]

(else:)[

	(set:$CardGameMessage to
		"The coin toss chooses the enemy to go first. As the first player, the enemy does not draw on this turn."
	)

	(display:"Enemy Turn Logic")

]

(go-to:"Card Game")


