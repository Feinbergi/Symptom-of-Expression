		(set:_nextY to $Maze2VDiamond7Y + $Maze2VDiamond7Direction)
	]
	(set:$Maze2VDiamond7Y to _nextY)
	(if:$Maze2VDiamond7X is $Maze2PlayerX and $Maze2VDiamond7Y is $Maze2PlayerY)[
		(set:$Maze2GameOver to true)
	]
]

<!-- VERTICAL DIAMOND 8 -->
(if:$Maze2GameOver is false)[
	(set:_nextY to $Maze2VDiamond8Y + $Maze2VDiamond8Direction)
	(if:_nextY <= 1 or _nextY >= 18)[
		(set:$Maze2VDiamond8Direction to 0 - $Maze2VDiamond8Direction)
		(set:_nextY to $Maze2VDiamond8Y + $Maze2VDiamond8Direction)
	]
	(set:$Maze2VDiamond8Y to _nextY)
	(if:$Maze2VDiamond8X is $Maze2PlayerX and $Maze2VDiamond8Y is $Maze2PlayerY)[
		(set:$Maze2GameOver to true)
	]
]


