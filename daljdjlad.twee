:: Task Complete Popup {"position":"6000,4300","size":"100,100"}
<div id="taskCompleteBackdrop"></div>

<div id="taskComplete">

<div id="taskCompleteStars">
★★★★★
</div>

<div id="taskCompleteHeader">
TASK COMPLETE
</div>

<div id="taskCompleteQuest">
(print:$TaskCompleteTitle)
</div>

<div id="taskCompleteReward">
+ (print:$TaskCompleteXP) XP
</div>

<script>
if(window.taskCompleteSound){
	window.taskCompleteSound.pause();
	window.taskCompleteSound.currentTime=0;
}
window.taskCompleteSound=new Audio("https://raw.githubusercontent.com/Feinbergi/Symptom-of-Expression/main/Dundadun%20GAME%20-%2030_07_2026,%2023.57.m4a");
window.taskCompleteSound.volume=0.8;
window.taskCompleteSound.play().catch(()=>{});
</script>

(live:5s)[
(set:$ShowTaskComplete to false)
(rerun:?TASKCOMPLETE)
(stop:)
]

</div>


