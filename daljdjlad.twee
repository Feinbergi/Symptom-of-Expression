:: FinishEnemyAttack {"position":"7100,4900","size":"100,100"}
(set:$BattleAdvanceAction to "")
(set:$BattleWaitingForClick to false)

(set:$BattleMessages to (a:))
(set:$BattleMessageIndex to 1)

(set:_damagePrevented to false)
(set:_breakMessage to "")
(set:_semiImmortalMessage to "")
(set:_semiImmortalDeath to false)

(if:$EnemyAttackHit)[

	(if:$EquipHead is "Nerdy Glasses"
		and $EnemyDamage > 4)[

		(set:_damagePrevented to true)

		(set:_breakMessage to
			"Your Nerdy Glasses shatter and protect you from the damage!"
		)

		(set:$EquipHead to "None")

		(if:$InspectItem is "Nerdy Glasses")[
			(set:$InspectItem to "")
			(set:$InspectSource to "")
		]

		(display:"InvStatBonuses")
		(display:"UpdateStats")

	]

	(if:not _damagePrevented)[

		(if:$SemiImmortalTalent is true)[

			(set:_damageToReachOne to (max:0,$HP - 1))

			(if:$EnemyDamage <= _damageToReachOne)[

				(set:$HP to (max:1,$HP - $EnemyDamage))

			]
			(else:)[

				(set:_overflowDamage to
					$EnemyDamage - _damageToReachOne
				)

				(set:$HP to 1)

				(set:$SemiImmortalMaxHPLoss to
					$SemiImmortalMaxHPLoss + _overflowDamage
				)

				(display:"UpdateStats")

				(if:$HP > $MaxHP)[
					(set:$HP to $MaxHP)
				]

				(if:$MaxHP < 1)[

					(set:_semiImmortalDeath to true)

					(set:_semiImmortalMessage to
						"Semi-Immortal keeps you at 1 HP, but the remaining "
						+ (str:_overflowDamage)
						+ " damage destroys your Maximum HP."
					)

				]
				(else:)[

					(set:_semiImmortalMessage to
						"Semi-Immortal keeps you at 1 HP. The remaining "
						+ (str:_overflowDamage)
						+ " damage permanently reduces your Maximum HP to "
						+ (str:$MaxHP)
						+ "."
					)

				]

			]

		]
		(else:)[

			(set:$HP to
				(max:0,$HP - $EnemyDamage)
			)

		]

	]

	(if:$ShowHP)[
		(rerun:?HPDATA)
	]

]

(set:$EnemyHasActed to true)

(set:$BattlePopup to "")
(set:$BattlePopupType to "")

(rerun:?battlePopupHook)

(if:_semiImmortalDeath)[

	(display:"BattleDefeat")

]
(else-if:_breakMessage is not "")[

	(set:$BattleMessages to
		(a:_breakMessage)
	)

	(set:$BattleAdvanceAction to "BattleContinueTurn")

	(display:"BattleShowMessages")

]
(else-if:_semiImmortalMessage is not "")[

	(set:$BattleMessages to
		(a:_semiImmortalMessage)
	)

	(set:$BattleAdvanceAction to "BattleContinueTurn")

	(display:"BattleShowMessages")

]
(else-if:$HP <= 0)[

	(display:"BattleDefeat")

]
(else:)[

	(display:"BattleContinueTurn")

]


:: FinishPlayerAttack {"position":"7100,4800","size":"100,100"}
(set:$BattleAdvanceAction to "")
(set:$BattleWaitingForClick to false)
(set:$BattleMessages to (a:))
(set:$BattleMessageIndex to 1)

(if:$PlayerAttackHit)[
	(set:$EnemyHP to
		(max:0,$EnemyHP - $PlayerDamage)
	)
	(rerun:?enemyHPHook)
]

(set:$PlayerHasActed to true)
(set:$BattlePopup to "")
(set:$BattlePopupType to "")
(rerun:?battlePopupHook)

(if:$EnemyHP <= 0)[
	(display:"BattleVictory")
]
(else:)[
	(display:"BattleContinueTurn")
]


