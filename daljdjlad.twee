:: 'I couldn't imagine having a worse Boss. They are vile and cruel and stinky and mean...' {"position":"2025,675","size":"100,100"}
(set: $i to 1)
(set: $t to "... ...
")

|tw>[ ]  <!-- hook for typewriter text -->
|links>[ ]  <!-- hook for the links, initially empty -->

(live: 0.01s)[
  (if: (substring: $t, 1, $i) is not $t)[
    (replace: ?tw)[(substring: $t, 1, $i)]
    (set: $i to $i + 1)
  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
      [['Life gives you lemons. Life gave me an allergy to lemons...']]
      
      [['Actually you know what. My Boss threatened to kill me... and sexually attack me. So he should be imprisoned for that. I've got my hand on a bible while writing this. So it's true...']] 
      
      [['Life is like a box of chocolates. Forrest Gump was so right. Those fancy boxes are always so hard to open, then other people always eat them if you don't hide them...']]
      
      (if: $GIRL is true)[['Before I die, I just want to shout-out to Jennifer who said I wasn't that ugly when I was in 5th grade...']]
    ]
    (stop:)
  ]
]


