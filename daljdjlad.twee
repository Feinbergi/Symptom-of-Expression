/*MENU FADE*/
.fadeLayer {
	position: fixed;
	inset: 0;
	background: black;
	opacity: 0;
	pointer-events: none;
	animation: fadeToBlack 1s linear forwards;
	z-index: 99999;
}

@keyframes fadeToBlack {
	from { opacity: 0; }
	to { opacity: 1; }
}

.revealFade {
	position: fixed;
	inset: 0;
	background: black;
	pointer-events: none;
	z-index: 99999;
	animation: fadeFromBlack 1s linear forwards;
}

@keyframes fadeFromBlack {
	from { opacity: 1; }
	to { opacity: 0; visibility: hidden; }
}








/*==========================
      TASK COMPLETE
==========================*/

#taskComplete{
position:fixed;
left:50%;
top:50%;
transform:translate(-50%,-50%);
z-index:99999;
text-align:center;
pointer-events:none;
animation:taskCompleteAppear 4.2s ease forwards;
}

#taskCompleteBackdrop{
position:fixed;
left:0;
top:0;
width:100%;
height:100%;
background:rgba(0,0,0,.72);
z-index:99998;
pointer-events:none;
animation:taskBackdrop 4.2s ease forwards;
}

#taskCompleteStars{
font-size:54px;
color:#ffd84a;
letter-spacing:8px;
margin-bottom:8px;
text-shadow:
0 0 12px #ffdf66,
0 0 30px gold;

animation:starPulse .55s infinite alternate;
}

#taskCompleteHeader{
font-size:56px;
font-weight:bold;
color:white;
letter-spacing:6px;
margin-bottom:10px;
text-shadow:
0 0 6px black,
0 0 18px gold,
0 0 36px orange;

animation:headerPulse .8s infinite alternate;
}

#taskCompleteQuest{
font-size:30px;
font-weight:bold;
color:#ffe28a;
text-shadow:0 0 10px black;
margin-bottom:18px;

animation:questRise .6s ease-out;
}

#taskCompleteReward{
font-size:34px;
font-weight:bold;
color:#ffd84a;
text-shadow:
0 0 8px black,
0 0 18px gold;

animation:xpPop .45s .35s both;
}


/*==========================
        MAIN POPUP
==========================*/

@keyframes taskCompleteAppear{

0%{
opacity:0;
transform:translate(-50%,-50%) scale(2);
filter:blur(8px);
}

12%{
opacity:1;
transform:translate(-50%,-50%) scale(.92);
filter:blur(0);
}

20%{
transform:translate(-50%,-50%) scale(1.04);
}

82%{
opacity:1;
transform:translate(-50%,-50%) scale(1);
}

100%{
opacity:0;
transform:translate(-50%,-50%) scale(.94);
filter:blur(2px);
}

}


/*==========================
       BACKDROP
==========================*/

@keyframes taskBackdrop{

0%{
opacity:0;
}

12%{
opacity:1;
}

82%{
opacity:1;
}

100%{
opacity:0;
}

}


/*==========================
        STARS
==========================*/

@keyframes starPulse{

from{

transform:scale(1);
text-shadow:
0 0 12px gold,
0 0 25px orange;

}

to{

transform:scale(1.08);
text-shadow:
0 0 20px gold,
0 0 40px orange,
0 0 65px yellow;

}

}


/*==========================
      HEADER PULSE
==========================*/

@keyframes headerPulse{

from{

letter-spacing:6px;

}

to{

letter-spacing:10px;

}

}


/*==========================
      QUEST SLIDE
==========================*/

@keyframes questRise{

0%{

opacity:0;
transform:translateY(35px);

}

100%{

opacity:1;
transform:translateY(0);

}

}


/*==========================
         XP POP
==========================*/

@keyframes xpPop{

0%{

opacity:0;
transform:scale(.3);

}

70%{

transform:scale(1.25);

}

100%{

opacity:1;
transform:scale(1);

}

}

















