:: It's true, and I have loads of sex, for your information {"position":"950,1950","size":"100,100"}
(set: $PREGNANT to true)
(set: $i to 1)
(set: $t to "Damn, I didn't know you were a player. Respect.

What about the kid then?
")

|tw>[ ]  <!-- hook for typewriter text -->
|links>[ ]  <!-- hook for the links, initially empty -->

(live: 0.01s)[
  (if: (substring: $t, 1, $i) is not $t)[
    (replace: ?tw)[(substring: $t, 1, $i)]
    (set: $i to $i + 1)
  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
      [[I'll just put the kid up for adoption]]
      
      [[I'll eat the kid and absorb their vitality]]
     
     [[I'll raise the kid good and proper, you'll see!]]
     
     [[I'll raise the kid to be a cog in the corporate machine. For company and honour!]]
    ]
    (stop:)
  ]
]
(set:_AlreadyPregnant to false)
(for:each _activeStatus,...$ActiveStatuses)[
	(if:_activeStatus's "id" is "Pregnant")[
		(set:_AlreadyPregnant to true)
	]
]
(if:not _AlreadyPregnant)[
	(set:_OldMaxHP to $MaxHP)
	(set:$ActiveStatuses to $ActiveStatuses + (a:(dm:"id","Pregnant","duration",-1)))
	(display:"InvStatBonuses")
	(display:"UpdateStats")
	(set:_MaxHPIncrease to $MaxHP - _OldMaxHP)
	(if:_MaxHPIncrease > 0)[
		(set:$HP to $HP + _MaxHPIncrease)
		(if:$HP > $MaxHP)[
			(set:$HP to $MaxHP)
		]
	]
]
(rerun:?HPDATA)


:: It's true... but I've never had sex... {"position":"875,1825","size":"100,100"}
(set: $PREGNANT to true)
(set: $i to 1)
(set: $t to "How are you pregnant then?
")

|tw>[ ]  <!-- hook for typewriter text -->
|links>[ ]  <!-- hook for the links, initially empty -->

(live: 0.01s)[
  (if: (substring: $t, 1, $i) is not $t)[
    (replace: ?tw)[(substring: $t, 1, $i)]
    (set: $i to $i + 1)
  ]
  (else-if: (substring: $t, 1, $i) is $t)[
    (replace: ?links)[
      [[I sometimes sleepwalk, maybe i had sleepsex?]]
      
      [[I got pregnant at an impregnation clinic so I could get maternity leave]]
     
     [[Can you get pregnant from hanging around other pregnant people?]]
    ]
    (stop:)
  ]
]
(set:_AlreadyPregnant to false)
(for:each _activeStatus,...$ActiveStatuses)[
	(if:_activeStatus's "id" is "Pregnant")[
		(set:_AlreadyPregnant to true)
	]
]
(if:not _AlreadyPregnant)[
	(set:_OldMaxHP to $MaxHP)
	(set:$ActiveStatuses to $ActiveStatuses + (a:(dm:"id","Pregnant","duration",-1)))
	(display:"InvStatBonuses")
	(display:"UpdateStats")
	(set:_MaxHPIncrease to $MaxHP - _OldMaxHP)
	(if:_MaxHPIncrease > 0)[
		(set:$HP to $HP + _MaxHPIncrease)
		(if:$HP > $MaxHP)[
			(set:$HP to $MaxHP)
		]
	]
]
(rerun:?HPDATA)


