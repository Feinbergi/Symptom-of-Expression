/* ================================================= */
/* ================== HUD BRIDGE =================== */
/* ================================================= */

/* Hide the data source hook (robust version) */


tw-hook[name="HPDATA"],
tw-hook[hookname="HPDATA"],
tw-hook[name="HPVAL"],
tw-hook[hookname="HPVAL"],
tw-hook[name="HPMAX"],
tw-hook[hookname="HPMAX"],
tw-hook[name="HPPCT"],
tw-hook[hookname="HPPCT"],
tw-hook[name="HPDATA" i],
tw-hook[hookname="HPDATA" i],
tw-hook[name="HPVAL" i],
tw-hook[hookname="HPVAL" i],
tw-hook[name="HPMAX" i],
tw-hook[hookname="HPMAX" i],
tw-hook[name="HPPCT" i],
tw-hook[hookname="HPPCT" i]{
  display:none !important;
}
tw-hook[name="HUDDATA"],
tw-hook[hookname="HUDDATA"],
tw-hook[name="HUDITEM"],
tw-hook[hookname="HUDITEM"],
tw-hook[name="HUDDATA" i],
tw-hook[hookname="HUDDATA" i],
tw-hook[name="HUDITEM" i],
tw-hook[hookname="HUDITEM" i]{
  display:none !important;
}


/* Global overlay HUD (true top-right, above PanelLeft divider) */
#HUD_GLOBAL{
  position: fixed;
  bottom: 18px;   /* changed from top */
  right: 18px;

  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 10px;

  z-index: 2000000;
  pointer-events: none;
}


/* Individual portrait blocks */
#HUD_GLOBAL .hudPortrait{
  width: 100px;
  height: 100px;
  background-size: cover;
  background-position: center;
  flex: 0 0 auto;
}


















































/* Fixed HP overlay above HUD portraits (bottom-right) */
#HP_GLOBAL{
  position: fixed;
  right: 18px;
  bottom: 18px;

  /* sit above the portraits: portraits are 100px tall */
  transform: translateY(-110px);

  z-index: 2000001; /* slightly above HUD_GLOBAL */
  pointer-events: auto;
}

/* Layout of the HP widget */
#HP_GLOBAL .hpRow{
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 6px;
}

/* The bar itself */
#HP_GLOBAL .hpBox{
  width: 260px;
  height: 16px;
  border: 2px solid #fff;
  background: #111;
  overflow: hidden;
}

#HP_GLOBAL .hpFill{
  height: 100%;
  width: 0%;
  background: #e6e6e6;
}

/* HP text */
#HP_GLOBAL .hpText{
  font-size: 14px;
  color: #fff;
  white-space: nowrap;
}

/* Optional: style a link if you add one later */
#HP_GLOBAL a{
  color: #fff !important;
  text-decoration: none !important;
  pointer-events: auto;
}























tw-passage tw-hook[name="UIHEADER"],
tw-passage tw-hook[hookname="UIHEADER"]{
  display:none !important;
}
tw-hook[name="UIHEADER"],
tw-hook[hookname="UIHEADER"]{
  display:none !important;
  height:0 !important;
  margin:0 !important;
  padding:0 !important;
  border:0 !important;
}
















/*BROKEBACK KARAOKE*/
.crawlRight{
	position:fixed;
	right:5%;
	top:20%;
	width:30vw;
	max-width:500px;
	z-index:999;
}

.crawlWindow{
	height:300px;
	overflow:hidden;
	background:rgba(0,0,0,0.85);
	border:2px solid #ffe08a;
	padding:20px;
}

.crawlText{
	position:relative;
	text-align:center;
	color:#ffe08a;
	font-size:1.3rem;
	line-height:1.8;
	animation:scrollUp 25s linear forwards;
}

@keyframes scrollUp{
	from{
		transform:translateY(25%);
	}
	to{
		transform:translateY(-120%);
	}
}



















/* Keep the Harlowe inventory hook above the fixed battle screen */
tw-hook[name="invoverlay"] {
	position: fixed !important;
	inset: 0 !important;
	width: 100vw !important;
	height: 100vh !important;
	margin: 0 !important;
	padding: 0 !important;
	z-index: 100000 !important;
	pointer-events: auto !important;
	overflow: visible !important;
	box-sizing: border-box !important;
}

/* =========================================================
   INVENTORY OVERLAY
   ========================================================= */

#invOverlay {
	position: fixed !important;
	inset: 0 !important;
	display: block;
	padding: 32px !important;
	box-sizing: border-box !important;
	color: #fff;
	background: #000;
	overflow-x: hidden !important;
	overflow-y: auto !important;
	z-index: 99999 !important;
}

#invInner {
	width: min(1200px, 100%) !important;
	margin: 0 auto !important;
	padding: 0 !important;
	color: #fff;
	box-sizing: border-box !important;
}

/* =========================================================
   INVENTORY HEADER
   ========================================================= */

#invTop {
	display: flex !important;
	align-items: center !important;
	justify-content: space-between !important;
	gap: 20px !important;
	margin: 0 0 20px 0 !important;
	padding: 0 !important;
}

#invTitle {
	margin: 0 !important;
	padding: 0 !important;
	font-size: 2rem !important;
	font-weight: bold !important;
	line-height: 1.1 !important;
}

#invClose {
	margin: 0 !important;
	padding: 0 !important;
	text-align: right !important;
}

#invClose tw-link {
	cursor: pointer;
}

/* =========================================================
   TOP ROW
   ========================================================= */

#invTopRow {
	display: grid !important;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
	align-items: start !important;
	gap: 20px !important;
	margin: 0 0 20px 0 !important;
	padding: 0 !important;
}

#invTopRow > tw-hook {
	display: block !important;
	width: 100% !important;
	min-width: 0 !important;
	margin: 0 !important;
	padding: 0 !important;
}

#invEquipped,
#invCharacter {
	width: 100% !important;
	height: auto !important;
	margin: 0 !important;
	box-sizing: border-box !important;
}

/* =========================================================
   INSPECT ROW
   ========================================================= */

#invMidRow {
	display: block !important;
	width: 100% !important;
	margin: 0 0 20px 0 !important;
	padding: 0 !important;
}

#invMidRow > tw-hook {
	display: block !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}

#invInspect {
	display: block !important;
	width: 100% !important;
	height: auto !important;
	min-height: 0 !important;
	margin: 0 !important;
	box-sizing: border-box !important;
}

#invInspect tw-hook {
	display: block;
	height: auto !important;
	min-height: 0 !important;
}

/* =========================================================
   INVENTORY AND STATUS ROW
   ========================================================= */

#invBottomRow {
	display: block !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}

#invBottomGrid {
	display: grid !important;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
	align-items: stretch !important;
	gap: 20px !important;
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
	box-sizing: border-box !important;
}

#invBottomGrid > tw-hook {
	display: block !important;
	width: 100% !important;
	min-width: 0 !important;
	margin: 0 !important;
	padding: 0 !important;
}

#invBag,
#invStatuses {
	width: 100% !important;
	height: 100% !important;
	margin: 0 !important;
	box-sizing: border-box !important;
}

/* =========================================================
   PANELS
   ========================================================= */

.invPanel {
	display: block !important;
	height: auto !important;
	min-height: 0 !important;
	margin: 0 !important;
	padding: 20px !important;
	color: #fff;
	background: #000;
	border: 1px solid #fff;
	box-sizing: border-box !important;
}

.invHeading {
	margin: 0 0 14px 0 !important;
	padding: 0 0 8px 0 !important;
	border-bottom: 1px solid #555;
	font-size: 1.25rem !important;
	font-weight: bold !important;
	line-height: 1.2 !important;
}

/* =========================================================
   INVENTORY TEXT
   ========================================================= */

.invLine {
	display: block !important;
	margin: 0 0 8px 0 !important;
	padding: 0 !important;
	font-size: 1rem !important;
	line-height: 1.4 !important;
	white-space: normal !important;
}

.invLine:last-child {
	margin-bottom: 0 !important;
}

.invMessage {
	display: block !important;
	margin: 0 0 12px 0 !important;
	padding: 10px !important;
	border: 1px solid #555;
	line-height: 1.4 !important;
	box-sizing: border-box !important;
}

.invBase {
	opacity: 0.7;
	font-size: 0.9em;
	line-height: inherit;
}

/* =========================================================
   STATUS EFFECTS
   ========================================================= */

.invNoStatuses {
	display: block !important;
	margin: 0 !important;
	padding: 0 !important;
	opacity: 0.7;
	font-style: italic;
	font-size: 1rem !important;
	line-height: 1.4 !important;
}

.invStatusEntry {
	display: block !important;
	margin: 0 0 12px 0 !important;
	padding: 12px !important;
	border: 1px solid #555;
	box-sizing: border-box !important;
}

.invStatusEntry:last-child {
	margin-bottom: 0 !important;
}

.invStatusBuff {
	border-left: 4px solid #fff;
}

.invStatusDebuff {
	border-left: 4px solid #777;
}

.invStatusName {
	display: block !important;
	margin: 0 0 3px 0 !important;
	padding: 0 !important;
	font-size: 1.05rem !important;
	font-weight: bold !important;
	line-height: 1.3 !important;
}

.invStatusIcon {
	display: inline-block !important;
	margin-right: 4px !important;
}

.invStatusType {
	display: block !important;
	margin: 0 0 7px 0 !important;
	padding: 0 !important;
	opacity: 0.65;
	font-size: 0.8rem !important;
	font-weight: bold !important;
	letter-spacing: 0.08em !important;
	text-transform: uppercase;
	line-height: 1.2 !important;
}

.invStatusDescription {
	display: block !important;
	margin: 0 0 7px 0 !important;
	padding: 0 !important;
	font-size: 0.95rem !important;
	line-height: 1.4 !important;
}

.invStatusDuration {
	display: block !important;
	margin: 0 !important;
	padding: 0 !important;
	opacity: 0.75;
	font-size: 0.85rem !important;
	line-height: 1.3 !important;
}

/* =========================================================
   REMOVE HARLOWE WHITESPACE EXPANSION
   ========================================================= */

#invOverlay tw-hook,
#invOverlay tw-expression {
	margin-top: 0 !important;
	margin-bottom: 0 !important;
}

#invOverlay br {
	line-height: 1 !important;
}

/* =========================================================
   SMALLER SCREENS
   ========================================================= */

@media screen and (max-width: 900px) {
	#invOverlay {
		padding: 20px !important;
	}

	#invTopRow,
	#invBottomGrid {
		grid-template-columns: 1fr !important;
	}
}

@media screen and (max-width: 600px) {
	#invOverlay {
		padding: 12px !important;
	}

	#invTop {
		margin-bottom: 12px !important;
	}

	#invTitle {
		font-size: 1.5rem !important;
	}

	.invPanel {
		padding: 14px !important;
	}
}



/* Office Map */
.map-screen {
	position: fixed !important;
	left: 50% !important;
	top: 50% !important;

	width: 100vw !important;
	height: 56.279vw !important;

	max-width: 177.683vh !important;
	max-height: 100vh !important;

	transform: translate(-50%, -50%) !important;

	overflow: hidden !important;
	background: #000 !important;
}

.map-background {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;
	width: 100% !important;
	height: 100% !important;

	object-fit: fill !important;
}

.mapLink {
	position: absolute !important;
	box-sizing: border-box !important;
	overflow: hidden !important;
	z-index: 5 !important;
}

.mapLink tw-link {
	display: block !important;
	width: 100% !important;
	height: 100% !important;

	font-size: 0 !important;
	line-height: 0 !important;
	color: transparent !important;

	background: rgba(255, 255, 255, 0);
	cursor: pointer;
}

.mapLink tw-link:hover {
	background: rgba(255, 0, 0, 0.18) !important;
	outline: 2px solid rgba(255, 255, 255, 0.5) !important;
}

