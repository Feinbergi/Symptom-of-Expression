	cursor: pointer !important;
	pointer-events: auto !important;
}


/* Harlowe wrapper created by (click:) or (click-rerun:) */

.mop-closet-click-area tw-enchantment {
	position: absolute !important;
	inset: 0 !important;

	display: block !important;

	width: 100% !important;
	height: 100% !important;

	margin: 0 !important;
	padding: 0 !important;

