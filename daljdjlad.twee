	),

	(dm:
		"id","workFlugiyo",
		"choices",(a:

			(dm:
				"label","What's Flugiyo?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","What's Flugiyo?"
					),
					(dm:
						"speaker","action",
						"text","Jerry's hollow eyes brighten."
					),
					(dm:
						"speaker","npc",
						"text","A game of bound spirits, fungoid champions and laminated prophecy."
					),
					(dm:
						"speaker","npc",
						"text","One gathers cards into a deck."
					),
					(dm:
						"speaker","npc",
						"text","Then the deck is sent against another, and the stronger arrangement survives."
					)
				),
				"next","workFlugiyoPlay"
			)

		)
	),

	(dm:
		"id","workFlugiyoPlay",
		"choices",(a:

			(dm:
				"label","Do you want to play?",
				"events",(a:
					(dm:
						"speaker","player",
						"text","Do you want to play?"
					),
					(dm:
						"speaker","npc",
						"text","Yes."
					),
					(dm:
						"speaker","npc",
						"text","I have waited through eleven dynasties for a worthy opponent."
					)
				),
				"next","workNoDeck"
			)

		)
	),

	(dm:
		"id","workNoDeck",
