:: Alien Conversation {"position":"5000,4700","size":"100,100"}
(set:$DialogueStage to "start")
(if:$EquipMisc1 is "Translator Torc" or $EquipMisc2 is "Translator Torc")[

	(if:$AlienConversationState is "accepted")[
		(set:$ActiveDialogue to $AlienAcceptedDialogue)
	]
	(else-if:$AlienConversationState is "refused")[
		(set:$ActiveDialogue to $AlienRefusedDialogue)
	]
	(else:)[
		(set:$ActiveDialogue to $AlienTranslatedDialogue)
	]

]
(else-if:$AlienConversationState is "met" or $AlienConversationState is "accepted" or $AlienConversationState is "refused")[

	(set:$AlienVisitCount to $AlienVisitCount + 1)
	(set:$ActiveDialogue to $AlienRecurringDialogue)

]
(else:)[

	(set:$ActiveDialogue to $AlienDialogue)

]

(display:"Conversation UI")


